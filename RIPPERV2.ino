const char *ir_discovery_database_path() {
  if (strcmp(ir_discovery_device_name, "TV") == 0) return "/infrared/databases/tv.ir";
  if (strcmp(ir_discovery_device_name, "PROJECTOR") == 0) return "/infrared/databases/projector.ir";
  if (strcmp(ir_discovery_device_name, "AUDIO") == 0) return "/infrared/databases/audio.ir";
  return NULL;
}


uint32_t parse_ir_database_hex(const String &text) {
  uint32_t value = 0;
  uint8_t shift = 0;
  int start = 0;
  while (start < (int)text.length() && shift < 32) {
    while (start < (int)text.length() && text[start] == ' ') start++;
    if (start >= (int)text.length()) break;
    int end = text.indexOf(' ', start);
    if (end < 0) end = text.length();
    value |= (uint32_t)strtoul(text.substring(start, end).c_str(), NULL, 16) << shift;
    shift += 8;
    start = end + 1;
  }
  return value;
}


uint32_t reverse_ir_bits32(uint32_t value) {
  value = ((value & 0x55555555UL) << 1) | ((value >> 1) & 0x55555555UL);
  value = ((value & 0x33333333UL) << 2) | ((value >> 2) & 0x33333333UL);
  value = ((value & 0x0F0F0F0FUL) << 4) | ((value >> 4) & 0x0F0F0F0FUL);
  value = ((value & 0x00FF00FFUL) << 8) | ((value >> 8) & 0x00FF00FFUL);
  return (value << 16) | (value >> 16);
}


bool make_ir_database_command(const String &protocol, uint32_t address,
                              uint32_t code, SavedIrRemoteCommand &command) {
  memset(&command, 0, sizeof(command));
  if (address > 0xFFFF || code > 0xFFFF) return false;
  command.valid = 1;
  command.address = (uint16_t)address;
  command.command = (uint16_t)code;

  if (protocol == "NEC" || protocol == "NECext") {
    command.protocol = NEC;
    command.bits = 32;
  } else if (protocol == "Samsung32") {
    command.protocol = SAMSUNG;
    command.bits = 32;
    uint32_t lsb = address < 0x100 ? (address | (address << 8)) : address;
    lsb |= code < 0x100 ? (code << 16) | ((uint32_t)(uint8_t)~code << 24) : code << 16;
    command.raw_data = reverse_ir_bits32(lsb);
  } else if (protocol == "SIRC" || protocol == "SIRC15" || protocol == "SIRC20") {
    command.protocol = SONY;
    command.bits = protocol == "SIRC20" ? 20 : (protocol == "SIRC15" ? 15 : 12);
    command.raw_data = ((uint64_t)address << 7) | (code & 0x7F);
  } else if (protocol == "RC5" || protocol == "RC5X") {
    command.protocol = RC5;
    command.bits = 14;
  } else if (protocol == "RC6") {
    command.protocol = RC6;
    command.bits = 20;
  } else {
    return false;
  }
  return true;
}


class CatalogTestCommandVisitor : public RipperIrCatalogCommandVisitor {
 public:
  explicit CatalogTestCommandVisitor(uint16_t target)
    : target_(target), ordinal_(0), raw_timings_(NULL), raw_count_(0),
      raw_capacity_(0), carrier_hz_(38000), found_(false), raw_(false), valid_(true) {
    memset(&parsed_command_, 0, sizeof(parsed_command_));
    memset(name_, 0, sizeof(name_));
  }

  ~CatalogTestCommandVisitor() {
    if (raw_timings_ != NULL) heap_caps_free(raw_timings_);
  }

  bool onParsedCommand(const RipperIrCatalogCommand &command) override {
    if (ordinal_ == target_) {
      strlcpy(name_, command.name, sizeof(name_));
      carrier_hz_ = command.frequency == 0 ? 38000 : command.frequency;
      found_ = command.protocol_supported && command.address <= UINT32_MAX &&
               command.command <= UINT32_MAX &&
               make_ir_database_command(String(command.protocol), (uint32_t)command.address,
                                        (uint32_t)command.command, parsed_command_);
      raw_ = false;
    }
    ordinal_++;
    return true;
  }

  bool onRawCommandBegin(const RipperIrCatalogCommand &command) override {
    if (ordinal_ != target_) return true;
    strlcpy(name_, command.name, sizeof(name_));
    carrier_hz_ = command.frequency == 0 ? 38000 : command.frequency;
    raw_capacity_ = 2048;
    raw_timings_ = (uint16_t *)heap_caps_malloc(
      raw_capacity_ * sizeof(uint16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (raw_timings_ == NULL) {
      raw_timings_ = (uint16_t *)heap_caps_malloc(
        raw_capacity_ * sizeof(uint16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    }
    valid_ = raw_timings_ != NULL;
    raw_ = true;
    return true;
  }

  bool onRawTiming(uint32_t timing_us) override {
    if (ordinal_ != target_) return true;
    if (!valid_ || raw_count_ >= raw_capacity_ || timing_us == 0 || timing_us > UINT16_MAX) {
      valid_ = false;
      return true;
    }
    raw_timings_[raw_count_++] = (uint16_t)timing_us;
    return true;
  }

  bool onRawCommandEnd(uint32_t timing_count) override {
    if (ordinal_ == target_) {
      found_ = valid_ && raw_timings_ != NULL && raw_count_ == timing_count && raw_count_ > 0;
    }
    ordinal_++;
    return true;
  }

  bool transmit() {
    if (!found_) return false;
    if (raw_) return send_repository_raw_ir(raw_timings_, raw_count_, carrier_hz_, 1, 0, 33);
    return send_saved_ir_command_at_carrier(parsed_command_, carrier_hz_);
  }

  bool isRaw() const { return raw_; }
  const SavedIrRemoteCommand &parsedCommand() const { return parsed_command_; }
  const char *name() const { return name_; }

 private:
  uint16_t target_;
  uint16_t ordinal_;
  uint16_t *raw_timings_;
  uint16_t raw_count_;
  uint16_t raw_capacity_;
  uint32_t carrier_hz_;
  SavedIrRemoteCommand parsed_command_;
  bool found_;
  bool raw_;
  bool valid_;
  char name_[40];
};


class CatalogExtraTestSelector : public RipperIrCatalogCommandVisitor {
 public:
  explicit CatalogExtraTestSelector(uint16_t primary)
    : primary_(primary), ordinal_(0), count_(0), raw_valid_(true), complete_(true) {}
  bool onParsedCommand(const RipperIrCatalogCommand &command) override {
    if (!command.protocol_supported) complete_ = false;
    if (ordinal_ != primary_ && command.protocol_supported) consider(command.name, ordinal_);
    ordinal_++;
    return true;
  }
  bool onRawCommandBegin(const RipperIrCatalogCommand &command) override {
    raw_valid_ = true;
    strlcpy(raw_name_, command.name, sizeof(raw_name_));
    return true;
  }
  bool onRawTiming(uint32_t timing_us) override {
    if (timing_us == 0 || timing_us > UINT16_MAX) raw_valid_ = false;
    return true;
  }
  bool onRawCommandEnd(uint32_t timing_count) override {
    if (!raw_valid_ || timing_count == 0 || timing_count > 2048) complete_ = false;
    if (ordinal_ != primary_ && raw_valid_ && timing_count > 0 && timing_count <= 2048)
      consider(raw_name_, ordinal_);
    ordinal_++;
    return true;
  }
  uint8_t count() const { return count_; }
  bool complete() const { return complete_; }
  uint16_t ordinal(uint8_t index) const { return index < count_ ? ordinals_[index] : 0; }
  const char *name(uint8_t index) const { return index < count_ ? names_[index] : ""; }
 private:
  uint8_t commandScore(const char *name, uint8_t &group) {
    char upper[40] = {};
    for (uint8_t i = 0; name[i] != '\0' && i + 1 < sizeof(upper); i++)
      upper[i] = (char)toupper((unsigned char)name[i]);
    group = 0;
    if (strstr(upper, "POWER") != NULL || strcmp(upper, "ON") == 0 ||
        strcmp(upper, "OFF") == 0) return 0;
    if (strstr(upper, "INPUT") != NULL || strstr(upper, "SOURCE") != NULL) {
      group = 1; return 100;
    }
    if (strstr(upper, "VOL+") != NULL || strstr(upper, "VOLUME UP") != NULL ||
        strstr(upper, "VOL UP") != NULL) {
      group = 2; return 95;
    }
    if (strstr(upper, "MUTE") != NULL) { group = 3; return 90; }
    if (strstr(upper, "CH+") != NULL || strstr(upper, "CHANNEL UP") != NULL ||
        strstr(upper, "CH UP") != NULL) {
      group = 4; return 85;
    }
    if (strstr(upper, "MENU") != NULL || strstr(upper, "HOME") != NULL) {
      group = 5; return 80;
    }
    if (strcmp(upper, "OK") == 0 || strcmp(upper, "ENTER") == 0 ||
        strcmp(upper, "UP") == 0) {
      group = 6; return 70;
    }
    return 20;
  }
  void consider(const char *name, uint16_t ordinal) {
    uint8_t group = 0;
    const uint8_t score = commandScore(name, group);
    if (score == 0) return;
    if (group != 0) {
      for (uint8_t i = 0; i < count_; i++) {
        if (groups_[i] == group) {
          if (score > scores_[i]) store(i, name, ordinal, score, group);
          return;
        }
      }
    }
    if (count_ < 2) {
      store(count_, name, ordinal, score, group);
      count_++;
      return;
    }
    const uint8_t weakest = scores_[0] <= scores_[1] ? 0 : 1;
    if (score > scores_[weakest]) store(weakest, name, ordinal, score, group);
  }
  void store(uint8_t index, const char *name, uint16_t ordinal,
             uint8_t score, uint8_t group) {
    ordinals_[index] = ordinal;
    scores_[index] = score;
    groups_[index] = group;
    strlcpy(names_[index], name, sizeof(names_[index]));
  }
  uint16_t primary_;
  uint16_t ordinal_;
  uint16_t ordinals_[2] = {};
  char names_[2][40] = {};
  char raw_name_[40] = {};
  uint8_t scores_[2] = {};
  uint8_t groups_[2] = {};
  uint8_t count_;
  bool raw_valid_;
  bool complete_;
};


bool prepare_ir_catalog_extra_tests(const RipperIrCatalogCandidateRef &candidate) {
  CatalogExtraTestSelector selector(candidate.test_command_ordinal);
  uint16_t parsed = 0, raw = 0, unsupported = 0;
  if (!ripper_ir_catalog.parseProfile(candidate.profile_ordinal, selector,
                                      &parsed, &raw, &unsupported) ||
      unsupported != 0 || !selector.complete()) return false;
  ir_catalog_extra_test_count = selector.count();
  ir_catalog_extra_test_index = 0;
  for (uint8_t i = 0; i < ir_catalog_extra_test_count; i++) {
    ir_catalog_extra_test_ordinals[i] = selector.ordinal(i);
    strlcpy(ir_catalog_extra_test_names[i], selector.name(i),
            sizeof(ir_catalog_extra_test_names[i]));
  }
  return true;
}


bool transmit_ir_catalog_candidate(const RipperIrCatalogCandidateRef &candidate) {
  CatalogTestCommandVisitor visitor(candidate.test_command_ordinal);
  uint16_t parsed = 0, raw = 0, unsupported = 0;
  if (!ripper_ir_catalog.parseProfile(candidate.profile_ordinal, visitor,
                                      &parsed, &raw, &unsupported) ||
      !visitor.transmit()) {
    Serial.printf("IR catalog test failed: profile=%lu error=%s\n",
                  (unsigned long)candidate.profile_ordinal,
                  ripper_ir_catalog.lastError());
    return false;
  }
  ir_catalog_last_test_was_raw = visitor.isRaw();
  strlcpy(ir_catalog_last_test_name, visitor.name(), sizeof(ir_catalog_last_test_name));
  if (!ir_catalog_last_test_was_raw) {
    ir_discovery_current_candidate = visitor.parsedCommand();
    ir_discovery_current_candidate_valid = true;
  } else {
    ir_discovery_current_candidate_valid = false;
  }
  Serial.printf("IR catalog test sent: %s profile=%lu command=%u\n",
                ir_catalog_discovery_manufacturer,
                (unsigned long)candidate.profile_ordinal,
                (unsigned)candidate.test_command_ordinal);
  return true;
}


bool catalog_label_repeats_on_hold(const char *label) {
  if (label == NULL) return false;
  String normalized(label);
  normalized.toUpperCase();
  return normalized.indexOf("VOLUME") >= 0 || normalized.indexOf("VOL+") >= 0 ||
         normalized.indexOf("VOL-") >= 0 || normalized.indexOf("CHANNEL") >= 0 ||
         normalized.indexOf("CH+") >= 0 || normalized.indexOf("CH-") >= 0 ||
         normalized.indexOf("BRIGHT") >= 0 || normalized.indexOf("DIM") >= 0;
}


class CatalogProfileImportVisitor : public RipperIrCatalogCommandVisitor {
 public:
  explicit CatalogProfileImportVisitor(File &file)
    : file_(file), payload_crc_(0xFFFFFFFFUL), payload_bytes_(0), buttons_(0),
      raw_timings_(NULL), raw_count_(0), raw_valid_(false), complete_(true), wrote_(true) {}
  ~CatalogProfileImportVisitor() {
    if (raw_timings_ != NULL) heap_caps_free(raw_timings_);
  }

  bool onParsedCommand(const RipperIrCatalogCommand &command) override {
    if (!command.protocol_supported || command.address > UINT32_MAX ||
        command.command > UINT32_MAX) {
      complete_ = false;
      return true;
    }
    SavedIrRemoteCommand parsed = {};
    if (!make_ir_database_command(String(command.protocol), (uint32_t)command.address,
                                  (uint32_t)command.command, parsed)) {
      complete_ = false;
      return true;
    }
    RipperIrButtonDiskV1 disk = {};
    makeDisk(command, disk);
    disk.encoding = RIPPER_IR_ENCODING_PARSED;
    disk.protocol = parsed.protocol;
    disk.address = parsed.address;
    disk.command = parsed.command;
    disk.extra = parsed.extra;
    disk.bits = parsed.bits;
    disk.flags = parsed.flags;
    disk.decoded_raw_data = parsed.raw_data;
    return writeRecord(disk, NULL, 0);
  }

  bool onRawCommandBegin(const RipperIrCatalogCommand &command) override {
    raw_command_ = command;
    raw_count_ = 0;
    raw_valid_ = true;
    if (raw_timings_ == NULL) {
      raw_timings_ = (uint16_t *)heap_caps_malloc(
        2048 * sizeof(uint16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
      if (raw_timings_ == NULL) {
        raw_timings_ = (uint16_t *)heap_caps_malloc(
          2048 * sizeof(uint16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
      }
    }
    if (raw_timings_ == NULL) raw_valid_ = false;
    return true;
  }

  bool onRawTiming(uint32_t timing_us) override {
    if (!raw_valid_ || raw_count_ >= 2048 || timing_us == 0 || timing_us > UINT16_MAX) {
      raw_valid_ = false;
      return true;
    }
    raw_timings_[raw_count_++] = (uint16_t)timing_us;
    return true;
  }

  bool onRawCommandEnd(uint32_t timing_count) override {
    if (!raw_valid_ || raw_count_ == 0 || raw_count_ != timing_count) {
      complete_ = false;
      return true;
    }
    RipperIrButtonDiskV1 disk = {};
    makeDisk(raw_command_, disk);
    disk.encoding = RIPPER_IR_ENCODING_RAW_TIMINGS;
    disk.raw_timing_count = raw_count_;
    return writeRecord(disk, raw_timings_, raw_count_);
  }

  bool complete() const { return complete_ && wrote_ && buttons_ > 0; }
  uint16_t buttons() const { return buttons_; }
  uint32_t payloadBytes() const { return payload_bytes_; }
  uint32_t payloadCrc() const { return ~payload_crc_; }

 private:
  void makeDisk(const RipperIrCatalogCommand &command, RipperIrButtonDiskV1 &disk) {
    memset(&disk, 0, sizeof(disk));
    disk.record_size = sizeof(disk);
    disk.button_id = buttons_ + 1;
    disk.page = buttons_ / MAX_IR_REMOTE_BUTTONS;
    disk.behavior_flags = catalog_label_repeats_on_hold(command.name) ?
      RIPPER_IR_BEHAVIOR_HOLD_REPEAT : 0;
    disk.repeat_count = 1;
    disk.repeat_gap_ms = 0;
    const uint8_t page_slot = buttons_ % MAX_IR_REMOTE_BUTTONS;
    disk.x = 7 + (page_slot % 3) * 92;
    disk.y = 5 + (page_slot / 3) * 54;
    disk.width = 84;
    disk.height = 44;
    disk.carrier_hz = command.frequency == 0 ? 38000 : command.frequency;
    strlcpy(disk.label, command.name[0] != '\0' ? command.name : "COMMAND",
            sizeof(disk.label));
  }

  bool writeRecord(const RipperIrButtonDiskV1 &disk,
                   const uint16_t *timings, uint16_t timing_count) {
    if (buttons_ >= 1024) {
      complete_ = false;
      return true;
    }
    if (file_.write((const uint8_t *)&disk, sizeof(disk)) != sizeof(disk)) {
      wrote_ = false; return false;
    }
    payload_crc_ = ripper_crc32_update(payload_crc_, (const uint8_t *)&disk, sizeof(disk));
    payload_bytes_ += sizeof(disk);
    if (timing_count > 0) {
      const size_t bytes = timing_count * sizeof(uint16_t);
      if (file_.write((const uint8_t *)timings, bytes) != bytes) {
        wrote_ = false; return false;
      }
      payload_crc_ = ripper_crc32_update(payload_crc_, (const uint8_t *)timings, bytes);
      payload_bytes_ += bytes;
    }
    buttons_++;
    return true;
  }

  File &file_;
  uint32_t payload_crc_;
  uint32_t payload_bytes_;
  uint16_t buttons_;
  uint16_t *raw_timings_;
  uint16_t raw_count_;
  RipperIrCatalogCommand raw_command_ = {};
  bool raw_valid_;
  bool complete_;
  bool wrote_;
};


bool import_complete_catalog_profile(uint32_t profile_ordinal, uint64_t &remote_id,
                                     uint16_t &button_count, uint8_t &page_count) {
  remote_id = 0;
  button_count = 0;
  page_count = 0;
  if (!sd_card_ready || !ripper_ir_repository_ready ||
      !ensure_ripper_ir_catalog_ready()) return false;
  RipperIrCatalogProfile profile = {};
  if (!ripper_ir_catalog.readProfile(profile_ordinal, profile) ||
      profile.command_count == 0 || profile.command_count > 1024 ||
      profile.unsupported_count != 0 ||
      !ripper_ir_repository_has_space((uint64_t)profile.tar_data_bytes +
                                      sizeof(RipperIrRemoteFileHeaderV1) + 8192)) {
    return false;
  }

  remote_id = ((uint64_t)profile.profile_crc32 << 32) | esp_random();
  RipperIrIndexEntryV1 collision = {};
  while (remote_id == 0 || ripper_ir_repository_find(remote_id, collision)) {
    remote_id = ((uint64_t)profile.profile_crc32 << 32) | esp_random();
  }
  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  RipperIrRemoteFileHeaderV1 header = {};
  bool wrote = file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  CatalogProfileImportVisitor visitor(file);
  uint16_t parsed = 0, raw = 0, unsupported = 0;
  const bool parsed_ok = wrote && ripper_ir_catalog.parseProfile(
    profile_ordinal, visitor, &parsed, &raw, &unsupported);
  button_count = visitor.buttons();
  page_count = button_count == 0 ? 0 :
    (uint8_t)((button_count + MAX_IR_REMOTE_BUTTONS - 1) / MAX_IR_REMOTE_BUTTONS);
  if (!parsed_ok || !visitor.complete() || unsupported != 0 || page_count == 0) {
    file.close();
    SD_MMC.remove(temporary_path);
    remote_id = 0;
    return false;
  }

  header.magic = RIPPER_IR_FILE_MAGIC;
  header.version = RIPPER_IR_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = remote_id;
  header.source_flags = RIPPER_IR_SOURCE_CATALOG |
    ((profile_ordinal & 0x00FFFFFFUL) << RIPPER_IR_SOURCE_CATALOG_ORDINAL_SHIFT);
  strlcpy(header.name, profile.manufacturer, sizeof(header.name));
  if (profile.model[0] != '\0' && strlen(header.name) + 1 < sizeof(header.name)) {
    strlcat(header.name, " ", sizeof(header.name));
    strlcat(header.name, profile.model, sizeof(header.name));
  }
  strlcpy(header.device_type, profile.category, sizeof(header.device_type));
  strlcpy(header.manufacturer, profile.manufacturer, sizeof(header.manufacturer));
  strlcpy(header.model, profile.model, sizeof(header.model));
  header.button_count = button_count;
  header.page_count = page_count;
  header.payload_bytes = visitor.payloadBytes();
  header.payload_crc32 = visitor.payloadCrc();
  header.header_crc32 = ripper_ir_header_crc(header);
  wrote = file.seek(0) &&
    file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  file.flush();
  file.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, remote_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    remote_id = 0;
    return false;
  }
  Serial.printf("IR catalog profile imported: ordinal=%lu id=%08lx%08lx buttons=%u pages=%u\n",
                (unsigned long)profile_ordinal,
                (unsigned long)(remote_id >> 32), (unsigned long)remote_id,
                (unsigned)button_count, (unsigned)page_count);
  return true;
}


bool update_repository_ir_current_page_layout() {
  if (!ir_working_remote_from_repository || ir_working_repository_id == 0 ||
      !validate_ripper_ir_remote_file(ir_working_repository_path,
                                      ir_working_repository_id)) return false;
  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(ir_working_repository_id,
                                               temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(ir_working_repository_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    return false;
  }
  RipperIrRemoteFileHeaderV1 header = {};
  bool wrote = source.read((uint8_t *)&header, sizeof(header)) == sizeof(header) &&
               target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  uint8_t buffer[256];
  for (uint16_t absolute = 0; wrote && absolute < header.button_count; absolute++) {
    RipperIrButtonDiskV1 disk = {};
    wrote = source.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    for (uint8_t cached = 0; cached < ir_working_remote.button_count; cached++) {
      if (ir_working_repository_absolute_indices[cached] == absolute) {
        disk.x = ir_working_repository_x[cached];
        disk.y = ir_working_repository_y[cached];
        disk.width = ir_working_repository_width[cached];
        disk.height = ir_working_repository_height[cached];
        break;
      }
    }
    wrote = target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk, sizeof(disk));
    uint32_t remaining = (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    while (wrote && remaining > 0) {
      const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
      wrote = source.read(buffer, chunk) == chunk && target.write(buffer, chunk) == chunk;
      if (wrote) payload_crc = ripper_crc32_update(payload_crc, buffer, chunk);
      remaining -= chunk;
    }
  }
  source.close();
  header.payload_crc32 = ~payload_crc;
  header.header_crc32 = ripper_ir_header_crc(header);
  wrote = wrote && target.seek(0) &&
          target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path,
                                                 ir_working_repository_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  return load_repository_ir_page(ir_working_repository_current_page);
}


bool rename_repository_ir_remote(uint64_t remote_id, const char *name) {
  if (!sd_card_ready || !ripper_ir_repository_ready || remote_id == 0 ||
      name == NULL || name[0] == '\0') return false;
  RipperIrIndexEntryV1 entry = {};
  if (!ripper_ir_repository_find(remote_id, entry) ||
      !validate_ripper_ir_remote_file(entry.file_path, remote_id)) return false;
  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(entry.file_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    SD_MMC.remove(temporary_path);
    return false;
  }
  RipperIrRemoteFileHeaderV1 header = {};
  bool wrote = source.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  strlcpy(header.name, name, sizeof(header.name));
  header.header_crc32 = ripper_ir_header_crc(header);
  wrote = wrote && target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  uint8_t buffer[256];
  while (wrote && source.available()) {
    const size_t count = source.read(buffer, sizeof(buffer));
    if (count == 0) { wrote = false; break; }
    wrote = target.write(buffer, count) == count;
  }
  source.close();
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, remote_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  if (ir_working_remote_from_repository && ir_working_repository_id == remote_id) {
    strlcpy(ir_working_remote.name, name, sizeof(ir_working_remote.name));
  }
  return true;
}


bool scan_ir_discovery_database(uint16_t wanted_index,
                                SavedIrRemoteCommand *wanted,
                                uint16_t *supported_count) {
  const char *path = ir_discovery_database_path();
  if (!sd_card_ready || path == NULL) return false;
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;

  String name, type, protocol, address_text, command_text;
  uint16_t count = 0;
  bool found = false;
  auto finish_record = [&]() {
    if (name == "Power" && type == "parsed") {
      SavedIrRemoteCommand candidate = {};
      if (make_ir_database_command(protocol, parse_ir_database_hex(address_text),
                                   parse_ir_database_hex(command_text), candidate)) {
        if (wanted != NULL && count == wanted_index) {
          *wanted = candidate;
          found = true;
        }
        count++;
      }
    }
    name = type = protocol = address_text = command_text = "";
  };

  while (file.available()) {
    String line = file.readStringUntil('\n');
    line.trim();
    if (line == "#") { finish_record(); continue; }
    int separator = line.indexOf(':');
    if (separator < 0) continue;
    String key = line.substring(0, separator);
    String value = line.substring(separator + 1);
    value.trim();
    if (key == "name") name = value;
    else if (key == "type") type = value;
    else if (key == "protocol") protocol = value;
    else if (key == "address") address_text = value;
    else if (key == "command") command_text = value;
  }
  finish_record();
  file.close();
  if (supported_count != NULL) *supported_count = count;
  return wanted == NULL ? true : found;
}


bool load_ir_discovery_candidate() {
  ir_discovery_current_candidate_valid = false;
  if (strcmp(ir_discovery_device_name, "LIGHT") == 0) {
    memset(&ir_discovery_current_candidate, 0, sizeof(ir_discovery_current_candidate));
    ir_discovery_current_candidate.valid = 1;
    ir_discovery_current_candidate.protocol = NEC;
    ir_discovery_current_candidate.address = 0;
    ir_discovery_current_candidate.command = 0x07;
    ir_discovery_current_candidate.bits = 32;
    ir_discovery_current_candidate_valid = ir_discovery_candidate_index == 0;
  } else {
    ir_discovery_current_candidate_valid = scan_ir_discovery_database(
      ir_discovery_candidate_index, &ir_discovery_current_candidate, NULL);
  }
  return ir_discovery_current_candidate_valid;
}


const char *ir_discovery_candidate_name() {
  static char label[64];
  if (!ir_discovery_current_candidate_valid) return "DATABASE ENTRY UNAVAILABLE";
  snprintf(label, sizeof(label), "%s POWER CODE %u",
           ir_discovery_device_name, (unsigned)(ir_discovery_candidate_index + 1));
  return label;
}


uint16_t ir_discovery_candidate_count() {
  return ir_discovery_candidate_total;
}


void fill_ir_discovery_anchor(SavedIrRemoteCommand &command) {
  command = ir_discovery_current_candidate;
}


bool transmit_ir_discovery_candidate() {
  if (ir_catalog_discovery_active) {
    if (ir_catalog_confirmation_stage == IR_CATALOG_CONFIRM_EXTRA) {
      if (ir_catalog_extra_test_index >= ir_catalog_extra_test_count) return false;
      RipperIrCatalogCandidateRef extra = ir_catalog_confirmed_candidate;
      extra.test_command_ordinal =
        ir_catalog_extra_test_ordinals[ir_catalog_extra_test_index];
      return transmit_ir_catalog_candidate(extra);
    }
    if (!ir_transmitter_ready || ir_catalog_discovery_batch_position >=
        ir_catalog_discovery_batch_count) return false;
    return transmit_ir_catalog_candidate(
      ir_catalog_discovery_batch[ir_catalog_discovery_batch_position]);
  }
  if (!ir_transmitter_ready || !ir_discovery_current_candidate_valid ||
      ir_discovery_candidate_index >= ir_discovery_candidate_count()) return false;

  SavedIrRemoteCommand candidate = {};
  fill_ir_discovery_anchor(candidate);
  if (!send_saved_ir_command(candidate)) return false;
  Serial.printf("IR signal transmit sent %s for %s\n",
                ir_discovery_candidate_name(), ir_discovery_device_name);
  return true;
}


void set_ir_discovery_send_button_text(const char *text) {
  if (ir_discovery_send_button == NULL) return;
  lv_obj_t *label = lv_obj_get_child(ir_discovery_send_button, 0);
  if (label != NULL) lv_label_set_text(label, text);
}


void set_ir_discovery_result_button_text(const char *worked, const char *next) {
  if (ir_discovery_worked_button != NULL) {
    lv_obj_t *label = lv_obj_get_child(ir_discovery_worked_button, 0);
    if (label != NULL) lv_label_set_text(label, worked);
  }
  if (ir_discovery_next_button != NULL) {
    lv_obj_t *label = lv_obj_get_child(ir_discovery_next_button, 0);
    if (label != NULL) lv_label_set_text(label, next);
  }
}

void set_ir_discovery_result_buttons_ready(bool ready) {
  if (ir_discovery_worked_button == NULL || ir_discovery_next_button == NULL) return;
  lv_obj_clear_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
  lv_obj_clear_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
  if (ready) {
    lv_obj_clear_state(ir_discovery_worked_button, LV_STATE_DISABLED);
    lv_obj_clear_state(ir_discovery_next_button, LV_STATE_DISABLED);
  } else {
    lv_obj_add_state(ir_discovery_worked_button, LV_STATE_DISABLED);
    lv_obj_add_state(ir_discovery_next_button, LV_STATE_DISABLED);
  }
}


bool transmit_ir_discovery_group() {
  if (ir_catalog_discovery_active) {
    if (!ir_transmitter_ready || ir_catalog_discovery_batch_count == 0) return false;
    uint8_t sent_count = 0;
    for (uint8_t i = 0; i < ir_catalog_discovery_batch_count; i++) {
      if (transmit_ir_catalog_candidate(ir_catalog_discovery_batch[i])) sent_count++;
      delay(250);
    }
    ir_catalog_discovery_batch_position = 0;
    return sent_count > 0;
  }
  if (!ir_transmitter_ready || ir_discovery_group_start >= ir_discovery_candidate_total) {
    return false;
  }

  ir_discovery_group_count = min((uint16_t)IR_DISCOVERY_GROUP_SIZE,
                                 (uint16_t)(ir_discovery_candidate_total - ir_discovery_group_start));
  uint8_t sent_count = 0;
  for (uint8_t i = 0; i < ir_discovery_group_count; i++) {
    ir_discovery_candidate_index = ir_discovery_group_start + i;
    if (load_ir_discovery_candidate() && transmit_ir_discovery_candidate()) sent_count++;
    // Keep the tests visibly separate so a device reaction can be noticed.
    delay(250);
  }

  ir_discovery_candidate_index = ir_discovery_group_start;
  load_ir_discovery_candidate();
  Serial.printf("IR signal transmit sent group %u-%u for %s (%u/%u sent)\n",
                (unsigned)(ir_discovery_group_start + 1),
                (unsigned)(ir_discovery_group_start + ir_discovery_group_count),
                ir_discovery_device_name, (unsigned)sent_count,
                (unsigned)ir_discovery_group_count);
  return sent_count > 0;
}


void refresh_ir_discovery_screen() {
  if (ir_discovery_label == NULL) return;

  if (ir_catalog_discovery_active) {
    if (ir_catalog_confirmation_stage == IR_CATALOG_CONFIRM_READY_TO_SAVE) {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s - %s\n\nREMOTE VERIFIED\n\nAdditional buttons responded.\nSave the complete profile?",
                            ir_discovery_device_name,
                            ir_catalog_discovery_manufacturer);
      lv_obj_add_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
      set_ir_discovery_result_button_text("SAVE REMOTE", "TRY NEXT");
      set_ir_discovery_result_buttons_ready(true);
      return;
    }
    if (ir_catalog_confirmation_stage == IR_CATALOG_CONFIRM_EXTRA) {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s - %s\n\nVERIFY %u / %u: %s\n\nWatch for this exact function.%s",
                            ir_discovery_device_name,
                            ir_catalog_discovery_manufacturer,
                            (unsigned)(ir_catalog_extra_test_index + 1),
                            (unsigned)ir_catalog_extra_test_count,
                            ir_catalog_extra_test_names[ir_catalog_extra_test_index],
                            ir_discovery_candidate_sent ? "\n\nDid it respond correctly?" : "");
      set_ir_discovery_send_button_text("SEND VERIFY BUTTON");
      set_ir_discovery_result_button_text("WORKED", "WRONG PROFILE");
      lv_obj_clear_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
      set_ir_discovery_result_buttons_ready(ir_discovery_candidate_sent);
      return;
    }
    set_ir_discovery_result_button_text("WORKED", "DIDN'T WORK");
    if (ir_catalog_discovery_batch_count == 0) {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s %s\n\nNO MORE MATCHES\n\nTry another manufacturer or\nuse Unknown Manufacturer.",
                            ir_discovery_device_name,
                            ir_catalog_discovery_manufacturer);
      lv_obj_add_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
      lv_obj_add_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
      lv_obj_add_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
      return;
    }
    if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH) {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s - %s\n\nTEST GROUP %u\n%u MATCHING REMOTES\n\nWatch for any response.%s",
                            ir_discovery_device_name,
                            ir_catalog_discovery_manufacturer,
                            (unsigned)ir_catalog_discovery_batch_number,
                            (unsigned)ir_catalog_discovery_batch_count,
                            ir_discovery_candidate_sent ? "\n\nDid any test work?" : "");
      set_ir_discovery_send_button_text("SEND 10 TESTS");
    } else {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s - %s\n\nCHECK %u OF %u\n\nSend this one test and report\nwhether the device responds.%s",
                            ir_discovery_device_name,
                            ir_catalog_discovery_manufacturer,
                            (unsigned)(ir_catalog_discovery_batch_position + 1),
                            (unsigned)ir_catalog_discovery_batch_count,
                            ir_discovery_candidate_sent ? "\n\nDid it respond?" : "");
      set_ir_discovery_send_button_text("SEND TEST SIGNAL");
    }
    lv_obj_clear_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
    if (ir_discovery_send_failed) {
      set_ir_discovery_send_button_text("RETRY TEST SIGNAL");
      set_ir_discovery_result_button_text("WORKED", "SKIP TEST");
      set_ir_discovery_result_buttons_ready(false);
      lv_obj_clear_state(ir_discovery_next_button, LV_STATE_DISABLED);
    } else {
      set_ir_discovery_result_buttons_ready(ir_discovery_candidate_sent);
    }
    return;
  }

  const uint16_t candidate_count = ir_discovery_candidate_count();
  if (candidate_count == 0) {
    if (strcmp(ir_discovery_device_name, "FAN") == 0) {
      lv_label_set_text(ir_discovery_label,
                        "FAN SIGNAL TRANSMIT\n\nMost ceiling-fan remotes use RF,\nnot IR. Use RF Signal Transmit from\nthe RF tools section instead.");
    } else if (strcmp(ir_discovery_device_name, "OTHER") == 0) {
      lv_label_set_text(ir_discovery_label,
                        "OTHER / UNKNOWN\n\nUse COPY IR REMOTE when you\nhave the original remote.");
    } else if (!sd_card_ready) {
      lv_label_set_text(ir_discovery_label,
                        "IR DATABASE UNAVAILABLE\n\nThe microSD card was not found.\nRestart with the card installed.");
    } else {
      lv_label_set_text_fmt(ir_discovery_label,
                            "%s DATABASE NOT FOUND\n\nCopy this file to the SD card:\n%s",
                            ir_discovery_device_name,
                            ir_discovery_database_path());
    }
    lv_obj_add_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
    return;
  }

  if (ir_discovery_candidate_index >= candidate_count) {
    lv_label_set_text_fmt(ir_discovery_label,
                          "%s SIGNAL TRANSMIT COMPLETE\n\nAll %u supported power codes\nwere tested with no match.\nTry COPY IR REMOTE instead.",
                          ir_discovery_device_name,
                          (unsigned)candidate_count);
    lv_obj_add_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
    return;
  }

  if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH) {
    const uint16_t group_end = min((uint16_t)(ir_discovery_group_start + IR_DISCOVERY_GROUP_SIZE),
                                   candidate_count);
    lv_label_set_text_fmt(ir_discovery_label,
                          "%s SIGNAL TRANSMIT\n\nGROUP %u-%u OF %u\n\nSend these tests together. Watch\nfor any response from your device.%s",
                          ir_discovery_device_name,
                          (unsigned)(ir_discovery_group_start + 1),
                          (unsigned)group_end,
                          (unsigned)candidate_count,
                          ir_discovery_candidate_sent ? "\n\nDid any test work?" : "");
    set_ir_discovery_send_button_text("SEND 10 TESTS");
    lv_obj_clear_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
    if (ir_discovery_candidate_sent) {
      lv_obj_clear_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
      lv_obj_clear_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
    } else {
      lv_obj_add_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
      lv_obj_add_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
    }
    return;
  }

  lv_label_set_text_fmt(ir_discovery_label,
                        "%s SIGNAL TRANSMIT\n\n%s %u / %u\n%s\n\nPoint at your own device, then\nsend this single test and report\nthe result.%s",
                        ir_discovery_device_name,
                        ir_discovery_group_mode == IR_DISCOVERY_GROUP_NARROW ? "CHECK" : "TEST",
                        (unsigned)(ir_discovery_candidate_index + 1),
                        (unsigned)candidate_count,
                        ir_discovery_candidate_name(),
                        ir_discovery_candidate_sent ? "\n\nDid it respond?" : "");
  set_ir_discovery_send_button_text("SEND TEST SIGNAL");
  lv_obj_clear_flag(ir_discovery_send_button, LV_OBJ_FLAG_HIDDEN);
  if (ir_discovery_candidate_sent) {
    lv_obj_clear_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_clear_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
  } else {
    lv_obj_add_flag(ir_discovery_worked_button, LV_OBJ_FLAG_HIDDEN);
    lv_obj_add_flag(ir_discovery_next_button, LV_OBJ_FLAG_HIDDEN);
  }
}


void start_ir_discovery(const char *device_name) {
  ir_catalog_discovery_active = false;
  ir_discovery_device_name = device_name;
  ir_discovery_candidate_index = 0;
  ir_discovery_candidate_sent = false;
  ir_discovery_send_failed = false;
  ir_discovery_candidate_total = 0;
  ir_discovery_current_candidate_valid = false;
  ir_discovery_group_mode = IR_DISCOVERY_GROUP_OFF;
  ir_discovery_group_start = 0;
  ir_discovery_group_count = 0;
  ir_discovery_group_offset = 0;
  if (strcmp(device_name, "LIGHT") == 0) {
    ir_discovery_candidate_total = 1;
  } else if (strcmp(device_name, "TV") == 0 ||
             strcmp(device_name, "PROJECTOR") == 0 ||
             strcmp(device_name, "AUDIO") == 0) {
    scan_ir_discovery_database(0, NULL, &ir_discovery_candidate_total);
  }
  if (ir_discovery_candidate_total > 1) {
    ir_discovery_group_mode = IR_DISCOVERY_GROUP_BATCH;
  }
  if (ir_discovery_candidate_total > 0) load_ir_discovery_candidate();
  Serial.printf("IR signal transmit %s: %u supported candidate(s) from %s\n",
                device_name, (unsigned)ir_discovery_candidate_total,
                ir_discovery_database_path() == NULL ? "built-in guidance" : ir_discovery_database_path());
  if (ir_discovery_screen == NULL) create_ir_discovery_screen();
  refresh_ir_discovery_screen();
  lv_scr_load(ir_discovery_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void start_ir_discovery_tv(lv_event_t *e) { start_ir_discovery("TV"); }
void start_ir_discovery_projector(lv_event_t *e) { start_ir_discovery("PROJECTOR"); }
void start_ir_discovery_audio(lv_event_t *e) { start_ir_discovery("AUDIO"); }
void start_ir_discovery_light(lv_event_t *e) { start_ir_discovery("LIGHT"); }
void start_ir_discovery_fan(lv_event_t *e) { start_ir_discovery("FAN"); }
void start_ir_discovery_other(lv_event_t *e) { start_ir_discovery("OTHER"); }


void send_ir_discovery_candidate(lv_event_t *e) {
  // Paint the global activity state before entering the blocking ten-signal
  // burst. Without this LVGL only got a chance to draw TRANSMITTING after the
  // final signal had already been sent.
  ir_discovery_send_failed = false;
  set_status("TRANSMITTING", COLOR_IR);
  // This callback performs the burst synchronously, so force the invalidated
  // header area to the display before transmission begins.  A normal timer
  // pass alone can leave the draw queued until this callback returns.
  lv_refr_now(NULL);
  delay(20);
  const bool sent = ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH
                      ? transmit_ir_discovery_group()
                      : transmit_ir_discovery_candidate();
  if (!sent) {
    ir_discovery_send_failed = true;
    refresh_ir_discovery_screen();
    transmitting_status_until_ms = 0;
    set_status(ir_discovery_current_candidate_valid ? "IR TX MODULE REQUIRED" : "IR DATABASE ENTRY ERROR", COLOR_RED);
    return;
  }
  ir_discovery_candidate_sent = true;
  refresh_ir_discovery_screen();
  // The burst is complete.  Do not start a second TRANSMITTING indication
  // here; that was the reason the status appeared only after the signals had
  // already finished.
  transmitting_status_until_ms = 0;
  set_status("SYSTEM READY", COLOR_READY);
}


void ir_discovery_next(lv_event_t *e) {
  if (!ir_discovery_candidate_sent && !ir_discovery_send_failed &&
      ir_catalog_confirmation_stage != IR_CATALOG_CONFIRM_READY_TO_SAVE) return;
  ir_discovery_candidate_sent = false;
  ir_discovery_send_failed = false;

  if (ir_catalog_discovery_active) {
    if (ir_catalog_confirmation_stage != IR_CATALOG_CONFIRM_NONE) {
      ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_NONE;
      ir_catalog_extra_test_count = 0;
      ir_catalog_extra_test_index = 0;
      ir_discovery_group_mode = IR_DISCOVERY_GROUP_NARROW;
    }
    if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH) {
      ir_catalog_discovery_after =
        ir_catalog_discovery_batch[ir_catalog_discovery_batch_count - 1];
      ir_catalog_discovery_has_after = true;
      ir_catalog_discovery_batch_count = 0;
      ripper_ir_catalog.findCandidateBatch(
        ir_catalog_discovery_category,
        ir_catalog_unknown_manufacturer ? NULL : ir_catalog_discovery_manufacturer, NULL,
        &ir_catalog_discovery_after, ir_catalog_discovery_batch,
        RIPPER_IR_CATALOG_DISCOVERY_BATCH_SIZE, ir_catalog_discovery_batch_count);
      ir_catalog_discovery_batch_position = 0;
      ir_catalog_discovery_batch_number++;
      refresh_ir_discovery_screen();
      set_status(ir_catalog_discovery_batch_count > 0 ?
                 "NEXT GROUP READY" : "SIGNAL TRANSMIT COMPLETE", COLOR_IR);
      return;
    }
    ir_catalog_discovery_batch_position++;
    if (ir_catalog_discovery_batch_position < ir_catalog_discovery_batch_count) {
      refresh_ir_discovery_screen();
      set_status("NEXT TEST READY", COLOR_IR);
      return;
    }
    ir_catalog_discovery_after =
      ir_catalog_discovery_batch[ir_catalog_discovery_batch_count - 1];
    ir_catalog_discovery_has_after = true;
    ir_catalog_discovery_batch_count = 0;
    ripper_ir_catalog.findCandidateBatch(
      ir_catalog_discovery_category,
      ir_catalog_unknown_manufacturer ? NULL : ir_catalog_discovery_manufacturer, NULL,
      &ir_catalog_discovery_after, ir_catalog_discovery_batch,
      RIPPER_IR_CATALOG_DISCOVERY_BATCH_SIZE, ir_catalog_discovery_batch_count);
    ir_catalog_discovery_batch_position = 0;
    ir_catalog_discovery_batch_number++;
    ir_discovery_group_mode = IR_DISCOVERY_GROUP_BATCH;
    refresh_ir_discovery_screen();
    set_status(ir_catalog_discovery_batch_count > 0 ?
               "NEXT GROUP READY" : "SIGNAL TRANSMIT COMPLETE", COLOR_MUTED);
    return;
  }

  if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH) {
    ir_discovery_group_start += ir_discovery_group_count;
    ir_discovery_candidate_index = ir_discovery_group_start;
    if (ir_discovery_candidate_index < ir_discovery_candidate_total) {
      load_ir_discovery_candidate();
    } else {
      ir_discovery_current_candidate_valid = false;
    }
    refresh_ir_discovery_screen();
    set_status(ir_discovery_candidate_index < ir_discovery_candidate_total ?
               "NEXT GROUP READY" : "SIGNAL TRANSMIT COMPLETE", COLOR_IR);
    return;
  }

  if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_NARROW) {
    ir_discovery_group_offset++;
    if (ir_discovery_group_offset < ir_discovery_group_count) {
      ir_discovery_candidate_index = ir_discovery_group_start + ir_discovery_group_offset;
      load_ir_discovery_candidate();
      refresh_ir_discovery_screen();
      set_status("NEXT TEST READY", COLOR_IR);
      return;
    }
    ir_discovery_group_start += ir_discovery_group_count;
    ir_discovery_candidate_index = ir_discovery_group_start;
    ir_discovery_group_mode = IR_DISCOVERY_GROUP_BATCH;
    ir_discovery_group_offset = 0;
    if (ir_discovery_candidate_index < ir_discovery_candidate_total) {
      load_ir_discovery_candidate();
    } else {
      ir_discovery_current_candidate_valid = false;
    }
    refresh_ir_discovery_screen();
    set_status(ir_discovery_candidate_index < ir_discovery_candidate_total ?
               "REACTION NOT REPRODUCED" : "SIGNAL TRANSMIT COMPLETE", COLOR_MUTED);
    return;
  }

  ir_discovery_candidate_index++;
  if (ir_discovery_candidate_index < ir_discovery_candidate_total) load_ir_discovery_candidate();
  else ir_discovery_current_candidate_valid = false;
  refresh_ir_discovery_screen();
  set_status("SYSTEM READY", COLOR_READY);
}


void ir_discovery_worked(lv_event_t *e) {
  if (!ir_discovery_candidate_sent &&
      ir_catalog_confirmation_stage != IR_CATALOG_CONFIRM_READY_TO_SAVE) {
    set_status("SEND A TEST FIRST", COLOR_RED);
    return;
  }

  if (ir_catalog_discovery_active &&
      ir_catalog_confirmation_stage == IR_CATALOG_CONFIRM_READY_TO_SAVE) {
    uint64_t remote_id = 0;
    uint16_t buttons = 0;
    uint8_t pages = 0;
    set_status("SAVING COMPLETE REMOTE", COLOR_IR);
    if (!import_complete_catalog_profile(ir_catalog_confirmed_candidate.profile_ordinal,
                                         remote_id, buttons, pages) ||
        !load_repository_ir_remote_adapter(remote_id)) {
      set_status("PROFILE CANNOT IMPORT COMPLETELY", COLOR_RED);
      return;
    }
    selected_ir_repository_id = remote_id;
    RipperIrIndexEntryV1 imported = {};
    uint32_t imported_ordinal = 0;
    if (ripper_ir_repository_find(remote_id, imported, &imported_ordinal)) {
      selected_ir_repository_ordinal = imported_ordinal;
    }
    ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_NONE;
    ensure_ir_remote_builder_screen();
    refresh_ir_remote_builder();
    lv_scr_load(ir_remote_builder_screen);
    set_status("COMPLETE REMOTE SAVED", COLOR_GREEN);
    return;
  }

  if (ir_catalog_discovery_active &&
      ir_catalog_confirmation_stage == IR_CATALOG_CONFIRM_EXTRA) {
    ir_discovery_candidate_sent = false;
    ir_catalog_extra_test_index++;
    if (ir_catalog_extra_test_index >= ir_catalog_extra_test_count) {
      ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_READY_TO_SAVE;
      ir_discovery_candidate_sent = true;
      set_status("REMOTE PROFILE VERIFIED", COLOR_GREEN);
    } else {
      set_status("NEXT VERIFY BUTTON READY", COLOR_IR);
    }
    refresh_ir_discovery_screen();
    return;
  }

  // A positive batch result only starts one-by-one verification; it does not
  // save a remote yet and must never be blocked by the legacy NVS capacity.
  if (ir_discovery_group_mode == IR_DISCOVERY_GROUP_BATCH) {
    ir_discovery_group_mode = IR_DISCOVERY_GROUP_NARROW;
    ir_discovery_group_offset = 0;
    if (ir_catalog_discovery_active) ir_catalog_discovery_batch_position = 0;
    else ir_discovery_candidate_index = ir_discovery_group_start;
    ir_discovery_candidate_sent = false;
    if (!ir_catalog_discovery_active) load_ir_discovery_candidate();
    refresh_ir_discovery_screen();
    set_status("CHECKING GROUP ONE BY ONE", COLOR_GREEN);
    return;
  }

  if (ir_catalog_discovery_active) {
    ir_catalog_confirmed_candidate =
      ir_catalog_discovery_batch[ir_catalog_discovery_batch_position];
    if (!prepare_ir_catalog_extra_tests(ir_catalog_confirmed_candidate)) {
      set_status("PROFILE NOT FULLY SUPPORTED - TRY NEXT", COLOR_RED);
      return;
    }
    ir_discovery_candidate_sent = false;
    if (ir_catalog_extra_test_count > 0) {
      ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_EXTRA;
      set_status("VERIFY MORE BUTTONS", COLOR_IR);
    } else {
      ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_READY_TO_SAVE;
      ir_discovery_candidate_sent = true;
      set_status("PROFILE READY TO SAVE", COLOR_GREEN);
    }
    refresh_ir_discovery_screen();
    return;
  }

  // SD-backed remotes are not subject to the old three-record NVS limit. Keep
  // that limit only for the NVS fallback when the repository is unavailable.
  if ((!sd_card_ready || !ripper_ir_repository_ready) &&
      saved_ir_remote_count >= MAX_IR_SAVED_REMOTES) {
    set_status("SAVED IR REMOTES FULL", COLOR_RED);
    return;
  }

  memset(&ir_working_remote, 0, sizeof(ir_working_remote));
  clear_repository_ir_remote_adapter();
  ir_working_remote.magic = SAVED_IR_REMOTE_MAGIC;
  snprintf(ir_working_remote.name, sizeof(ir_working_remote.name), "%s SIGNAL", ir_discovery_device_name);
  ir_working_remote.button_count = 1;
  strlcpy(ir_working_remote.button_names[0],
          ir_catalog_discovery_active && ir_catalog_last_test_name[0] != '\0' ?
            ir_catalog_last_test_name : "POWER",
          sizeof(ir_working_remote.button_names[0]));
  fill_ir_discovery_anchor(ir_working_remote.buttons[0]);
  ir_working_remote_from_save = false;
  ir_guided_copy_active = false;
  ir_name_saves_guided_copy = false;
  ir_name_saves_discovery_anchor = true;

  if (ir_remote_name_screen == NULL) create_ir_remote_name_screen();
  lv_textarea_set_text(ir_remote_name_textarea, ir_working_remote.name);
  lv_scr_load(ir_remote_name_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


bool ir_manufacturer_name_matches(const char *left, const char *right) {
  if (left == NULL || right == NULL) return false;
  while (true) {
    while (*left && !isalnum((unsigned char)*left)) left++;
    while (*right && !isalnum((unsigned char)*right)) right++;
    const unsigned char left_char = (unsigned char)*left;
    const unsigned char right_char = (unsigned char)*right;
    if (tolower(left_char) != tolower(right_char)) return false;
    if (left_char == 0 || right_char == 0) return left_char == right_char;
    left++;
    right++;
  }
}


bool ir_major_manufacturer_list(const char *category,
                                const char *const *&items,
                                size_t &item_count) {
  static const char *tv[] = {
    "Samsung", "LG", "Sony", "Vizio", "TCL", "Hisense", "Insignia",
    "Toshiba", "Philips", "Panasonic", "Sharp", "JVC", "RCA", "Element",
    "Westinghouse", "Sanyo", "Magnavox", "Haier"
  };
  static const char *projector[] = {
    "Epson", "BenQ", "Optoma", "ViewSonic", "Sony", "LG", "Samsung",
    "NEC", "Acer", "Canon", "Dell", "Hitachi", "Infocus", "JVC"
  };
  static const char *audio[] = {
    "Bose", "Yamaha", "Denon", "Sony", "Samsung", "LG", "JBL", "Onkyo",
    "Pioneer", "Marantz", "Harman Kardon", "Kenwood", "Panasonic", "Philips",
    "Sherwood"
  };
  static const char *fan[] = {
    "Dyson", "Honeywell", "Lasko", "Vornado", "Dreo", "Panasonic", "Philips",
    "Shark", "Westinghouse", "Rowenta", "Midea", "Pelonis", "Bionaire",
    "Woozoo", "Big Ass Fans", "Haier"
  };

  items = NULL;
  item_count = 0;
  if (strcmp(category, "TVs") == 0) {
    items = tv; item_count = sizeof(tv) / sizeof(tv[0]);
  } else if (strcmp(category, "Projector") == 0) {
    items = projector; item_count = sizeof(projector) / sizeof(projector[0]);
  } else if (strcmp(category, "A_V_receiver") == 0) {
    items = audio; item_count = sizeof(audio) / sizeof(audio[0]);
  } else if (strcmp(category, "Fan") == 0) {
    items = fan; item_count = sizeof(fan) / sizeof(fan[0]);
  }
  return items != NULL && item_count > 0;
}


bool ir_major_manufacturer(const char *category, const char *name) {
  const char *const *items = NULL;
  size_t item_count = 0;
  ir_major_manufacturer_list(category, items, item_count);
  for (size_t i = 0; i < item_count; i++) {
    if (ir_manufacturer_name_matches(name, items[i])) return true;
  }
  return false;
}


class ManufacturerCacheVisitor : public RipperIrCatalogNameVisitor {
 public:
  explicit ManufacturerCacheVisitor(const char *category) : category_(category) {}

  bool onName(const char *name, uint32_t matching_profiles) override {
    if (!ir_major_manufacturer(category_, name)) return true;
    if (ir_major_manufacturer_cache_count >= IR_MAJOR_MANUFACTURER_CACHE_MAX) return false;
    strlcpy(ir_major_manufacturer_cache_names[ir_major_manufacturer_cache_count], name,
            sizeof(ir_major_manufacturer_cache_names[0]));
    ir_major_manufacturer_cache_counts[ir_major_manufacturer_cache_count] = matching_profiles;
    ir_major_manufacturer_cache_count++;
    return true;
  }

 private:
  const char *category_;
};


void create_ir_manufacturer_screen();


void refresh_ir_manufacturer_screen() {
  if (ir_manufacturer_screen == NULL || !ripper_ir_catalog.ready()) return;
  memset(ir_manufacturer_names, 0, sizeof(ir_manufacturer_names));
  memset(ir_manufacturer_profile_counts, 0, sizeof(ir_manufacturer_profile_counts));
  if (!ir_major_manufacturer_cache_valid ||
      strcmp(ir_major_manufacturer_cache_category, ir_catalog_discovery_category) != 0) {
    ir_major_manufacturer_cache_count = 0;
    memset(ir_major_manufacturer_cache_names, 0,
           sizeof(ir_major_manufacturer_cache_names));
    memset(ir_major_manufacturer_cache_counts, 0,
           sizeof(ir_major_manufacturer_cache_counts));
    const char *const *major_names = NULL;
    size_t major_count = 0;
    if (!ir_major_manufacturer_list(ir_catalog_discovery_category,
                                    major_names, major_count)) {
      set_status("NO KNOWN MANUFACTURERS", COLOR_MUTED);
      return;
    }
    ir_major_manufacturer_cache_count = min(
      (size_t)IR_MAJOR_MANUFACTURER_CACHE_MAX, major_count);
    for (uint8_t i = 0; i < ir_major_manufacturer_cache_count; i++) {
      strlcpy(ir_major_manufacturer_cache_names[i], major_names[i],
              sizeof(ir_major_manufacturer_cache_names[i]));
    }
    strlcpy(ir_major_manufacturer_cache_category, ir_catalog_discovery_category,
            sizeof(ir_major_manufacturer_cache_category));
    ir_major_manufacturer_cache_valid = true;
  }
  ir_manufacturer_total = ir_major_manufacturer_cache_count;
  const uint16_t offset = (uint16_t)ir_manufacturer_page * IR_MANUFACTURERS_PER_PAGE;
  ir_manufacturer_page_count = offset < ir_manufacturer_total ?
    min((uint16_t)IR_MANUFACTURERS_PER_PAGE,
        (uint16_t)(ir_manufacturer_total - offset)) : 0;
  for (uint8_t i = 0; i < ir_manufacturer_page_count; i++) {
    strlcpy(ir_manufacturer_names[i],
            ir_major_manufacturer_cache_names[offset + i],
            sizeof(ir_manufacturer_names[i]));
    ir_manufacturer_profile_counts[i] =
      ir_major_manufacturer_cache_counts[offset + i];
  }

  char friendly_device[24] = {};
  strlcpy(friendly_device, ir_discovery_device_name, sizeof(friendly_device));
  for (char *p = friendly_device; *p; p++) if (*p == '_') *p = ' ';
  lv_label_set_text_fmt(ir_manufacturer_title_label, "%s MANUFACTURER", friendly_device);
  const uint16_t pages = max((uint16_t)1,
    (uint16_t)((ir_manufacturer_total + IR_MANUFACTURERS_PER_PAGE - 1) /
               IR_MANUFACTURERS_PER_PAGE));
  lv_label_set_text_fmt(ir_manufacturer_page_label, "PAGE %u / %u  -  %u MAKERS",
                        (unsigned)(ir_manufacturer_page + 1),
                        (unsigned)pages, (unsigned)ir_manufacturer_total);

  for (uint8_t i = 0; i < IR_MANUFACTURERS_PER_PAGE; i++) {
    if (i >= ir_manufacturer_page_count) {
      lv_obj_add_flag(ir_manufacturer_buttons[i], LV_OBJ_FLAG_HIDDEN);
      continue;
    }
    char display_name[48] = {};
    strlcpy(display_name, ir_manufacturer_names[i], sizeof(display_name));
    for (char *p = display_name; *p; p++) if (*p == '_') *p = ' ';
    lv_label_set_text(lv_obj_get_child(ir_manufacturer_buttons[i], 0), display_name);
    lv_obj_clear_flag(ir_manufacturer_buttons[i], LV_OBJ_FLAG_HIDDEN);
  }
  if (ir_manufacturer_page == 0) lv_obj_add_flag(ir_manufacturer_previous_button, LV_OBJ_FLAG_HIDDEN);
  else lv_obj_clear_flag(ir_manufacturer_previous_button, LV_OBJ_FLAG_HIDDEN);
  if ((uint32_t)(ir_manufacturer_page + 1) * IR_MANUFACTURERS_PER_PAGE >= ir_manufacturer_total) {
    lv_obj_add_flag(ir_manufacturer_next_button, LV_OBJ_FLAG_HIDDEN);
  } else {
    lv_obj_clear_flag(ir_manufacturer_next_button, LV_OBJ_FLAG_HIDDEN);
  }
}


void start_ir_catalog_manufacturer_discovery() {
  memset(ir_catalog_discovery_batch, 0, sizeof(ir_catalog_discovery_batch));
  ir_catalog_discovery_batch_count = 0;
  ir_catalog_discovery_batch_position = 0;
  ir_catalog_discovery_batch_number = 1;
  ir_catalog_discovery_has_after = false;
  ir_catalog_last_test_was_raw = false;
  ir_catalog_last_test_name[0] = '\0';
  ir_catalog_confirmation_stage = IR_CATALOG_CONFIRM_NONE;
  ir_catalog_extra_test_count = 0;
  ir_catalog_extra_test_index = 0;
  ir_discovery_candidate_sent = false;
  ir_discovery_send_failed = false;
  ir_discovery_current_candidate_valid = false;
  ir_discovery_group_mode = IR_DISCOVERY_GROUP_BATCH;
  if (!ripper_ir_catalog.findCandidateBatch(
        ir_catalog_discovery_category,
        ir_catalog_unknown_manufacturer ? NULL : ir_catalog_discovery_manufacturer, NULL,
        NULL, ir_catalog_discovery_batch, RIPPER_IR_CATALOG_DISCOVERY_BATCH_SIZE,
        ir_catalog_discovery_batch_count)) {
    set_status("CATALOG SEARCH FAILED", COLOR_RED);
    return;
  }
  ir_catalog_discovery_active = true;
  if (ir_discovery_screen == NULL) create_ir_discovery_screen();
  refresh_ir_discovery_screen();
  lv_scr_load(ir_discovery_screen);
  set_status(ir_catalog_discovery_batch_count > 0 ? "TEST GROUP READY" : "NO MATCHING REMOTES",
             ir_catalog_discovery_batch_count > 0 ? COLOR_READY : COLOR_MUTED);
  Serial.printf("IR manufacturer signal transmit: %s / %s, first batch=%u\n",
                ir_catalog_discovery_category, ir_catalog_discovery_manufacturer,
                (unsigned)ir_catalog_discovery_batch_count);
}


void select_ir_manufacturer(lv_event_t *e) {
  const uint8_t index = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (index >= ir_manufacturer_page_count) return;
  ir_catalog_unknown_manufacturer = false;
  strlcpy(ir_catalog_discovery_manufacturer, ir_manufacturer_names[index],
          sizeof(ir_catalog_discovery_manufacturer));
  start_ir_catalog_manufacturer_discovery();
}


void previous_ir_manufacturer_page(lv_event_t *e) {
  if (ir_manufacturer_page == 0) return;
  ir_manufacturer_page--;
  refresh_ir_manufacturer_screen();
}


void next_ir_manufacturer_page(lv_event_t *e) {
  if ((uint32_t)(ir_manufacturer_page + 1) * IR_MANUFACTURERS_PER_PAGE >=
      ir_manufacturer_total) return;
  ir_manufacturer_page++;
  refresh_ir_manufacturer_screen();
}


void use_universal_ir_discovery(lv_event_t *e) {
  if (ir_catalog_discovery_category[0] != '\0' && ensure_ripper_ir_catalog_ready()) {
    ir_catalog_unknown_manufacturer = true;
    strlcpy(ir_catalog_discovery_manufacturer, "UNKNOWN MANUFACTURER",
            sizeof(ir_catalog_discovery_manufacturer));
    start_ir_catalog_manufacturer_discovery();
    return;
  }
  ir_catalog_unknown_manufacturer = false;
  start_ir_discovery(ir_discovery_device_name);
}


void open_ir_manufacturer_picker(const char *device_name, const char *catalog_category) {
  strlcpy(ir_catalog_discovery_category, catalog_category,
          sizeof(ir_catalog_discovery_category));
  ir_discovery_device_name = device_name;
  ir_catalog_discovery_active = false;
  ir_catalog_unknown_manufacturer = false;
  ir_manufacturer_page = 0;
  ir_manufacturer_total = 0;
  if (!ensure_ripper_ir_catalog_ready()) {
    set_status("IR CATALOG UNAVAILABLE", COLOR_RED);
    start_ir_discovery(device_name);
    return;
