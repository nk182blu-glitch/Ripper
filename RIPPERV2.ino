bool ensure_catalog_usb_chunk_buffer() {
  if (catalog_usb_chunk_buffer != NULL) return true;
  const uint32_t caps = psramFound()
    ? (MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT)
    : (MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  catalog_usb_chunk_buffer =
    (uint8_t *)heap_caps_malloc(RIPPER_CATALOG_USB_CHUNK_MAX, caps);
  if (catalog_usb_chunk_buffer == NULL) {
    Serial.println("RDB1 ERROR MEMORY");
    return false;
  }
  return true;
}

void release_catalog_usb_chunk_buffer() {
  if (catalog_usb_chunk_buffer == NULL) return;
  heap_caps_free(catalog_usb_chunk_buffer);
  catalog_usb_chunk_buffer = NULL;
}

bool initialize_sd_card() {
  if (!SD_MMC.setPins(SD_MMC_CLK_PIN, SD_MMC_CMD_PIN, SD_MMC_D0_PIN)) {
    Serial.println("SD card pin assignment failed");
    return false;
  }
  if (!SD_MMC.begin("/sdcard", true, false, 20000)) {
    Serial.println("SD card not detected (insert a FAT32 card)");
    return false;
  }
  sd_card_total_bytes = SD_MMC.totalBytes();
  sd_card_used_bytes = SD_MMC.usedBytes();
  Serial.printf("SD card ready: %.1f MB total, %.1f MB used\n",
                (double)sd_card_total_bytes / 1048576.0,
                (double)sd_card_used_bytes / 1048576.0);
  return true;
}

bool ensure_ripper_ir_catalog_ready() {
  if (ripper_ir_catalog.ready()) return true;
  if (!sd_card_ready) {
    Serial.println("IR catalog unavailable: SD card not ready");
    return false;
  }
  if (!ripper_ir_catalog.begin(SD_MMC, RIPPER_IR_CATALOG_INDEX_PATH,
                               RIPPER_IR_CATALOG_ARCHIVE_PATH)) {
    Serial.printf("IR catalog reader unavailable: %s\n", ripper_ir_catalog.lastError());
    return false;
  }
  Serial.printf("IR catalog reader ready on demand: %lu profiles, %lu unsupported parsed commands\n",
                (unsigned long)ripper_ir_catalog.profileCount(),
                (unsigned long)ripper_ir_catalog.generationUnsupportedCount());
  return true;
}

// RF catalog files remain read-only and separate from saved remotes. Only one
// source catalog is active at a time, and the reader closes its FATFS handles
// between operations so browsing will not reserve heap needed by BLE/Wi-Fi.
bool ensure_ripper_rf_catalog_ready(uint8_t source) {
  if (ripper_rf_catalog.ready() && ripper_rf_catalog_active_source == (int8_t)source)
    return true;
  if (!sd_card_ready) {
    Serial.println("RF catalog unavailable: SD card not ready");
    return false;
  }
  const char *index_path = source == 0 ? RIPPER_RF_UBER_INDEX_PATH :
    source == 1 ? RIPPER_RF_BRUCE_INDEX_PATH : NULL;
  const char *archive_path = source == 0 ? RIPPER_RF_UBER_ARCHIVE_PATH :
    source == 1 ? RIPPER_RF_BRUCE_ARCHIVE_PATH : NULL;
  if (index_path == NULL || archive_path == NULL) {
    Serial.println("RF catalog source is invalid");
    return false;
  }
  ripper_rf_catalog.end();
  ripper_rf_catalog_active_source = -1;
  if (!ripper_rf_catalog.begin(SD_MMC, index_path, archive_path)) {
    Serial.printf("RF catalog reader unavailable: %s\n",
                  ripper_rf_catalog.lastError());
    return false;
  }
  ripper_rf_catalog_active_source = (int8_t)source;
  Serial.printf("RF catalog reader ready on demand: %lu profiles, %lu signals, %lu string-cache bytes\n",
                (unsigned long)ripper_rf_catalog.profileCount(),
                (unsigned long)ripper_rf_catalog.signalCount(),
                (unsigned long)ripper_rf_catalog.stringCacheBytes());
  return true;
}


// Serial-only hardware validation for the read-only RF catalogs. This streams
// a real signal near the beginning, middle, and end of each index without
// retaining timing arrays or adding technical controls to the permanent UI.
class RipperRfCatalogCheckVisitor : public RipperRfCatalogSignalVisitor {
 public:
  uint32_t emitted = 0;

  bool onSignalEnd(uint32_t emitted_values) override {
    emitted = emitted_values;
    return emitted_values > 0;
  }
};


bool check_ripper_rf_catalog_profile(uint32_t ordinal) {
  RipperRfCatalogProfile profile = {};
  if (!ripper_rf_catalog.readProfile(ordinal, profile)) return false;
  for (uint16_t local = 0; local < profile.signal_count; local++) {
    RipperRfCatalogSignal signal = {};
    if (!ripper_rf_catalog.readSignal(ordinal, local, signal)) return false;
    if ((signal.flags & RIPPER_RF_CATALOG_SIGNAL_PARSEABLE) == 0) continue;
    RipperRfCatalogCheckVisitor visitor;
    if (!ripper_rf_catalog.parseSignal(ordinal, local, visitor)) return false;
    Serial.printf("RFC1 SAMPLE %lu %u %lu %s %s\n",
                  (unsigned long)ordinal, (unsigned int)local,
                  (unsigned long)visitor.emitted, profile.category, signal.label);
    return true;
  }
  Serial.printf("RFC1 ERROR NO_PARSEABLE_SIGNAL %lu\n", (unsigned long)ordinal);
  return false;
}


void run_ripper_rf_catalog_check(uint8_t source) {
  const uint32_t free_before = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  if (source > 1 || !ensure_ripper_rf_catalog_ready(source)) {
    Serial.printf("RFC1 ERROR %u %s\n", (unsigned int)source,
                  source > 1 ? "INVALID_SOURCE" : ripper_rf_catalog.lastError());
    return;
  }
  const uint32_t profile_count = ripper_rf_catalog.profileCount();
  const uint32_t signal_count = ripper_rf_catalog.signalCount();
  const uint32_t sample_ordinals[3] = {
    0, profile_count / 2, profile_count - 1
  };
  bool ok = true;
  for (uint8_t sample = 0; sample < 3 && ok; sample++) {
    if (sample > 0 && sample_ordinals[sample] == sample_ordinals[sample - 1]) continue;
    ok = check_ripper_rf_catalog_profile(sample_ordinals[sample]);
  }
  char error_text[64] = {};
  strlcpy(error_text, ripper_rf_catalog.lastError(), sizeof(error_text));
  ripper_rf_catalog.end();
  ripper_rf_catalog_active_source = -1;
  const uint32_t free_after = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  if (ok) {
    Serial.printf("RFC1 OK %u %lu %lu %lu %lu\n", (unsigned int)source,
                  (unsigned long)profile_count, (unsigned long)signal_count,
                  (unsigned long)free_before, (unsigned long)free_after);
  } else {
    Serial.printf("RFC1 ERROR %u %s\n", (unsigned int)source,
                  error_text[0] == '\0' ? "PROFILE_CHECK" : error_text);
  }
}

