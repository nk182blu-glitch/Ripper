const char *const *rf_catalog_find_aliases(uint8_t category_index,
                                            uint8_t &alias_count) {
  alias_count = 0;
  switch (category_index) {
    case 1:
      alias_count = sizeof(RF_CATALOG_ALIASES_OUTLET) /
                    sizeof(RF_CATALOG_ALIASES_OUTLET[0]);
      return RF_CATALOG_ALIASES_OUTLET;
    case 2:
      alias_count = sizeof(RF_CATALOG_ALIASES_LIGHT) /
                    sizeof(RF_CATALOG_ALIASES_LIGHT[0]);
      return RF_CATALOG_ALIASES_LIGHT;
    case 3:
      alias_count = sizeof(RF_CATALOG_ALIASES_FAN) /
                    sizeof(RF_CATALOG_ALIASES_FAN[0]);
      return RF_CATALOG_ALIASES_FAN;
    case 4:
      alias_count = sizeof(RF_CATALOG_ALIASES_PROJECTOR) /
                    sizeof(RF_CATALOG_ALIASES_PROJECTOR[0]);
      return RF_CATALOG_ALIASES_PROJECTOR;
    case 5:
      alias_count = sizeof(RF_CATALOG_ALIASES_DOOR) /
                    sizeof(RF_CATALOG_ALIASES_DOOR[0]);
      return RF_CATALOG_ALIASES_DOOR;
    case 6:
      alias_count = sizeof(RF_CATALOG_ALIASES_BLINDS) /
                    sizeof(RF_CATALOG_ALIASES_BLINDS[0]);
      return RF_CATALOG_ALIASES_BLINDS;
    case 7:
      alias_count = sizeof(RF_CATALOG_ALIASES_FIREPLACE) /
                    sizeof(RF_CATALOG_ALIASES_FIREPLACE[0]);
      return RF_CATALOG_ALIASES_FIREPLACE;
    default:
      return NULL;
  }
}


void sort_rf_catalog_find_candidates() {
  for (uint8_t left = 0; left < rf_catalog_find_candidate_count; left++) {
    for (uint8_t right = left + 1; right < rf_catalog_find_candidate_count;
         right++) {
      const RipperRfCatalogCandidateRef &a =
        rf_catalog_find_candidates[left].profile;
      const RipperRfCatalogCandidateRef &b =
        rf_catalog_find_candidates[right].profile;
      if (b.score < a.score ||
          (b.score == a.score && b.signal_count <= a.signal_count)) continue;
      RfCatalogFindCandidate swap = rf_catalog_find_candidates[left];
      rf_catalog_find_candidates[left] = rf_catalog_find_candidates[right];
      rf_catalog_find_candidates[right] = swap;
    }
  }
}


bool prepare_rf_catalog_find_candidates(uint8_t category_index) {
  const uint32_t started_ms = millis();
  rf_catalog_find_candidate_count = 0;
  rf_catalog_find_candidate_index = 0;
  rf_catalog_find_test_sent = false;
  uint8_t alias_count = 0;
  const char *const *aliases =
    rf_catalog_find_aliases(category_index, alias_count);
  if (aliases == NULL || alias_count == 0) return false;
  if (!ensure_ripper_rf_catalog_ready(0)) {
    close_ripper_rf_catalog_session();
    return false;
  }
  const uint32_t catalog_ready_ms = millis();

  uint32_t after_ordinal = UINT32_MAX;
  bool has_more = true;
  while (has_more &&
         rf_catalog_find_candidate_count < RF_CATALOG_FIND_MAX_CANDIDATES) {
    RipperRfCatalogCandidateRef batch[RF_CATALOG_FIND_MAX_CANDIDATES] = {};
    size_t batch_count = 0;
    RipperRfCatalogQuery query = {};
    query.category_options = aliases;
    query.category_option_count = alias_count;
    query.after_ordinal = after_ordinal;
    // Keep category opening fast: use the compact catalog index to find a
    // supported test command now. The exact profile is still fully parsed and
    // transactionally validated before WORKED is allowed to save it.
    query.require_complete = false;
    query.include_exact_duplicates = false;
    if (!ripper_rf_catalog.findProfileBatch(
          query, batch, RF_CATALOG_FIND_MAX_CANDIDATES,
          batch_count, has_more)) {
      close_ripper_rf_catalog_session();
      return false;
    }
    if (batch_count == 0) break;
    after_ordinal = batch[batch_count - 1].profile_ordinal;
    for (size_t index = 0; index < batch_count &&
         rf_catalog_find_candidate_count < RF_CATALOG_FIND_MAX_CANDIDATES;
         index++) {
      RfCatalogFindCandidate &candidate =
        rf_catalog_find_candidates[rf_catalog_find_candidate_count++];
      candidate.source = 0;
      candidate.profile = batch[index];
    }
  }
  sort_rf_catalog_find_candidates();
  const uint32_t finished_ms = millis();
  Serial.printf("RF Find Controls: %u testable %s candidate(s) ready; init=%lu ms query=%lu ms total=%lu ms\n",
                (unsigned)rf_catalog_find_candidate_count,
                rf_catalog_find_category_name,
                (unsigned long)(catalog_ready_ms - started_ms),
                (unsigned long)(finished_ms - catalog_ready_ms),
                (unsigned long)(finished_ms - started_ms));
  return rf_catalog_find_candidate_count > 0;
}


class RipperRfCatalogTestCollector : public RipperRfCatalogSignalVisitor {
 public:
  RipperRfCatalogTestCollector(uint32_t expected_count, uint32_t *timings,
                               uint32_t capacity)
      : expected_count_(expected_count), timings_(timings), capacity_(capacity) {}

  bool onRawTiming(int32_t signed_duration_us) override {
    if (signed_duration_us == 0 || signed_duration_us == INT32_MIN ||
        input_count_ >= expected_count_) return false;
    const bool positive = signed_duration_us > 0;
    const uint32_t duration = positive ? (uint32_t)signed_duration_us :
      (uint32_t)(-(int64_t)signed_duration_us);
    if (duration == 0 || duration > RIPPER_RF_MAX_TIMING_US ||
        total_duration_us + duration > RF_CATALOG_TEST_MAX_DURATION_US)
      return false;
    total_duration_us += duration;
    if (!has_current_) {
      first_level = positive ? 1 : 0;
      current_positive_ = positive;
      current_duration_ = duration;
      has_current_ = true;
    } else if (current_positive_ == positive) {
      const uint64_t combined = (uint64_t)current_duration_ + duration;
      if (combined > RIPPER_RF_MAX_TIMING_US) return false;
      current_duration_ = (uint32_t)combined;
    } else {
      if (!pushCurrent()) return false;
      current_positive_ = positive;
      current_duration_ = duration;
      has_current_ = true;
    }
    input_count_++;
    return true;
  }

  bool onBinRawByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onParsedKeyByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onSignalEnd(uint32_t emitted_values) override {
    if (has_current_ && !pushCurrent()) return false;
    return input_count_ == expected_count_ && emitted_values == expected_count_ &&
      output_count >= 2;
  }

  uint8_t first_level = 0;
  uint32_t output_count = 0;
  uint64_t total_duration_us = 0;
  bool requires_extended = false;

 private:
  bool pushCurrent() {
    if (timings_ == NULL || output_count >= capacity_) return false;
    timings_[output_count++] = current_duration_;
    if (current_duration_ > UINT16_MAX || output_count > 4096)
      requires_extended = true;
    has_current_ = false;
    return true;
  }

  uint32_t expected_count_ = 0;
  uint32_t *timings_ = NULL;
  uint32_t capacity_ = 0;
  uint32_t input_count_ = 0;
  uint32_t current_duration_ = 0;
  bool current_positive_ = false;
  bool has_current_ = false;
};


bool transmit_rf_catalog_find_candidate() {
  if (rf_catalog_find_candidate_index >= rf_catalog_find_candidate_count ||
      !cc1101_ready) return false;
  const RfCatalogFindCandidate &candidate =
    rf_catalog_find_candidates[rf_catalog_find_candidate_index];
  if (!ensure_ripper_rf_catalog_ready(candidate.source)) return false;
  RipperRfCatalogSignal signal = {};
  if (!ripper_rf_catalog.readSignal(candidate.profile.profile_ordinal,
                                    candidate.profile.test_signal_ordinal,
                                    signal) ||
      signal.encoding != RIPPER_RF_CATALOG_ENCODING_RAW ||
      signal.raw_timing_count < 2 ||
      signal.raw_timing_count > RF_CATALOG_TEST_MAX_TIMINGS) {
    return false;
  }

  const size_t timing_bytes = signal.raw_timing_count * sizeof(uint32_t);
  uint32_t *timings = (uint32_t *)heap_caps_malloc(
    timing_bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (timings == NULL && timing_bytes <= 32768UL) {
    timings = (uint32_t *)heap_caps_malloc(
      timing_bytes, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  }
  if (timings == NULL) {
    return false;
  }

  RipperRfCatalogTestCollector collector(signal.raw_timing_count, timings,
                                         signal.raw_timing_count);
  const bool parsed = ripper_rf_catalog.parseSignal(
    candidate.profile.profile_ordinal,
    candidate.profile.test_signal_ordinal, collector);
  RipperRfButtonDiskV1 disk = {};
  const bool prepared = parsed && make_catalog_rf_button(
    signal, candidate.profile.test_signal_ordinal, collector.first_level,
    collector.output_count, collector.requires_extended, disk);
  if (!prepared || !apply_repository_rf_radio(disk)) {
    heap_caps_free(timings);
    return false;
  }

  set_status("TRANSMITTING", COLOR_RF);
  lv_timer_handler();
  lv_refr_now(NULL);
  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  if (cc1101.transmitDirectAsync() != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    heap_caps_free(timings);
    return false;
  }
  bool level = collector.first_level != 0;
  digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
  for (uint32_t index = 0; index < collector.output_count; index++) {
    delay_repository_rf_duration(timings[index]);
    level = !level;
    digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
  }
  digitalWrite(CC1101_GDO0, LOW);
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  heap_caps_free(timings);
  Serial.printf("RF Find Controls test sent: source=%u profile=%lu model=%s signal=%s timings=%lu duration=%llu us\n",
                (unsigned)candidate.source,
                (unsigned long)candidate.profile.profile_ordinal,
                candidate.profile.model, candidate.profile.test_label,
                (unsigned long)collector.output_count,
                (unsigned long long)collector.total_duration_us);
  return true;
}


void refresh_rf_catalog_find_screen() {
  if (rf_catalog_find_title_label == NULL ||
      rf_catalog_find_state_label == NULL ||
      rf_catalog_find_hint_label == NULL) return;
  lv_label_set_text_fmt(rf_catalog_find_title_label, "%s CONTROLS",
                        rf_catalog_find_category_name);
  if (rf_catalog_find_candidate_count == 0) {
    lv_label_set_text(rf_catalog_find_state_label,
                      "NO TESTABLE MATCH FOUND");
    lv_label_set_text(rf_catalog_find_hint_label,
                      "Use the supported fixed-code search,\nor copy the original remote.");
    return;
  }
  const RipperRfCatalogCandidateRef &candidate =
    rf_catalog_find_candidates[rf_catalog_find_candidate_index].profile;
  lv_label_set_text_fmt(rf_catalog_find_state_label,
                        "REMOTE MATCH %u OF %u\nTEST CONTROL: %s",
                        (unsigned)(rf_catalog_find_candidate_index + 1),
                        (unsigned)rf_catalog_find_candidate_count,
                        candidate.test_label);
  lv_label_set_text(rf_catalog_find_hint_label,
                    rf_catalog_find_test_sent ?
                      "Did the device respond? WORKED saves the\ncomplete remote. Otherwise try the next match." :
                      "Watch the device, then tap TEST CONTROL.\nNothing is saved until you confirm WORKED.");
}


void rf_catalog_find_send_test(lv_event_t *e) {
  (void)e;
  if (rf_catalog_find_candidate_count == 0) {
    set_status("NO SAVED MATCH READY", COLOR_RED);
    return;
  }
  if (!transmit_rf_catalog_find_candidate()) {
    rf_catalog_find_test_sent = false;
    set_status("TEST SIGNAL NOT USABLE", COLOR_RED);
    return;
  }
  rf_catalog_find_test_sent = true;
  refresh_rf_catalog_find_screen();
  set_status("DID IT WORK?", COLOR_SETTINGS);
}


void rf_catalog_find_try_next(lv_event_t *e) {
  (void)e;
  if (rf_catalog_find_candidate_count == 0) return;
  if (rf_catalog_find_candidate_index + 1 < rf_catalog_find_candidate_count) {
    rf_catalog_find_candidate_index++;
    rf_catalog_find_test_sent = false;
    refresh_rf_catalog_find_screen();
    set_status("NEXT MATCH READY", COLOR_RF);
  } else {
    set_status("NO MORE SAVED MATCHES", COLOR_MUTED);
  }
}


void rf_catalog_find_worked(lv_event_t *e) {
  (void)e;
  if (!rf_catalog_find_test_sent ||
      rf_catalog_find_candidate_index >= rf_catalog_find_candidate_count) {
    set_status("TEST A CONTROL FIRST", COLOR_RED);
    return;
  }
  const RfCatalogFindCandidate candidate =
    rf_catalog_find_candidates[rf_catalog_find_candidate_index];
  set_status("SAVING COMPLETE REMOTE", COLOR_RF);
  lv_timer_handler();
  lv_refr_now(NULL);
  uint64_t remote_id = 0;
  char error_text[64] = {};
  if (!import_ripper_rf_catalog_profile(
        candidate.source, candidate.profile.profile_ordinal,
        remote_id, error_text, sizeof(error_text))) {
    set_status(error_text[0] != '\0' ? error_text : "REMOTE SAVE FAILED",
               COLOR_RED);
    return;
  }
  RipperRfIndexEntryV1 entry = {};
  uint32_t ordinal = 0;
  if (!ripper_rf_repository_find(remote_id, entry, &ordinal) ||
      !load_repository_rf_remote_adapter(remote_id)) {
    set_status("REMOTE SAVED - OPEN FAILED", COLOR_RED);
    return;
  }
  selected_rf_repository_id = remote_id;
  selected_rf_repository_ordinal = ordinal;
  selected_saved_index = find_legacy_rf_remote_by_id(remote_id);
  refresh_universal_remote();
  lv_scr_load(universal_remote_screen);
  set_status("COMPLETE REMOTE SAVED", COLOR_GREEN);
}


