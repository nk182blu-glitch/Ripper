// RipperZero 2.1.3 phone connection. LVGL remains the single source of truth:
// every flushed region is copied into a PSRAM shadow framebuffer and the
// authenticated local web app renders that exact 320x480 image. Remote taps
// are queued back into the normal LVGL pointer driver, so phone and physical
// touch use the same screens, callbacks, validation, and transmit safeguards.
#define RIPPER_MOBILE_FRAME_WIDTH 320
#define RIPPER_MOBILE_FRAME_HEIGHT 480
#define RIPPER_MOBILE_FRAME_PIXELS \
  ((uint32_t)RIPPER_MOBILE_FRAME_WIDTH * RIPPER_MOBILE_FRAME_HEIGHT)
#define RIPPER_MOBILE_FRAME_BYTES \
  (RIPPER_MOBILE_FRAME_PIXELS * sizeof(uint16_t))
#define RIPPER_MOBILE_TILE_SIZE 32
#define RIPPER_MOBILE_TILE_COLUMNS \
  ((RIPPER_MOBILE_FRAME_WIDTH + RIPPER_MOBILE_TILE_SIZE - 1) / RIPPER_MOBILE_TILE_SIZE)
#define RIPPER_MOBILE_TILE_ROWS \
  ((RIPPER_MOBILE_FRAME_HEIGHT + RIPPER_MOBILE_TILE_SIZE - 1) / RIPPER_MOBILE_TILE_SIZE)
#define RIPPER_MOBILE_TILE_COUNT \
  (RIPPER_MOBILE_TILE_COLUMNS * RIPPER_MOBILE_TILE_ROWS)
#define RIPPER_MOBILE_IMPORT_ROOT "/ripper/imports"
#define RIPPER_MOBILE_MAX_UPLOAD_BYTES (16UL * 1024UL * 1024UL)
