void persist_pending_rf_repository_deletes() {
  saved_preferences.begin("ripperzero", false);
  saved_preferences.putBytes("rfDeleteIds", pending_rf_repository_delete_ids,
                             sizeof(pending_rf_repository_delete_ids));
