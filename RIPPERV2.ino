void open_hunter_tx45_capture(lv_event_t *e) {
  (void)e;
  if (!cc1101_ready) { set_status("CC1101 NOT READY", COLOR_RED); return; }
  stop_live_rf_scanner();
  if (rf_capture_active) stop_rf_capture();
  if (hunter_tx45_screen == NULL) create_hunter_tx45_screen();
  lv_obj_remove_event_cb(hunter_tx45_capture_button, start_hunter_tx45_sample);
  lv_obj_remove_event_cb(hunter_tx45_capture_button, begin_hunter_tx45_session);
  lv_obj_add_event_cb(hunter_tx45_capture_button, begin_hunter_tx45_session, LV_EVENT_CLICKED, NULL);
  hunter_tx45_session_started = false;
  hunter_tx45_capture_mode = false;
  refresh_hunter_tx45_screen();
  lv_scr_load(hunter_tx45_screen);
}

void close_hunter_tx45_capture(lv_event_t *e) {
  (void)e;
  if (rf_capture_active) stop_rf_capture();
  hunter_tx45_capture_mode = false;
  hunter_tx45_session_started = false;
  apply_rf_profile(hunter_tx45_previous_profile, false);
  set_status("SYSTEM READY", COLOR_READY);
  open_hunter_tx45_remote(e);
}

void begin_hunter_tx45_session(lv_event_t *e) {
  (void)e;
  if (hunter_tx45_session_started) { start_hunter_tx45_sample(NULL); return; }
  if (!sd_card_ready) {
    lv_label_set_text(hunter_tx45_status_label, "SD CARD REQUIRED - INSERT AND RESTART");
    set_status("SD CARD REQUIRED", COLOR_RED);
    return;
  }
  hunter_tx45_previous_profile = safe_rf_profile_index();
  if (!apply_rf_profile(0, false)) {
    lv_label_set_text(hunter_tx45_status_label, "HUNTER RADIO PROFILE FAILED");
    set_status("RF SETUP FAILED", COLOR_RED);
    return;
  }
  saved_preferences.begin("ripperzero", false);
  hunter_tx45_session_id = saved_preferences.getUInt("tx45Session", 0) + 1;
  saved_preferences.putUInt("tx45Session", hunter_tx45_session_id);
  saved_preferences.end();
  hunter_tx45_command_index = 0;
  hunter_tx45_sample_index = 0;
  hunter_tx45_session_started = true;
  hunter_tx45_capture_mode = true;
  lv_obj_remove_event_cb(hunter_tx45_capture_button, begin_hunter_tx45_session);
  lv_obj_add_event_cb(hunter_tx45_capture_button, start_hunter_tx45_sample, LV_EVENT_CLICKED, NULL);
  refresh_hunter_tx45_screen();
  set_status("SYSTEM READY", COLOR_READY);
}

void start_hunter_tx45_sample(lv_event_t *e) {
  (void)e;
  if (!hunter_tx45_session_started || rf_capture_active) return;
  if (!start_rf_capture()) {
    lv_label_set_text(hunter_tx45_status_label, "COULD NOT START RECEIVER - TRY AGAIN");
    set_status("RF CAPTURE FAILED", COLOR_RED);
    return;
  }
  lv_label_set_text(hunter_tx45_status_label, "LISTENING - PRESS AND RELEASE NOW");
  lv_obj_add_state(hunter_tx45_capture_button, LV_STATE_DISABLED);
  set_status("LISTENING", COLOR_RF);
}

bool save_hunter_tx45_raw_sample(uint16_t edges, float peak_rssi, float noise_rssi) {
  File file = SD_MMC.open("/hunter_tx45_raw.csv", FILE_APPEND);
  if (!file) return false;
  if (file.size() == 0) {
    file.println("session,date_time,command,sample,frequency_mhz,peak_rssi_dbm,noise_dbm,edge_count,levels,durations_us");
  }
  char date_time[32] = "DATE NOT SET";
  if (rtc_ready && rtc.isClockIntegrityGuaranteed()) {
    RTC_DateTime now = rtc.getDateTime();
    format_clock_text(date_time, sizeof(date_time), now, true);
  }
  file.printf("%lu,\"%s\",\"%s\",%u,%.3f,%.1f,%.1f,%u,\"",
              (unsigned long)hunter_tx45_session_id, date_time,
              HUNTER_TX45_COMMANDS[hunter_tx45_command_index],
              hunter_tx45_sample_index + 1, RF_PROFILES[0].frequency,
              peak_rssi, noise_rssi, edges);
  for (uint16_t i = 0; i < edges; i++) file.print(rf_capture_levels[i] ? '1' : '0');
  file.print("\",\"");
  for (uint16_t i = 0; i < edges; i++) {
    if (i) file.print(' ');
    file.print((unsigned long)rf_capture_durations[i]);
  }
  file.println("\"");
  file.close();
  return true;
}

void export_hunter_tx45_usb(lv_event_t *e) {
  (void)e;
  if (rf_capture_active) {
    lv_label_set_text(hunter_tx45_status_label, "STOP CAPTURE BEFORE EXPORTING");
    return;
  }
  if (!sd_card_ready) {
    lv_label_set_text(hunter_tx45_status_label, "SD CARD NOT AVAILABLE");
    set_status("SD CARD NOT AVAILABLE", COLOR_RED);
    return;
  }
  File file = SD_MMC.open("/hunter_tx45_raw.csv", FILE_READ);
  if (!file) {
    lv_label_set_text(hunter_tx45_status_label, "NO TX45 CAPTURE FILE FOUND");
    set_status("NO TX45 DATA", COLOR_RED);
    return;
  }
  lv_label_set_text(hunter_tx45_status_label, "EXPORTING TO USB - PLEASE WAIT");
  set_status("USB EXPORT", COLOR_RF);
  lv_timer_handler();
  Serial.println("<<<HUNTER_TX45_CSV_BEGIN>>>");
  while (file.available()) {
    uint8_t buffer[256];
    const size_t count = file.read(buffer, sizeof(buffer));
    if (count == 0) break;
    Serial.write(buffer, count);
    delay(1);
  }
  file.close();
  Serial.println();
  Serial.println("<<<HUNTER_TX45_CSV_END>>>");
  Serial.flush();
  lv_label_set_text(hunter_tx45_status_label, "USB EXPORT COMPLETE");
  set_status("SYSTEM READY", COLOR_READY);
}

void finish_hunter_tx45_sample() {
  if (rf_rmt_ready && rmtReceiveCompleted(CC1101_GDO0)) {
    rf_capture_edge_count = 0;
    for (size_t i = 0; i < rf_rmt_symbol_count && rf_capture_edge_count + 1 < RF_CAPTURE_MAX_EDGES; i++) {
      if (rf_rmt_symbols[i].duration0 >= RF_CAPTURE_MIN_PULSE_US) {
        rf_capture_durations[rf_capture_edge_count] = rf_rmt_symbols[i].duration0;
        rf_capture_levels[rf_capture_edge_count++] = rf_rmt_symbols[i].level0;
      }
      if (rf_rmt_symbols[i].duration1 >= RF_CAPTURE_MIN_PULSE_US) {
        rf_capture_durations[rf_capture_edge_count] = rf_rmt_symbols[i].duration1;
        rf_capture_levels[rf_capture_edge_count++] = rf_rmt_symbols[i].level1;
      }
    }
  }
  const uint16_t edges = rf_capture_edge_count;
  const bool carrier_seen = rf_capture_carrier_seen;
  const float peak_rssi = rf_capture_peak_rssi;
  const float noise_rssi = rf_capture_baseline_rssi;
  stop_rf_capture();
  lv_obj_clear_state(hunter_tx45_capture_button, LV_STATE_DISABLED);

  if (!carrier_seen || edges < 20) {
    lv_label_set_text(hunter_tx45_status_label, "NO CLEAN SIGNAL - RETRY THIS SAMPLE");
    set_status("NO USABLE RF SIGNAL", COLOR_RED);
    return;
  }
  if (!save_hunter_tx45_raw_sample(edges, peak_rssi, noise_rssi)) {
    lv_label_set_text(hunter_tx45_status_label, "SD WRITE FAILED - SAMPLE NOT COUNTED");
    set_status("SD WRITE FAILED", COLOR_RED);
    return;
  }

  hunter_tx45_sample_index++;
  if (hunter_tx45_sample_index >= HUNTER_TX45_SAMPLES_PER_COMMAND) {
    hunter_tx45_sample_index = 0;
    hunter_tx45_command_index++;
  }
  if (hunter_tx45_command_index >= HUNTER_TX45_COMMAND_COUNT) {
    hunter_tx45_capture_mode = false;
    hunter_tx45_session_started = false;
    lv_bar_set_value(hunter_tx45_progress_bar, 100, LV_ANIM_ON);
    lv_label_set_text(hunter_tx45_step_label, "CAPTURE COMPLETE");
    lv_label_set_text(hunter_tx45_instruction_label,
                      "30 raw samples saved to SD:\n/hunter_tx45_raw.csv\n\nNo signal was transmitted.");
    lv_label_set_text(hunter_tx45_status_label, "DATASET READY FOR ANALYSIS");
    lv_label_set_text(lv_obj_get_child(hunter_tx45_capture_button, 0), "NEW SESSION");
    lv_obj_remove_event_cb(hunter_tx45_capture_button, start_hunter_tx45_sample);
    lv_obj_add_event_cb(hunter_tx45_capture_button, begin_hunter_tx45_session, LV_EVENT_CLICKED, NULL);
    set_status("SYSTEM READY", COLOR_READY);
    return;
  }
  refresh_hunter_tx45_screen();
  set_status("SYSTEM READY", COLOR_READY);
}


