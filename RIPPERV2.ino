// ============================================================
// STATUS FUNCTIONS
// ============================================================

enum GlobalActivityState : uint8_t {
  GLOBAL_ACTIVITY_READY = 0,
  GLOBAL_ACTIVITY_LISTENING,
  GLOBAL_ACTIVITY_SCANNING,
  GLOBAL_ACTIVITY_CAPTURING,
  GLOBAL_ACTIVITY_TRANSMITTING,
  GLOBAL_ACTIVITY_PROCESSING,
  GLOBAL_ACTIVITY_SAVING,
  GLOBAL_ACTIVITY_CONNECTING,
  GLOBAL_ACTIVITY_PAIRING,
  GLOBAL_ACTIVITY_ERROR
};

const char *global_activity_text(uint8_t state) {
  switch (state) {
    case GLOBAL_ACTIVITY_LISTENING:    return "LISTENING";
    case GLOBAL_ACTIVITY_SCANNING:     return "SCANNING";
    case GLOBAL_ACTIVITY_CAPTURING:    return "CAPTURING";
    case GLOBAL_ACTIVITY_TRANSMITTING: return "TRANSMITTING";
    case GLOBAL_ACTIVITY_PROCESSING:   return "PROCESSING";
    case GLOBAL_ACTIVITY_SAVING:       return "SAVING";
    case GLOBAL_ACTIVITY_CONNECTING:   return "CONNECTING";
    case GLOBAL_ACTIVITY_PAIRING:      return "PAIRING";
    case GLOBAL_ACTIVITY_ERROR:        return "ERROR";
    case GLOBAL_ACTIVITY_READY:
    default:                           return "SYSTEM READY";
  }
}

uint8_t classify_global_activity(const char *detail, uint32_t color) {
  if (detail == NULL || detail[0] == '\0' ||
      strcmp(detail, "SYSTEM READY") == 0 ||
      strcmp(detail, "READY") == 0) {
    return GLOBAL_ACTIVITY_READY;
  }

  // Exact live-operation states are checked before the error fallback so an
  // operation such as TURNING OFF can use a red accent without reading as a
  // failure. Everything else shown in the header is restricted to this small,
  // stable activity vocabulary; the original detail remains available for
  // Serial diagnostics and screen-specific messages.
  if (strncmp(detail, "TRANSMITTING", 12) == 0)
    return GLOBAL_ACTIVITY_TRANSMITTING;
  if (strstr(detail, "LISTENING") != NULL)
    return GLOBAL_ACTIVITY_LISTENING;
  if (strcmp(detail, "CAPTURING") == 0 ||
      strcmp(detail, "CAPTURE IN PROGRESS") == 0 ||
      strcmp(detail, "RECORDING") == 0 ||
      strcmp(detail, "RF ANALYZER BUSY") == 0)
    return GLOBAL_ACTIVITY_CAPTURING;
  if (strcmp(detail, "SCANNING") == 0 ||
      strcmp(detail, "LIVE RF SCANNING") == 0)
    return GLOBAL_ACTIVITY_SCANNING;
  if (strcmp(detail, "SAVING COMPLETE REMOTE") == 0 ||
      strcmp(detail, "SD SAVE PENDING") == 0 ||
      strcmp(detail, "SD LAYOUT PENDING") == 0 ||
      strcmp(detail, "USB EXPORT") == 0)
    return GLOBAL_ACTIVITY_SAVING;
  if (strcmp(detail, "CONNECTING") == 0)
    return GLOBAL_ACTIVITY_CONNECTING;
  if (strcmp(detail, "PAIRING") == 0)
    return GLOBAL_ACTIVITY_PAIRING;
  if (strcmp(detail, "TURNING OFF") == 0 ||
      strcmp(detail, "SERVING") == 0)
    return GLOBAL_ACTIVITY_PROCESSING;
  if (strcmp(detail, "AUTO-DETECTING RF SIGNAL") == 0)
    return GLOBAL_ACTIVITY_SCANNING;
  if (strcmp(detail, "DIAGNOSTICS") == 0 ||
      strcmp(detail, "FINDING SAVED MATCHES") == 0 ||
      strcmp(detail, "REFINING") == 0)
    return GLOBAL_ACTIVITY_PROCESSING;

  if (color == COLOR_RED ||
      strstr(detail, "FAILED") != NULL ||
      strstr(detail, "ERROR") != NULL ||
      strstr(detail, "INVALID") != NULL ||
      strstr(detail, "UNAVAILABLE") != NULL ||
      strstr(detail, "UNSUPPORTED") != NULL ||
      strstr(detail, "NOT READY") != NULL ||
      strstr(detail, "NOT FOUND") != NULL ||
      strstr(detail, "NOT USABLE") != NULL ||
      strstr(detail, "REQUIRED") != NULL ||
      strstr(detail, "REJECTED") != NULL ||
      strstr(detail, "CANNOT") != NULL ||
      strstr(detail, "COULD NOT") != NULL ||
      strstr(detail, "MEMORY LOW") != NULL ||
      strstr(detail, "BUFFER FULL") != NULL ||
      strstr(detail, "MEMORY FULL") != NULL ||
      strstr(detail, "READ-ONLY") != NULL ||
      strstr(detail, "NO LONGER AVAILABLE") != NULL) {
    return GLOBAL_ACTIVITY_ERROR;
  }

  if (strncmp(detail, "SAVING ", 7) == 0 ||
      strncmp(detail, "EXPORTING ", 10) == 0)
    return GLOBAL_ACTIVITY_SAVING;
  if (strncmp(detail, "CONNECTING ", 11) == 0)
    return GLOBAL_ACTIVITY_CONNECTING;
  if (strncmp(detail, "PAIRING ", 8) == 0)
    return GLOBAL_ACTIVITY_PAIRING;
  if (strncmp(detail, "PROCESSING ", 11) == 0 ||
      strncmp(detail, "FINDING ", 8) == 0 ||
      strncmp(detail, "REFINING ", 9) == 0)
    return GLOBAL_ACTIVITY_PROCESSING;

  // Completed results, instructions, and screen titles are idle states. Their
  // detailed wording belongs to the active screen rather than the global bar.
  return GLOBAL_ACTIVITY_READY;
}

uint32_t global_activity_color(uint8_t state, uint32_t requested_color) {
  if (state == GLOBAL_ACTIVITY_READY) return COLOR_READY;
  if (state == GLOBAL_ACTIVITY_ERROR) return COLOR_RED;
  if (state == GLOBAL_ACTIVITY_TRANSMITTING) return COLOR_SETTINGS;
  return requested_color;
}

void render_global_status() {
  const bool boosted = boost_mode_is_active();
  char rendered[80];
  if (boosted) {
    const char *base = strcmp(global_status_text, "SYSTEM READY") == 0 ?
                       "SYSTEM" : global_status_text;
    snprintf(rendered, sizeof(rendered), "%s #FF9500 BOOSTED#", base);
  } else {
    strlcpy(rendered, global_status_text, sizeof(rendered));
  }

  for (uint8_t i = 0; i < status_indicator_count; i++) {
    lv_label_set_recolor(status_labels[i], boosted);
    lv_obj_set_width(status_labels[i], boosted ? 208 : 122);
    lv_obj_set_style_text_font(status_labels[i],
                               boosted ? FONT_DISPLAY_MD : FONT_MONO_SM,
                               LV_PART_MAIN);
    lv_label_set_long_mode(status_labels[i], LV_LABEL_LONG_DOT);
    lv_label_set_text(status_labels[i], rendered);
    lv_obj_set_style_text_color(status_labels[i],
                                lv_color_hex(global_status_color), LV_PART_MAIN);
    lv_obj_set_style_bg_color(status_dots[i],
                              lv_color_hex(boosted ? COLOR_SETTINGS : global_status_color),
                              LV_PART_MAIN);
  }
  refresh_connection_indicators();
}

void set_status(
  const char *text,
  uint32_t color
) {
  const char *detail = text != NULL ? text : "SYSTEM READY";
  const uint8_t activity = classify_global_activity(detail, color);
  const char *activity_text = global_activity_text(activity);
  const bool transmitting = activity == GLOBAL_ACTIVITY_TRANSMITTING;
  const bool ready = activity == GLOBAL_ACTIVITY_READY;

  // A synchronous transmitter often reports its completed result immediately
  // after returning. Hold TRANSMITTING briefly so the user can actually see the
  // active state; a real error or another live operation still overrides it.
  if (transmitting) {
    transmitting_status_until_ms = millis() + 700;
  } else if (!ready) {
    transmitting_status_until_ms = 0;
  }
  const bool keep_transmitting = ready && transmitting_status_until_ms != 0 &&
                                 (int32_t)(millis() - transmitting_status_until_ms) < 0;
  const char *display_text = transmitting || keep_transmitting ?
                             "TRANSMITTING" : activity_text;
  const uint32_t display_color = transmitting || keep_transmitting ?
                                COLOR_SETTINGS :
                                global_activity_color(activity, color);

  if (strcmp(detail, global_status_detail_text) != 0 &&
      strcmp(detail, activity_text) != 0) {
    Serial.printf("Status detail: %s [%s]\n", detail, activity_text);
  }
  strlcpy(global_status_detail_text, detail, sizeof(global_status_detail_text));
  strlcpy(global_status_text, display_text, sizeof(global_status_text));
  global_status_color = display_color;
  render_global_status();
  if (transmitting && lv_disp_get_default() != NULL) {
    lv_refr_now(NULL);
  }
}


