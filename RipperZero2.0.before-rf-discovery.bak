// ============================================================
// KNOWN DEVICE SETUP
// ============================================================

void load_tv_steps() {

  current_device_name =
    "TV";


  current_steps[0] =
    "POWER";

  current_steps[1] =
    "VOLUME UP";

  current_steps[2] =
    "VOLUME DOWN";

  current_steps[3] =
    "CHANNEL UP";

  current_steps[4] =
    "CHANNEL DOWN";

  current_steps[5] =
    "MUTE";


  current_step_count =
    6;

  current_step_index =
    0;
}


void load_fan_steps() {

  current_device_name =
    "FAN";


  current_steps[0] =
    "POWER";

  current_steps[1] =
    "SPEED UP";

  current_steps[2] =
    "SPEED DOWN";

  current_steps[3] =
    "OSCILLATE";

  current_steps[4] =
    "LIGHT";


  current_step_count =
    5;

  current_step_index =
    0;
}


void load_light_steps() {

  current_device_name =
    "LIGHT";


  current_steps[0] =
    "POWER";

  current_steps[1] =
    "BRIGHTER";

  current_steps[2] =
    "DIMMER";

  current_steps[3] =
    "MODE";


  current_step_count =
    4;

  current_step_index =
    0;
}


void load_garage_steps() {

  current_device_name =
    "GARAGE / GATE";


  current_steps[0] =
    "OPEN";

  current_steps[1] =
    "CLOSE";

  current_steps[2] =
    "STOP";


  current_step_count =
    3;

  current_step_index =
    0;
}


// ============================================================
// UPDATE KNOWN CAPTURE SCREEN
// ============================================================

void update_known_capture_screen() {

  if (
    known_instruction_label == NULL ||
    known_progress_label == NULL
  ) {
    return;
  }


  if (
    current_step_index >=
    current_step_count
  ) {

    lv_label_set_text(
      known_instruction_label,
      "SETUP COMPLETE"
    );


    lv_label_set_text(
      known_progress_label,
      "Remote learning finished"
    );


    set_status(
      "SETUP COMPLETE",
      COLOR_GREEN
    );


    return;
  }


  char instruction[80];

  snprintf(
    instruction,
    sizeof(instruction),
    "Press %s on the\noriginal remote",
    current_steps[
      current_step_index
    ]
  );


  lv_label_set_text(
    known_instruction_label,
    instruction
  );


  char progress[40];

  snprintf(
    progress,
    sizeof(progress),
    "%d / %d",
    current_step_index + 1,
    current_step_count
  );


  lv_label_set_text(
    known_progress_label,
    progress
  );
}


// ============================================================
// CAPTURE KNOWN STEP
// ============================================================

void capture_known_step(
  lv_event_t *e
) {

  current_step_index++;


  set_status(
    "SIGNAL CAPTURED",
    COLOR_GREEN
  );


  update_known_capture_screen();
}


// ============================================================
// SKIP KNOWN STEP
// ============================================================

void skip_known_step(
  lv_event_t *e
) {

  current_step_index++;


  set_status(
    "SKIPPED",
    COLOR_MUTED
  );


  update_known_capture_screen();
}


