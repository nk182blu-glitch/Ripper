void refresh_rf_raw_details_screen() {
  if (rf_raw_details_label == NULL) return;
  uint32_t shortest = UINT32_MAX;
  uint32_t longest = 0;
  uint64_t total = 0;
  for (uint16_t i = 0; i < rf_raw_lab_timing_count; i++) {
    const uint32_t duration = rf_raw_lab_timings[i];
    shortest = min(shortest, duration);
    longest = max(longest, duration);
    total += duration;
  }
  if (shortest == UINT32_MAX) shortest = 0;
  char text[620];
  snprintf(text, sizeof(text),
           "SOURCE       %s\nFREQUENCY    %.3f MHz\nMODULATION   %s\nBIT RATE     %.3f kBaud\nDEVIATION    %.3f kHz\nBANDWIDTH    %lu kHz\nFIRST LEVEL  %s\n\nTIMINGS      %u edges\nRANGE        %lu - %lu us\nFRAME TOTAL  %llu us\nREPEAT       %u x / %lu ms gap\nEST. BIT     %lu us\n\nPEAK RSSI    %.1f dBm\nNOISE FLOOR  %.1f dBm\nCAPTURE      %u repeats / %u%% match",
           rf_raw_lab_has_capture ? "RECEIVED RF" : "MANUAL",
           rf_raw_lab_frequency_hz / 1000000.0f,
           rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK / ASK" : "2-FSK",
           rf_raw_lab_bit_rate_bps / 1000.0f,
           rf_raw_lab_deviation_hz / 1000.0f,
           (unsigned long)(rf_raw_lab_bandwidth_hz / 1000UL),
           rf_raw_lab_first_level ? "HIGH" : "LOW",
           rf_raw_lab_timing_count, (unsigned long)shortest,
           (unsigned long)longest, (unsigned long long)total,
           rf_raw_lab_repeat_count,
           (unsigned long)(rf_raw_lab_repeat_gap_us / 1000UL),
           (unsigned long)rf_raw_lab_estimated_bit_us,
           rf_raw_lab_capture_peak_rssi, rf_raw_lab_capture_noise_rssi,
           rf_raw_lab_capture_repeat_count, rf_raw_lab_capture_repeat_quality);
  lv_label_set_text(rf_raw_details_label, text);
}


bool load_rf_raw_lab_from_capture_buffer(bool adopt_active_profile) {
  if (rf_capture_active || rf_capture_edge_count < 2 ||
      rf_capture_edge_count > RF_CAPTURE_MAX_EDGES ||
      !reserve_rf_raw_lab_timings(rf_capture_edge_count)) return false;
  rf_raw_lab_timing_count = 0;
  for (uint16_t i = 0; i < rf_capture_edge_count; i++) {
    uint32_t duration = rf_capture_durations[i];
    const uint8_t level = rf_capture_levels[i] ? 1 : 0;
    if (duration < RF_CAPTURE_MIN_PULSE_US ||
        duration >= RF_RMT_IDLE_MARKER_US) continue;
    if (rf_raw_lab_timing_count == 0) {
      rf_raw_lab_first_level = level;
      rf_raw_lab_timings[rf_raw_lab_timing_count++] = duration;
      continue;
    }
    const uint8_t previous_level = rf_raw_lab_first_level ^
      ((rf_raw_lab_timing_count - 1U) & 1U);
    if (level == previous_level) {
      uint64_t merged = (uint64_t)rf_raw_lab_timings[rf_raw_lab_timing_count - 1] + duration;
      rf_raw_lab_timings[rf_raw_lab_timing_count - 1] =
        merged > RIPPER_RF_MAX_TIMING_US ? RIPPER_RF_MAX_TIMING_US : (uint32_t)merged;
    } else if (rf_raw_lab_timing_count < RF_CAPTURE_MAX_EDGES) {
      rf_raw_lab_timings[rf_raw_lab_timing_count++] = duration;
    }
  }
  if (rf_raw_lab_timing_count < 2) {
    rf_raw_lab_timing_count = 0;
    return false;
  }
  if (adopt_active_profile) {
    const uint8_t profile_index = safe_rf_profile_index();
    const RFProfilePreset &profile = RF_PROFILES[profile_index];
    const float captured_frequency = rf_scope_capture_frequency > 0.0f ?
      rf_scope_capture_frequency : profile.frequency;
    rf_raw_lab_frequency_hz = (uint32_t)lroundf(captured_frequency * 1000000.0f);
    rf_raw_lab_bit_rate_bps = (uint32_t)lroundf(profile.bit_rate * 1000.0f);
    rf_raw_lab_deviation_hz = (uint32_t)lroundf(profile.deviation * 1000.0f);
    rf_raw_lab_bandwidth_hz = (uint32_t)lroundf(profile.bandwidth * 1000.0f);
    rf_raw_lab_modulation = profile.ook ? RIPPER_RF_MODULATION_OOK :
                                         RIPPER_RF_MODULATION_FSK;
  }
  rf_raw_lab_has_capture = true;
  // The RMT buffer already contains the complete received burst, including
  // any repetitions emitted while the physical button was held. Replaying
  // that large burst eight more times made the UI appear frozen for seconds.
  // Start captured signals at one replay; Advanced settings can add repeats.
  rf_raw_lab_repeat_count = 1;
  rf_raw_lab_selected_timing = 0;
  rf_raw_lab_capture_peak_rssi = rf_capture_peak_rssi;
  rf_raw_lab_capture_noise_rssi = rf_capture_baseline_rssi;
  rf_raw_lab_capture_repeat_count = rf_capture_repeat_count;
  rf_raw_lab_capture_repeat_quality = rf_capture_repeat_quality;
  rf_raw_lab_estimated_bit_us = estimate_rf_bit_time(rf_capture_edge_count);
  refresh_rf_raw_lab_screen();
  refresh_rf_raw_settings_screen();
  refresh_rf_raw_timing_screen();
  refresh_rf_raw_details_screen();
  return true;
}


void finish_rf_raw_lab_capture() {
  if (rf_rmt_ready && rmtReceiveCompleted(CC1101_GDO0)) {
    rf_capture_edge_count = 0;
    for (size_t i = 0; i < rf_rmt_symbol_count &&
         rf_capture_edge_count + 1 < RF_CAPTURE_MAX_EDGES; i++) {
      if (rf_rmt_symbols[i].duration0 >= RF_CAPTURE_MIN_PULSE_US) {
        rf_capture_durations[rf_capture_edge_count] = rf_rmt_symbols[i].duration0;
        rf_capture_levels[rf_capture_edge_count++] = rf_rmt_symbols[i].level0;
      }
      if (rf_rmt_symbols[i].duration1 >= RF_CAPTURE_MIN_PULSE_US) {
        rf_capture_durations[rf_capture_edge_count] = rf_rmt_symbols[i].duration1;
        rf_capture_levels[rf_capture_edge_count++] = rf_rmt_symbols[i].level1;
      }
    }
  }
  const uint16_t edges = rf_capture_edge_count;
  // Raw Lab intentionally records the demodulated envelope directly. A valid
  // RMT edge train is sufficient even when the CC1101 carrier-sense/RSSI gate
  // misses a short or weak button press.
  const bool carrier_seen = rf_capture_carrier_seen || edges >= 2;
  stop_rf_capture();
  rf_raw_lab_capture_mode = false;
  rf_raw_lab_waiting_second_press = false;
  const bool loaded = carrier_seen && edges >= 2 &&
    load_rf_raw_lab_from_capture_buffer(false);
  refresh_rf_raw_lab_screen();
  set_status(loaded ? "RF SIGNAL LOADED" : "NO RF AT SELECTED FREQUENCY",
             loaded ? COLOR_GREEN : COLOR_RED);
  Serial.printf("Raw RF lab capture: %s, edges=%u, %.3f MHz %s, baseline=%.1f dBm peak=%.1f dBm\n",
                loaded ? "LOADED" : "FAILED", edges,
                rf_raw_lab_frequency_hz / 1000000.0f,
                rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK" : "FSK",
                rf_capture_baseline_rssi, rf_capture_peak_rssi);
}


void capture_rf_raw_lab(lv_event_t *e) {
  (void)e;
  if (rf_raw_auto_state != RF_RAW_AUTO_IDLE) {
    stop_rf_raw_auto_find(true);
    refresh_rf_raw_lab_screen();
    set_status("RF SEARCH CANCELLED", COLOR_MUTED);
    Serial.println("Raw RF auto-find cancelled");
    return;
  }
  if (rf_raw_lab_capture_mode && rf_capture_active) {
    stop_rf_capture();
    rf_raw_lab_capture_mode = false;
    rf_raw_lab_waiting_second_press = false;
    refresh_rf_raw_lab_screen();
    set_status("RF CAPTURE CANCELLED", COLOR_MUTED);
    Serial.println("Raw RF lab capture cancelled");
    return;
  }
  if (!cc1101_ready || rf_capture_active) {
    set_status("RF CAPTURE BUSY", COLOR_RED);
    return;
  }
  start_rf_raw_auto_find();
}


void capture_rf_raw_lab_manual(lv_event_t *e) {
  (void)e;
  if (!cc1101_ready || rf_capture_active ||
      rf_raw_auto_state != RF_RAW_AUTO_IDLE) {
    set_status("RF CAPTURE BUSY", COLOR_RED);
    return;
  }
  rf_raw_lab_waiting_second_press = false;
  rf_raw_manual_capture_pending = true;
  if (rf_raw_lab_screen == NULL) create_rf_raw_lab_screen();
  lv_scr_load(rf_raw_lab_screen);
  set_status("LISTENING", COLOR_RF);
}


void load_last_rf_capture_into_lab(lv_event_t *e) {
  (void)e;
  if (!load_rf_raw_lab_from_capture_buffer(true)) {
    set_status("NO RECEIVED SIGNAL AVAILABLE", COLOR_RED);
    return;
  }
  set_status("RF SIGNAL LOADED", COLOR_GREEN);
}


bool replay_rf_raw_lab() {
#if !CC1101_ACCESS_ENABLED
  return false;
#else
  if (!cc1101_ready || !rf_raw_lab_settings_valid()) return false;
  RipperRfButtonDiskV1 disk = {};
  make_rf_raw_lab_button_disk(disk, 1, 0, "RAW");
  if (!apply_repository_rf_radio(disk)) return false;
  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  if (cc1101.transmitDirectAsync() != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    return false;
  }
  for (uint8_t repeat = 0; repeat < rf_raw_lab_repeat_count; repeat++) {
    bool level = rf_raw_lab_first_level != 0;
    digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    for (uint16_t i = 0; i < rf_raw_lab_timing_count; i++) {
      delay_repository_rf_duration(rf_raw_lab_timings[i]);
      level = !level;
      digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    }
    digitalWrite(CC1101_GDO0, LOW);
    if (repeat + 1 < rf_raw_lab_repeat_count && rf_raw_lab_repeat_gap_us > 0)
      delay_repository_rf_duration(rf_raw_lab_repeat_gap_us);
  }
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  return true;
#endif
}


void transmit_rf_raw_lab(lv_event_t *e) {
  (void)e;
  if (!rf_raw_lab_settings_valid()) {
    set_status("RF RAW SETTINGS INVALID", COLOR_RED);
    return;
  }
  set_status("TRANSMITTING", COLOR_RF);
  // Replay is synchronous, so force the invalidated global header onto the
  // LCD before entering the timing loop. A normal timer pass can leave the
  // draw queued until after the complete waveform has already been sent.
  lv_refr_now(NULL);
  const uint32_t transmit_status_started_ms = millis();
  const bool sent = replay_rf_raw_lab();
  Serial.printf("Raw RF lab transmit: %s, %u timings, %.3f MHz %s, %u frame(s), %lu us gap\n",
                sent ? "OK" : "FAILED", rf_raw_lab_timing_count,
                rf_raw_lab_frequency_hz / 1000000.0f,
                rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK" : "FSK",
                rf_raw_lab_repeat_count,
                (unsigned long)rf_raw_lab_repeat_gap_us);
  const uint32_t transmit_status_elapsed_ms =
    millis() - transmit_status_started_ms;
  if (transmit_status_elapsed_ms < 300UL)
    delay(300UL - transmit_status_elapsed_ms);
  transmitting_status_until_ms = 0;
  set_status(sent ? "SYSTEM READY" : "RF SEND FAILED",
             sent ? COLOR_READY : COLOR_RED);
  lv_refr_now(NULL);
}


void adjust_rf_raw_frequency(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  int64_t next = (int64_t)rf_raw_lab_frequency_hz + delta;
  next = constrain(next, (int64_t)300000000, (int64_t)928000000);
  if (next > 348000000 && next < 387000000)
    next = delta >= 0 ? 387000000 : 348000000;
  if (next > 464000000 && next < 779000000)
    next = delta >= 0 ? 779000000 : 464000000;
  rf_raw_lab_frequency_hz = (uint32_t)next;
  refresh_rf_raw_settings_screen();
  refresh_rf_raw_lab_screen();
}


void toggle_rf_raw_modulation(lv_event_t *e) {
  (void)e;
  rf_raw_lab_modulation = rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ?
    RIPPER_RF_MODULATION_FSK : RIPPER_RF_MODULATION_OOK;
  refresh_rf_raw_settings_screen();
  refresh_rf_raw_lab_screen();
}


void adjust_rf_raw_bit_rate(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  rf_raw_lab_bit_rate_bps = constrain((int64_t)rf_raw_lab_bit_rate_bps + delta,
                                      (int64_t)100, (int64_t)500000);
