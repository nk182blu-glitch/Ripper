  refresh_rf_raw_timing_screen();
}


void adjust_rf_raw_timing(lv_event_t *e) {
  if (rf_raw_lab_timing_count == 0) return;
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  const int64_t next = constrain(
    (int64_t)rf_raw_lab_timings[rf_raw_lab_selected_timing] + delta,
    (int64_t)RF_CAPTURE_MIN_PULSE_US, (int64_t)RIPPER_RF_MAX_TIMING_US);
  rf_raw_lab_timings[rf_raw_lab_selected_timing] = (uint32_t)next;
  rf_raw_lab_has_capture = false;
  refresh_rf_raw_timing_screen();
  refresh_rf_raw_lab_screen();
}


void add_rf_raw_timing(lv_event_t *e) {
  (void)e;
  if (rf_raw_lab_timing_count >= RF_CAPTURE_MAX_EDGES ||
      !reserve_rf_raw_lab_timings(rf_raw_lab_timing_count + 1)) {
    set_status("RF RAW MEMORY FULL", COLOR_RED);
    return;
  }
  const uint16_t insert_at = rf_raw_lab_timing_count == 0 ? 0 :
    rf_raw_lab_selected_timing + 1;
  for (uint16_t i = rf_raw_lab_timing_count; i > insert_at; i--)
    rf_raw_lab_timings[i] = rf_raw_lab_timings[i - 1];
  rf_raw_lab_timings[insert_at] = 350;
  rf_raw_lab_timing_count++;
  rf_raw_lab_selected_timing = insert_at;
  rf_raw_lab_has_capture = false;
  refresh_rf_raw_timing_screen();
  refresh_rf_raw_lab_screen();
}


void delete_rf_raw_timing(lv_event_t *e) {
  (void)e;
  if (rf_raw_lab_timing_count == 0) return;
  for (uint16_t i = rf_raw_lab_selected_timing;
       i + 1 < rf_raw_lab_timing_count; i++)
    rf_raw_lab_timings[i] = rf_raw_lab_timings[i + 1];
  rf_raw_lab_timing_count--;
  if (rf_raw_lab_selected_timing >= rf_raw_lab_timing_count &&
      rf_raw_lab_selected_timing > 0) rf_raw_lab_selected_timing--;
  rf_raw_lab_has_capture = false;
  refresh_rf_raw_timing_screen();
  refresh_rf_raw_lab_screen();
}


bool save_rf_raw_as_new_remote(const char *remote_name, const char *button_name,
                               uint64_t &saved_id) {
  saved_id = 0;
  if (!sd_card_ready || !ripper_rf_repository_ready ||
      remote_name == NULL || remote_name[0] == '\0' ||
      button_name == NULL || button_name[0] == '\0' ||
      !rf_raw_lab_settings_valid() ||
      !ripper_rf_repository_ensure_directories()) return false;
  const uint32_t timing_bytes =
    (uint32_t)rf_raw_lab_timing_count * sizeof(uint32_t);
  const uint32_t payload_bytes = sizeof(RipperRfButtonDiskV1) + timing_bytes;
  if (!ripper_rf_repository_has_space(
        sizeof(RipperRfRemoteFileHeaderV1) + payload_bytes)) return false;
  RipperRfIndexEntryV1 collision = {};
  do {
    saved_id = ((uint64_t)esp_random() << 32) | esp_random();
  } while (saved_id == 0 || ripper_rf_repository_find(saved_id, collision));
  char temporary_path[112] = {};
  if (!ripper_rf_repository_make_staging_path(saved_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  RipperRfButtonDiskV1 disk = {};
  make_rf_raw_lab_button_disk(disk, 1, 0, button_name);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk,
                                    sizeof(disk));
  payload_crc = ripper_crc32_update(payload_crc,
                                    (const uint8_t *)rf_raw_lab_timings,
                                    timing_bytes);
  RipperRfRemoteFileHeaderV1 header = {};
  header.magic = RIPPER_RF_FILE_MAGIC;
  header.version = RIPPER_RF_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = saved_id;
  header.source_flags = RIPPER_RF_SOURCE_RIPPER_LEARNED;
  strlcpy(header.name, remote_name, sizeof(header.name));
  strlcpy(header.device_type, "CUSTOM RF", sizeof(header.device_type));
  header.button_count = 1;
  header.page_count = 1;
  header.payload_bytes = payload_bytes;
  header.payload_crc32 = ~payload_crc;
  header.header_crc32 = ripper_rf_header_crc(header);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!target) return false;
  bool wrote = target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header) &&
    target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
    target.write((const uint8_t *)rf_raw_lab_timings, timing_bytes) == timing_bytes;
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_rf_remote_file(temporary_path, saved_id) ||
      !ripper_rf_repository_commit_staged(temporary_path)) {
    if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
    saved_id = 0;
    return false;
  }
  return true;
}


bool append_rf_raw_to_remote(uint64_t remote_id, const char *button_name) {
  RipperRfIndexEntryV1 entry = {};
  if (!sd_card_ready || !ripper_rf_repository_ready || remote_id == 0 ||
      button_name == NULL || button_name[0] == '\0' ||
      !rf_raw_lab_settings_valid() ||
      !ripper_rf_repository_find(remote_id, entry) ||
      !validate_ripper_rf_remote_file(entry.file_path, remote_id) ||
      entry.button_count >= 4095) return false;
  const uint32_t timing_bytes =
    (uint32_t)rf_raw_lab_timing_count * sizeof(uint32_t);
  const uint32_t added_bytes = sizeof(RipperRfButtonDiskV1) + timing_bytes;
  File size_probe = SD_MMC.open(entry.file_path, FILE_READ);
  const uint64_t source_bytes = size_probe ? size_probe.size() : 0;
  if (size_probe) size_probe.close();
  if (source_bytes == 0 ||
      !ripper_rf_repository_has_space(source_bytes + added_bytes)) return false;
  char temporary_path[112] = {};
  if (!ripper_rf_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(entry.file_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    return false;
  }
  RipperRfRemoteFileHeaderV1 header = {};
  bool wrote = source.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  RipperRfRemoteFileHeaderV1 placeholder = {};
  wrote = wrote && target.write((const uint8_t *)&placeholder,
                                sizeof(placeholder)) == sizeof(placeholder);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  uint32_t copied_payload = 0;
  uint16_t maximum_button_id = 0;
  uint8_t buffer[256];
  for (uint16_t absolute = 0; wrote && absolute < header.button_count; absolute++) {
    RipperRfButtonDiskV1 disk = {};
    wrote = source.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
      target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    maximum_button_id = max(maximum_button_id, disk.button_id);
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk,
                                      sizeof(disk));
    copied_payload += sizeof(disk);
    uint64_t remaining64 = ripper_rf_button_timing_bytes(disk);
    if (remaining64 > UINT32_MAX) {
      wrote = false;
      break;
    }
    uint32_t remaining = (uint32_t)remaining64;
    while (wrote && remaining > 0) {
      const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
      wrote = source.read(buffer, chunk) == chunk &&
              target.write(buffer, chunk) == chunk;
      if (wrote) {
        payload_crc = ripper_crc32_update(payload_crc, buffer, chunk);
        copied_payload += chunk;
      }
      remaining -= chunk;
    }
  }
  source.close();
  const uint16_t new_page_wide = header.button_count / MAX_UNIVERSAL_BUTTONS;
  if (new_page_wide >= UINT8_MAX) wrote = false;
  const uint8_t new_page = (uint8_t)new_page_wide;
  RipperRfButtonDiskV1 added = {};
  make_rf_raw_lab_button_disk(added, maximum_button_id + 1, new_page, button_name);
  wrote = wrote && copied_payload == header.payload_bytes &&
    target.write((const uint8_t *)&added, sizeof(added)) == sizeof(added) &&
    target.write((const uint8_t *)rf_raw_lab_timings, timing_bytes) == timing_bytes;
  if (wrote) {
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&added,
                                      sizeof(added));
    payload_crc = ripper_crc32_update(payload_crc,
                                      (const uint8_t *)rf_raw_lab_timings,
                                      timing_bytes);
    header.source_flags |= RIPPER_RF_SOURCE_RIPPER_LEARNED;
    header.button_count++;
    if (header.page_count <= new_page) header.page_count = new_page + 1;
    header.payload_bytes += added_bytes;
    header.payload_crc32 = ~payload_crc;
    header.header_crc32 = ripper_rf_header_crc(header);
    wrote = target.seek(0) &&
      target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  }
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_rf_remote_file(temporary_path, remote_id) ||
      !ripper_rf_repository_commit_staged(temporary_path)) {
    if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
    return false;
  }
  return true;
}


void refresh_rf_raw_save_targets() {
  if (rf_raw_save_target_screen == NULL) return;
  const uint32_t logical_count = ripper_rf_repository_count + 1;
  const uint32_t page_count = max(1UL, (logical_count + 3) / 4);
  if (rf_raw_save_target_page >= page_count)
    rf_raw_save_target_page = page_count - 1;
  const uint32_t first = rf_raw_save_target_page * 4;
  for (uint8_t tile = 0; tile < 4; tile++) {
    rf_raw_save_target_ids[tile] = 0;
    const uint32_t logical = first + tile;
    if (logical >= logical_count) {
      lv_obj_add_flag(rf_raw_save_target_buttons[tile], LV_OBJ_FLAG_HIDDEN);
      continue;
    }
    lv_obj_clear_flag(rf_raw_save_target_buttons[tile], LV_OBJ_FLAG_HIDDEN);
    lv_obj_clear_state(rf_raw_save_target_buttons[tile], LV_STATE_DISABLED);
    if (logical == 0) {
      lv_label_set_text(rf_raw_save_target_labels[tile], "+  NEW CUSTOM REMOTE");
      continue;
    }
    RipperRfIndexEntryV1 entry = {};
    if (!ripper_rf_repository_read_metadata(logical - 1, entry)) {
      lv_label_set_text(rf_raw_save_target_labels[tile], "REMOTE UNAVAILABLE");
      lv_obj_add_state(rf_raw_save_target_buttons[tile], LV_STATE_DISABLED);
      continue;
    }
    rf_raw_save_target_ids[tile] = entry.remote_id;
    lv_label_set_text(rf_raw_save_target_labels[tile], entry.name);
  }
  lv_label_set_text_fmt(rf_raw_save_target_page_label, "PAGE %lu / %lu",
                        (unsigned long)(rf_raw_save_target_page + 1),
                        (unsigned long)page_count);
  if (rf_raw_save_target_page == 0)
    lv_obj_add_state(rf_raw_save_target_previous_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(rf_raw_save_target_previous_button, LV_STATE_DISABLED);
  if (rf_raw_save_target_page + 1 >= page_count)
    lv_obj_add_state(rf_raw_save_target_next_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(rf_raw_save_target_next_button, LV_STATE_DISABLED);
}


void begin_rf_raw_save_name(bool naming_remote) {
  if (rf_raw_save_name_screen == NULL) create_rf_raw_save_name_screen();
  rf_raw_save_naming_remote = naming_remote;
  lv_label_set_text(rf_raw_save_name_prompt,
                    naming_remote ? "NAME THE NEW REMOTE" : "NAME THIS BUTTON");
  lv_textarea_set_placeholder_text(rf_raw_save_name_textarea,
                                   naming_remote ? "Remote name" : "Button name");
  lv_textarea_set_max_length(rf_raw_save_name_textarea, naming_remote ? 47 : 31);
  lv_textarea_set_text(rf_raw_save_name_textarea, "");
  lv_obj_scroll_to_x(rf_raw_save_name_screen, 0, LV_ANIM_OFF);
  lv_obj_scroll_to_y(rf_raw_save_name_screen, 0, LV_ANIM_OFF);
  lv_scr_load(rf_raw_save_name_screen);
}


void select_rf_raw_save_target(lv_event_t *e) {
  const uint8_t tile = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (tile >= 4) return;
  rf_raw_save_target_remote_id = rf_raw_save_target_ids[tile];
  rf_raw_save_creating_remote = rf_raw_save_target_remote_id == 0;
  rf_raw_save_remote_name[0] = '\0';
  begin_rf_raw_save_name(rf_raw_save_creating_remote);
}


void rf_raw_save_previous_page(lv_event_t *e) {
  (void)e;
  if (rf_raw_save_target_page > 0) rf_raw_save_target_page--;
  refresh_rf_raw_save_targets();
}


void rf_raw_save_next_page(lv_event_t *e) {
  (void)e;
  const uint32_t page_count = max(1UL, (ripper_rf_repository_count + 4) / 4);
  if (rf_raw_save_target_page + 1 < page_count) rf_raw_save_target_page++;
  refresh_rf_raw_save_targets();
}


void cancel_rf_raw_save(lv_event_t *e) {
  (void)e;
  lv_scr_load(rf_raw_lab_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void commit_rf_raw_save_name(lv_event_t *e) {
  (void)e;
  const char *entered = lv_textarea_get_text(rf_raw_save_name_textarea);
  if (entered == NULL || entered[0] == '\0') {
    lv_label_set_text(rf_raw_save_name_prompt, "ENTER A NAME FIRST");
    return;
  }
  if (rf_raw_save_naming_remote) {
    strlcpy(rf_raw_save_remote_name, entered, sizeof(rf_raw_save_remote_name));
    begin_rf_raw_save_name(false);
    return;
  }
  char button_name[32] = {};
  strlcpy(button_name, entered, sizeof(button_name));
  uint64_t saved_id = rf_raw_save_target_remote_id;
  const bool saved = rf_raw_save_creating_remote ?
    save_rf_raw_as_new_remote(rf_raw_save_remote_name, button_name, saved_id) :
    append_rf_raw_to_remote(saved_id, button_name);
  if (!saved) {
    lv_label_set_text(rf_raw_save_name_prompt,
                      "SAVE FAILED - CHECK SD / SETTINGS");
    set_status("RF RAW SAVE FAILED", COLOR_RED);
    return;
  }
  Serial.printf("Raw RF saved: remote=%08lx%08lx button=%s timings=%u frequency=%lu modulation=%s repeat=%u gap=%lu\n",
                (unsigned long)(saved_id >> 32), (unsigned long)saved_id,
                button_name, rf_raw_lab_timing_count,
                (unsigned long)rf_raw_lab_frequency_hz,
                rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK" : "FSK",
                rf_raw_lab_repeat_count,
                (unsigned long)rf_raw_lab_repeat_gap_us);
  RipperRfIndexEntryV1 entry = {};
  uint32_t ordinal = 0;
  if (ripper_rf_repository_find(saved_id, entry, &ordinal) &&
      load_repository_rf_remote_adapter(saved_id)) {
    selected_rf_repository_id = saved_id;
    selected_rf_repository_ordinal = ordinal;
    selected_saved_index = find_legacy_rf_remote_by_id(saved_id);
    refresh_universal_remote();
    lv_scr_load(universal_remote_screen);
    set_status("RF BUTTON SAVED", COLOR_GREEN);
    return;
  }
  lv_scr_load(rf_raw_lab_screen);
  set_status("RF BUTTON SAVED", COLOR_GREEN);
}


void open_rf_raw_save_targets(lv_event_t *e) {
  (void)e;
  if (!rf_raw_lab_settings_valid()) {
    set_status("RF RAW SETTINGS INVALID", COLOR_RED);
    return;
  }
  if (!sd_card_ready || !ripper_rf_repository_ready) {
    set_status("SD STORAGE NOT READY", COLOR_RED);
    return;
  }
  if (rf_raw_save_target_screen == NULL) create_rf_raw_save_target_screen();
  rf_raw_save_target_page = 0;
  refresh_rf_raw_save_targets();
  lv_scr_load(rf_raw_save_target_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void open_rf_raw_lab(lv_event_t *e) {
  (void)e;
  stop_live_rf_scanner();
  if (rf_capture_active) {
    set_status("RF CAPTURE BUSY", COLOR_RED);
    return;
  }
  ensure_rf_raw_lab_starter();
  if (rf_raw_lab_screen == NULL) create_rf_raw_lab_screen();
  refresh_rf_raw_lab_screen();
  lv_scr_load(rf_raw_lab_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void close_rf_raw_lab(lv_event_t *e) {
  (void)e;
  if (rf_raw_lab_capture_mode && rf_capture_active) stop_rf_capture();
  if (rf_raw_auto_state != RF_RAW_AUTO_IDLE) stop_rf_raw_auto_find(true);
  rf_raw_lab_capture_mode = false;
  rf_raw_lab_waiting_second_press = false;
  rf_raw_manual_capture_pending = false;
  open_rf(e);
}


