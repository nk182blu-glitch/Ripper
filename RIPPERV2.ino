uint64_t calculate_legacy_rf_remote_id(uint8_t remote_index) {
  if (remote_index >= saved_remote_count) return 0;
  uint64_t hash = 1469598103934665603ULL;
  const SavedRemoteRecord &remote = saved_remotes[remote_index];
  hash = ripper_fnv1a64_update(hash, "RIPPER-NVS-RF", 13);
  hash = ripper_fnv1a64_update(hash, remote.name,
                               strnlen(remote.name, sizeof(remote.name)));
  hash = ripper_fnv1a64_update(hash, remote.category,
                               strnlen(remote.category, sizeof(remote.category)));
  hash = ripper_fnv1a64_update(hash, &remote.button_count, sizeof(remote.button_count));
  for (uint8_t button = 0;
       button < remote.button_count && button < MAX_UNIVERSAL_BUTTONS; button++) {
    const SavedRfRawCommand &command = saved_rf_raw_commands[remote_index][button];
    hash = ripper_fnv1a64_update(hash, remote.button_names[button],
                                 strnlen(remote.button_names[button],
                                         sizeof(remote.button_names[button])));
    hash = ripper_fnv1a64_update(hash, &command.valid, sizeof(command.valid));
    hash = ripper_fnv1a64_update(hash, &command.profile_index,
                                 sizeof(command.profile_index));
    hash = ripper_fnv1a64_update(hash, &command.first_level,
                                 sizeof(command.first_level));
    const uint16_t edge_count = command.edge_count <= RF_SAVED_RAW_MAX_EDGES ?
      command.edge_count : RF_SAVED_RAW_MAX_EDGES;
    hash = ripper_fnv1a64_update(hash, &edge_count, sizeof(edge_count));
    hash = ripper_fnv1a64_update(hash, command.durations_us,
                                 edge_count * sizeof(command.durations_us[0]));
  }
  if (saved_rf_layouts[remote_index].magic == SAVED_REMOTE_LAYOUT_MAGIC) {
    hash = ripper_fnv1a64_update(hash, saved_rf_layouts[remote_index].x,
                                 sizeof(saved_rf_layouts[remote_index].x));
    hash = ripper_fnv1a64_update(hash, saved_rf_layouts[remote_index].y,
                                 sizeof(saved_rf_layouts[remote_index].y));
  }
  return hash == 0 ? 1 : hash;
}


uint64_t generate_saved_rf_remote_id() {
  for (uint8_t attempt = 0; attempt < 16; attempt++) {
    const uint64_t candidate = ((uint64_t)esp_random() << 32) | esp_random();
    if (candidate == 0) continue;
    bool duplicate = false;
    for (uint8_t i = 0; i < saved_remote_count; i++) {
      if (saved_rf_remote_ids[i] == candidate) {
        duplicate = true;
        break;
      }
    }
    if (!duplicate) return candidate;
  }
  const uint64_t fallback = ((uint64_t)millis() << 32) ^ 0x5249505045525246ULL;
  return fallback == 0 ? 1 : fallback;
}


void load_saved_rf_remote_ids() {
  memset(saved_rf_remote_ids, 0, sizeof(saved_rf_remote_ids));
  memset(pending_rf_repository_delete_ids, 0,
         sizeof(pending_rf_repository_delete_ids));
  saved_preferences.begin("ripperzero", true);
  const size_t stored_id_bytes = saved_preferences.getBytesLength("rfRemoteIds");
  if (stored_id_bytes == sizeof(saved_rf_remote_ids)) {
    saved_preferences.getBytes("rfRemoteIds", saved_rf_remote_ids,
                               sizeof(saved_rf_remote_ids));
  }
  if (saved_preferences.getBytesLength("rfDeleteIds") ==
      sizeof(pending_rf_repository_delete_ids)) {
    saved_preferences.getBytes("rfDeleteIds", pending_rf_repository_delete_ids,
                               sizeof(pending_rf_repository_delete_ids));
  }
  saved_preferences.end();

  bool changed = stored_id_bytes != sizeof(saved_rf_remote_ids);
  for (uint8_t i = 0; i < saved_remote_count; i++) {
    if (saved_rf_remote_ids[i] == 0) {
      saved_rf_remote_ids[i] = calculate_legacy_rf_remote_id(i);
      if (saved_rf_remote_ids[i] == 0) saved_rf_remote_ids[i] = generate_saved_rf_remote_id();
      changed = true;
    }
  }
  for (uint8_t i = saved_remote_count; i < MAX_SAVED_REMOTES; i++) {
    if (saved_rf_remote_ids[i] != 0) {
      saved_rf_remote_ids[i] = 0;
      changed = true;
    }
  }
  if (changed) persist_saved_rf_remote_ids();
}


void queue_pending_rf_repository_delete(uint64_t remote_id) {
  if (remote_id == 0) return;
  for (uint8_t i = 0; i < MAX_SAVED_REMOTES; i++) {
    if (pending_rf_repository_delete_ids[i] == remote_id) return;
    if (pending_rf_repository_delete_ids[i] == 0) {
      pending_rf_repository_delete_ids[i] = remote_id;
      persist_pending_rf_repository_deletes();
      return;
    }
  }
  Serial.println("RF repository delete queue full; SD deletion deferred");
}


void persist_saved_rf_raw_command(uint8_t remote_index, uint8_t button_index) {
  if (remote_index >= MAX_SAVED_REMOTES || button_index >= MAX_UNIVERSAL_BUTTONS) return;
  char key[10];
  rf_command_storage_key(key, sizeof(key), remote_index, button_index);
  saved_preferences.begin("ripperzero", false);
  if (saved_rf_raw_commands[remote_index][button_index].valid) {
    saved_preferences.putBytes(key, &saved_rf_raw_commands[remote_index][button_index],
                               sizeof(SavedRfRawCommand));
  } else {
    saved_preferences.remove(key);
  }
  saved_preferences.end();
}


void clear_saved_rf_raw_commands(uint8_t remote_index) {
  if (remote_index >= MAX_SAVED_REMOTES) return;
  memset(saved_rf_raw_commands[remote_index], 0, sizeof(saved_rf_raw_commands[remote_index]));
  for (uint8_t button = 0; button < MAX_UNIVERSAL_BUTTONS; button++) {
    persist_saved_rf_raw_command(remote_index, button);
  }
}


void persist_saved_rf_raw_command_bank(uint8_t remote_index) {
  if (remote_index >= MAX_SAVED_REMOTES) return;
  for (uint8_t button = 0; button < MAX_UNIVERSAL_BUTTONS; button++) {
    persist_saved_rf_raw_command(remote_index, button);
  }
}


void refresh_saved_summary() {
  if (saved_summary_label == NULL) {
    return;
  }

  if (saved_remote_count == 0) {
    lv_label_set_text(saved_summary_label, "No saved remotes yet\n\nConfirmed signal transmit results\nwill appear here.");
    return;
  }

  if (selected_saved_index < 0 || selected_saved_index >= saved_remote_count) {
    selected_saved_index = 0;
  }
  char list_text[320] = "SAVED REMOTES\n";
  for (uint8_t i = 0; i < saved_remote_count; i++) {
    char line[40];
    snprintf(line, sizeof(line), "%c %d. %s\n", i == selected_saved_index ? '>' : ' ', i + 1, saved_remotes[i].name);
    strncat(list_text, line, sizeof(list_text) - strlen(list_text) - 1);
  }
  lv_label_set_text(saved_summary_label, list_text);
}


void load_saved_remotes() {
  saved_preferences.begin("ripperzero", true);
  saved_remote_count = saved_preferences.getUChar("remoteCount", 0);
  if (saved_remote_count > MAX_SAVED_REMOTES) {
    saved_remote_count = 0;
  }
  size_t expected = saved_remote_count * sizeof(SavedRemoteRecord);
  if (expected > 0 && saved_preferences.getBytesLength("remotes") == expected) {
    saved_preferences.getBytes("remotes", saved_remotes, expected);
  } else if (expected > 0) {
    saved_remote_count = 0;
  }
  saved_preferences.end();
}


void persist_saved_remotes() {
  saved_preferences.begin("ripperzero", false);
  saved_preferences.putUChar("remoteCount", saved_remote_count);
  saved_preferences.putBytes(
    "remotes",
    saved_remotes,
    saved_remote_count * sizeof(SavedRemoteRecord)
  );
  saved_preferences.end();
}


void delete_latest_saved_remote(lv_event_t *e) {
  if (saved_remote_count == 0) {
    set_status("NO SAVED REMOTES", COLOR_MUTED);
    return;
  }

  saved_remote_count--;
  queue_pending_rf_repository_delete(saved_rf_remote_ids[saved_remote_count]);
  saved_rf_remote_ids[saved_remote_count] = 0;
  memset(&saved_rf_layouts[saved_remote_count], 0, sizeof(SavedRemoteLayout));
  clear_saved_rf_raw_commands(saved_remote_count);
  discovery_anchor_index = -1;
  persist_saved_remotes();
  persist_saved_remote_layouts();
  persist_saved_rf_remote_ids();
  process_pending_rf_repository_deletes();
  refresh_saved_summary();
  set_status("LAST REMOTE DELETED", COLOR_SAVED);
}


void save_discovery_anchor() {
  if (discovery_anchor_index < 0) {
    if (saved_remote_count >= MAX_SAVED_REMOTES) {
      set_status("SAVED REMOTES FULL", COLOR_RED);
      return;
    }
    discovery_anchor_index = saved_remote_count++;
    saved_rf_remote_ids[discovery_anchor_index] = generate_saved_rf_remote_id();
  }

  SavedRemoteRecord &record = saved_remotes[discovery_anchor_index];
  record.magic = SAVED_REMOTE_MAGIC;
  snprintf(record.name, sizeof(record.name), "SIGNAL TRANSMIT %d", discovery_anchor_index + 1);
  strncpy(record.category, discovery_category, sizeof(record.category) - 1);
  record.category[sizeof(record.category) - 1] = '\0';
  record.candidate_index = discovery_candidate_index;
  record.has_anchor = true;
  record.button_count = 0;

  persist_saved_remotes();
  persist_saved_rf_remote_ids();
  refresh_saved_summary();
}


// ============================================================
// BOOST MODE BACKEND
// ============================================================

const char *boost_mode_state_name(BoostModeState state) {
  switch (state) {
    case BOOST_MODE_OFF: return "OFF";
    case BOOST_MODE_WAITING_FOR_POWER: return "WAITING_FOR_POWER";
    case BOOST_MODE_STARTING: return "STARTING";
    case BOOST_MODE_ACTIVE: return "ACTIVE";
    case BOOST_MODE_FAULT: return "FAULT";
    default: return "UNKNOWN";
  }
}

const char *boost_mode_fault_name(BoostModeFault fault) {
  switch (fault) {
    case BOOST_FAULT_NONE: return "NONE";
    case BOOST_FAULT_BACKEND_DISABLED: return "BACKEND_DISABLED";
    case BOOST_FAULT_CONTROL_PIN_UNSET: return "CONTROL_PIN_UNSET";
    case BOOST_FAULT_EXTERNAL_POWER_LOST: return "EXTERNAL_POWER_LOST";
    case BOOST_FAULT_E01_NOT_READY: return "E01_NOT_READY";
    default: return "UNKNOWN";
  }
}

bool boost_external_power_available() {
#if BOOST_REQUIRE_USB_POWER
  return battery_monitor_ready && battery_pmu.isVbusIn();
#else
  return true;
#endif
}

bool boost_hardware_configured() {
#if !BOOST_MODE_BACKEND_ENABLED
  return false;
#else
  return BOOST_POWER_CONTROL_PIN >= 0;
#endif
}

void boost_write_power(bool enabled) {
  if (BOOST_POWER_CONTROL_PIN < 0) return;
  digitalWrite(BOOST_POWER_CONTROL_PIN,
               enabled ? BOOST_POWER_ACTIVE_LEVEL : !BOOST_POWER_ACTIVE_LEVEL);
}

void boost_set_e01_power_level(bool boosted) {
#if E01_ACCESS_ENABLED
  if (!e01_ready) return;
  e01_radio.powerUp();
  e01_radio.setPALevel(boosted ? RF24_PA_MAX : RF24_PA_MIN);
  e01_radio.stopListening();
  e01_radio.powerDown();
#else
  (void)boosted;
#endif
}

void boost_enter_fault(BoostModeFault fault) {
  boost_write_power(false);
  boost_set_e01_power_level(false);
  boost_mode_state = BOOST_MODE_FAULT;
  boost_mode_fault = fault;
  render_global_status();
  Serial.printf("Boost Mode fault: %s\n", boost_mode_fault_name(fault));
}

void initialize_boost_mode() {
  boost_mode_requested = false;
  boost_mode_state = BOOST_MODE_OFF;
  boost_mode_fault = BOOST_FAULT_NONE;
  boost_mode_transition_ms = 0;

  if (BOOST_POWER_CONTROL_PIN >= 0) {
    pinMode(BOOST_POWER_CONTROL_PIN, OUTPUT);
    boost_write_power(false);
  }

  saved_preferences.begin("ripperzero", true);
  const bool saved_request = saved_preferences.getBool("boostMode", false);
  saved_preferences.end();

  // Never energize external hardware merely because it was enabled before a
  // reboot. The saved value is retained for the future UI, but every boot
  // requires a fresh, explicit enable action.
  Serial.printf("Boost Mode backend: %s; hardware=%s; saved=%s; boot=OFF\n",
                BOOST_MODE_BACKEND_ENABLED ? "READY" : "DISABLED",
                boost_hardware_configured() ? "CONFIGURED" : "UNCONFIGURED",
                saved_request ? "ON" : "OFF");
}

bool request_boost_mode(bool enabled, bool remember) {
  if (remember) {
    saved_preferences.begin("ripperzero", false);
    saved_preferences.putBool("boostMode", enabled);
    saved_preferences.end();
  }

  if (!enabled) {
    boost_mode_requested = false;
    boost_write_power(false);
    boost_set_e01_power_level(false);
    boost_mode_state = BOOST_MODE_OFF;
    boost_mode_fault = BOOST_FAULT_NONE;
    render_global_status();
    Serial.println("Boost Mode: OFF");
    return true;
  }

  boost_mode_requested = true;
#if !BOOST_MODE_BACKEND_ENABLED
  boost_enter_fault(BOOST_FAULT_BACKEND_DISABLED);
  return false;
#else
  if (!boost_hardware_configured()) {
    boost_enter_fault(BOOST_FAULT_CONTROL_PIN_UNSET);
    return false;
  }
  if (!boost_external_power_available()) {
    boost_mode_state = BOOST_MODE_WAITING_FOR_POWER;
    boost_mode_fault = BOOST_FAULT_NONE;
    Serial.println("Boost Mode: waiting for verified USB power");
    return false;
  }

  boost_write_power(true);
  boost_mode_transition_ms = millis();
  boost_mode_state = BOOST_MODE_STARTING;
  boost_mode_fault = BOOST_FAULT_NONE;
  Serial.println("Boost Mode: external power enabled; stabilizing");
  return true;
#endif
}

void service_boost_mode() {
  if (!boost_mode_requested) return;

  if (!boost_hardware_configured()) {
    if (boost_mode_state != BOOST_MODE_FAULT ||
        boost_mode_fault != BOOST_FAULT_CONTROL_PIN_UNSET) {
      boost_enter_fault(BOOST_FAULT_CONTROL_PIN_UNSET);
    }
    return;
  }

  if (!boost_external_power_available()) {
    if (boost_mode_state == BOOST_MODE_ACTIVE ||
        boost_mode_state == BOOST_MODE_STARTING) {
      boost_enter_fault(BOOST_FAULT_EXTERNAL_POWER_LOST);
    } else if (boost_mode_state != BOOST_MODE_FAULT) {
      boost_mode_state = BOOST_MODE_WAITING_FOR_POWER;
    }
    return;
  }

  if (boost_mode_state == BOOST_MODE_WAITING_FOR_POWER) {
    boost_write_power(true);
    boost_mode_transition_ms = millis();
    boost_mode_state = BOOST_MODE_STARTING;
    Serial.println("Boost Mode: USB power detected; stabilizing");
  }

  if (boost_mode_state == BOOST_MODE_STARTING &&
      (uint32_t)(millis() - boost_mode_transition_ms) >= BOOST_POWER_STABILIZE_MS) {
    boost_set_e01_power_level(true);
    boost_mode_state = BOOST_MODE_ACTIVE;
    render_global_status();
    Serial.println("Boost Mode: ACTIVE");
  }
}

bool boost_mode_is_active() {
  return boost_mode_state == BOOST_MODE_ACTIVE;
}

void format_boost_mode_status(char *buffer, size_t size) {
  if (buffer == NULL || size == 0) return;
  if (boost_mode_state == BOOST_MODE_FAULT) {
    snprintf(buffer, size, "%s: %s", boost_mode_state_name(boost_mode_state),
             boost_mode_fault_name(boost_mode_fault));
  } else {
    snprintf(buffer, size, "%s", boost_mode_state_name(boost_mode_state));
  }
}


