void service_wifi_custom_ssid_editor_layout() {
  if (wifi_custom_ssid_editor_screen == NULL ||
      lv_scr_act() != wifi_custom_ssid_editor_screen ||
      wifi_custom_ssid_textarea == NULL || wifi_custom_ssid_keyboard == NULL) {
    return;
  }

  // LVGL can run automatic focus scrolling after a textarea receives focus,
  // even when the screen was initially laid out at fixed coordinates. Keep
  // this editor pinned so the keyboard cannot be shifted below the viewport.
  lv_obj_clear_flag(wifi_custom_ssid_editor_screen, LV_OBJ_FLAG_SCROLLABLE);
  if (lv_obj_get_scroll_x(wifi_custom_ssid_editor_screen) != 0) {
    lv_obj_scroll_to_x(wifi_custom_ssid_editor_screen, 0, LV_ANIM_OFF);
  }
  if (lv_obj_get_scroll_y(wifi_custom_ssid_editor_screen) != 0) {
    lv_obj_scroll_to_y(wifi_custom_ssid_editor_screen, 0, LV_ANIM_OFF);
  }
  if (lv_obj_get_x(wifi_custom_ssid_textarea) != 14 ||
      lv_obj_get_y(wifi_custom_ssid_textarea) != 90) {
    lv_obj_set_pos(wifi_custom_ssid_textarea, 14, 90);
  }
  if (lv_obj_get_x(wifi_custom_ssid_keyboard) != 0 ||
      lv_obj_get_y(wifi_custom_ssid_keyboard) != 174 ||
      lv_obj_get_width(wifi_custom_ssid_keyboard) != 320 ||
      lv_obj_get_height(wifi_custom_ssid_keyboard) != 256) {
    lv_obj_align(wifi_custom_ssid_keyboard, LV_ALIGN_TOP_LEFT, 0, 174);
    lv_obj_set_size(wifi_custom_ssid_keyboard, 320, 256);
  }
}


