// ============================================================
// REFRESH UNIVERSAL REMOTE
// ============================================================

void refresh_universal_remote() {

  if (
    universal_remote_screen == NULL
  ) {
    return;
  }


  lv_obj_clean(
    universal_remote_screen
  );


  create_header(
    universal_remote_screen,
    "UNKNOWN REMOTE"
  );


  int y =
    105;


  for (
    int i = 0;
    i < universal_button_count;
    i++
  ) {

    create_button(
      universal_remote_screen,
      35,
      y,
      250,
      38,
      universal_button_names[i],
      COLOR_RF,
      NULL
    );


    y += 45;
  }


  if (
    universal_button_count <
    MAX_UNIVERSAL_BUTTONS
  ) {

    create_button(
      universal_remote_screen,
      55,
      y,
      210,
      45,
      "+ ADD BUTTON",
      COLOR_GREEN,
      add_universal_button
    );

  } else {

    create_button(
      universal_remote_screen,
      55,
      y,
      210,
      45,
      "REMOTE FULL",
      COLOR_RED,
      NULL
    );
  }


  create_button(
    universal_remote_screen,
    55,
    370,
    100,
    40,
    "RF MENU",
    COLOR_RF,
    open_rf
  );


  create_button(
    universal_remote_screen,
    165,
    370,
    100,
    40,
    "HOME",
    COLOR_RF,
    go_home
  );


  create_footer(
    universal_remote_screen
  );
}


