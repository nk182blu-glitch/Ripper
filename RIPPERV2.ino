void ripper_mobile_files() {
  if (!ripper_mobile_require_auth()) return;
  String json = "{\"ok\":true,\"files\":[";
  uint8_t emitted = 0;
  if (sd_card_ready && SD_MMC.exists(RIPPER_MOBILE_IMPORT_ROOT)) {
    File root = SD_MMC.open(RIPPER_MOBILE_IMPORT_ROOT);
    if (root) {
      File entry = root.openNextFile();
      while (entry && emitted < 40) {
        if (!entry.isDirectory()) {
          const char *listed_name = entry.name();
          const char *basename = strrchr(listed_name, '/');
          basename = basename == NULL ? listed_name : basename + 1;
          if (emitted++) json += ',';
          json += "{\"name\":\"" + wifi_json_escape(basename) +
                  "\",\"bytes\":" + String((unsigned long)entry.size()) + "}";
        }
        entry.close();
        entry = root.openNextFile();
      }
      root.close();
    }
  }
  json += "]}";
  wifi_web_server.send(200, "application/json", json);
}


void ripper_mobile_file_download() {
  if (!ripper_mobile_require_auth()) return;
  char filename[72];
  if (!ripper_mobile_safe_filename(wifi_web_server.arg("name"), filename,
                                   sizeof(filename))) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"INVALID FILE NAME\"}");
    return;
  }
  char path[112];
  snprintf(path, sizeof(path), "%s/%s", RIPPER_MOBILE_IMPORT_ROOT, filename);
  File file = SD_MMC.open(path, FILE_READ);
  if (!file || file.isDirectory()) {
    if (file) file.close();
    wifi_web_server.send(404, "application/json",
                         "{\"ok\":false,\"error\":\"FILE NOT FOUND\"}");
    return;
  }
  wifi_web_server.sendHeader("Content-Disposition",
                             "attachment; filename=\"" + String(filename) + "\"");
  wifi_web_server.streamFile(file, "application/octet-stream");
  file.close();
}


void ripper_mobile_upload_stream() {
  HTTPUpload &upload = wifi_web_server.upload();
  if (upload.status == UPLOAD_FILE_START) {
    ripper_mobile_upload_failed = !ripper_mobile_authorized() || !sd_card_ready;
    ripper_mobile_upload_bytes = 0;
    ripper_mobile_upload_temp_path[0] = '\0';
    ripper_mobile_upload_final_path[0] = '\0';
    char filename[72];
    if (!ripper_mobile_upload_failed &&
        ripper_mobile_safe_filename(upload.filename, filename, sizeof(filename))) {
      if (!SD_MMC.exists(RIPPER_IR_STORAGE_ROOT)) SD_MMC.mkdir(RIPPER_IR_STORAGE_ROOT);
      if (!SD_MMC.exists(RIPPER_MOBILE_IMPORT_ROOT)) SD_MMC.mkdir(RIPPER_MOBILE_IMPORT_ROOT);
      snprintf(ripper_mobile_upload_temp_path,
               sizeof(ripper_mobile_upload_temp_path), "%s/.%lu.part",
               RIPPER_MOBILE_IMPORT_ROOT, (unsigned long)millis());
      snprintf(ripper_mobile_upload_final_path,
               sizeof(ripper_mobile_upload_final_path), "%s/%lu_%s",
               RIPPER_MOBILE_IMPORT_ROOT, (unsigned long)millis(), filename);
      SD_MMC.remove(ripper_mobile_upload_temp_path);
      ripper_mobile_upload_file = SD_MMC.open(ripper_mobile_upload_temp_path, FILE_WRITE);
      if (!ripper_mobile_upload_file) ripper_mobile_upload_failed = true;
    } else {
      ripper_mobile_upload_failed = true;
    }
  } else if (upload.status == UPLOAD_FILE_WRITE) {
    if (!ripper_mobile_upload_failed && ripper_mobile_upload_file) {
      if (ripper_mobile_upload_bytes + upload.currentSize >
          RIPPER_MOBILE_MAX_UPLOAD_BYTES ||
          ripper_mobile_upload_file.write(upload.buf, upload.currentSize) !=
            upload.currentSize) {
        ripper_mobile_upload_failed = true;
      } else {
        ripper_mobile_upload_bytes += upload.currentSize;
      }
    }
  } else if (upload.status == UPLOAD_FILE_END) {
    if (ripper_mobile_upload_file) {
      ripper_mobile_upload_file.flush();
      ripper_mobile_upload_file.close();
    }
    if (!ripper_mobile_upload_failed && ripper_mobile_upload_bytes > 0 &&
        SD_MMC.rename(ripper_mobile_upload_temp_path,
                      ripper_mobile_upload_final_path)) {
      sd_card_used_bytes = SD_MMC.usedBytes();
    } else {
      ripper_mobile_upload_failed = true;
      if (ripper_mobile_upload_temp_path[0] != '\0')
        SD_MMC.remove(ripper_mobile_upload_temp_path);
    }
  } else if (upload.status == UPLOAD_FILE_ABORTED) {
    ripper_mobile_upload_failed = true;
    if (ripper_mobile_upload_file) ripper_mobile_upload_file.close();
    if (ripper_mobile_upload_temp_path[0] != '\0')
      SD_MMC.remove(ripper_mobile_upload_temp_path);
  }
}


void ripper_mobile_upload_complete() {
  if (!ripper_mobile_authorized()) {
    wifi_web_server.send(401, "application/json",
                         "{\"ok\":false,\"error\":\"PAIRING REQUIRED\"}");
  } else if (ripper_mobile_upload_failed) {
    wifi_web_server.send(422, "application/json",
                         "{\"ok\":false,\"error\":\"UPLOAD NOT COMMITTED\"}");
  } else {
    wifi_web_server.send(201, "application/json", "{\"ok\":true}");
  }
}


