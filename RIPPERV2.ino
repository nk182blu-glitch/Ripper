    RTC_DateTime now = rtc.getDateTime();
    if (now.getYear() >= 2020 && now.getYear() <= 2099 &&
        now.getMonth() >= 1 && now.getMonth() <= 12 &&
        now.getDay() >= 1 && now.getDay() <= 31) {
      clock_edit_year = now.getYear();
