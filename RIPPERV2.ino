String wifi_json_escape(const char *value) {
  String escaped;
  if (value == NULL) return escaped;
  for (const char *p = value; *p != '\0'; ++p) {
    if (*p == '"' || *p == '\\') escaped += '\\';
    if ((uint8_t)*p >= 0x20) escaped += *p;
  }
  return escaped;
}


