bool ripper_rf_file_version_supported(uint16_t version) {
  return version == RIPPER_RF_FILE_VERSION_V1 ||
         version == RIPPER_RF_FILE_VERSION;
}


uint32_t ripper_rf_button_timing_count(const RipperRfButtonDiskV1 &disk) {
  return disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS32 ?
    (uint32_t)disk.parsed_key : disk.raw_timing_count;
}


uint8_t ripper_rf_button_timing_width(const RipperRfButtonDiskV1 &disk) {
  return disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS32 ?
    sizeof(uint32_t) : sizeof(uint16_t);
}


uint64_t ripper_rf_button_timing_bytes(const RipperRfButtonDiskV1 &disk) {
  return (uint64_t)ripper_rf_button_timing_count(disk) *
         ripper_rf_button_timing_width(disk);
}

