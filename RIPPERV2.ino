  if (!universal_remote_loaded_from_save && universal_button_count < MAX_UNIVERSAL_BUTTONS) {

    create_button(
      remote_list,
      25,
      y,
      230,
      45,
      "ADD ANOTHER BUTTON",
      COLOR_GREEN,
      add_universal_button
    );

  } else if (!universal_remote_loaded_from_save) {

    create_button(
      remote_list,
      25,
      y,
      230,
      45,
      "REMOTE FULL",
      COLOR_RED,
      NULL
    );
  }


  if (universal_remote_loaded_from_save) {
    const int action_y = repository_pages ? 368 : 350;
    if (repository_pages) {
      lv_obj_t *page_label = lv_label_create(universal_remote_screen);
      lv_obj_set_width(page_label, 160);
      lv_label_set_text_fmt(page_label, "PAGE %u / %u  -  %u BUTTONS",
