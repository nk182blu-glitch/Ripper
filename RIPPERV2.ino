bool delete_repository_ir_button(uint16_t absolute_to_delete) {
  if (!ir_working_remote_from_repository || ir_working_repository_id == 0 ||
      ir_working_repository_total_buttons <= 1 ||
      absolute_to_delete >= ir_working_repository_total_buttons ||
      !validate_ripper_ir_remote_file(ir_working_repository_path,
                                      ir_working_repository_id)) return false;

  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(ir_working_repository_id,
                                               temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(ir_working_repository_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    return false;
  }

  RipperIrRemoteFileHeaderV1 header = {};
  bool wrote = source.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  RipperIrRemoteFileHeaderV1 placeholder = {};
  wrote = wrote && target.write((const uint8_t *)&placeholder, sizeof(placeholder)) ==
                   sizeof(placeholder);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  uint32_t payload_bytes = 0;
  uint16_t kept = 0;
  uint8_t buffer[256];
  for (uint16_t absolute = 0; wrote && absolute < header.button_count; absolute++) {
    RipperIrButtonDiskV1 disk = {};
    wrote = source.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    uint32_t remaining = (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    if (absolute == absolute_to_delete) {
      wrote = source.seek(source.position() + remaining);
      continue;
    }

    // Repack remaining commands into dense twelve-button pages so deleting
    // the last command on any page cannot leave an inaccessible empty page.
    disk.page = (uint8_t)(kept / MAX_IR_REMOTE_BUTTONS);
    wrote = target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (wrote) {
      payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk, sizeof(disk));
      payload_bytes += sizeof(disk);
    }
    while (wrote && remaining > 0) {
      const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
      wrote = source.read(buffer, chunk) == chunk && target.write(buffer, chunk) == chunk;
      if (wrote) {
        payload_crc = ripper_crc32_update(payload_crc, buffer, chunk);
        payload_bytes += chunk;
      }
      remaining -= chunk;
    }
    kept++;
  }
  source.close();

  if (wrote && kept + 1 == header.button_count && kept > 0) {
    header.button_count = kept;
    header.page_count = (uint8_t)((kept + MAX_IR_REMOTE_BUTTONS - 1) /
                                  MAX_IR_REMOTE_BUTTONS);
    header.payload_bytes = payload_bytes;
    header.payload_crc32 = ~payload_crc;
    header.header_crc32 = ripper_ir_header_crc(header);
    wrote = target.seek(0) &&
            target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  } else {
    wrote = false;
  }
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path,
                                                 ir_working_repository_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }

  const uint64_t remote_id = ir_working_repository_id;
  const uint8_t target_page = min(ir_working_repository_current_page,
                                  (uint8_t)(header.page_count - 1));
  if (!load_repository_ir_remote_adapter(remote_id) ||
      (target_page > 0 && !load_repository_ir_page(target_page))) return false;
  return true;
}


bool delete_legacy_ir_button(uint8_t button_index) {
  if (remote_layout_editing_remote_index >= saved_ir_remote_count) return false;
  SavedIrRemoteRecord &remote = saved_ir_remotes[remote_layout_editing_remote_index];
  if (remote.button_count <= 1 || button_index >= remote.button_count) return false;
  for (uint8_t i = button_index; i + 1 < remote.button_count; i++) {
    strlcpy(remote.button_names[i], remote.button_names[i + 1],
            sizeof(remote.button_names[i]));
    remote.buttons[i] = remote.buttons[i + 1];
    if (i + 1 < MAX_UNIVERSAL_BUTTONS) {
      saved_ir_layouts[remote_layout_editing_remote_index].x[i] =
        saved_ir_layouts[remote_layout_editing_remote_index].x[i + 1];
      saved_ir_layouts[remote_layout_editing_remote_index].y[i] =
        saved_ir_layouts[remote_layout_editing_remote_index].y[i + 1];
    }
  }
  remote.button_count--;
  memset(remote.button_names[remote.button_count], 0,
         sizeof(remote.button_names[remote.button_count]));
  memset(&remote.buttons[remote.button_count], 0, sizeof(remote.buttons[0]));
  ir_working_remote = remote;
  persist_saved_ir_remotes();
  persist_saved_remote_layouts();
  if (sd_card_ready && ripper_ir_repository_ready &&
      !write_legacy_ir_remote_to_sd(remote_layout_editing_remote_index)) {
    Serial.println("IR button deleted in NVS; SD synchronization pending");
  }
  return true;
}


void select_remote_layout_button(lv_event_t *e) {
  remote_layout_selected_button = (int8_t)(uintptr_t)lv_event_get_user_data(e);
  remote_layout_delete_armed = false;
  refresh_remote_layout_editor();
}


void move_remote_layout_button(int dx, int dy) {
  if (remote_layout_selected_button < 0 ||
      remote_layout_selected_button >= remote_layout_button_count()) {
    set_status("SELECT A BUTTON", COLOR_MUTED);
    return;
  }

  SavedRemoteLayout *layout = layout_for_saved_remote(
    remote_layout_editing_ir, remote_layout_editing_remote_index);
  const bool repository_layout = remote_layout_editing_ir &&
                                 ir_working_remote_from_repository;
  const bool rf_repository_layout = !remote_layout_editing_ir &&
                                    rf_working_remote_from_repository;
  if (layout == NULL && !repository_layout && !rf_repository_layout) return;
  remote_layout_delete_armed = false;

  uint8_t index = (uint8_t)remote_layout_selected_button;
  int x, y, w, h;
  uint8_t unknown_index = 0;
  for (uint8_t i = 0; i <= index; i++) {
    bool is_unknown = !get_virtual_remote_button_bounds(remote_layout_button_name(i), x, y, w, h);
    if (i == index) {
      get_saved_layout_button_bounds(remote_layout_editing_ir,
                                     remote_layout_editing_remote_index, i,
                                     remote_layout_button_name(i), unknown_index,
                                     x, y, w, h);
      break;
    }
    if (is_unknown) unknown_index++;
  }

  x += dx;
  y += dy;
  x = constrain(x, 5, 285 - w);
  y = constrain(y, 5, 220 - h);
  if (repository_layout) {
    ir_working_repository_x[index] = x;
    ir_working_repository_y[index] = y;
  } else if (rf_repository_layout) {
    rf_working_repository_x[index] = x;
    rf_working_repository_y[index] = y;
  } else {
    layout->magic = SAVED_REMOTE_LAYOUT_MAGIC;
    layout->x[index] = x;
    layout->y[index] = y;
  }
  refresh_remote_layout_editor();
  set_status("SYSTEM READY", COLOR_READY);
}


void move_remote_layout_left(lv_event_t *e)  { move_remote_layout_button(-10, 0); }
void move_remote_layout_right(lv_event_t *e) { move_remote_layout_button(10, 0); }
void move_remote_layout_up(lv_event_t *e)    { move_remote_layout_button(0, -10); }
void move_remote_layout_down(lv_event_t *e)  { move_remote_layout_button(0, 10); }


void delete_selected_ir_remote_button(lv_event_t *e) {
  (void)e;
  if (!remote_layout_editing_ir) {
    set_status("IR BUTTONS ONLY", COLOR_MUTED);
    return;
  }
  if (remote_layout_selected_button < 0 ||
      remote_layout_selected_button >= remote_layout_button_count()) {
    set_status("SELECT A BUTTON", COLOR_MUTED);
    return;
  }
  if (remote_layout_button_count() <= 1) {
    set_status("DELETE REMOTE TO REMOVE LAST BUTTON", COLOR_RED);
    return;
  }
  if (!remote_layout_delete_armed) {
    remote_layout_delete_armed = true;
    refresh_remote_layout_editor();
    set_status("TAP CONFIRM DELETE", COLOR_RED);
    return;
  }

  const uint8_t selected = (uint8_t)remote_layout_selected_button;
  const bool deleted = ir_working_remote_from_repository ?
    delete_repository_ir_button(ir_working_repository_absolute_indices[selected]) :
    delete_legacy_ir_button(selected);
  if (!deleted) {
    remote_layout_delete_armed = false;
    refresh_remote_layout_editor();
    set_status("BUTTON DELETE FAILED", COLOR_RED);
    return;
  }
  remote_layout_selected_button = -1;
  remote_layout_delete_armed = false;
  if (ir_working_remote_from_repository) {
    memcpy(ir_repository_layout_backup_x, ir_working_repository_x,
           sizeof(ir_repository_layout_backup_x));
    memcpy(ir_repository_layout_backup_y, ir_working_repository_y,
           sizeof(ir_repository_layout_backup_y));
  } else {
    remote_layout_before_edit = saved_ir_layouts[remote_layout_editing_remote_index];
  }
  refresh_remote_layout_editor();
  set_status("BUTTON DELETED", COLOR_GREEN);
  Serial.printf("IR remote button deleted; %u button(s) remain on current page\n",
                (unsigned)remote_layout_button_count());
}


void reset_remote_layout(lv_event_t *e) {
  remote_layout_delete_armed = false;
  if (remote_layout_editing_ir && ir_working_remote_from_repository) {
    for (uint8_t i = 0; i < ir_working_remote.button_count; i++) {
      ir_working_repository_x[i] = 7 + (i % 3) * 92;
      ir_working_repository_y[i] = 5 + (i / 3) * 54;
      ir_working_repository_width[i] = 84;
      ir_working_repository_height[i] = 44;
    }
    remote_layout_selected_button = -1;
    refresh_remote_layout_editor();
    return;
  }
  if (!remote_layout_editing_ir && rf_working_remote_from_repository) {
    for (uint8_t i = 0; i < universal_button_count; i++) {
      rf_working_repository_x[i] = 7 + (i % 3) * 92;
      rf_working_repository_y[i] = 5 + (i / 3) * 54;
    }
    remote_layout_selected_button = -1;
    refresh_remote_layout_editor();
    return;
  }
  SavedRemoteLayout *layout = layout_for_saved_remote(
    remote_layout_editing_ir, remote_layout_editing_remote_index);
  if (layout == NULL) return;
  memset(layout, 0, sizeof(SavedRemoteLayout));
  remote_layout_selected_button = -1;
  refresh_remote_layout_editor();
}


void return_to_edited_remote(lv_event_t *e) {
  if (remote_layout_editing_ir) {
    refresh_ir_remote_builder();
    lv_scr_load(ir_remote_builder_screen);
  } else {
    refresh_universal_remote();
    lv_scr_load(universal_remote_screen);
  }
  set_status("SYSTEM READY", COLOR_READY);
}


void cancel_remote_layout_editor(lv_event_t *e) {
  if (remote_layout_editing_ir && ir_working_remote_from_repository) {
    memcpy(ir_working_repository_x, ir_repository_layout_backup_x,
           sizeof(ir_repository_layout_backup_x));
    memcpy(ir_working_repository_y, ir_repository_layout_backup_y,
           sizeof(ir_repository_layout_backup_y));
    return_to_edited_remote(e);
    return;
  }
  if (!remote_layout_editing_ir && rf_working_remote_from_repository) {
    for (uint8_t i = 0; i < universal_button_count; i++) {
      rf_working_repository_x[i] = rf_repository_layout_backup_x[i];
      rf_working_repository_y[i] = rf_repository_layout_backup_y[i];
    }
    return_to_edited_remote(e);
    return;
  }
  SavedRemoteLayout *layout = layout_for_saved_remote(
    remote_layout_editing_ir, remote_layout_editing_remote_index);
  if (layout != NULL) *layout = remote_layout_before_edit;
  return_to_edited_remote(e);
}


void save_remote_layout_editor(lv_event_t *e) {
  if (remote_layout_editing_ir && ir_working_remote_from_repository) {
    if (!update_repository_ir_current_page_layout()) {
      set_status("SD LAYOUT SAVE FAILED", COLOR_RED);
      return;
    }
    Serial.printf("Saved repository IR layout page %u\n",
                  (unsigned)(ir_working_repository_current_page + 1));
    return_to_edited_remote(e);
    return;
  }
  if (!remote_layout_editing_ir && rf_working_remote_from_repository) {
    if (!update_repository_rf_current_page_layout()) {
      set_status("SD LAYOUT SAVE FAILED", COLOR_RED);
      return;
    }
    Serial.printf("Saved repository RF layout page %u\n",
                  (unsigned)(rf_working_repository_current_page + 1));
    return_to_edited_remote(e);
    return;
  }
  persist_saved_remote_layouts();
  bool repository_update_failed = false;
  if (remote_layout_editing_ir && remote_layout_editing_remote_index < saved_ir_remote_count) {
    repository_update_failed = !sd_card_ready || !ripper_ir_repository_ready ||
      !write_legacy_ir_remote_to_sd(remote_layout_editing_remote_index);
    if (repository_update_failed) {
      Serial.println("IR layout retained in NVS; SD repository update deferred");
    }
  } else if (!remote_layout_editing_ir &&
             remote_layout_editing_remote_index < saved_remote_count) {
    repository_update_failed = !sd_card_ready || !ripper_rf_repository_ready ||
      !write_legacy_rf_remote_to_sd(remote_layout_editing_remote_index);
    if (repository_update_failed) {
      ripper_rf_repository_runtime_authoritative = false;
      Serial.println("RF layout retained in NVS; SD repository update deferred");
    }
  }
  Serial.printf("Saved %s remote layout\n", remote_layout_editing_ir ? "IR" : "RF");
  return_to_edited_remote(e);
  if (repository_update_failed) set_status("SD LAYOUT PENDING", COLOR_MUTED);
}


