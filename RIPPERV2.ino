                            (unsigned)rf_working_repository_page_count,
                            (unsigned)rf_working_repository_total_buttons);
      lv_obj_set_style_text_color(page_label, lv_color_hex(COLOR_MUTED),
                                  LV_PART_MAIN);
      lv_obj_set_style_text_font(page_label, FONT_MONO_XS,
                                 LV_PART_MAIN);
      lv_obj_set_style_text_align(page_label, LV_TEXT_ALIGN_CENTER,
                                  LV_PART_MAIN);
      lv_obj_align(page_label, LV_ALIGN_TOP_MID, 0, 337);
      if (rf_working_repository_current_page > 0) {
        create_button(universal_remote_screen, 10, 330, 62, 30, "< PAGE",
                      COLOR_RF, previous_repository_rf_page);
      }
      if (rf_working_repository_current_page + 1 <
          rf_working_repository_page_count) {
        create_button(universal_remote_screen, 248, 330, 62, 30, "PAGE >",
                      COLOR_RF, next_repository_rf_page);
      }
    }
    create_button(universal_remote_screen, 10, action_y, 66, 36, "RF", COLOR_RF, open_rf);
    create_button(universal_remote_screen, 86, action_y, 66, 36, "MOVE", COLOR_RF,
                  open_rf_remote_layout_editor);
    create_button(universal_remote_screen, 162, action_y, 66, 36, "BACK", COLOR_SAVED, open_saved);
    create_button(universal_remote_screen, 238, action_y, 72, 36, "HOME", COLOR_RF, go_home);
  } else {
    create_button(universal_remote_screen, 15, 370, 88, 40, "RF MENU", COLOR_RF, open_rf);


    create_button(universal_remote_screen, 108, 370, 104, 40, "FINISH REMOTE", COLOR_GREEN,
                  save_universal_remote);
    create_button(universal_remote_screen, 224, 370, 81, 40, "HOME", COLOR_RF, go_home);
  }


  create_footer(
    universal_remote_screen
  );
}


