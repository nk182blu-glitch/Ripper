// ============================================================

#define GFX_BL 6

#define SPI_MISO 2
#define SPI_MOSI 1
#define SPI_SCLK 5

#define LCD_CS  -1
#define LCD_DC   3
#define LCD_RST -1

#define LCD_HOR_RES 320
#define LCD_VER_RES 480

#define I2C_SDA 8
#define I2C_SCL 7


// ============================================================
// COLORS
// ============================================================

#define COLOR_BG        0x05070A
#define COLOR_PANEL     0x0B1018
#define COLOR_PANEL2    0x101722
#define COLOR_TEXT      0xE8EEF5
#define COLOR_MUTED     0x8C98A8

#define COLOR_RF        0x00BFFF
#define COLOR_IR        0xFF3B30
#define COLOR_SAVED     0xA855F7
#define COLOR_SETTINGS  0xFF9500
#define COLOR_READY     0x55E85A

#define COLOR_GREEN     0x55E85A
#define COLOR_RED       0xFF3B30


// ============================================================
// HARDWARE OBJECTS
// ============================================================

TCA9554 TCA(0x20);

Arduino_DataBus *bus = new Arduino_ESP32SPI(
  LCD_DC,
  LCD_CS,
  SPI_SCLK,
  SPI_MOSI,
  SPI_MISO
);

Arduino_GFX *gfx = new Arduino_ST7796(
  bus,
  LCD_RST,
  0,
  true,
  LCD_HOR_RES,
  LCD_VER_RES
);

TouchDrvFT6X36 touch;


