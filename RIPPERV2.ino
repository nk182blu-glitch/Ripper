void process_pending_ir_repository_deletes() {
  if (!sd_card_ready || !ripper_ir_repository_ready) return;
  bool changed = false;
  for (uint8_t i = 0; i < MAX_IR_SAVED_REMOTES; i++) {
    const uint64_t remote_id = pending_ir_repository_delete_ids[i];
    if (remote_id == 0) continue;
    RipperIrIndexEntryV1 existing = {};
    if (!ripper_ir_repository_find(remote_id, existing) ||
        ripper_ir_repository_delete(remote_id)) {
      pending_ir_repository_delete_ids[i] = 0;
      changed = true;
    }
  }
  if (changed) persist_pending_ir_repository_deletes();
}


void rf_command_storage_key(char *key, size_t key_size, uint8_t remote_index, uint8_t button_index) {
