    if (i == (uint8_t)remote_layout_selected_button) {
      lv_obj_set_style_border_color(button, lv_color_hex(COLOR_GREEN), LV_PART_MAIN);
      lv_obj_set_style_border_width(button, 3, LV_PART_MAIN);
