uint32_t ripper_crc32_update(uint32_t crc, const uint8_t *data, size_t length) {
  while (length-- > 0) {
    crc ^= *data++;
    for (uint8_t bit = 0; bit < 8; bit++) {
      crc = (crc >> 1) ^ (0xEDB88320UL & (uint32_t)-(int32_t)(crc & 1));
    }
  }
  return crc;
}


uint32_t ripper_ir_header_crc(RipperIrRemoteFileHeaderV1 header) {
  header.header_crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&header, sizeof(header));
}


uint32_t ripper_ir_index_header_crc(RipperIrIndexHeaderV1 header) {
  header.header_crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&header, sizeof(header));
}


uint64_t ripper_fnv1a64_update(uint64_t hash, const void *data, size_t length) {
  const uint8_t *bytes = (const uint8_t *)data;
  while (length-- > 0) {
    hash ^= *bytes++;
    hash *= 1099511628211ULL;
  }
  return hash;
}


uint64_t calculate_legacy_ir_remote_id(uint8_t remote_index) {
  uint64_t hash = 1469598103934665603ULL;
  const SavedIrRemoteRecord &remote = saved_ir_remotes[remote_index];
  hash = ripper_fnv1a64_update(hash, "RIPPER-NVS-IR", 13);
  hash = ripper_fnv1a64_update(hash, &remote_index, sizeof(remote_index));
  hash = ripper_fnv1a64_update(hash, remote.name, strnlen(remote.name, sizeof(remote.name)));
  hash = ripper_fnv1a64_update(hash, &remote.button_count, sizeof(remote.button_count));
  for (uint8_t button = 0; button < remote.button_count && button < MAX_IR_REMOTE_BUTTONS; button++) {
    const SavedIrRemoteCommand &command = remote.buttons[button];
    hash = ripper_fnv1a64_update(hash, remote.button_names[button],
                                 strnlen(remote.button_names[button], sizeof(remote.button_names[button])));
    // Hash persisted values individually so compiler padding can never change
    // a migrated remote's stable filename between firmware builds.
    hash = ripper_fnv1a64_update(hash, &command.protocol, sizeof(command.protocol));
    hash = ripper_fnv1a64_update(hash, &command.address, sizeof(command.address));
    hash = ripper_fnv1a64_update(hash, &command.command, sizeof(command.command));
    hash = ripper_fnv1a64_update(hash, &command.extra, sizeof(command.extra));
    hash = ripper_fnv1a64_update(hash, &command.raw_data, sizeof(command.raw_data));
    hash = ripper_fnv1a64_update(hash, &command.bits, sizeof(command.bits));
    hash = ripper_fnv1a64_update(hash, &command.flags, sizeof(command.flags));
  }
  if (saved_ir_layouts[remote_index].magic == SAVED_REMOTE_LAYOUT_MAGIC) {
    const SavedRemoteLayout &layout = saved_ir_layouts[remote_index];
    hash = ripper_fnv1a64_update(hash, &layout.magic, sizeof(layout.magic));
    hash = ripper_fnv1a64_update(hash, layout.x, sizeof(layout.x));
    hash = ripper_fnv1a64_update(hash, layout.y, sizeof(layout.y));
  }
  return hash;
}


uint64_t legacy_ir_remote_id(uint8_t remote_index) {
  if (remote_index < MAX_IR_SAVED_REMOTES && saved_ir_remote_ids[remote_index] != 0) {
    return saved_ir_remote_ids[remote_index];
  }
  return calculate_legacy_ir_remote_id(remote_index);
}


