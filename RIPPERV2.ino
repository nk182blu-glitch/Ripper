void cancel_ir_button_learn(lv_event_t *e) {
  ir_receiver_test_active = false;
  ir_power_learn_active = false;
  ir_remote_learn_active = false;
  if (ir_guided_copy_active) {
    refresh_ir_guided_copy_screen();
    lv_scr_load(ir_guided_copy_screen);
  } else {
    refresh_ir_remote_builder();
    lv_scr_load(ir_remote_builder_screen);
  }
  set_status("SYSTEM READY", COLOR_READY);
}


void save_ir_working_remote(lv_event_t *e) {
  if (ir_working_remote.button_count == 0) {
    set_status("LEARN A BUTTON FIRST", COLOR_RED);
    return;
  }
  if (sd_card_ready && ripper_ir_repository_ready) {
    uint64_t remote_id = generate_saved_ir_remote_id();
    RipperIrIndexEntryV1 collision = {};
    while (remote_id != 0 && ripper_ir_repository_find(remote_id, collision)) {
      remote_id = generate_saved_ir_remote_id();
    }
    if (remote_id == 0 || !write_working_ir_remote_to_sd(remote_id)) {
      set_status("SD SAVE FAILED", COLOR_RED);
      Serial.println("IR remote SD save failed; working copy retained");
      return;
    }
    RipperIrIndexEntryV1 saved_entry = {};
    uint32_t saved_ordinal = 0;
    if (!ripper_ir_repository_find(remote_id, saved_entry, &saved_ordinal)) {
      set_status("SD INDEX FAILED", COLOR_RED);
      return;
    }
    selected_ir_repository_ordinal = saved_ordinal;
    selected_ir_repository_id = remote_id;
    ir_guided_copy_active = false;
    refresh_ir_saved_summary();
    open_saved(e);
    set_status("REMOTE SAVED", COLOR_GREEN);
    Serial.printf("IR remote saved to SD: %s (%08lx%08lx)\n", ir_working_remote.name,
                  (unsigned long)(remote_id >> 32), (unsigned long)remote_id);
    return;
  }
  if (saved_ir_remote_count >= MAX_IR_SAVED_REMOTES) {
    set_status("SD REQUIRED TO SAVE", COLOR_RED);
    return;
  }
  uint8_t saved_index = saved_ir_remote_count;
  saved_ir_remotes[saved_ir_remote_count++] = ir_working_remote;
  memset(&saved_ir_layouts[saved_index], 0, sizeof(SavedRemoteLayout));
  saved_ir_remote_ids[saved_index] = generate_saved_ir_remote_id();
  selected_ir_saved_index = saved_ir_remote_count - 1;
  persist_saved_ir_remotes();
  persist_saved_remote_layouts();
  persist_saved_ir_remote_ids();
  const bool repository_saved = sd_card_ready && ripper_ir_repository_ready &&
    write_legacy_ir_remote_to_sd(saved_index);
  if (!repository_saved) {
    Serial.println("IR remote saved to NVS; SD repository update deferred");
  }
  refresh_ir_saved_summary();
  open_saved(e);
  if (!repository_saved) set_status("SD SAVE PENDING", COLOR_MUTED);
  Serial.printf("IR remote saved: %s\n", ir_working_remote.name);
}


