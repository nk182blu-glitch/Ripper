void open_saved_hub_tile(lv_event_t *e) {
  // LVGL emits CLICKED when a long press is released too. Consume that one
  // click so the delete confirmation remains on screen.
  if (saved_hub_ignore_release_click) {
    saved_hub_ignore_release_click = false;
    return;
  }
  uint8_t tile_index = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (tile_index >= SAVED_HUB_PAGE_SIZE) return;
  if (saved_hub_tile_kind[tile_index] == 3) {
    open_hunter_tx45_remote(e);
    return;
  }
  if (saved_hub_tile_kind[tile_index] == 1) {
    selected_saved_index = saved_hub_tile_record_index[tile_index];
    open_latest_saved_remote(e);
    return;
  }
  if (saved_hub_tile_kind[tile_index] == 5) {
    const uint64_t remote_id = saved_hub_tile_repository_id[tile_index];
    RipperRfIndexEntryV1 entry = {};
    uint32_t ordinal = 0;
    if (!ripper_rf_repository_find(remote_id, entry, &ordinal) ||
        !load_repository_rf_remote_adapter(remote_id)) {
      const int8_t recovery_index = find_legacy_rf_remote_by_id(remote_id);
      if (recovery_index >= 0) {
        selected_saved_index = recovery_index;
        open_latest_saved_remote(e);
        return;
      }
      set_status("SD READ FAILED", COLOR_RED);
      return;
    }
    selected_rf_repository_id = remote_id;
    selected_rf_repository_ordinal = ordinal;
    selected_saved_index = find_legacy_rf_remote_by_id(remote_id);
    refresh_universal_remote();
    lv_scr_load(universal_remote_screen);
    set_status("SYSTEM READY", COLOR_READY);
    return;
  }
  if (saved_hub_tile_kind[tile_index] == 2) {
    uint64_t remote_id = saved_hub_tile_repository_id[tile_index];
    RipperIrIndexEntryV1 entry = {};
    uint32_t ordinal = 0;
    if (!ripper_ir_repository_find(remote_id, entry, &ordinal) ||
        !load_repository_ir_remote_adapter(remote_id)) {
      set_status("SD READ FAILED", COLOR_RED);
      return;
    }
    selected_ir_repository_id = remote_id;
    selected_ir_repository_ordinal = ordinal;
    selected_ir_saved_index = -1;
    for (uint8_t i = 0; i < saved_ir_remote_count; i++) {
      if (saved_ir_remote_ids[i] == remote_id) {
        selected_ir_saved_index = i;
        break;
      }
    }
    ensure_ir_remote_builder_screen();
    refresh_ir_remote_builder();
    lv_scr_load(ir_remote_builder_screen);
    set_status("SYSTEM READY", COLOR_READY);
    return;
  }
  if (saved_hub_tile_kind[tile_index] == 4) {
    selected_ir_saved_index = saved_hub_tile_record_index[tile_index];
    open_selected_ir_remote(e);
  }
}


void request_saved_hub_delete(lv_event_t *e) {
  uint8_t tile_index = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (tile_index >= SAVED_HUB_PAGE_SIZE) return;
  if (saved_hub_tile_kind[tile_index] == 3) {
    saved_hub_ignore_release_click = true;
    set_status("BUILT-IN REMOTE CANNOT BE DELETED", COLOR_MUTED);
    return;
  }
  char remote_name[48] = {};

  saved_delete_pending_repository_ir = false;
  saved_delete_pending_repository_rf = false;
  saved_delete_pending_repository_id = 0;
  if (saved_hub_tile_kind[tile_index] == 1) {
    saved_delete_pending_is_ir = false;
    saved_delete_pending_index = saved_hub_tile_record_index[tile_index];
    if (saved_delete_pending_index >= saved_remote_count) return;
    strlcpy(remote_name, saved_remotes[saved_delete_pending_index].name,
            sizeof(remote_name));
  } else if (saved_hub_tile_kind[tile_index] == 2) {
    saved_delete_pending_is_ir = true;
    saved_delete_pending_repository_ir = true;
    saved_delete_pending_repository_id = saved_hub_tile_repository_id[tile_index];
    RipperIrIndexEntryV1 entry = {};
    if (!ripper_ir_repository_find(saved_delete_pending_repository_id, entry)) return;
    strlcpy(remote_name, entry.name, sizeof(remote_name));
  } else if (saved_hub_tile_kind[tile_index] == 5) {
    saved_delete_pending_is_ir = false;
    saved_delete_pending_repository_rf = true;
    saved_delete_pending_repository_id =
      saved_hub_tile_repository_id[tile_index];
    RipperRfIndexEntryV1 entry = {};
    if (!ripper_rf_repository_find(saved_delete_pending_repository_id, entry))
      return;
    strlcpy(remote_name, entry.name, sizeof(remote_name));
  } else if (saved_hub_tile_kind[tile_index] == 4) {
    saved_delete_pending_is_ir = true;
    saved_delete_pending_index = saved_hub_tile_record_index[tile_index];
    if (saved_delete_pending_index >= saved_ir_remote_count) return;
    strlcpy(remote_name, saved_ir_remotes[saved_delete_pending_index].name,
            sizeof(remote_name));
  } else return;

  if (saved_delete_confirm_screen == NULL) create_saved_delete_confirm_screen();
  saved_hub_ignore_release_click = true;
  lv_label_set_text_fmt(saved_delete_confirm_label,
                        "%s REMOTE\n\n%s\n\nRename it or delete it?",
                        saved_delete_pending_is_ir ? "IR" : "RF", remote_name);
  lv_scr_load(saved_delete_confirm_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void confirm_saved_hub_delete(lv_event_t *e) {
  saved_hub_ignore_release_click = false;
  bool ir_repository_delete_pending = false;
  if (saved_delete_pending_repository_rf) {
    if (saved_delete_pending_repository_id == 0 ||
        !ripper_rf_repository_delete(saved_delete_pending_repository_id)) {
      set_status("SD DELETE FAILED", COLOR_RED);
      return;
    }
    Serial.printf("Saved SD RF remote deleted: %08lx%08lx\n",
                  (unsigned long)(saved_delete_pending_repository_id >> 32),
                  (unsigned long)saved_delete_pending_repository_id);
    if (selected_rf_repository_id == saved_delete_pending_repository_id) {
      selected_rf_repository_id = 0;
      clear_repository_rf_remote_adapter();
    }
    saved_delete_pending_repository_rf = false;
    saved_delete_pending_repository_id = 0;
  } else if (saved_delete_pending_repository_ir) {
    if (saved_delete_pending_repository_id == 0 ||
        !ripper_ir_repository_delete(saved_delete_pending_repository_id)) {
      set_status("SD DELETE FAILED", COLOR_RED);
      return;
    }
    Serial.printf("Saved SD IR remote deleted: %08lx%08lx\n",
                  (unsigned long)(saved_delete_pending_repository_id >> 32),
                  (unsigned long)saved_delete_pending_repository_id);
    saved_delete_pending_repository_ir = false;
    saved_delete_pending_repository_id = 0;
    selected_ir_repository_id = 0;
    clear_repository_ir_remote_adapter();
  } else if (saved_delete_pending_is_ir) {
    if (saved_delete_pending_index >= saved_ir_remote_count) {
      open_saved(e);
      return;
    }
    queue_pending_ir_repository_delete(saved_ir_remote_ids[saved_delete_pending_index]);
    for (uint8_t i = saved_delete_pending_index; i + 1 < saved_ir_remote_count; i++) {
      saved_ir_remotes[i] = saved_ir_remotes[i + 1];
      saved_ir_layouts[i] = saved_ir_layouts[i + 1];
      saved_ir_remote_ids[i] = saved_ir_remote_ids[i + 1];
    }
    saved_ir_remote_count--;
    memset(&saved_ir_layouts[saved_ir_remote_count], 0, sizeof(SavedRemoteLayout));
    saved_ir_remote_ids[saved_ir_remote_count] = 0;
    if (saved_ir_remote_count == 0) {
      selected_ir_saved_index = -1;
    } else if (selected_ir_saved_index < 0 || selected_ir_saved_index >= saved_ir_remote_count) {
      selected_ir_saved_index = 0;
    }
    persist_saved_ir_remotes();
    persist_saved_remote_layouts();
    persist_saved_ir_remote_ids();
    process_pending_ir_repository_deletes();
    for (uint8_t i = 0; i < MAX_IR_SAVED_REMOTES; i++) {
      if (pending_ir_repository_delete_ids[i] != 0) {
        ir_repository_delete_pending = true;
        break;
      }
    }
    refresh_ir_saved_summary();
    Serial.println("Saved IR remote deleted");
  } else {
    if (saved_delete_pending_index >= saved_remote_count) {
      open_saved(e);
      return;
    }
    queue_pending_rf_repository_delete(
      saved_rf_remote_ids[saved_delete_pending_index]);
    for (uint8_t i = saved_delete_pending_index; i + 1 < saved_remote_count; i++) {
      saved_remotes[i] = saved_remotes[i + 1];
      saved_rf_layouts[i] = saved_rf_layouts[i + 1];
      saved_rf_remote_ids[i] = saved_rf_remote_ids[i + 1];
      memcpy(saved_rf_raw_commands[i], saved_rf_raw_commands[i + 1],
             sizeof(saved_rf_raw_commands[i]));
      persist_saved_rf_raw_command_bank(i);
    }
    saved_remote_count--;
    memset(&saved_rf_layouts[saved_remote_count], 0, sizeof(SavedRemoteLayout));
    saved_rf_remote_ids[saved_remote_count] = 0;
    clear_saved_rf_raw_commands(saved_remote_count);
    if (saved_remote_count == 0) {
      selected_saved_index = -1;
    } else if (selected_saved_index < 0 || selected_saved_index >= saved_remote_count) {
      selected_saved_index = 0;
    }
    discovery_anchor_index = -1;
    persist_saved_remotes();
    persist_saved_remote_layouts();
    persist_saved_rf_remote_ids();
    process_pending_rf_repository_deletes();
    refresh_saved_summary();
    Serial.println("Saved RF remote deleted");
  }

  refresh_saved_hub();
  lv_scr_load(saved_hub_screen);
  set_status(ir_repository_delete_pending ? "SD DELETE PENDING" : "SYSTEM READY",
             ir_repository_delete_pending ? COLOR_MUTED : COLOR_READY);
}


void cancel_saved_hub_delete(lv_event_t *e) {
  saved_hub_ignore_release_click = false;
  open_saved(e);
}

void begin_saved_remote_rename(lv_event_t *e) {
  if (saved_delete_pending_repository_rf) {
    RipperRfIndexEntryV1 entry = {};
    if (!ripper_rf_repository_find(saved_delete_pending_repository_id, entry)) {
      saved_hub_ignore_release_click = false;
      open_saved(e);
      set_status("REMOTE NO LONGER AVAILABLE", COLOR_MUTED);
      return;
    }
    if (saved_rename_screen == NULL) create_saved_rename_screen();
    lv_textarea_set_text(saved_rename_textarea, entry.name);
    lv_scr_load(saved_rename_screen);
    return;
  }
  if (saved_delete_pending_repository_ir) {
    RipperIrIndexEntryV1 entry = {};
    if (!ripper_ir_repository_find(saved_delete_pending_repository_id, entry)) {
      saved_hub_ignore_release_click = false;
      open_saved(e);
      set_status("REMOTE NO LONGER AVAILABLE", COLOR_MUTED);
      return;
    }
    if (saved_rename_screen == NULL) create_saved_rename_screen();
    lv_textarea_set_text(saved_rename_textarea, entry.name);
    lv_scr_load(saved_rename_screen);
    return;
  }
  if (saved_rename_screen == NULL) create_saved_rename_screen();
  if ((saved_delete_pending_is_ir &&
       saved_delete_pending_index >= saved_ir_remote_count) ||
      (!saved_delete_pending_is_ir &&
       saved_delete_pending_index >= saved_remote_count)) {
    saved_hub_ignore_release_click = false;
    open_saved(e);
    set_status("REMOTE NO LONGER AVAILABLE", COLOR_MUTED);
    return;
  }
  const char *name = saved_delete_pending_is_ir ?
    saved_ir_remotes[saved_delete_pending_index].name :
    saved_remotes[saved_delete_pending_index].name;
  lv_textarea_set_text(saved_rename_textarea, name);
  lv_scr_load(saved_rename_screen);
}

void commit_saved_remote_rename(lv_event_t *e) {
  const char *name = lv_textarea_get_text(saved_rename_textarea);
  if (name == NULL || name[0] == '\0') {
    set_status("ENTER A REMOTE NAME", COLOR_RED);
    return;
  }
  bool repository_update_failed = false;
  if (saved_delete_pending_repository_rf) {
    if (!rename_repository_rf_remote(saved_delete_pending_repository_id,
                                     name)) {
      set_status("SD RENAME FAILED", COLOR_RED);
      return;
    }
  } else if (saved_delete_pending_repository_ir) {
    if (!rename_repository_ir_remote(saved_delete_pending_repository_id, name)) {
      set_status("SD RENAME FAILED", COLOR_RED);
      return;
    }
  } else if (saved_delete_pending_is_ir) {
    if (saved_delete_pending_index >= saved_ir_remote_count) return;
    strlcpy(saved_ir_remotes[saved_delete_pending_index].name, name,
            sizeof(saved_ir_remotes[saved_delete_pending_index].name));
    persist_saved_ir_remotes();
    repository_update_failed = !sd_card_ready || !ripper_ir_repository_ready ||
      !write_legacy_ir_remote_to_sd(saved_delete_pending_index);
    if (repository_update_failed) {
      Serial.println("IR rename retained in NVS; SD repository update deferred");
    }
    refresh_ir_saved_summary();
  } else {
    if (saved_delete_pending_index >= saved_remote_count) return;
    strlcpy(saved_remotes[saved_delete_pending_index].name, name,
            sizeof(saved_remotes[saved_delete_pending_index].name));
    persist_saved_remotes();
    repository_update_failed = !sd_card_ready || !ripper_rf_repository_ready ||
      !write_legacy_rf_remote_to_sd(saved_delete_pending_index);
    if (repository_update_failed) {
      ripper_rf_repository_runtime_authoritative = false;
      Serial.println("RF rename retained in NVS; SD repository update deferred");
    }
    refresh_saved_summary();
  }
  saved_hub_ignore_release_click = false;
  refresh_saved_hub();
  lv_scr_load(saved_hub_screen);
  set_status(repository_update_failed ? "SD RENAME PENDING" : "REMOTE RENAMED",
             repository_update_failed ? COLOR_MUTED : COLOR_GREEN);
}


void refresh_saved_hub() {
  if (saved_hub_screen == NULL) return;

  const bool use_rf_repository = ripper_rf_repository_ready &&
    ripper_rf_repository_runtime_authoritative;
  const uint32_t rf_count = use_rf_repository ?
    ripper_rf_repository_count : saved_remote_count;
  const uint32_t ir_count = ripper_ir_repository_ready ?
    ripper_ir_repository_count : saved_ir_remote_count;
  const uint32_t total_entries = rf_count + ir_count + 1;
  const uint32_t page_count =
    (total_entries + SAVED_HUB_PAGE_SIZE - 1) / SAVED_HUB_PAGE_SIZE;
  if (saved_hub_page >= page_count) saved_hub_page = page_count - 1;
  const uint32_t first_entry = saved_hub_page * SAVED_HUB_PAGE_SIZE;

  memset(saved_hub_tile_kind, 0, sizeof(saved_hub_tile_kind));
  memset(saved_hub_tile_record_index, 0, sizeof(saved_hub_tile_record_index));
  memset(saved_hub_tile_repository_id, 0, sizeof(saved_hub_tile_repository_id));
  for (uint8_t tile = 0; tile < SAVED_HUB_PAGE_SIZE; tile++) {
    const uint32_t logical_index = first_entry + tile;
    if (logical_index >= total_entries) {
      lv_obj_add_flag(saved_hub_tiles[tile], LV_OBJ_FLAG_HIDDEN);
      continue;
    }
    const char *name = NULL;
    const char *type = NULL;
    uint32_t color = COLOR_SAVED;
    bool is_ir = false;
    if (logical_index == 0) {
      saved_hub_tile_kind[tile] = 3;
      name = "HUNTER FAN";
      type = "TX45 RF REMOTE";
      color = COLOR_GREEN;
    } else if (logical_index <= rf_count) {
      const uint32_t rf_ordinal = logical_index - 1;
      if (use_rf_repository) {
        RipperRfIndexEntryV1 entry = {};
        if (!ripper_rf_repository_read_metadata(rf_ordinal, entry)) {
          lv_obj_add_flag(saved_hub_tiles[tile], LV_OBJ_FLAG_HIDDEN);
          continue;
        }
        saved_hub_tile_kind[tile] = 5;
        saved_hub_tile_repository_id[tile] = entry.remote_id;
        lv_label_set_text(saved_hub_tile_name_labels[tile], entry.name);
        name = NULL;
      } else {
        const uint8_t record = (uint8_t)rf_ordinal;
        saved_hub_tile_kind[tile] = 1;
        saved_hub_tile_record_index[tile] = record;
        name = saved_remotes[record].name;
      }
      type = "RF REMOTE";
      color = COLOR_RF;
    } else {
      const uint32_t ir_ordinal = logical_index - rf_count - 1;
      is_ir = true;
      color = COLOR_IR;
      if (ripper_ir_repository_ready) {
        RipperIrIndexEntryV1 entry = {};
        if (!ripper_ir_repository_read_metadata(ir_ordinal, entry)) {
          lv_obj_add_flag(saved_hub_tiles[tile], LV_OBJ_FLAG_HIDDEN);
          continue;
        }
        saved_hub_tile_kind[tile] = 2;
        saved_hub_tile_repository_id[tile] = entry.remote_id;
        lv_label_set_text(saved_hub_tile_name_labels[tile], entry.name);
        name = NULL;
        type = "IR REMOTE";
      } else {
        const uint8_t record = (uint8_t)ir_ordinal;
        saved_hub_tile_kind[tile] = 4;
        saved_hub_tile_record_index[tile] = record;
        saved_hub_tile_repository_id[tile] = saved_ir_remote_ids[record];
        name = saved_ir_remotes[record].name;
        type = "IR RECOVERY";
      }
    }
    if (name != NULL) lv_label_set_text(saved_hub_tile_name_labels[tile], name);
    lv_label_set_text(saved_hub_tile_type_labels[tile], type);
    lv_obj_set_style_border_color(saved_hub_tiles[tile], lv_color_hex(color), LV_PART_MAIN);
    lv_obj_set_style_shadow_color(saved_hub_tiles[tile], lv_color_hex(color), LV_PART_MAIN);
    lv_obj_set_style_text_color(saved_hub_tile_type_labels[tile], lv_color_hex(color), LV_PART_MAIN);
    if (is_ir) {
      lv_obj_add_flag(saved_hub_rf_icons[tile], LV_OBJ_FLAG_HIDDEN);
      lv_obj_clear_flag(saved_hub_ir_icons[tile], LV_OBJ_FLAG_HIDDEN);
    } else {
      lv_obj_clear_flag(saved_hub_rf_icons[tile], LV_OBJ_FLAG_HIDDEN);
      lv_obj_add_flag(saved_hub_ir_icons[tile], LV_OBJ_FLAG_HIDDEN);
    }
    lv_obj_clear_flag(saved_hub_tiles[tile], LV_OBJ_FLAG_HIDDEN);
  }
  lv_obj_add_flag(saved_hub_empty_label, LV_OBJ_FLAG_HIDDEN);
  lv_label_set_text_fmt(saved_hub_page_label, "PAGE %lu / %lu",
                        (unsigned long)(saved_hub_page + 1),
                        (unsigned long)page_count);
  if (saved_hub_page == 0) lv_obj_add_state(saved_hub_previous_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(saved_hub_previous_button, LV_STATE_DISABLED);
  if (saved_hub_page + 1 >= page_count) lv_obj_add_state(saved_hub_next_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(saved_hub_next_button, LV_STATE_DISABLED);
}


void saved_hub_previous_page(lv_event_t *e) {
  if (saved_hub_page > 0) saved_hub_page--;
  refresh_saved_hub();
}


void saved_hub_next_page(lv_event_t *e) {
  const uint32_t ir_count = ripper_ir_repository_ready ?
    ripper_ir_repository_count : saved_ir_remote_count;
  const uint32_t total_entries = (uint32_t)saved_remote_count + ir_count + 1;
  const uint32_t page_count =
    (total_entries + SAVED_HUB_PAGE_SIZE - 1) / SAVED_HUB_PAGE_SIZE;
  if (saved_hub_page + 1 < page_count) saved_hub_page++;
  refresh_saved_hub();
}


