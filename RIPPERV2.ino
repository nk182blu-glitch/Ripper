void refresh_ir_raw_save_targets() {
  if (ir_raw_save_target_screen == NULL) return;
  const uint32_t logical_count = ripper_ir_repository_count + 1;
  const uint32_t page_count = max(1UL, (logical_count + 3) / 4);
  if (ir_raw_save_target_page >= page_count) ir_raw_save_target_page = page_count - 1;
  const uint32_t first = ir_raw_save_target_page * 4;
  for (uint8_t tile = 0; tile < 4; tile++) {
    ir_raw_save_target_ids[tile] = 0;
    const uint32_t logical = first + tile;
    if (logical >= logical_count) {
      lv_obj_add_flag(ir_raw_save_target_buttons[tile], LV_OBJ_FLAG_HIDDEN);
      continue;
    }
    lv_obj_clear_flag(ir_raw_save_target_buttons[tile], LV_OBJ_FLAG_HIDDEN);
    if (logical == 0) {
      lv_label_set_text(ir_raw_save_target_labels[tile], "+  NEW CUSTOM REMOTE");
      continue;
    }
    RipperIrIndexEntryV1 entry = {};
    if (!ripper_ir_repository_read_metadata(logical - 1, entry)) {
      lv_label_set_text(ir_raw_save_target_labels[tile], "REMOTE UNAVAILABLE");
      lv_obj_add_state(ir_raw_save_target_buttons[tile], LV_STATE_DISABLED);
      continue;
    }
    lv_obj_clear_state(ir_raw_save_target_buttons[tile], LV_STATE_DISABLED);
    ir_raw_save_target_ids[tile] = entry.remote_id;
    lv_label_set_text(ir_raw_save_target_labels[tile], entry.name);
  }
  lv_label_set_text_fmt(ir_raw_save_target_page_label, "PAGE %lu / %lu",
                        (unsigned long)(ir_raw_save_target_page + 1),
                        (unsigned long)page_count);
  if (ir_raw_save_target_page == 0)
    lv_obj_add_state(ir_raw_save_target_previous_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(ir_raw_save_target_previous_button, LV_STATE_DISABLED);
  if (ir_raw_save_target_page + 1 >= page_count)
    lv_obj_add_state(ir_raw_save_target_next_button, LV_STATE_DISABLED);
  else lv_obj_clear_state(ir_raw_save_target_next_button, LV_STATE_DISABLED);
}

void begin_ir_raw_save_name(bool naming_remote) {
  if (ir_raw_save_name_screen == NULL) create_ir_raw_save_name_screen();
  ir_raw_save_naming_remote = naming_remote;
  lv_label_set_text(ir_raw_save_name_prompt,
                    naming_remote ? "NAME THE NEW REMOTE" : "NAME THIS BUTTON");
  lv_textarea_set_placeholder_text(ir_raw_save_name_textarea,
                                   naming_remote ? "Remote name" : "Button name");
  lv_textarea_set_max_length(ir_raw_save_name_textarea, naming_remote ? 47 : 31);
  lv_textarea_set_text(ir_raw_save_name_textarea, "");
  // Re-enter this editor at its fixed origin.  LVGL focus handling must not
  // preserve an earlier automatic scroll offset and hide the keyboard.
  lv_obj_scroll_to_x(ir_raw_save_name_screen, 0, LV_ANIM_OFF);
  lv_obj_scroll_to_y(ir_raw_save_name_screen, 0, LV_ANIM_OFF);
  lv_scr_load(ir_raw_save_name_screen);
}

void select_ir_raw_save_target(lv_event_t *e) {
  const uint8_t tile = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (tile >= 4) return;
  ir_raw_save_target_remote_id = ir_raw_save_target_ids[tile];
  ir_raw_save_creating_remote = ir_raw_save_target_remote_id == 0;
  ir_raw_save_remote_name[0] = '\0';
  begin_ir_raw_save_name(ir_raw_save_creating_remote);
}

void ir_raw_save_previous_page(lv_event_t *e) {
  (void)e;
  if (ir_raw_save_target_page > 0) ir_raw_save_target_page--;
  refresh_ir_raw_save_targets();
}

void ir_raw_save_next_page(lv_event_t *e) {
  (void)e;
  const uint32_t page_count = max(1UL, (ripper_ir_repository_count + 4) / 4);
  if (ir_raw_save_target_page + 1 < page_count) ir_raw_save_target_page++;
  refresh_ir_raw_save_targets();
}

void cancel_ir_raw_save(lv_event_t *e) {
  (void)e;
  lv_scr_load(ir_raw_transmitter_screen);
  set_status("SYSTEM READY", COLOR_READY);
}

void commit_ir_raw_save_name(lv_event_t *e) {
  (void)e;
  const char *entered = lv_textarea_get_text(ir_raw_save_name_textarea);
  if (entered == NULL || entered[0] == '\0') {
    lv_label_set_text(ir_raw_save_name_prompt, "ENTER A NAME FIRST");
    return;
  }
  if (ir_raw_save_naming_remote) {
    strlcpy(ir_raw_save_remote_name, entered, sizeof(ir_raw_save_remote_name));
    begin_ir_raw_save_name(false);
    return;
  }
  char button_name[32] = {};
  strlcpy(button_name, entered, sizeof(button_name));
  uint64_t saved_id = ir_raw_save_target_remote_id;
  const bool saved = ir_raw_save_creating_remote ?
    save_ir_raw_as_new_remote(ir_raw_save_remote_name, button_name, saved_id) :
    append_ir_raw_to_remote(saved_id, button_name);
  if (!saved) {
    lv_label_set_text(ir_raw_save_name_prompt,
                      "SAVE FAILED - CHECK SD / SPACE");
    set_status("SYSTEM READY", COLOR_READY);
    return;
  }
  Serial.printf("Raw IR saved: remote=%08lx%08lx button=%s timings=%u carrier=%lu duty=%u repeat=%u gap=%u\n",
                (unsigned long)(saved_id >> 32), (unsigned long)saved_id,
                button_name, (unsigned)ir_raw_lab_timing_count,
                (unsigned long)ir_raw_lab_carrier_hz, ir_raw_lab_duty_percent,
                ir_raw_lab_repeat_count, ir_raw_lab_repeat_gap_ms);
  RipperIrIndexEntryV1 entry = {};
  uint32_t ordinal = 0;
  if (ripper_ir_repository_find(saved_id, entry, &ordinal) &&
      load_repository_ir_remote_adapter(saved_id)) {
    selected_ir_repository_id = saved_id;
    selected_ir_repository_ordinal = ordinal;
    ensure_ir_remote_builder_screen();
    refresh_ir_remote_builder();
    lv_scr_load(ir_remote_builder_screen);
    set_status("SYSTEM READY", COLOR_READY);
    return;
  }
  lv_scr_load(ir_raw_transmitter_screen);
  set_status("SYSTEM READY", COLOR_READY);
}

void open_ir_raw_save_targets(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count == 0 || ir_raw_lab_timing_count > 2048) {
    set_status("IR RAW EMPTY OR TOO LARGE", COLOR_RED);
    return;
  }
  if (!sd_card_ready || !ripper_ir_repository_ready) {
    set_status("SD STORAGE NOT READY", COLOR_RED);
    return;
  }
  if (ir_raw_save_target_screen == NULL) create_ir_raw_save_target_screen();
  ir_raw_save_target_page = 0;
  refresh_ir_raw_save_targets();
  lv_scr_load(ir_raw_save_target_screen);
  set_status("SYSTEM READY", COLOR_READY);
}

