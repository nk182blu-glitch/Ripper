bool reserve_rf_raw_lab_timings(uint16_t required) {
  if (required == 0) return true;
  if (required > RF_CAPTURE_MAX_EDGES) return false;
  if (rf_raw_lab_timings != NULL && rf_raw_lab_timing_capacity >= required)
    return true;
  uint16_t requested = required;
  if (rf_raw_lab_timing_capacity > 0) {
    const uint32_t grown = (uint32_t)rf_raw_lab_timing_capacity +
      rf_raw_lab_timing_capacity / 2U + 16U;
    if (grown > requested) requested = min((uint32_t)RF_CAPTURE_MAX_EDGES, grown);
  }
  uint32_t *replacement = (uint32_t *)heap_caps_malloc(
    (size_t)requested * sizeof(uint32_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (replacement == NULL) {
    replacement = (uint32_t *)heap_caps_malloc(
      (size_t)requested * sizeof(uint32_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  }
  if (replacement == NULL) return false;
  if (rf_raw_lab_timings != NULL && rf_raw_lab_timing_count > 0) {
    memcpy(replacement, rf_raw_lab_timings,
           (size_t)rf_raw_lab_timing_count * sizeof(uint32_t));
  }
  if (rf_raw_lab_timings != NULL) heap_caps_free(rf_raw_lab_timings);
  rf_raw_lab_timings = replacement;
  rf_raw_lab_timing_capacity = requested;
  return true;
}


void ensure_rf_raw_lab_starter() {
  if (rf_raw_lab_timing_count > 0) return;
  const uint32_t starter[] = {350, 1050, 1050, 350, 350, 1050, 350, 10000};
  const uint16_t count = sizeof(starter) / sizeof(starter[0]);
  if (!reserve_rf_raw_lab_timings(count)) return;
  memcpy(rf_raw_lab_timings, starter, sizeof(starter));
  rf_raw_lab_timing_count = count;
  rf_raw_lab_selected_timing = 0;
  rf_raw_lab_first_level = 1;
}


bool rf_raw_lab_settings_valid() {
  const float frequency_mhz = rf_raw_lab_frequency_hz / 1000000.0f;
  const bool supported_band =
    (frequency_mhz >= 300.0f && frequency_mhz <= 348.0f) ||
    (frequency_mhz >= 387.0f && frequency_mhz <= 464.0f) ||
    (frequency_mhz >= 779.0f && frequency_mhz <= 928.0f);
  if (!supported_band || rf_raw_lab_bit_rate_bps == 0 ||
      rf_raw_lab_bandwidth_hz == 0 || rf_raw_lab_repeat_count == 0 ||
      (rf_raw_lab_modulation != RIPPER_RF_MODULATION_OOK &&
       rf_raw_lab_modulation != RIPPER_RF_MODULATION_FSK) ||
      rf_raw_lab_timing_count < 2 ||
      rf_raw_lab_timing_count > RF_CAPTURE_MAX_EDGES) return false;
  for (uint16_t i = 0; i < rf_raw_lab_timing_count; i++) {
    if (rf_raw_lab_timings[i] == 0 ||
        rf_raw_lab_timings[i] > RIPPER_RF_MAX_TIMING_US) return false;
  }
  return true;
}


void make_rf_raw_lab_button_disk(RipperRfButtonDiskV1 &disk,
                                 uint16_t button_id, uint8_t page,
                                 const char *label) {
  memset(&disk, 0, sizeof(disk));
  disk.record_size = sizeof(disk);
  disk.button_id = button_id;
  disk.page = page;
  disk.encoding = RIPPER_RF_ENCODING_RAW_TIMINGS32;
  disk.repeat_count = rf_raw_lab_repeat_count;
  disk.first_level = rf_raw_lab_first_level ? 1 : 0;
  disk.modulation = rf_raw_lab_modulation;
  disk.legacy_profile_index = 0xFF;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  disk.frequency_hz = rf_raw_lab_frequency_hz;
  disk.bit_rate_bps = rf_raw_lab_bit_rate_bps;
  disk.deviation_hz = rf_raw_lab_deviation_hz;
  disk.bandwidth_hz = rf_raw_lab_bandwidth_hz;
  disk.repeat_gap_us = rf_raw_lab_repeat_gap_us;
  disk.parsed_key = rf_raw_lab_timing_count;
  strlcpy(disk.preset_name, "RIPPER RAW LAB", sizeof(disk.preset_name));
  strlcpy(disk.protocol_name, "RAW", sizeof(disk.protocol_name));
  strlcpy(disk.label, label, sizeof(disk.label));
}


static const uint8_t RF_RAW_AUTO_BAND_COUNT = 4;

// These are the practical CC1101 household ranges. The 500 kHz coarse step
// is no wider than the 650 kHz receive profile, avoiding blind gaps.
bool rf_raw_auto_band_config(uint8_t band, float &start_mhz, float &stop_mhz,
                             uint8_t &ook_profile, uint8_t &fsk_profile) {
  switch (band) {
    case 0:
      start_mhz = 300.0f; stop_mhz = 348.0f;
      ook_profile = 6; fsk_profile = 15;
      return true;
    case 1:
      start_mhz = 387.0f; stop_mhz = 464.0f;
      ook_profile = 2; fsk_profile = 16;
      return true;
    case 2:
      start_mhz = 863.0f; stop_mhz = 870.0f;
      ook_profile = 18; fsk_profile = 13;
      return true;
    case 3:
      start_mhz = 902.0f; stop_mhz = 928.0f;
      ook_profile = 19; fsk_profile = 13;
      return true;
    default:
      return false;
  }
}


bool sample_rf_raw_auto_point(float frequency_mhz, float &peak_rssi,
                              uint16_t &transitions, uint16_t sample_ms = 12) {
#if !CC1101_ACCESS_ENABLED
  (void)frequency_mhz;
  (void)peak_rssi;
  (void)transitions;
  (void)sample_ms;
  return false;
#else
  peak_rssi = -140.0f;
  transitions = 0;
  if (cc1101.setFrequency(frequency_mhz) != RADIOLIB_ERR_NONE ||
      cc1101.receiveDirectAsync() != RADIOLIB_ERR_NONE) return false;
  delay(4);
  uint8_t previous_level = digitalRead(CC1101_GDO0);
  const uint32_t sample_until = millis() + sample_ms;
  while ((int32_t)(millis() - sample_until) < 0) {
    const float rssi = cc1101.getRSSI();
    if (rssi > peak_rssi) peak_rssi = rssi;
    const uint8_t level = digitalRead(CC1101_GDO0);
    if (level != previous_level) {
      transitions++;
      previous_level = level;
    }
    delayMicroseconds(200);
  }
  cc1101.packetMode();
  return true;
#endif
}


void stop_rf_raw_auto_find(bool restore_previous_profile) {
#if CC1101_ACCESS_ENABLED
  if (cc1101_ready) {
    cc1101.packetMode();
    if (restore_previous_profile &&
        rf_raw_auto_previous_profile < RF_PROFILE_COUNT) {
      apply_rf_profile(rf_raw_auto_previous_profile, false);
    }
  }
#else
  (void)restore_previous_profile;
#endif
  rf_raw_auto_state = RF_RAW_AUTO_IDLE;
  rf_raw_auto_radio_prepared = false;
}


void start_rf_raw_auto_find() {
  rf_raw_lab_waiting_second_press = false;
  rf_raw_auto_previous_profile = safe_rf_profile_index();
  rf_raw_auto_state = RF_RAW_AUTO_COARSE;
  rf_raw_auto_band = 0;
  rf_raw_auto_point = 0;
  rf_raw_auto_point_count = 0;
  rf_raw_auto_best_profile = 6;
  rf_raw_auto_best_fsk_profile = 15;
  rf_raw_auto_best_mhz = 0.0f;
  rf_raw_auto_best_rssi = -140.0f;
  rf_raw_auto_best_score = -1000.0f;
  rf_raw_auto_best_transitions = 0;
  rf_raw_auto_ook_score = -1000.0f;
  rf_raw_auto_fsk_score = -1000.0f;
  rf_raw_auto_ook_peak_rssi = -140.0f;
  rf_raw_auto_fsk_peak_rssi = -140.0f;
  rf_raw_auto_next_ms = millis();
  rf_raw_auto_radio_prepared = false;
  refresh_rf_raw_lab_screen();
  set_status("LISTENING", COLOR_RF);
  Serial.println("Raw RF auto-find started: scanning 300-348, 387-464, 863-870 and 902-928 MHz");
}


bool begin_rf_raw_capture_at_current_settings() {
  if (!cc1101_ready || rf_capture_active) return false;
  ensure_rf_raw_lab_starter();
  RipperRfButtonDiskV1 settings = {};
  make_rf_raw_lab_button_disk(settings, 1, 0, "RAW");
  if (!apply_repository_rf_radio(settings)) return false;
  rf_raw_lab_capture_mode = true;
  rf_raw_lab_capture_started_ms = millis();
  if (!start_rf_capture()) {
    rf_raw_lab_capture_mode = false;
    rf_raw_lab_waiting_second_press = false;
    return false;
  }
  refresh_rf_raw_lab_screen();
  set_status("LISTENING", COLOR_RF);
  Serial.printf("Raw RF lab capture waiting for signal: %.3f MHz %s, 10 second window\n",
                rf_raw_lab_frequency_hz / 1000000.0f,
                rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK" : "FSK");
  return true;
}


void update_rf_raw_auto_find() {
#if !CC1101_ACCESS_ENABLED
  return;
#else
  if (rf_raw_auto_state == RF_RAW_AUTO_IDLE || !cc1101_ready) return;
  if ((int32_t)(millis() - rf_raw_auto_next_ms) < 0) return;

  if (rf_raw_auto_state == RF_RAW_AUTO_COARSE) {
    uint8_t ook_profile = 0;
    uint8_t fsk_profile = 0;
    if (!rf_raw_auto_band_config(rf_raw_auto_band,
          rf_raw_auto_band_start_mhz, rf_raw_auto_band_stop_mhz,
          ook_profile, fsk_profile)) {
      stop_rf_raw_auto_find(true);
      refresh_rf_raw_lab_screen();
      set_status("RF AUTO-FIND FAILED", COLOR_RED);
      return;
    }
    if (!rf_raw_auto_radio_prepared) {
      rf_raw_auto_profile = ook_profile;
      rf_raw_auto_point_count =
        (uint16_t)lroundf((rf_raw_auto_band_stop_mhz -
                           rf_raw_auto_band_start_mhz) * 2.0f) + 1U;
      if (!apply_rf_profile(rf_raw_auto_profile, false)) {
        stop_rf_raw_auto_find(true);
        refresh_rf_raw_lab_screen();
        set_status("RF AUTO-FIND START FAILED", COLOR_RED);
        return;
      }
      rf_raw_auto_radio_prepared = true;
    }

    const float frequency = rf_raw_auto_band_start_mhz +
      0.5f * rf_raw_auto_point;
    float peak = -140.0f;
    uint16_t transitions = 0;
    if (sample_rf_raw_auto_point(frequency, peak, transitions)) {
      const float score = peak + min((uint16_t)40, transitions) * 0.15f;
      if (score > rf_raw_auto_best_score) {
        rf_raw_auto_best_score = score;
        rf_raw_auto_best_rssi = peak;
        rf_raw_auto_best_mhz = frequency;
        rf_raw_auto_best_profile = ook_profile;
        rf_raw_auto_best_fsk_profile = fsk_profile;
        rf_raw_auto_best_transitions = transitions;
      }
    }
    rf_raw_auto_point++;
    if ((rf_raw_auto_point & 7U) == 0U ||
        rf_raw_auto_point >= rf_raw_auto_point_count) {
      refresh_rf_raw_lab_screen();
    }
    rf_raw_auto_next_ms = millis() + 2;
    if (rf_raw_auto_point < rf_raw_auto_point_count) return;

    rf_raw_auto_band++;
    rf_raw_auto_point = 0;
    rf_raw_auto_radio_prepared = false;
    if (rf_raw_auto_band < RF_RAW_AUTO_BAND_COUNT) return;

    if (rf_raw_auto_best_mhz <= 0.0f || rf_raw_auto_best_rssi < -105.0f) {
      Serial.printf("Raw RF auto-find: no usable signal, best %.1f dBm at %.3f MHz\n",
                    rf_raw_auto_best_rssi, rf_raw_auto_best_mhz);
      stop_rf_raw_auto_find(true);
      refresh_rf_raw_lab_screen();
      set_status("NO RF SIGNAL FOUND - HOLD BUTTON", COLOR_RED);
      return;
    }

    rf_raw_auto_state = RF_RAW_AUTO_REFINE;
    rf_raw_auto_band_start_mhz = rf_raw_auto_best_mhz - 0.75f;
    rf_raw_auto_band_stop_mhz = rf_raw_auto_best_mhz + 0.75f;
    rf_raw_auto_point = 0;
    rf_raw_auto_point_count = 16;
    rf_raw_auto_radio_prepared = false;
    rf_raw_auto_best_score = -1000.0f;
    set_status("LISTENING", COLOR_RF);
    refresh_rf_raw_lab_screen();
    return;
  }

  if (rf_raw_auto_state == RF_RAW_AUTO_REFINE) {
    if (!rf_raw_auto_radio_prepared) {
      if (!apply_rf_profile(rf_raw_auto_best_profile, false)) {
        stop_rf_raw_auto_find(true);
        set_status("RF REFINE FAILED", COLOR_RED);
        return;
      }
      rf_raw_auto_radio_prepared = true;
    }
    const float fraction = rf_raw_auto_point_count > 1 ?
      (float)rf_raw_auto_point / (rf_raw_auto_point_count - 1U) : 0.0f;
    const float frequency = rf_raw_auto_band_start_mhz +
      (rf_raw_auto_band_stop_mhz - rf_raw_auto_band_start_mhz) * fraction;
    float peak = -140.0f;
    uint16_t transitions = 0;
    if (sample_rf_raw_auto_point(frequency, peak, transitions, 18)) {
      const float score = peak + min((uint16_t)60, transitions) * 0.15f;
      if (score > rf_raw_auto_best_score) {
        rf_raw_auto_best_score = score;
        rf_raw_auto_best_rssi = peak;
        rf_raw_auto_best_mhz = frequency;
        rf_raw_auto_best_transitions = transitions;
      }
    }
    rf_raw_auto_point++;
    refresh_rf_raw_lab_screen();
    rf_raw_auto_next_ms = millis() + 2;
    if (rf_raw_auto_point < rf_raw_auto_point_count) return;
    rf_raw_auto_state = RF_RAW_AUTO_TEST_OOK;
    rf_raw_auto_radio_prepared = false;
    set_status("LISTENING", COLOR_RF);
    return;
  }

  if (rf_raw_auto_state == RF_RAW_AUTO_TEST_OOK ||
      rf_raw_auto_state == RF_RAW_AUTO_TEST_FSK) {
    const bool testing_ook = rf_raw_auto_state == RF_RAW_AUTO_TEST_OOK;
    const uint8_t test_profile = testing_ook ? rf_raw_auto_best_profile :
                                              rf_raw_auto_best_fsk_profile;
    float peak = -140.0f;
    uint16_t transitions = 0;
    if (apply_rf_profile(test_profile, false) &&
        sample_rf_raw_auto_point(rf_raw_auto_best_mhz, peak, transitions, 80)) {
      const float score = peak + min((uint16_t)100, transitions) * 0.20f;
      if (testing_ook) {
        rf_raw_auto_ook_score = score;
        rf_raw_auto_ook_peak_rssi = peak;
      } else {
        rf_raw_auto_fsk_score = score;
        rf_raw_auto_fsk_peak_rssi = peak;
      }
      Serial.printf("Raw RF modulation test: %s peak=%.1f dBm edges=%u score=%.1f\n",
                    testing_ook ? "OOK" : "FSK", peak, transitions, score);
    }
    if (testing_ook) {
      rf_raw_auto_state = RF_RAW_AUTO_TEST_FSK;
      rf_raw_auto_next_ms = millis() + 10;
      refresh_rf_raw_lab_screen();
      return;
    }

    // Edge counts from an idle FSK discriminator can look impressive even
    // though no transmitter is present. Only choose FSK if its test retained
    // a strong carrier near the signal found by the frequency sweep. If the
    // user released early or the test is inconclusive, default to household
    // OOK rather than treating discriminator noise as a protocol decision.
    const float modulation_signal_floor =
      max(-95.0f, rf_raw_auto_best_rssi - 20.0f);
    const bool ook_signal_present =
      rf_raw_auto_ook_peak_rssi >= modulation_signal_floor;
    const bool fsk_signal_present =
      rf_raw_auto_fsk_peak_rssi >= modulation_signal_floor;
    const bool use_fsk = fsk_signal_present &&
      (!ook_signal_present ||
       rf_raw_auto_fsk_score > rf_raw_auto_ook_score + 3.0f);
    const uint8_t selected_profile = use_fsk ? rf_raw_auto_best_fsk_profile :
                                               rf_raw_auto_best_profile;
    const RFProfilePreset &profile = RF_PROFILES[selected_profile];
    rf_raw_lab_frequency_hz =
      (uint32_t)lroundf(rf_raw_auto_best_mhz * 1000000.0f);
    rf_raw_lab_bit_rate_bps = (uint32_t)lroundf(profile.bit_rate * 1000.0f);
    rf_raw_lab_deviation_hz = (uint32_t)lroundf(profile.deviation * 1000.0f);
    rf_raw_lab_bandwidth_hz = (uint32_t)lroundf(profile.bandwidth * 1000.0f);
    rf_raw_lab_modulation = use_fsk ? RIPPER_RF_MODULATION_FSK :
                                      RIPPER_RF_MODULATION_OOK;
    if (!apply_rf_profile(selected_profile, false) ||
        cc1101.setFrequency(rf_raw_auto_best_mhz) != RADIOLIB_ERR_NONE ||
        cc1101.receiveDirectAsync() != RADIOLIB_ERR_NONE) {
      stop_rf_raw_auto_find(true);
      refresh_rf_raw_lab_screen();
      set_status("RF LOCK FAILED", COLOR_RED);
      return;
    }
    rf_raw_auto_state = RF_RAW_AUTO_WAIT_RELEASE;
    rf_raw_auto_quiet_started_ms = 0;
    rf_raw_auto_next_ms = millis() + 20;
    refresh_rf_raw_settings_screen();
    refresh_rf_raw_lab_screen();
    set_status("LISTENING", COLOR_GREEN);
    Serial.printf("Raw RF auto-find locked: %.3f MHz %s, peak %.1f dBm\n",
                  rf_raw_auto_best_mhz, use_fsk ? "FSK" : "OOK",
                  rf_raw_auto_best_rssi);
    return;
  }

  if (rf_raw_auto_state == RF_RAW_AUTO_WAIT_RELEASE) {
    const float rssi = cc1101.getRSSI();
    const float quiet_threshold = max(-105.0f, rf_raw_auto_best_rssi - 10.0f);
    if (rssi <= quiet_threshold) {
      if (rf_raw_auto_quiet_started_ms == 0)
        rf_raw_auto_quiet_started_ms = millis();
      // A held remote often has quiet gaps between repeated frames. Requiring
      // one full second of continuous quiet distinguishes an actual release
      // from those inter-frame gaps before asking for a second press.
      if ((uint32_t)(millis() - rf_raw_auto_quiet_started_ms) >= 1000UL) {
        cc1101.packetMode();
        rf_raw_auto_state = RF_RAW_AUTO_IDLE;
        rf_raw_auto_radio_prepared = false;
        rf_raw_lab_waiting_second_press = true;
        refresh_rf_raw_lab_screen();
        if (!begin_rf_raw_capture_at_current_settings()) {
          set_status("RF CAPTURE START FAILED", COLOR_RED);
        } else {
          set_status("LISTENING", COLOR_RF);
        }
        return;
      }
    } else {
      rf_raw_auto_quiet_started_ms = 0;
    }
    rf_raw_auto_next_ms = millis() + 20;
  }
#endif
}


void refresh_rf_raw_lab_screen() {
  if (rf_raw_lab_summary_label == NULL) return;
  char capture_state[64];
  if (rf_raw_auto_state == RF_RAW_AUTO_COARSE) {
    const uint8_t progress = rf_raw_auto_point_count > 0 ?
      (uint16_t)rf_raw_auto_point * 100U / rf_raw_auto_point_count : 0;
    snprintf(capture_state, sizeof(capture_state),
             "HOLD BUTTON - BAND %u/4  %u%%", rf_raw_auto_band + 1, progress);
  } else if (rf_raw_auto_state == RF_RAW_AUTO_REFINE) {
    snprintf(capture_state, sizeof(capture_state),
             "REFINING %.3f MHz", rf_raw_auto_best_mhz);
  } else if (rf_raw_auto_state == RF_RAW_AUTO_TEST_OOK ||
             rf_raw_auto_state == RF_RAW_AUTO_TEST_FSK) {
    strlcpy(capture_state, "CHECKING OOK / FSK", sizeof(capture_state));
  } else if (rf_raw_auto_state == RF_RAW_AUTO_WAIT_RELEASE) {
    snprintf(capture_state, sizeof(capture_state),
             "FOUND %.3f - RELEASE BUTTON", rf_raw_auto_best_mhz);
  } else if (rf_raw_lab_capture_mode && rf_raw_lab_waiting_second_press) {
    strlcpy(capture_state, "PRESS SAME BUTTON AGAIN", sizeof(capture_state));
  } else if (rf_raw_lab_capture_mode) {
    const uint32_t elapsed_ms = millis() - rf_raw_lab_capture_started_ms;
    const uint8_t remaining_seconds =
      elapsed_ms >= 10000UL ? 0 : (uint8_t)((10000UL - elapsed_ms + 999UL) / 1000UL);
    snprintf(capture_state, sizeof(capture_state),
             "LISTENING FOR RF... %u s", remaining_seconds);
  } else {
    strlcpy(capture_state,
            rf_raw_lab_has_capture ? "RECEIVED SIGNAL LOADED" : "MANUAL WAVEFORM",
            sizeof(capture_state));
  }
  char text[260];
  snprintf(text, sizeof(text),
           "%s\n%.3f MHz  %s\n%u frame%s  |  %lu ms gap\n%u timing edges%s",
           capture_state,
           rf_raw_lab_frequency_hz / 1000000.0f,
           rf_raw_lab_modulation == RIPPER_RF_MODULATION_OOK ? "OOK / ASK" : "2-FSK",
           rf_raw_lab_repeat_count, rf_raw_lab_repeat_count == 1 ? "" : "s",
           (unsigned long)(rf_raw_lab_repeat_gap_us / 1000UL),
           rf_raw_lab_timing_count,
           rf_raw_lab_has_capture ? "  |  captured" : "");
  lv_label_set_text(rf_raw_lab_summary_label, text);
  if (rf_raw_lab_capture_button != NULL) {
    const char *button_text = rf_raw_auto_state != RF_RAW_AUTO_IDLE ?
      "CANCEL SEARCH" : (rf_raw_lab_capture_mode ? "CANCEL CAPTURE" : "CAPTURE NEW");
    lv_label_set_text(lv_obj_get_child(rf_raw_lab_capture_button, 0), button_text);
    lv_obj_clear_state(rf_raw_lab_capture_button, LV_STATE_DISABLED);
  }
}


