// Background timer loop driven smoothly by the LVGL engine tick rate
static void vibe_deauth_tick_callback(lv_timer_t * timer) {
    if (vibe_deauth_active) {
        run_dynamic_deauth_injection();
        if (vibe_last_tx_ok) {
            vibe_pkts_sent++;
            lv_label_set_text_fmt(vibe_count_label, "PKTS INJECTED: %lu", vibe_pkts_sent);
        } else {
            // The stock ESP32-S3 Wi-Fi driver rejects some management-frame
            // subtypes. Stop after the first rejected frame instead of
            // flooding Serial and falsely increasing the success counter.
            vibe_deauth_active = false;
            lv_timer_pause(timer);
            lv_label_set_text(vibe_status_label, "STATUS: FRAME REJECTED BY DRIVER");
            lv_obj_set_style_bg_color(vibe_action_btn, lv_color_hex(COLOR_PANEL), LV_PART_MAIN);
            lv_label_set_text(vibe_btn_label, "RETRY");
            set_status("WI-FI DRIVER REJECTED FRAME", COLOR_RED);
            Serial.println("Wi-Fi raw frame rejected; live transmitter stopped");
        }
    }
}

