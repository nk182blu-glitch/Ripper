const char *ir_raw_lab_protocol_name() {
  return getProtocolString((decode_type_t)ir_raw_lab_protocol);
}

bool reserve_ir_raw_lab_timings(uint16_t required) {
  if (required == 0) return true;
  if (ir_raw_lab_timings != NULL && ir_raw_lab_timing_capacity >= required) return true;
  uint32_t requested = required;
  if (ir_raw_lab_timing_capacity > 0) {
    const uint32_t grown = (uint32_t)ir_raw_lab_timing_capacity +
                           (uint32_t)ir_raw_lab_timing_capacity / 2U + 8U;
    if (grown > requested) requested = grown;
  }
  if (requested > UINT16_MAX) requested = UINT16_MAX;
  uint16_t *replacement = (uint16_t *)heap_caps_malloc(
    requested * sizeof(uint16_t), MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
  if (replacement == NULL) {
    replacement = (uint16_t *)heap_caps_malloc(
      requested * sizeof(uint16_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
  }
  if (replacement == NULL) return false;
  if (ir_raw_lab_timings != NULL && ir_raw_lab_timing_count > 0) {
    memcpy(replacement, ir_raw_lab_timings,
           ir_raw_lab_timing_count * sizeof(uint16_t));
  }
  if (ir_raw_lab_timings != NULL) heap_caps_free(ir_raw_lab_timings);
  ir_raw_lab_timings = replacement;
  ir_raw_lab_timing_capacity = (uint16_t)requested;
  return true;
}

void refresh_ir_raw_lab_screen() {
  if (ir_raw_capture_label == NULL) return;
  if (!ir_raw_lab_has_capture || ir_raw_lab_timing_count == 0) {
    lv_label_set_text(ir_raw_capture_label,
      "POINT A REMOTE AT RIPPER\nAND PRESS A BUTTON\n\nWaiting for one signal...\n\nCarrier and duty cannot be\nmeasured by this IR sensor.");
    return;
  }
  uint16_t shortest = UINT16_MAX;
  uint16_t longest = 0;
  uint64_t total = 0;
  for (uint16_t i = 0; i < ir_raw_lab_timing_count; i++) {
    const uint16_t value = ir_raw_lab_timings[i];
    if (value < shortest) shortest = value;
    if (value > longest) longest = value;
    total += value;
  }
  char detail[520];
  snprintf(detail, sizeof(detail),
    "PROTOCOL  %s\nADDRESS   0x%04X\nCOMMAND   0x%04X\nBITS      %u\nFLAGS     0x%02X\nDATA      0x%llX\n\nTIMINGS   %u mark/space\nTOTAL     %llu us\nRANGE     %u - %u us\n\nCarrier/duty: not measurable",
    ir_raw_lab_protocol_name(), ir_raw_lab_address, ir_raw_lab_command,
    ir_raw_lab_bits, ir_raw_lab_flags,
    (unsigned long long)ir_raw_lab_decoded_data,
    ir_raw_lab_timing_count, (unsigned long long)total, shortest, longest);
  lv_label_set_text(ir_raw_capture_label, detail);
}

void arm_ir_raw_capture(lv_event_t *e) {
  (void)e;
  ir_raw_lab_capture_active = true;
  ir_raw_lab_has_capture = false;
  ir_raw_lab_timing_count = 0;
  refresh_ir_raw_lab_screen();
  set_status("LISTENING", COLOR_IR);
}

void open_ir_raw_lab(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_screen == NULL) create_ir_raw_lab_screen();
  ir_raw_lab_capture_active = true;
  refresh_ir_raw_lab_screen();
  lv_scr_load(ir_raw_lab_screen);
  set_status("LISTENING", COLOR_IR);
}

void close_ir_raw_lab(lv_event_t *e) {
  ir_raw_lab_capture_active = false;
  open_ir(e);
}

void show_ir_raw_details(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_screen == NULL) create_ir_raw_lab_screen();
  ir_raw_lab_capture_active = false;
  refresh_ir_raw_lab_screen();
  lv_scr_load(ir_raw_lab_screen);
  set_status("SYSTEM READY", COLOR_READY);
}

void open_ir_raw_transmitter(lv_event_t *e) {
  (void)e;
  ir_raw_lab_capture_active = false;
  if (ir_raw_lab_timing_count == 0) {
    const uint16_t starter[] = {9000, 4500, 560, 560};
    if (!reserve_ir_raw_lab_timings(sizeof(starter) / sizeof(starter[0]))) {
      set_status("IR MEMORY LOW", COLOR_RED);
      return;
    }
    memcpy(ir_raw_lab_timings, starter, sizeof(starter));
    ir_raw_lab_timing_count = sizeof(starter) / sizeof(starter[0]);
    ir_raw_lab_selected_timing = 0;
  }
  if (ir_raw_transmitter_screen == NULL) create_ir_raw_transmitter_screen();
  refresh_ir_raw_transmitter_screen();
  lv_scr_load(ir_raw_transmitter_screen);
  set_status("SYSTEM READY", COLOR_READY);
}

void adjust_raw_carrier(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  int32_t value = (int32_t)ir_raw_lab_carrier_hz + delta;
  ir_raw_lab_carrier_hz = constrain(value, 10000, 100000);
  refresh_ir_raw_transmitter_screen();
}

void adjust_raw_duty(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  ir_raw_lab_duty_percent = constrain((int)ir_raw_lab_duty_percent + delta, 10, 50);
  refresh_ir_raw_transmitter_screen();
}

void adjust_raw_repeats(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  ir_raw_lab_repeat_count = constrain((int)ir_raw_lab_repeat_count + delta, 1, 20);
  refresh_ir_raw_transmitter_screen();
}

void adjust_raw_gap(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  ir_raw_lab_repeat_gap_ms = constrain((int)ir_raw_lab_repeat_gap_ms + delta, 0, 1000);
  refresh_ir_raw_transmitter_screen();
}

void transmit_ir_raw_lab(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count == 0) {
    set_status("IR RAW EMPTY", COLOR_RED);
    return;
  }
  set_status("TRANSMITTING", COLOR_IR);
  const bool sent = send_repository_raw_ir(
    ir_raw_lab_timings, ir_raw_lab_timing_count, ir_raw_lab_carrier_hz,
    ir_raw_lab_repeat_count, ir_raw_lab_repeat_gap_ms, ir_raw_lab_duty_percent);
  Serial.printf("Raw IR lab transmit: %s, %u timings, %lu Hz, %u%% duty, %u frame(s), %u ms gap\n",
                sent ? "OK" : "FAILED", ir_raw_lab_timing_count,
                (unsigned long)ir_raw_lab_carrier_hz, ir_raw_lab_duty_percent,
                ir_raw_lab_repeat_count, ir_raw_lab_repeat_gap_ms);
  set_status(sent ? "SYSTEM READY" : "IR SEND FAILED",
             sent ? COLOR_READY : COLOR_RED);
}

void make_ir_raw_lab_button_disk(RipperIrButtonDiskV1 &disk,
                                 uint16_t button_id, uint8_t page,
                                 const char *label) {
  memset(&disk, 0, sizeof(disk));
  disk.record_size = sizeof(disk);
  disk.button_id = button_id;
  disk.page = page;
  disk.encoding = RIPPER_IR_ENCODING_RAW_TIMINGS;
  disk.repeat_count = ir_raw_lab_repeat_count;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  disk.carrier_hz = ir_raw_lab_carrier_hz;
  disk.repeat_gap_ms = ir_raw_lab_repeat_gap_ms;
  // This byte was reserved in the v1 record.  Zero continues to mean the
  // historical 33% default; new raw signals store their exact selected duty.
  disk.reserved = ir_raw_lab_duty_percent;
  disk.raw_timing_count = ir_raw_lab_timing_count;
  strlcpy(disk.label, label, sizeof(disk.label));
}

bool save_ir_raw_as_new_remote(const char *remote_name, const char *button_name,
                               uint64_t &saved_id) {
  saved_id = 0;
  if (!sd_card_ready || !ripper_ir_repository_ready || remote_name == NULL ||
      remote_name[0] == '\0' || button_name == NULL || button_name[0] == '\0' ||
      ir_raw_lab_timing_count == 0 || ir_raw_lab_timing_count > 2048 ||
      !ripper_ir_repository_ensure_directories()) return false;
  const uint32_t timing_bytes =
    (uint32_t)ir_raw_lab_timing_count * sizeof(uint16_t);
  const uint32_t payload_bytes = sizeof(RipperIrButtonDiskV1) + timing_bytes;
  if (!ripper_ir_repository_has_space(
        sizeof(RipperIrRemoteFileHeaderV1) + payload_bytes)) return false;

  RipperIrIndexEntryV1 collision = {};
  do {
    saved_id = ((uint64_t)esp_random() << 32) | esp_random();
  } while (saved_id == 0 || ripper_ir_repository_find(saved_id, collision));
  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(saved_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);

  RipperIrButtonDiskV1 disk = {};
  make_ir_raw_lab_button_disk(disk, 1, 0, button_name);
  uint32_t crc = 0xFFFFFFFFUL;
  crc = ripper_crc32_update(crc, (const uint8_t *)&disk, sizeof(disk));
  crc = ripper_crc32_update(crc, (const uint8_t *)ir_raw_lab_timings, timing_bytes);
  RipperIrRemoteFileHeaderV1 header = {};
  header.magic = RIPPER_IR_FILE_MAGIC;
  header.version = RIPPER_IR_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = saved_id;
  header.source_flags = RIPPER_IR_SOURCE_RIPPER_LEARNED;
  strlcpy(header.name, remote_name, sizeof(header.name));
  strlcpy(header.device_type, "CUSTOM IR", sizeof(header.device_type));
  header.button_count = 1;
  header.page_count = 1;
  header.payload_bytes = payload_bytes;
  header.payload_crc32 = ~crc;
  header.header_crc32 = ripper_ir_header_crc(header);

  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  bool wrote = file &&
    file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header) &&
    file.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
    file.write((const uint8_t *)ir_raw_lab_timings, timing_bytes) == timing_bytes;
  if (file) { file.flush(); file.close(); }
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, saved_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    saved_id = 0;
    return false;
  }
  return true;
}

bool append_ir_raw_to_remote(uint64_t remote_id, const char *button_name) {
  if (!sd_card_ready || !ripper_ir_repository_ready || remote_id == 0 ||
      button_name == NULL || button_name[0] == '\0' ||
      ir_raw_lab_timing_count == 0 || ir_raw_lab_timing_count > 2048) return false;
  RipperIrIndexEntryV1 entry = {};
  if (!ripper_ir_repository_find(remote_id, entry) ||
      !validate_ripper_ir_remote_file(entry.file_path, remote_id)) return false;
  RipperIrRemoteFileHeaderV1 header = {};
  if (!ripper_ir_read_remote_header(entry.file_path, header) ||
      header.button_count >= 1024) return false;
  const uint8_t new_page = (uint8_t)(header.button_count / MAX_IR_REMOTE_BUTTONS);
  if (new_page == UINT8_MAX) return false;
  const uint32_t timing_bytes =
    (uint32_t)ir_raw_lab_timing_count * sizeof(uint16_t);
  const uint32_t added_bytes = sizeof(RipperIrButtonDiskV1) + timing_bytes;
  if (!ripper_ir_repository_has_space(sizeof(header) + header.payload_bytes + added_bytes))
    return false;

  char temporary_path[112] = {};
  if (!ripper_ir_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(entry.file_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    return false;
  }
  RipperIrRemoteFileHeaderV1 placeholder = {};
  bool wrote = source.seek(sizeof(header)) &&
    target.write((const uint8_t *)&placeholder, sizeof(placeholder)) == sizeof(placeholder);
  uint32_t crc = 0xFFFFFFFFUL;
  uint16_t maximum_button_id = 0;
  uint8_t buffer[256];
  for (uint16_t index = 0; wrote && index < header.button_count; index++) {
    RipperIrButtonDiskV1 disk = {};
    wrote = source.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
            target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    if (disk.button_id > maximum_button_id) maximum_button_id = disk.button_id;
    crc = ripper_crc32_update(crc, (const uint8_t *)&disk, sizeof(disk));
    uint32_t remaining = (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    while (wrote && remaining > 0) {
      const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
      wrote = source.read(buffer, chunk) == chunk &&
              target.write(buffer, chunk) == chunk;
      if (wrote) crc = ripper_crc32_update(crc, buffer, chunk);
      remaining -= chunk;
    }
  }
  source.close();
  RipperIrButtonDiskV1 added = {};
  make_ir_raw_lab_button_disk(added, maximum_button_id + 1, new_page, button_name);
  wrote = wrote && target.write((const uint8_t *)&added, sizeof(added)) == sizeof(added) &&
          target.write((const uint8_t *)ir_raw_lab_timings, timing_bytes) == timing_bytes;
  if (wrote) {
    crc = ripper_crc32_update(crc, (const uint8_t *)&added, sizeof(added));
    crc = ripper_crc32_update(crc, (const uint8_t *)ir_raw_lab_timings, timing_bytes);
  }
  header.source_flags |= RIPPER_IR_SOURCE_RIPPER_LEARNED;
  header.button_count++;
  if (header.page_count <= new_page) header.page_count = new_page + 1;
  header.payload_bytes += added_bytes;
  header.payload_crc32 = ~crc;
  header.header_crc32 = ripper_ir_header_crc(header);
  wrote = wrote && target.seek(0) &&
          target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, remote_id) ||
      !ripper_ir_repository_commit_staged(temporary_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  return true;
}

