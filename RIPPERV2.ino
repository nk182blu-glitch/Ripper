input[type=range]{padding:0}.login{max-width:420px;margin:18vh auto 0}.login input{width:100%;margin:10px 0}.fileInput{width:100%;padding:10px}.spinner{opacity:.55;pointer-events:none}@media(min-width:600px){.buttons{grid-template-columns:repeat(3,1fr)}nav .nav{font-size:12px}}
</style></head><body><div id="login" class="login card"><h2>PAIR WITH RIPPER</h2><p class="muted">Enter the password shown by Ripper Web Control.</p><input id="keyInput" type="password" autocomplete="current-password" placeholder="Pairing password"><button class="good" onclick="pair()">CONNECT</button><p id="loginError" class="danger"></p></div>
<main id="app" class="app hidden"><div class="top"><div class="brand"><b>RIPPERZERO</b><span id="version" class="version">v2.1.3</span></div><div class="status"><span><span id="activity">CONNECTING</span> <span id="link" class="link offline">RETRYING</span></span><span id="battery">BAT --</span></div>
<nav><button class="nav active" data-view="mirror">SCREEN</button><button class="nav" data-view="remotes">REMOTES</button><button class="nav" data-view="signal">SIGNAL</button><button class="nav" data-view="files">FILES</button><button class="nav" data-view="settings">SETTINGS</button></nav></div>
<div id="phoneNotice" class="phoneNotice hidden" role="status"></div>
<section id="mirror" class="view active"><div class="notice">Live Ripper display. Tap, hold, drag, and scroll just like the touchscreen.</div><div class="mirror"><div class="screenShell"><canvas id="screen" width="320" height="480" aria-label="Live Ripper touchscreen"></canvas></div></div><button class="wide" onclick="frame(true)">REFRESH SCREEN</button></section>
<section id="remotes" class="view"><div id="remoteBrowser" class="card"><b>SAVED REMOTES</b><p class="muted">IR, RF, and Hunter controls stored on Ripper.</p><div id="remoteList">Loading...</div><div id="remotePager" class="row"></div></div><div id="remoteDetail" class="card hidden"></div></section>
<section id="signal" class="view"><div class="card"><b>RECEIVED SIGNAL DETAILS</b><pre id="signalText" class="muted detailText">No details loaded.</pre><button onclick="loadSignal()">REFRESH DETAILS</button></div></section>
<section id="files" class="view"><div class="card"><b>SD IMPORTS</b><p class="muted">Files are transactionally staged in /ripper/imports. Existing remotes and catalogs are never overwritten.</p><input id="uploadFile" class="fileInput" type="file"><button id="uploadButton" onclick="uploadFile()">UPLOAD TO RIPPER</button><div id="fileList"></div></div></section>
<section id="settings" class="view"><div class="card"><b>SAFE SETTINGS</b><p>Display brightness: <span id="brightnessValue">--</span>%</p><input id="brightness" aria-label="Display brightness" type="range" min="10" max="100" step="5"><button id="brightnessButton" onclick="saveBrightness()">APPLY BRIGHTNESS</button></div><div class="card"><b>HOME SCREEN APP</b><p class="muted">On iPhone choose Share → Add to Home Screen. On Android choose Add to Home screen from the browser menu.</p></div><div class="card"><b>CONNECTION</b><pre id="deviceInfo" class="muted detailText"></pre><button class="danger" onclick="unpair()">FORGET THIS RIPPER</button></div></section>
</main><script>
let key=localStorage.getItem('ripperKey')||'',active='mirror',lastGen=0,frameBusy=false,frameTimer=null,infoTimer=null,remoteOffset=0,remoteTotal=0,remoteLimit=8,pointerDown=false,lastMoveAt=0,lastPoint={x:0,y:0},holdTimer=null,touchQueue=Promise.resolve(),uploadBusy=false;
const q=(s)=>document.querySelector(s),qa=(s)=>[...document.querySelectorAll(s)];
function url(path,extra=''){return path+(path.includes('?')?'&':'?')+'key='+encodeURIComponent(key)+(extra?'&'+extra:'')}
function showNotice(message,tone='warn',source='ui'){let n=q('#phoneNotice');n.textContent=message;n.dataset.source=source;n.className='phoneNotice '+tone}
function clearNotice(source=''){let n=q('#phoneNotice');if(source&&n.dataset.source!==source)return;n.textContent='';n.dataset.source='';n.className='phoneNotice hidden'}
function markOnline(){q('#link').textContent='CONNECTED';q('#link').classList.remove('offline');clearNotice('network')}
function markOffline(){q('#link').textContent='RETRYING';q('#link').classList.add('offline');showNotice('Connection lost. Ripper will retry automatically.','warn','network')}
async function api(path,opt={}){try{opt.cache='no-store';let r=await fetch(url(path),opt);if(r.status===401){showLogin('Pairing password was rejected.');throw Error('unauthorized')}markOnline();return r}catch(e){if(e.message!=='unauthorized')markOffline();throw e}}
function showLogin(msg=''){if(msg)stopFrames();q('#app').classList.add('hidden');q('#login').classList.remove('hidden');q('#loginError').textContent=msg;q('#keyInput').value=key}
function showApp(){q('#login').classList.add('hidden');q('#app').classList.remove('hidden')}
async function pair(){key=q('#keyInput').value.trim();if(!key)return;localStorage.setItem('ripperKey',key);showApp();startFrames();try{let r=await api('/api/info');if(!r.ok)throw Error();await refreshInfo();loadRemotes()}catch(e){if(e.message==='unauthorized')showLogin('Pairing password was rejected.');else markOffline()}}
function unpair(){localStorage.removeItem('ripperKey');key='';stopFrames();showLogin()}
async function refreshInfo(){try{let r=await api('/api/info');if(!r.ok)throw Error('Device status unavailable');let j=await r.json();q('#version').textContent='v'+j.version;q('#activity').textContent=j.status;q('#battery').textContent=j.battery<0?'BAT --':'BAT '+j.battery+'%';q('#brightness').value=j.brightness;q('#brightnessValue').textContent=j.brightness;q('#deviceInfo').textContent='RipperZero '+j.version+'\n'+j.ip+'\nSD: '+j.sd_free_mb+' MB free\nIR remotes: '+j.ir_remotes+'\nRF remotes: '+j.rf_remotes;return true}catch(e){if(active==='settings')q('#deviceInfo').textContent='Ripper connection unavailable. Retrying…';return false}}
async function frame(force=false){if(active!=='mirror'||frameBusy)return;frameBusy=true;try{let r=await api('/api/screen?generation='+(force?0:lastGen));if(r.status===204||r.status===429)return;if(!r.ok)throw Error();let x=Number(r.headers.get('X-Ripper-X')||0),y=Number(r.headers.get('X-Ripper-Y')||0),w=Number(r.headers.get('X-Ripper-Width')||320),h=Number(r.headers.get('X-Ripper-Height')||480),b=await r.arrayBuffer();if(w<1||h<1||x<0||y<0||x+w>320||y+h>480||b.byteLength!==w*h*2)throw Error();lastGen=Number(r.headers.get('X-Ripper-Generation')||lastGen);let d=new DataView(b),ctx=q('#screen').getContext('2d'),im=ctx.createImageData(w,h),p=im.data;for(let i=0,o=0;i<w*h;i++,o+=4){let v=d.getUint16(i*2,true);p[o]=((v>>11)&31)*255/31;p[o+1]=((v>>5)&63)*255/63;p[o+2]=(v&31)*255/31;p[o+3]=255}ctx.putImageData(im,x,y)}catch(e){}finally{frameBusy=false}}
function startFrames(){stopFrames();frame(true);frameTimer=setInterval(()=>frame(),160);infoTimer=setInterval(()=>refreshInfo(),1500)}function stopFrames(){if(frameTimer)clearInterval(frameTimer);if(infoTimer)clearInterval(infoTimer);if(holdTimer)clearInterval(holdTimer);frameTimer=infoTimer=holdTimer=null;pointerDown=false}
function screenPoint(e){let r=q('#screen').getBoundingClientRect();return{x:Math.max(0,Math.min(319,Math.round((e.clientX-r.left)*320/r.width))),y:Math.max(0,Math.min(479,Math.round((e.clientY-r.top)*480/r.height)))}}
function queueTouch(action,p){let body='action='+action+'&x='+p.x+'&y='+p.y;touchQueue=touchQueue.catch(()=>{}).then(()=>api('/api/touch',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body}));return touchQueue}
q('#screen').addEventListener('pointerdown',e=>{e.preventDefault();pointerDown=true;lastPoint=screenPoint(e);q('#screen').setPointerCapture(e.pointerId);queueTouch('down',lastPoint);if(navigator.vibrate)navigator.vibrate(8);if(holdTimer)clearInterval(holdTimer);holdTimer=setInterval(()=>{if(pointerDown)queueTouch('move',lastPoint)},900)});
q('#screen').addEventListener('pointermove',e=>{if(!pointerDown)return;e.preventDefault();lastPoint=screenPoint(e);let now=Date.now();if(now-lastMoveAt>=35){lastMoveAt=now;queueTouch('move',lastPoint)}});
function finishPointer(e){if(!pointerDown)return;e.preventDefault();pointerDown=false;if(holdTimer)clearInterval(holdTimer);holdTimer=null;queueTouch('up',lastPoint);setTimeout(()=>frame(),90)}
q('#screen').addEventListener('pointerup',finishPointer);q('#screen').addEventListener('pointercancel',finishPointer);
qa('.nav').forEach(b=>b.onclick=()=>{qa('.nav').forEach(x=>x.classList.toggle('active',x===b));qa('.view').forEach(v=>v.classList.toggle('active',v.id===b.dataset.view));active=b.dataset.view;window.scrollTo(0,0);if(active==='mirror')frame(true);if(active==='remotes')loadRemotes();if(active==='signal')loadSignal();if(active==='files')loadFiles();if(active==='settings')refreshInfo()});
async function loadRemotes(offset=remoteOffset){try{remoteOffset=Math.max(0,offset);let r=await api('/api/remotes?offset='+remoteOffset+'&limit='+remoteLimit);if(!r.ok)throw Error('Remote list unavailable');let j=await r.json(),h='';remoteTotal=j.total||0;if(remoteOffset>=remoteTotal&&remoteOffset>0){remoteOffset=Math.max(0,remoteOffset-remoteLimit);return loadRemotes(remoteOffset)}for(let x of j.remotes)h+=`<div class="remote card"><div><b>${esc(x.name)}</b><div class="muted">${x.type.toUpperCase()} · ${x.buttons} buttons · ${x.pages} page(s)</div></div><button onclick="openRemote('${x.type}','${x.id}',0)">OPEN</button></div>`;q('#remoteList').innerHTML=h||'<p class="muted">No saved remotes.</p>';let page=Math.floor(remoteOffset/remoteLimit)+1,pages=Math.max(1,Math.ceil(remoteTotal/remoteLimit));q('#remotePager').innerHTML=(remoteOffset>0?`<button onclick="loadRemotes(${Math.max(0,remoteOffset-remoteLimit)})">PREVIOUS</button>`:'')+`<span class="button muted">PAGE ${page} / ${pages}</span>`+(remoteOffset+remoteLimit<remoteTotal?`<button onclick="loadRemotes(${remoteOffset+remoteLimit})">NEXT</button>`:'')}catch(e){q('#remoteList').innerHTML='<p class="notice">Saved remotes are unavailable. Ripper will retry when you reopen this section.</p>';q('#remotePager').innerHTML=''}}
async function openRemote(type,id,page){try{let r=await api('/api/remote?type='+type+'&id='+id+'&page='+page),j=await r.json();if(!r.ok)throw Error(j.error||'REMOTE ERROR');let h=`<div class="remote"><b>${esc(j.name)}</b><button onclick="closeRemote()">BACK TO LIST</button></div><div class="buttons">`;for(let b of j.buttons)h+=`<button onclick="sendButton('${type}','${id}',${b.index})">${esc(b.label)}</button>`;h+='</div><div class="row">'+(page>0?`<button onclick="openRemote('${type}','${id}',${page-1})">PREVIOUS</button>`:'')+(page+1<j.pages?`<button onclick="openRemote('${type}','${id}',${page+1})">NEXT</button>`:'')+'</div>';q('#remoteDetail').innerHTML=h;q('#remoteBrowser').classList.add('hidden');q('#remoteDetail').classList.remove('hidden');window.scrollTo(0,0)}catch(e){q('#activity').textContent='REMOTE ERROR';showNotice(e.message||'Remote unavailable.','error')}}
function closeRemote(){q('#remoteDetail').classList.add('hidden');q('#remoteBrowser').classList.remove('hidden');window.scrollTo(0,0)}
async function sendButton(type,id,index){q('#activity').textContent='TRANSMITTING';try{let body=`key=${encodeURIComponent(key)}&type=${type}&id=${id}&index=${index}`,r=await api('/api/send',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body}),j=await r.json();if(!r.ok||!j.ok){q('#activity').textContent=j.error||'TRANSMIT FAILED';showNotice(j.error||'Transmit failed.','error');return}clearNotice();setTimeout(refreshInfo,700)}catch(e){q('#activity').textContent='TRANSMIT FAILED';showNotice('Transmit request failed. Check the Ripper connection.','error')}}
async function loadSignal(){try{let r=await api('/api/signal');if(!r.ok)throw Error();let j=await r.json();q('#signalText').textContent=`IR capture: ${j.ir.captured?'YES':'NO'}\nProtocol: ${j.ir.protocol}\nCarrier: ${j.ir.carrier_khz} kHz\nDuty cycle: ${j.ir.duty}%\nTimings: ${j.ir.timings}\n\nRF capture: ${j.rf.captured?'YES':'NO'}\nFrequency: ${j.rf.frequency_mhz} MHz\nModulation: ${j.rf.modulation}\nBit rate: ${j.rf.bit_rate}\nTimings: ${j.rf.timings}`}catch(e){q('#signalText').textContent='Signal details are unavailable. Ripper will retry when you refresh.'}}
async function loadFiles(){try{let r=await api('/api/files');if(!r.ok)throw Error();let j=await r.json(),h='';for(let f of j.files)h+=`<div class="remote card"><div class="fileName">${esc(f.name)}<div class="muted">${f.bytes} bytes</div></div><a class="button" href="${url('/api/file','name='+encodeURIComponent(f.name))}">DOWNLOAD</a></div>`;q('#fileList').innerHTML=h||'<p class="muted">No staged imports.</p>'}catch(e){q('#fileList').innerHTML='<p class="notice">SD imports are unavailable. Check the Ripper connection.</p>'}}
async function uploadFile(){if(uploadBusy)return;let f=q('#uploadFile').files[0];if(!f){showNotice('Choose a file before uploading.','warn');return}let button=q('#uploadButton');uploadBusy=true;button.disabled=true;button.textContent='UPLOADING…';showNotice('Uploading '+f.name+'…','warn');try{let d=new FormData();d.append('file',f);let r=await api('/api/upload',{method:'POST',body:d}),j=await r.json();if(!r.ok||!j.ok)throw Error(j.error||'Upload failed');showNotice('Upload saved safely.','success');await loadFiles()}catch(e){showNotice(e.message||'Upload failed. Existing files were not changed.','error')}finally{uploadBusy=false;button.disabled=false;button.textContent='UPLOAD TO RIPPER'}}
async function saveBrightness(){let button=q('#brightnessButton'),v=q('#brightness').value,body=`key=${encodeURIComponent(key)}&brightness=${v}`;button.disabled=true;try{let r=await api('/api/settings',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});if(!r.ok)throw Error();showNotice('Display brightness updated.','success');await refreshInfo()}catch(e){showNotice('Brightness was not changed. Check the Ripper connection.','error')}finally{button.disabled=false}}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
if(key){showApp();startFrames();refreshInfo();loadRemotes()}else showLogin();
</script></body></html>
)RIPPERHTML";


void ripper_mobile_manifest() {
  wifi_web_server.sendHeader("Cache-Control", "public, max-age=3600");
  wifi_web_server.send_P(200, "application/manifest+json",
                         RIPPER_MOBILE_MANIFEST);
}


void ripper_mobile_icon() {
  wifi_web_server.sendHeader("Cache-Control", "public, max-age=86400");
  wifi_web_server.send_P(200, "image/svg+xml", RIPPER_MOBILE_ICON_SVG);
}


bool ripper_mobile_authorized() {
  if (!wifi_web_server.hasArg("key")) return false;
  const String supplied = wifi_web_server.arg("key");
  const char *expected = wifi_control_password();
  if (supplied.length() != strlen(expected)) return false;
  uint8_t different = 0;
  for (size_t i = 0; i < supplied.length(); i++)
    different |= (uint8_t)supplied[i] ^ (uint8_t)expected[i];
  return different == 0;
}


bool ripper_mobile_require_auth() {
  if (ripper_mobile_authorized()) return true;
  wifi_web_server.send(401, "application/json",
                       "{\"ok\":false,\"error\":\"PAIRING REQUIRED\"}");
  return false;
}


uint64_t ripper_mobile_parse_id(const String &text) {
  if (text.length() == 0 || text.length() > 16) return 0;
  for (size_t i = 0; i < text.length(); i++) {
    const char c = text[i];
    if (!isxdigit((unsigned char)c)) return 0;
  }
  return strtoull(text.c_str(), NULL, 16);
}


String ripper_mobile_id(uint64_t id) {
  char text[17];
  snprintf(text, sizeof(text), "%016llx", (unsigned long long)id);
  return String(text);
}


bool ripper_mobile_safe_filename(const String &name, char *output,
                                 size_t output_size) {
  if (name.length() == 0 || name.length() > 64 || output_size < 2) return false;
  size_t used = 0;
  for (size_t i = 0; i < name.length() && used + 1 < output_size; i++) {
    const char c = name[i];
    if (isalnum((unsigned char)c) || c == '.' || c == '-' || c == '_')
      output[used++] = c;
    else if (c == ' ')
      output[used++] = '_';
    else
      return false;
  }
  output[used] = '\0';
  return used > 0 && strcmp(output, ".") != 0 && strcmp(output, "..") != 0;
}


void ripper_mobile_info() {
  if (!ripper_mobile_require_auth()) return;
  if (sd_card_ready) {
    sd_card_total_bytes = SD_MMC.totalBytes();
    sd_card_used_bytes = SD_MMC.usedBytes();
  }
  const uint64_t free_bytes = sd_card_total_bytes >= sd_card_used_bytes ?
    sd_card_total_bytes - sd_card_used_bytes : 0;
  String json;
  json.reserve(320);
  json = "{\"ok\":true,\"version\":\"" RIPPER_VERSION "\",\"backup\":";
  json += RIPPER_BACKUP_COUNT;
  json += ",\"status\":\"" + wifi_json_escape(global_status_text) + "\"";
  json += ",\"battery\":" + String(battery_percent);
  json += ",\"brightness\":" + String(display_brightness);
  json += ",\"ip\":\"" + WiFi.softAPIP().toString() + "\"";
  json += ",\"sd_ready\":" + String(sd_card_ready ? "true" : "false");
  json += ",\"sd_free_mb\":" + String((unsigned long)(free_bytes / 1048576ULL));
  json += ",\"ir_remotes\":" + String(ripper_ir_repository_count);
  json += ",\"rf_remotes\":" + String(ripper_rf_repository_count);
  json += ",\"mirror_ready\":" + String(ripper_mobile_framebuffer != NULL ? "true" : "false") + "}";
  wifi_web_server.sendHeader("Cache-Control", "no-store");
  wifi_web_server.send(200, "application/json", json);
}


void ripper_mobile_screen() {
  if (!ripper_mobile_require_auth()) return;
  if (ripper_mobile_framebuffer == NULL) {
    wifi_web_server.send(503, "application/json",
                         "{\"ok\":false,\"error\":\"SCREEN MIRROR UNAVAILABLE\"}");
    return;
  }
  const uint32_t requested_generation =
    wifi_web_server.hasArg("generation") ?
      strtoul(wifi_web_server.arg("generation").c_str(), NULL, 10) : 0;
  const uint32_t current_generation = ripper_mobile_frame_generation;
  if (requested_generation != 0 && requested_generation == current_generation) {
    wifi_web_server.send(204, "application/octet-stream", "");
    return;
  }

  int16_t x1 = 0;
  int16_t y1 = 0;
  int16_t x2 = RIPPER_MOBILE_FRAME_WIDTH - 1;
  int16_t y2 = RIPPER_MOBILE_FRAME_HEIGHT - 1;
  bool have_changes = requested_generation == 0 ||
                      requested_generation > current_generation;
  if (!have_changes) {
    x1 = RIPPER_MOBILE_FRAME_WIDTH;
    y1 = RIPPER_MOBILE_FRAME_HEIGHT;
    x2 = -1;
    y2 = -1;
    for (uint8_t row = 0; row < RIPPER_MOBILE_TILE_ROWS; row++) {
      for (uint8_t column = 0; column < RIPPER_MOBILE_TILE_COLUMNS; column++) {
        const uint16_t tile = row * RIPPER_MOBILE_TILE_COLUMNS + column;
        if (ripper_mobile_tile_generation[tile] <= requested_generation)
          continue;
        have_changes = true;
        x1 = min(x1, (int16_t)(column * RIPPER_MOBILE_TILE_SIZE));
        y1 = min(y1, (int16_t)(row * RIPPER_MOBILE_TILE_SIZE));
        x2 = max(x2, (int16_t)min(
          RIPPER_MOBILE_FRAME_WIDTH - 1,
          (column + 1) * RIPPER_MOBILE_TILE_SIZE - 1));
        y2 = max(y2, (int16_t)min(
          RIPPER_MOBILE_FRAME_HEIGHT - 1,
          (row + 1) * RIPPER_MOBILE_TILE_SIZE - 1));
      }
    }
  }
  if (!have_changes) {
    wifi_web_server.send(204, "application/octet-stream", "");
    return;
  }
  if ((uint32_t)(millis() - ripper_mobile_last_frame_ms) < 70) {
    wifi_web_server.send(429, "application/json",
                         "{\"ok\":false,\"error\":\"FRAME RATE LIMITED\"}");
    return;
  }
  ripper_mobile_last_frame_ms = millis();
  const uint16_t frame_width = x2 - x1 + 1;
  const uint16_t frame_height = y2 - y1 + 1;
  const uint32_t content_length =
    (uint32_t)frame_width * frame_height * sizeof(uint16_t);
  WiFiClient client = wifi_web_server.client();
  client.printf("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\n"
                "Content-Length: %lu\r\nCache-Control: no-store\r\n"
                "X-Ripper-Generation: %lu\r\nX-Ripper-X: %d\r\n"
                "X-Ripper-Y: %d\r\nX-Ripper-Width: %u\r\n"
                "X-Ripper-Height: %u\r\nConnection: close\r\n\r\n",
                (unsigned long)content_length,
                (unsigned long)current_generation,
                x1, y1, frame_width, frame_height);
  for (int16_t y = y1; y <= y2 && client.connected(); y++) {
    const uint8_t *row_bytes = (const uint8_t *)&ripper_mobile_framebuffer[
      (uint32_t)y * RIPPER_MOBILE_FRAME_WIDTH + x1];
    uint32_t remaining = (uint32_t)frame_width * sizeof(uint16_t);
    while (remaining > 0 && client.connected()) {
      const size_t chunk = min((uint32_t)4096, remaining);
      const size_t wrote = client.write(row_bytes, chunk);
      if (wrote == 0) return;
      row_bytes += wrote;
      remaining -= wrote;
    }
    yield();
  }
}


void ripper_mobile_tap() {
  if (!ripper_mobile_require_auth()) return;
  if (!wifi_web_server.hasArg("x") || !wifi_web_server.hasArg("y")) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"MISSING COORDINATES\"}");
    return;
  }
  const int x = wifi_web_server.arg("x").toInt();
  const int y = wifi_web_server.arg("y").toInt();
  if (x < 0 || x >= RIPPER_MOBILE_FRAME_WIDTH ||
      y < 0 || y >= RIPPER_MOBILE_FRAME_HEIGHT) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"COORDINATES OUT OF RANGE\"}");
    return;
  }
  ripper_mobile_touch_x = x;
  ripper_mobile_touch_y = y;
  ripper_mobile_pointer_pressed = false;
  ripper_mobile_touch_seen = false;
  ripper_mobile_touch_release_ms = millis() + 90;
  ripper_mobile_touch_phase = 1;
  wifi_web_server.send(202, "application/json", "{\"ok\":true}");
}


void ripper_mobile_touch() {
  if (!ripper_mobile_require_auth()) return;
  if (!wifi_web_server.hasArg("action") ||
      !wifi_web_server.hasArg("x") || !wifi_web_server.hasArg("y")) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"MISSING TOUCH DATA\"}");
    return;
  }
  const String action = wifi_web_server.arg("action");
  const int x = wifi_web_server.arg("x").toInt();
  const int y = wifi_web_server.arg("y").toInt();
  if ((action != "down" && action != "move" && action != "up") ||
      x < 0 || x >= RIPPER_MOBILE_FRAME_WIDTH ||
      y < 0 || y >= RIPPER_MOBILE_FRAME_HEIGHT) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"INVALID TOUCH DATA\"}");
    return;
  }
  ripper_mobile_touch_phase = 0;
  ripper_mobile_touch_seen = false;
  ripper_mobile_touch_x = x;
  ripper_mobile_touch_y = y;
  ripper_mobile_pointer_last_event_ms = millis();
  ripper_mobile_pointer_pressed = action != "up";
  auto_shutdown_last_activity_ms = millis();
  wifi_web_server.send(202, "application/json", "{\"ok\":true}");
}


void ripper_mobile_remotes() {
  if (!ripper_mobile_require_auth()) return;
  const uint32_t total = 1 + ripper_rf_repository_count +
                         ripper_ir_repository_count;
  uint32_t offset = wifi_web_server.hasArg("offset") ?
    strtoul(wifi_web_server.arg("offset").c_str(), NULL, 10) : 0;
  uint8_t limit = wifi_web_server.hasArg("limit") ?
    constrain(wifi_web_server.arg("limit").toInt(), 1, 20) : 12;
  String json;
  json.reserve(4096);
  json = "{\"ok\":true,\"total\":" + String(total) + ",\"remotes\":[";
  uint8_t emitted = 0;
  for (uint32_t logical = offset; logical < total && emitted < limit; logical++) {
    if (emitted++) json += ',';
    if (logical == 0) {
      json += "{\"type\":\"hunter\",\"id\":\"hunter\",\"name\":\"HUNTER FAN\",\"buttons\":4,\"pages\":1}";
      continue;
    }
    const uint32_t repository_ordinal = logical - 1;
    if (repository_ordinal < ripper_rf_repository_count) {
      RipperRfIndexEntryV1 entry = {};
      if (!ripper_rf_repository_read_metadata(repository_ordinal, entry)) {
        json += "{\"type\":\"rf\",\"id\":\"invalid\",\"name\":\"UNAVAILABLE\",\"buttons\":0,\"pages\":0}";
        continue;
      }
      json += "{\"type\":\"rf\",\"id\":\"" + ripper_mobile_id(entry.remote_id) +
              "\",\"name\":\"" + wifi_json_escape(entry.name) +
              "\",\"buttons\":" + String(entry.button_count) +
              ",\"pages\":" + String(entry.page_count) + "}";
    } else {
      RipperIrIndexEntryV1 entry = {};
      const uint32_t ir_ordinal = repository_ordinal - ripper_rf_repository_count;
      if (!ripper_ir_repository_read_metadata(ir_ordinal, entry)) {
        json += "{\"type\":\"ir\",\"id\":\"invalid\",\"name\":\"UNAVAILABLE\",\"buttons\":0,\"pages\":0}";
        continue;
      }
      json += "{\"type\":\"ir\",\"id\":\"" + ripper_mobile_id(entry.remote_id) +
              "\",\"name\":\"" + wifi_json_escape(entry.name) +
              "\",\"buttons\":" + String(entry.button_count) +
              ",\"pages\":" + String(entry.page_count) + "}";
    }
  }
  json += "]}";
  wifi_web_server.sendHeader("Cache-Control", "no-store");
  wifi_web_server.send(200, "application/json", json);
}


void ripper_mobile_remote() {
  if (!ripper_mobile_require_auth()) return;
  const String type = wifi_web_server.arg("type");
  const uint8_t requested_page = constrain(wifi_web_server.arg("page").toInt(), 0, 255);
  if (type == "hunter") {
    wifi_web_server.send(200, "application/json",
      "{\"ok\":true,\"name\":\"HUNTER FAN\",\"pages\":1,\"buttons\":["
      "{\"index\":0,\"label\":\"FAN POWER\"},{\"index\":1,\"label\":\"LIGHT\"},"
      "{\"index\":2,\"label\":\"SPEED +\"},{\"index\":3,\"label\":\"SPEED -\"}]}");
    return;
  }
  const uint64_t remote_id = ripper_mobile_parse_id(wifi_web_server.arg("id"));
  if (remote_id == 0 || (type != "ir" && type != "rf")) {
    wifi_web_server.send(400, "application/json",
                         "{\"ok\":false,\"error\":\"INVALID REMOTE\"}");
    return;
  }
  String json;
  json.reserve(4096);
  bool valid = false;
  if (type == "ir") {
    RipperIrIndexEntryV1 entry = {};
    if (ripper_ir_repository_find(remote_id, entry) &&
        requested_page < entry.page_count &&
        validate_ripper_ir_remote_file(entry.file_path, remote_id)) {
      File file = SD_MMC.open(entry.file_path, FILE_READ);
      RipperIrRemoteFileHeaderV1 header = {};
      valid = file && file.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
      json = "{\"ok\":true,\"name\":\"" + wifi_json_escape(entry.name) +
             "\",\"pages\":" + String(entry.page_count) + ",\"buttons\":[";
      uint8_t emitted = 0;
      for (uint16_t index = 0; valid && index < header.button_count; index++) {
        RipperIrButtonDiskV1 disk = {};
        valid = file.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
                disk.record_size == sizeof(disk);
        if (!valid) break;
        if (disk.page == requested_page) {
          if (emitted++) json += ',';
          json += "{\"index\":" + String(index) + ",\"label\":\"" +
                  wifi_json_escape(disk.label) + "\"}";
        }
        valid = file.seek(file.position() +
                          (uint32_t)disk.raw_timing_count * sizeof(uint16_t));
      }
      if (file) file.close();
      json += "]}";
    }
  } else {
    RipperRfIndexEntryV1 entry = {};
    if (ripper_rf_repository_find(remote_id, entry) &&
        requested_page < entry.page_count &&
        validate_ripper_rf_remote_file(entry.file_path, remote_id)) {
      File file = SD_MMC.open(entry.file_path, FILE_READ);
      RipperRfRemoteFileHeaderV1 header = {};
      valid = file && file.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
      json = "{\"ok\":true,\"name\":\"" + wifi_json_escape(entry.name) +
             "\",\"pages\":" + String(entry.page_count) + ",\"buttons\":[";
      uint8_t emitted = 0;
      for (uint16_t index = 0; valid && index < header.button_count; index++) {
        RipperRfButtonDiskV1 disk = {};
        valid = file.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk) &&
                disk.record_size == sizeof(disk);
        if (!valid) break;
        if (disk.page == requested_page) {
          if (emitted++) json += ',';
          json += "{\"index\":" + String(index) + ",\"label\":\"" +
                  wifi_json_escape(disk.label) + "\"}";
        }
        valid = file.seek(file.position() + ripper_rf_button_timing_bytes(disk));
      }
      if (file) file.close();
      json += "]}";
    }
  }
  if (!valid) {
    wifi_web_server.send(404, "application/json",
                         "{\"ok\":false,\"error\":\"REMOTE UNAVAILABLE\"}");
    return;
  }
  wifi_web_server.sendHeader("Cache-Control", "no-store");
  wifi_web_server.send(200, "application/json", json);
}


void ripper_mobile_send() {
  if (!ripper_mobile_require_auth()) return;
  if ((uint32_t)(millis() - ripper_mobile_last_transmit_ms) < 250) {
    wifi_web_server.send(429, "application/json",
                         "{\"ok\":false,\"error\":\"TRANSMIT RATE LIMITED\"}");
    return;
  }
  if (rf_capture_active || ir_receiver_test_active) {
    wifi_web_server.send(409, "application/json",
                         "{\"ok\":false,\"error\":\"RIPPER IS LISTENING\"}");
    return;
  }
  const String type = wifi_web_server.arg("type");
  const uint16_t button_index = constrain(wifi_web_server.arg("index").toInt(), 0, 65535);
  bool sent = false;
  const char *error = "REMOTE UNAVAILABLE";
  set_status("TRANSMITTING", type == "ir" ? COLOR_IR : COLOR_RF);
  if (type == "hunter") {
    sent = button_index < 4 && transmit_hunter_tx45(button_index, 4);
    error = "HUNTER SEND FAILED";
  } else {
    const uint64_t remote_id = ripper_mobile_parse_id(wifi_web_server.arg("id"));
    if (type == "ir") {
      RipperIrIndexEntryV1 entry = {};
      if (remote_id != 0 && ripper_ir_repository_find(remote_id, entry))
        sent = send_repository_ir_button_from_path(
          entry.file_path, entry.button_count, button_index);
      error = ir_repository_send_error;
    } else if (type == "rf") {
      RipperRfIndexEntryV1 entry = {};
      if (remote_id != 0 && ripper_rf_repository_find(remote_id, entry))
        sent = replay_repository_rf_button_from_path(
          entry.file_path, entry.button_count, button_index);
      error = rf_repository_send_error;
    }
  }
  ripper_mobile_last_transmit_ms = millis();
  if (sent) {
    transmitting_status_until_ms = millis() + 650;
    wifi_web_server.send(200, "application/json", "{\"ok\":true}");
  } else {
    set_status(error != NULL && error[0] != '\0' ? error : "TRANSMIT FAILED",
               COLOR_RED);
    String json = "{\"ok\":false,\"error\":\"" +
                  wifi_json_escape(error) + "\"}";
    wifi_web_server.send(422, "application/json", json);
  }
}


