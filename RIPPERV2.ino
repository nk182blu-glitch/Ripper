  lv_label_set_text_fmt(ir_raw_transmitter_value_labels[2], "REPEAT FRAMES  %u",
                        ir_raw_lab_repeat_count);
  lv_label_set_text_fmt(ir_raw_transmitter_value_labels[3], "REPEAT GAP  %u ms",
