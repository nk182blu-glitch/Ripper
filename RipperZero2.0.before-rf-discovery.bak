// ============================================================
// GENERIC SECONDARY PAGE
// ============================================================

lv_obj_t *create_page(
  const char *title,
  const char *description,
  uint32_t accent_color
) {

  lv_obj_t *screen =
    lv_obj_create(NULL);


  lv_obj_set_style_bg_color(
    screen,
    lv_color_hex(COLOR_BG),
    LV_PART_MAIN
  );


  lv_obj_set_style_bg_opa(
    screen,
    LV_OPA_COVER,
    LV_PART_MAIN
  );


  create_header(
    screen,
    title
  );


  lv_obj_t *panel =
    lv_obj_create(screen);


  lv_obj_set_size(
    panel,
    280,
    220
  );


  lv_obj_align(
    panel,
    LV_ALIGN_CENTER,
    0,
    15
  );


  lv_obj_set_style_pad_all(
    panel,
    0,
    LV_PART_MAIN
  );


  lv_obj_set_style_bg_color(
    panel,
    lv_color_hex(COLOR_PANEL),
    LV_PART_MAIN
  );


  lv_obj_set_style_bg_opa(
    panel,
    LV_OPA_COVER,
    LV_PART_MAIN
  );


  lv_obj_set_style_border_width(
    panel,
    2,
    LV_PART_MAIN
  );


  lv_obj_set_style_border_color(
    panel,
    lv_color_hex(accent_color),
    LV_PART_MAIN
  );


  lv_obj_set_style_radius(
    panel,
    16,
    LV_PART_MAIN
  );


  lv_obj_t *description_label =
    lv_label_create(panel);


  lv_label_set_text(
    description_label,
    description
  );


  lv_obj_set_style_text_color(
    description_label,
    lv_color_hex(COLOR_MUTED),
    LV_PART_MAIN
  );


  lv_obj_set_style_text_font(
    description_label,
    &lv_font_montserrat_12,
    LV_PART_MAIN
  );


  lv_obj_align(
    description_label,
    LV_ALIGN_TOP_MID,
    0,
    25
  );


  lv_obj_t *coming =
    lv_label_create(panel);


  lv_label_set_text(
    coming,
    "COMING SOON"
  );


  lv_obj_set_style_text_color(
    coming,
    lv_color_hex(accent_color),
    LV_PART_MAIN
  );


  lv_obj_set_style_text_font(
    coming,
    &lv_font_montserrat_16,
    LV_PART_MAIN
  );


  lv_obj_align(
    coming,
    LV_ALIGN_CENTER,
    0,
    0
  );


  lv_obj_t *home_btn =
    create_button(
      panel,
      55,
      150,
      170,
      48,
      "<  HOME",
      accent_color,
      go_home
    );


  create_footer(
    screen
  );


  return screen;
}


