                             sizeof(pending_ir_repository_delete_ids));
  saved_preferences.end();
}


void queue_pending_ir_repository_delete(uint64_t remote_id) {
  if (remote_id == 0) return;
  for (uint8_t i = 0; i < MAX_IR_SAVED_REMOTES; i++) {
    if (pending_ir_repository_delete_ids[i] == remote_id) return;
    if (pending_ir_repository_delete_ids[i] == 0) {
      pending_ir_repository_delete_ids[i] = remote_id;
      persist_pending_ir_repository_deletes();
      return;
    }
  }
  Serial.println("IR repository delete queue full; SD deletion deferred");
}


uint64_t generate_saved_ir_remote_id() {
  for (uint8_t attempt = 0; attempt < 16; attempt++) {
    uint64_t candidate = ((uint64_t)esp_random() << 32) | esp_random();
    if (candidate == 0) continue;
    bool duplicate = false;
    for (uint8_t i = 0; i < saved_ir_remote_count; i++) {
      if (saved_ir_remote_ids[i] == candidate) {
        duplicate = true;
        break;
      }
    }
    if (!duplicate) return candidate;
  }
  uint64_t fallback = ((uint64_t)millis() << 32) ^ 0x5249505045524952ULL;
  return fallback == 0 ? 1 : fallback;
}


void load_saved_ir_remote_ids() {
  memset(saved_ir_remote_ids, 0, sizeof(saved_ir_remote_ids));
  memset(pending_ir_repository_delete_ids, 0, sizeof(pending_ir_repository_delete_ids));
  saved_preferences.begin("ripperzero", true);
  const size_t stored_bytes = saved_preferences.getBytesLength("irRemoteIds");
  if (stored_bytes == sizeof(saved_ir_remote_ids)) {
    saved_preferences.getBytes("irRemoteIds", saved_ir_remote_ids, sizeof(saved_ir_remote_ids));
  }
  if (saved_preferences.getBytesLength("irDeleteIds") ==
      sizeof(pending_ir_repository_delete_ids)) {
    saved_preferences.getBytes("irDeleteIds", pending_ir_repository_delete_ids,
                               sizeof(pending_ir_repository_delete_ids));
  }
  saved_preferences.end();

  bool changed = stored_bytes != sizeof(saved_ir_remote_ids);
  for (uint8_t i = 0; i < saved_ir_remote_count; i++) {
    if (saved_ir_remote_ids[i] == 0) {
      // Match Stage 1's deterministic ID so its verified migration file is
      // adopted instead of duplicated when persistent identities are added.
      saved_ir_remote_ids[i] = calculate_legacy_ir_remote_id(i);
      if (saved_ir_remote_ids[i] == 0) saved_ir_remote_ids[i] = generate_saved_ir_remote_id();
      changed = true;
    }
  }
  for (uint8_t i = saved_ir_remote_count; i < MAX_IR_SAVED_REMOTES; i++) {
    if (saved_ir_remote_ids[i] != 0) {
      saved_ir_remote_ids[i] = 0;
      changed = true;
    }
  }
  if (changed) persist_saved_ir_remote_ids();
}


void make_legacy_ir_button_disk(uint8_t remote_index, uint8_t button_index,
                                RipperIrButtonDiskV1 &disk) {
  memset(&disk, 0, sizeof(disk));
  const SavedIrRemoteRecord &remote = saved_ir_remotes[remote_index];
  const SavedIrRemoteCommand &command = remote.buttons[button_index];
  disk.record_size = sizeof(disk);
  disk.button_id = button_index + 1;
  disk.page = 0;
  disk.encoding = RIPPER_IR_ENCODING_PARSED;
  disk.behavior_flags =
    (strcmp(remote.button_names[button_index], "VOLUME UP") == 0 ||
     strcmp(remote.button_names[button_index], "VOLUME DOWN") == 0) ?
      RIPPER_IR_BEHAVIOR_HOLD_REPEAT : 0;
  disk.repeat_count = 1;
  disk.repeat_gap_ms = 0;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  disk.width = 0;
  disk.height = 0;
  if (saved_ir_layouts[remote_index].magic == SAVED_REMOTE_LAYOUT_MAGIC &&
      button_index < MAX_UNIVERSAL_BUTTONS) {
    disk.x = saved_ir_layouts[remote_index].x[button_index];
    disk.y = saved_ir_layouts[remote_index].y[button_index];
  }
  disk.carrier_hz = 38000;
  disk.protocol = command.protocol;
  disk.address = command.address;
  disk.command = command.command;
  disk.extra = command.extra;
  disk.bits = command.bits;
  disk.flags = command.flags;
  disk.decoded_raw_data = command.raw_data;
  disk.raw_timing_count = 0;
  strlcpy(disk.label, remote.button_names[button_index], sizeof(disk.label));
}


bool validate_ripper_ir_remote_file(const char *path, uint64_t expected_remote_id) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;

  RipperIrRemoteFileHeaderV1 header = {};
  const bool header_read = file.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  if (!header_read || header.magic != RIPPER_IR_FILE_MAGIC ||
      header.version != RIPPER_IR_FILE_VERSION || header.header_size != sizeof(header) ||
      header.header_crc32 != ripper_ir_header_crc(header) ||
      (expected_remote_id != 0 && header.remote_id != expected_remote_id) ||
      header.button_count > 1024 || header.page_count == 0 ||
      ((header.source_flags & RIPPER_IR_SOURCE_LEGACY_NVS) != 0 &&
       header.payload_bytes != (uint32_t)header.button_count * sizeof(RipperIrButtonDiskV1)) ||
      header.payload_bytes > 4UL * 1024UL * 1024UL ||
      file.size() != sizeof(header) + header.payload_bytes) {
    file.close();
    return false;
  }

  uint32_t structured_bytes = 0;
  for (uint16_t button = 0; button < header.button_count; button++) {
    RipperIrButtonDiskV1 disk = {};
    if (file.read((uint8_t *)&disk, sizeof(disk)) != sizeof(disk) ||
        disk.record_size != sizeof(disk) || disk.page >= header.page_count ||
        (disk.encoding != RIPPER_IR_ENCODING_PARSED &&
         disk.encoding != RIPPER_IR_ENCODING_RAW_TIMINGS)) {
      file.close();
      return false;
    }
    const uint32_t timing_bytes = (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    structured_bytes += sizeof(disk) + timing_bytes;
    if (structured_bytes > header.payload_bytes ||
        (disk.encoding == RIPPER_IR_ENCODING_PARSED && disk.raw_timing_count != 0) ||
        !file.seek(sizeof(header) + structured_bytes)) {
      file.close();
      return false;
    }
  }
  if (structured_bytes != header.payload_bytes || !file.seek(sizeof(header))) {
    file.close();
    return false;
  }

  uint8_t buffer[256];
  uint32_t remaining = header.payload_bytes;
  uint32_t crc = 0xFFFFFFFFUL;
  while (remaining > 0) {
    const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
    const size_t read_count = file.read(buffer, chunk);
    if (read_count != chunk) {
      file.close();
      return false;
    }
    crc = ripper_crc32_update(crc, buffer, read_count);
    remaining -= read_count;
  }
  file.close();
  return (~crc) == header.payload_crc32;
}


bool ripper_ir_path_ends_with(const char *path, const char *suffix) {
  if (path == NULL || suffix == NULL) return false;
  const size_t path_length = strlen(path);
  const size_t suffix_length = strlen(suffix);
  return path_length >= suffix_length &&
         strcmp(path + path_length - suffix_length, suffix) == 0;
}


bool ripper_ir_repository_ensure_directories() {
  if (!sd_card_ready) return false;
  if (!SD_MMC.exists(RIPPER_IR_STORAGE_ROOT) && !SD_MMC.mkdir(RIPPER_IR_STORAGE_ROOT)) return false;
  if (!SD_MMC.exists(RIPPER_IR_REMOTE_DIR) && !SD_MMC.mkdir(RIPPER_IR_REMOTE_DIR)) return false;
  return true;
}


bool ripper_ir_repository_has_space(uint64_t required_bytes) {
  if (!sd_card_ready) return false;
  sd_card_total_bytes = SD_MMC.totalBytes();
  sd_card_used_bytes = SD_MMC.usedBytes();
  const uint64_t free_bytes = sd_card_total_bytes >= sd_card_used_bytes ?
    sd_card_total_bytes - sd_card_used_bytes : 0;
  return free_bytes >= required_bytes + RIPPER_IR_REPOSITORY_RESERVE_BYTES;
}


bool ripper_ir_read_remote_header(const char *path, RipperIrRemoteFileHeaderV1 &header) {
  memset(&header, 0, sizeof(header));
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  const bool read_ok = file.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  file.close();
  return read_ok && header.magic == RIPPER_IR_FILE_MAGIC &&
         header.version == RIPPER_IR_FILE_VERSION &&
         header.header_size == sizeof(header) &&
         header.header_crc32 == ripper_ir_header_crc(header);
}


bool ripper_ir_repository_read_button(const char *path, uint16_t requested_button,
                                      RipperIrButtonDiskV1 &button,
                                      uint16_t *raw_timings, uint16_t raw_capacity,
                                      uint16_t &raw_count) {
  raw_count = 0;
  if (!sd_card_ready || path == NULL) return false;
  // Browsing trusts the compact index, but opening a remote verifies the
  // complete individual file before any command is exposed for transmission.
  if (!validate_ripper_ir_remote_file(path, 0)) return false;
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;

  RipperIrRemoteFileHeaderV1 header = {};
  if (file.read((uint8_t *)&header, sizeof(header)) != sizeof(header) ||
      header.magic != RIPPER_IR_FILE_MAGIC || header.version != RIPPER_IR_FILE_VERSION ||
      header.header_size != sizeof(header) || header.header_crc32 != ripper_ir_header_crc(header) ||
      requested_button >= header.button_count) {
    file.close();
    return false;
  }

  for (uint16_t index = 0; index < header.button_count; index++) {
    if (file.read((uint8_t *)&button, sizeof(button)) != sizeof(button) ||
        button.record_size != sizeof(button)) {
      file.close();
      return false;
    }
    if (index == requested_button) {
      raw_count = button.raw_timing_count;
      if (raw_count > 0) {
        if (raw_timings == NULL && raw_capacity == 0) {
          file.close();
          return true;
        }
        if (raw_timings == NULL || raw_count > raw_capacity ||
            file.read((uint8_t *)raw_timings, raw_count * sizeof(uint16_t)) !=
              raw_count * sizeof(uint16_t)) {
          file.close();
          raw_count = 0;
          return false;
        }
      }
      file.close();
      return true;
    }
    const uint32_t skip_bytes = (uint32_t)button.raw_timing_count * sizeof(uint16_t);
    if (!file.seek(file.position() + skip_bytes)) {
      file.close();
      return false;
    }
  }
  file.close();
  return false;
}


bool validate_ripper_ir_index_file(const char *path, RipperIrIndexHeaderV1 *header_out = NULL) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  RipperIrIndexHeaderV1 header = {};
  const bool valid_header = file.read((uint8_t *)&header, sizeof(header)) == sizeof(header) &&
    header.magic == RIPPER_IR_INDEX_MAGIC && header.version == RIPPER_IR_INDEX_VERSION &&
    header.header_size == sizeof(header) && header.record_size == sizeof(RipperIrIndexEntryV1) &&
    header.entry_count <= 65535UL && header.header_crc32 == ripper_ir_index_header_crc(header) &&
    file.size() == sizeof(header) + (uint64_t)header.entry_count * sizeof(RipperIrIndexEntryV1);
  if (!valid_header) {
    file.close();
    return false;
  }

  uint8_t buffer[256];
  uint32_t remaining = header.entry_count * sizeof(RipperIrIndexEntryV1);
  uint32_t crc = 0xFFFFFFFFUL;
  while (remaining > 0) {
    const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
    const size_t read_count = file.read(buffer, chunk);
    if (read_count != chunk) {
      file.close();
      return false;
    }
    crc = ripper_crc32_update(crc, buffer, read_count);
    remaining -= read_count;
  }
  file.close();
  if ((~crc) != header.records_crc32) return false;
  if (header_out != NULL) *header_out = header;
  return true;
}


bool ripper_ir_repository_read_metadata(uint32_t ordinal, RipperIrIndexEntryV1 &entry) {
  memset(&entry, 0, sizeof(entry));
  if (!ripper_ir_repository_ready || ordinal >= ripper_ir_repository_count) return false;
  File file = SD_MMC.open(RIPPER_IR_INDEX_PATH, FILE_READ);
  if (!file) return false;
  const uint64_t offset = sizeof(RipperIrIndexHeaderV1) +
    (uint64_t)ordinal * sizeof(RipperIrIndexEntryV1);
  const bool ok = file.seek(offset) &&
    file.read((uint8_t *)&entry, sizeof(entry)) == sizeof(entry) &&
    entry.record_size == sizeof(entry);
  file.close();
  return ok;
}


bool ripper_ir_repository_find(uint64_t remote_id, RipperIrIndexEntryV1 &entry,
                               uint32_t *ordinal_out = NULL) {
  for (uint32_t ordinal = 0; ordinal < ripper_ir_repository_count; ordinal++) {
    if (!ripper_ir_repository_read_metadata(ordinal, entry)) return false;
    if (entry.remote_id == remote_id) {
      if (ordinal_out != NULL) *ordinal_out = ordinal;
      return true;
    }
  }
  return false;
}


uint32_t ripper_ir_tombstone_crc(RipperIrTombstoneV1 tombstone) {
  tombstone.crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&tombstone, sizeof(tombstone));
}


bool validate_ripper_ir_tombstone(const char *path, uint64_t expected_remote_id) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  RipperIrTombstoneV1 tombstone = {};
  const bool valid = file.size() == sizeof(tombstone) &&
    file.read((uint8_t *)&tombstone, sizeof(tombstone)) == sizeof(tombstone) &&
    tombstone.magic == RIPPER_IR_TOMBSTONE_MAGIC &&
    (expected_remote_id == 0 || tombstone.remote_id == expected_remote_id) &&
    tombstone.crc32 == ripper_ir_tombstone_crc(tombstone);
  file.close();
  return valid;
}


bool write_ripper_ir_tombstone(const char *remote_path, uint64_t remote_id) {
  char marker_path[112];
  char temporary_path[120];
  snprintf(marker_path, sizeof(marker_path), "%s.deleted", remote_path);
  snprintf(temporary_path, sizeof(temporary_path), "%s.tmp", marker_path);
  if (validate_ripper_ir_tombstone(marker_path, remote_id)) return true;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  RipperIrTombstoneV1 tombstone = {};
  tombstone.magic = RIPPER_IR_TOMBSTONE_MAGIC;
  tombstone.remote_id = remote_id;
  tombstone.crc32 = ripper_ir_tombstone_crc(tombstone);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  const bool wrote = file.write((const uint8_t *)&tombstone, sizeof(tombstone)) == sizeof(tombstone);
  file.flush();
  file.close();
  if (!wrote || !validate_ripper_ir_tombstone(temporary_path, remote_id)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
  return SD_MMC.rename(temporary_path, marker_path) &&
         validate_ripper_ir_tombstone(marker_path, remote_id);
}


bool ripper_ir_repository_make_staging_path(uint64_t remote_id, char *path, size_t path_size) {
  if (path == NULL || path_size == 0) return false;
  RipperIrIndexEntryV1 existing = {};
  if (ripper_ir_repository_find(remote_id, existing)) {
    return snprintf(path, path_size, "%s.tmp", existing.file_path) < (int)path_size;
  }
  return snprintf(path, path_size, RIPPER_IR_REMOTE_DIR "/%08lx%08lx.rrf.tmp",
                  (unsigned long)(remote_id >> 32),
                  (unsigned long)remote_id) < (int)path_size;
}


void ripper_ir_repository_set_state_from_index() {
  RipperIrIndexHeaderV1 header = {};
  ripper_ir_repository_ready = validate_ripper_ir_index_file(RIPPER_IR_INDEX_PATH, &header);
  ripper_ir_repository_count = ripper_ir_repository_ready ? header.entry_count : 0;
  ripper_ir_repository_generation = ripper_ir_repository_ready ? header.generation : 0;
}


bool ripper_ir_repository_commit_index_temp() {
  if (!validate_ripper_ir_index_file(RIPPER_IR_INDEX_TEMP_PATH)) return false;
  if (SD_MMC.exists(RIPPER_IR_INDEX_BACKUP_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_BACKUP_PATH);
  const bool had_index = SD_MMC.exists(RIPPER_IR_INDEX_PATH);
  if (had_index && !SD_MMC.rename(RIPPER_IR_INDEX_PATH, RIPPER_IR_INDEX_BACKUP_PATH)) return false;
  if (!SD_MMC.rename(RIPPER_IR_INDEX_TEMP_PATH, RIPPER_IR_INDEX_PATH) ||
      !validate_ripper_ir_index_file(RIPPER_IR_INDEX_PATH)) {
    if (SD_MMC.exists(RIPPER_IR_INDEX_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_PATH);
    if (had_index) SD_MMC.rename(RIPPER_IR_INDEX_BACKUP_PATH, RIPPER_IR_INDEX_PATH);
    return false;
  }
  if (SD_MMC.exists(RIPPER_IR_INDEX_BACKUP_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_BACKUP_PATH);
  ripper_ir_repository_set_state_from_index();
  return ripper_ir_repository_ready;
}


bool rebuild_ripper_ir_repository_index() {
  if (!ripper_ir_repository_ensure_directories()) return false;
  File directory = SD_MMC.open(RIPPER_IR_REMOTE_DIR, FILE_READ);
  if (!directory || !directory.isDirectory()) {
    if (directory) directory.close();
    return false;
  }
  if (SD_MMC.exists(RIPPER_IR_INDEX_TEMP_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_TEMP_PATH);
  File index = SD_MMC.open(RIPPER_IR_INDEX_TEMP_PATH, FILE_WRITE);
  if (!index) {
    directory.close();
    return false;
  }

  RipperIrIndexHeaderV1 index_header = {};
  bool wrote = index.write((const uint8_t *)&index_header, sizeof(index_header)) == sizeof(index_header);
  uint32_t records_crc = 0xFFFFFFFFUL;
  uint32_t entry_count = 0;
  File candidate = directory.openNextFile();
  while (candidate && wrote) {
    char path[128] = {};
    const char *candidate_name = candidate.name();
    if (candidate_name != NULL && candidate_name[0] == '/') {
      strlcpy(path, candidate_name, sizeof(path));
    } else if (candidate_name != NULL) {
      snprintf(path, sizeof(path), RIPPER_IR_REMOTE_DIR "/%s", candidate_name);
    }
    const bool regular_remote = !candidate.isDirectory() && ripper_ir_path_ends_with(path, ".rrf");
    candidate.close();

    if (regular_remote && validate_ripper_ir_remote_file(path, 0)) {
      RipperIrRemoteFileHeaderV1 remote_header = {};
      if (ripper_ir_read_remote_header(path, remote_header)) {
        RipperIrIndexEntryV1 entry = {};
        entry.record_size = sizeof(entry);
        entry.remote_id = remote_header.remote_id;
        entry.source_flags = remote_header.source_flags;
        File remote_file = SD_MMC.open(path, FILE_READ);
        entry.file_bytes = remote_file ? remote_file.size() : 0;
        if (remote_file) remote_file.close();
        entry.button_count = remote_header.button_count;
        entry.page_count = remote_header.page_count;
        strlcpy(entry.name, remote_header.name, sizeof(entry.name));
        strlcpy(entry.device_type, remote_header.device_type, sizeof(entry.device_type));
        strlcpy(entry.manufacturer, remote_header.manufacturer, sizeof(entry.manufacturer));
        strlcpy(entry.model, remote_header.model, sizeof(entry.model));
        strlcpy(entry.file_path, path, sizeof(entry.file_path));
        wrote = index.write((const uint8_t *)&entry, sizeof(entry)) == sizeof(entry);
        if (wrote) {
          records_crc = ripper_crc32_update(records_crc, (const uint8_t *)&entry, sizeof(entry));
          entry_count++;
        }
      }
    } else if (regular_remote) {
      Serial.printf("IR repository skipped corrupt remote: %s\n", path);
    }
    candidate = directory.openNextFile();
  }
  if (candidate) candidate.close();
  directory.close();

  if (!wrote) {
    index.close();
    SD_MMC.remove(RIPPER_IR_INDEX_TEMP_PATH);
    return false;
  }
  index_header.magic = RIPPER_IR_INDEX_MAGIC;
  index_header.version = RIPPER_IR_INDEX_VERSION;
  index_header.header_size = sizeof(index_header);
  index_header.record_size = sizeof(RipperIrIndexEntryV1);
  index_header.entry_count = entry_count;
  index_header.generation = ripper_ir_repository_generation + 1;
  index_header.records_crc32 = ~records_crc;
  index_header.header_crc32 = ripper_ir_index_header_crc(index_header);
  wrote = index.seek(0) &&
    index.write((const uint8_t *)&index_header, sizeof(index_header)) == sizeof(index_header);
  index.flush();
  index.close();
  if (!wrote || !ripper_ir_repository_commit_index_temp()) {
    SD_MMC.remove(RIPPER_IR_INDEX_TEMP_PATH);
    return false;
  }
  Serial.printf("IR repository index ready: %lu remote(s), generation %lu\n",
                (unsigned long)ripper_ir_repository_count,
                (unsigned long)ripper_ir_repository_generation);
  return true;
}


bool recover_ripper_ir_repository_transactions() {
  if (!ripper_ir_repository_ensure_directories()) return false;
  bool transaction_found = false;
  File directory = SD_MMC.open(RIPPER_IR_REMOTE_DIR, FILE_READ);
  if (!directory || !directory.isDirectory()) {
    if (directory) directory.close();
    return false;
  }
  File candidate = directory.openNextFile();
  while (candidate) {
    char path[128] = {};
    const char *candidate_name = candidate.name();
    if (candidate_name != NULL && candidate_name[0] == '/') {
      strlcpy(path, candidate_name, sizeof(path));
    } else if (candidate_name != NULL) {
      snprintf(path, sizeof(path), RIPPER_IR_REMOTE_DIR "/%s", candidate_name);
    }
    const bool is_file = !candidate.isDirectory();
    candidate.close();

    if (is_file && ripper_ir_path_ends_with(path, ".rrf.deleted.tmp")) {
      transaction_found = true;
      char marker_path[128] = {};
      strlcpy(marker_path, path, sizeof(marker_path));
      marker_path[strlen(marker_path) - 4] = '\0';
      if (validate_ripper_ir_tombstone(marker_path, 0)) {
        SD_MMC.remove(path);
      } else if (validate_ripper_ir_tombstone(path, 0)) {
        if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
        SD_MMC.rename(path, marker_path);
      } else {
        SD_MMC.remove(path);
      }
    } else if (is_file && ripper_ir_path_ends_with(path, ".rrf.tmp")) {
      transaction_found = true;
      char final_path[128] = {};
      strlcpy(final_path, path, sizeof(final_path));
      final_path[strlen(final_path) - 4] = '\0';
      if (validate_ripper_ir_remote_file(final_path, 0)) {
        SD_MMC.remove(path);
      } else if (validate_ripper_ir_remote_file(path, 0)) {
        if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
        if (!SD_MMC.rename(path, final_path)) {
          Serial.printf("IR repository will retry interrupted commit: %s\n", path);
        }
      } else {
        SD_MMC.remove(path);
      }
    } else if (is_file && ripper_ir_path_ends_with(path, ".rrf.del")) {
      transaction_found = true;
      char original_path[128] = {};
      char marker_path[136] = {};
      strlcpy(original_path, path, sizeof(original_path));
      original_path[strlen(original_path) - 4] = '\0';
      snprintf(marker_path, sizeof(marker_path), "%s.deleted", original_path);
      RipperIrRemoteFileHeaderV1 deleted_header = {};
      if (ripper_ir_read_remote_header(path, deleted_header) &&
          validate_ripper_ir_tombstone(marker_path, deleted_header.remote_id)) {
        SD_MMC.remove(path);
      } else if (validate_ripper_ir_remote_file(original_path, 0)) {
        SD_MMC.remove(path);
      } else {
        if (SD_MMC.exists(original_path)) SD_MMC.remove(original_path);
        SD_MMC.rename(path, original_path);
      }
    } else if (is_file && ripper_ir_path_ends_with(path, ".rrf.bak")) {
      transaction_found = true;
      char final_path[128] = {};
      strlcpy(final_path, path, sizeof(final_path));
      final_path[strlen(final_path) - 4] = '\0';
      if (validate_ripper_ir_remote_file(final_path, 0)) {
        SD_MMC.remove(path);
      } else if (validate_ripper_ir_remote_file(path, 0)) {
        if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
        SD_MMC.rename(path, final_path);
      }
    }
    candidate = directory.openNextFile();
  }
  if (candidate) candidate.close();
  directory.close();
  return transaction_found;
}


bool ripper_ir_repository_commit_staged(const char *staged_path) {
  if (!sd_card_ready || staged_path == NULL ||
      !ripper_ir_path_ends_with(staged_path, ".rrf.tmp") ||
      !validate_ripper_ir_remote_file(staged_path, 0)) return false;
  RipperIrRemoteFileHeaderV1 header = {};
  if (!ripper_ir_read_remote_header(staged_path, header)) return false;

  char expected_staged_path[112];
  if (!ripper_ir_repository_make_staging_path(header.remote_id, expected_staged_path,
                                               sizeof(expected_staged_path)) ||
      strcmp(staged_path, expected_staged_path) != 0) return false;
  char final_path[96] = {};
  char backup_path[104];
  strlcpy(final_path, staged_path, sizeof(final_path));
  final_path[strlen(final_path) - 4] = '\0';
  snprintf(backup_path, sizeof(backup_path), "%s.bak", final_path);
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  const bool replacing = SD_MMC.exists(final_path);
  if (replacing && !SD_MMC.rename(final_path, backup_path)) return false;
  if (!SD_MMC.rename(staged_path, final_path) ||
      !validate_ripper_ir_remote_file(final_path, header.remote_id) ||
      !rebuild_ripper_ir_repository_index()) {
    if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
    if (replacing) SD_MMC.rename(backup_path, final_path);
    rebuild_ripper_ir_repository_index();
    return false;
  }
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  char marker_path[112];
  snprintf(marker_path, sizeof(marker_path), "%s.deleted", final_path);
  if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
  return true;
}


bool ripper_ir_repository_delete(uint64_t remote_id) {
  RipperIrIndexEntryV1 entry = {};
  if (!ripper_ir_repository_find(remote_id, entry) ||
      strncmp(entry.file_path, RIPPER_IR_REMOTE_DIR "/", strlen(RIPPER_IR_REMOTE_DIR) + 1) != 0 ||
      !ripper_ir_path_ends_with(entry.file_path, ".rrf")) return false;
  char tombstone_path[104];
  snprintf(tombstone_path, sizeof(tombstone_path), "%s.del", entry.file_path);
  if (SD_MMC.exists(tombstone_path)) SD_MMC.remove(tombstone_path);
  if (!write_ripper_ir_tombstone(entry.file_path, remote_id)) return false;
  if (!SD_MMC.rename(entry.file_path, tombstone_path)) {
    char marker_path[112];
    snprintf(marker_path, sizeof(marker_path), "%s.deleted", entry.file_path);
    SD_MMC.remove(marker_path);
    return false;
  }
  if (!rebuild_ripper_ir_repository_index()) {
    SD_MMC.rename(tombstone_path, entry.file_path);
    char marker_path[112];
    snprintf(marker_path, sizeof(marker_path), "%s.deleted", entry.file_path);
    SD_MMC.remove(marker_path);
    rebuild_ripper_ir_repository_index();
    return false;
  }
  SD_MMC.remove(tombstone_path);
  return true;
}


bool initialize_ripper_ir_repository() {
  ripper_ir_repository_ready = false;
  ripper_ir_repository_count = 0;
  if (!ripper_ir_repository_ensure_directories()) return false;
  const bool recovered_transaction = recover_ripper_ir_repository_transactions();
  if (recovered_transaction) return rebuild_ripper_ir_repository_index();

  RipperIrIndexHeaderV1 header = {};
  if (validate_ripper_ir_index_file(RIPPER_IR_INDEX_PATH, &header)) {
    if (SD_MMC.exists(RIPPER_IR_INDEX_TEMP_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_TEMP_PATH);
    if (SD_MMC.exists(RIPPER_IR_INDEX_BACKUP_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_BACKUP_PATH);
    ripper_ir_repository_set_state_from_index();
    return true;
  }
  if (validate_ripper_ir_index_file(RIPPER_IR_INDEX_TEMP_PATH)) {
    if (SD_MMC.exists(RIPPER_IR_INDEX_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_PATH);
    if (SD_MMC.rename(RIPPER_IR_INDEX_TEMP_PATH, RIPPER_IR_INDEX_PATH)) {
      ripper_ir_repository_set_state_from_index();
      if (ripper_ir_repository_ready) return true;
    }
  }
  if (validate_ripper_ir_index_file(RIPPER_IR_INDEX_BACKUP_PATH)) {
    if (SD_MMC.exists(RIPPER_IR_INDEX_PATH)) SD_MMC.remove(RIPPER_IR_INDEX_PATH);
    if (SD_MMC.rename(RIPPER_IR_INDEX_BACKUP_PATH, RIPPER_IR_INDEX_PATH)) {
      ripper_ir_repository_set_state_from_index();
      if (ripper_ir_repository_ready) return true;
    }
  }
  return rebuild_ripper_ir_repository_index();
}


bool write_legacy_ir_remote_to_sd(uint8_t remote_index) {
  if (!sd_card_ready || remote_index >= saved_ir_remote_count) return false;
  const SavedIrRemoteRecord &remote = saved_ir_remotes[remote_index];
  if (remote.magic != SAVED_IR_REMOTE_MAGIC || remote.button_count == 0 ||
      remote.button_count > MAX_IR_REMOTE_BUTTONS) return false;

  if (!ripper_ir_repository_ensure_directories()) return false;

  const uint64_t remote_id = legacy_ir_remote_id(remote_index);
  char temporary_path[112];
  if (!ripper_ir_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  char final_path[96] = {};
  strlcpy(final_path, temporary_path, sizeof(final_path));
  final_path[strlen(final_path) - 4] = '\0';

  char deleted_marker_path[112];
  snprintf(deleted_marker_path, sizeof(deleted_marker_path), "%s.deleted", final_path);
  if (validate_ripper_ir_tombstone(deleted_marker_path, remote_id)) {
    Serial.printf("IR NVS recovery copy remains hidden after user deletion: %s\n", remote.name);
    return true;
  }

  const uint32_t payload_bytes = remote.button_count * sizeof(RipperIrButtonDiskV1);
  if (!ripper_ir_repository_has_space((uint64_t)sizeof(RipperIrRemoteFileHeaderV1) + payload_bytes)) {
    Serial.printf("IR SD migration skipped for %s: insufficient free space\n", remote.name);
    return false;
  }

  uint32_t payload_crc = 0xFFFFFFFFUL;
  for (uint8_t button = 0; button < remote.button_count; button++) {
    RipperIrButtonDiskV1 disk = {};
    make_legacy_ir_button_disk(remote_index, button, disk);
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk, sizeof(disk));
  }
  payload_crc = ~payload_crc;

  RipperIrRemoteFileHeaderV1 header = {};
  header.magic = RIPPER_IR_FILE_MAGIC;
  header.version = RIPPER_IR_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = remote_id;
  header.source_flags = RIPPER_IR_SOURCE_LEGACY_NVS;
  strlcpy(header.name, remote.name, sizeof(header.name));
  strlcpy(header.device_type, "IR REMOTE", sizeof(header.device_type));
  header.button_count = remote.button_count;
  header.page_count = 1;
  header.payload_bytes = payload_bytes;
  header.payload_crc32 = payload_crc;
  header.header_crc32 = ripper_ir_header_crc(header);

  RipperIrRemoteFileHeaderV1 existing_header = {};
  if (validate_ripper_ir_remote_file(final_path, remote_id) &&
      ripper_ir_read_remote_header(final_path, existing_header) &&
      existing_header.header_crc32 == header.header_crc32 &&
      existing_header.payload_crc32 == header.payload_crc32) return true;

  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  bool wrote = file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  for (uint8_t button = 0; wrote && button < remote.button_count; button++) {
    RipperIrButtonDiskV1 disk = {};
    make_legacy_ir_button_disk(remote_index, button, disk);
    wrote = file.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
  }
  file.flush();
  file.close();

  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, remote_id)) {
    SD_MMC.remove(temporary_path);
    Serial.printf("IR SD migration verification failed for %s; NVS copy retained\n", remote.name);
    return false;
  }

  if (!ripper_ir_repository_commit_staged(temporary_path)) {
    Serial.printf("IR SD migration commit failed for %s; NVS copy retained\n", remote.name);
    return false;
  }

  Serial.printf("IR NVS recovery copy verified on SD: %s (%u buttons)\n",
                final_path, remote.button_count);
  return true;
}


void make_working_ir_button_disk(uint8_t button_index, RipperIrButtonDiskV1 &disk) {
  memset(&disk, 0, sizeof(disk));
  const SavedIrRemoteCommand &command = ir_working_remote.buttons[button_index];
  disk.record_size = sizeof(disk);
  disk.button_id = button_index + 1;
  disk.page = 0;
  disk.encoding = RIPPER_IR_ENCODING_PARSED;
  disk.behavior_flags =
    (strcmp(ir_working_remote.button_names[button_index], "VOLUME UP") == 0 ||
     strcmp(ir_working_remote.button_names[button_index], "VOLUME DOWN") == 0) ?
      RIPPER_IR_BEHAVIOR_HOLD_REPEAT : 0;
  disk.repeat_count = 1;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  disk.carrier_hz = 38000;
  disk.protocol = command.protocol;
  disk.address = command.address;
  disk.command = command.command;
  disk.extra = command.extra;
  disk.bits = command.bits;
  disk.flags = command.flags;
  disk.decoded_raw_data = command.raw_data;
  strlcpy(disk.label, ir_working_remote.button_names[button_index], sizeof(disk.label));
}


bool write_working_ir_remote_to_sd(uint64_t remote_id) {
  if (!sd_card_ready || !ripper_ir_repository_ready || remote_id == 0 ||
      ir_working_remote.magic != SAVED_IR_REMOTE_MAGIC ||
      ir_working_remote.button_count == 0 ||
      ir_working_remote.button_count > MAX_IR_REMOTE_BUTTONS ||
      !ripper_ir_repository_ensure_directories()) return false;

  char temporary_path[112];
  if (!ripper_ir_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  const uint32_t payload_bytes =
    (uint32_t)ir_working_remote.button_count * sizeof(RipperIrButtonDiskV1);
  if (!ripper_ir_repository_has_space((uint64_t)sizeof(RipperIrRemoteFileHeaderV1) +
                                      payload_bytes)) return false;

  uint32_t payload_crc = 0xFFFFFFFFUL;
  for (uint8_t button = 0; button < ir_working_remote.button_count; button++) {
    RipperIrButtonDiskV1 disk = {};
    make_working_ir_button_disk(button, disk);
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk, sizeof(disk));
  }

  RipperIrRemoteFileHeaderV1 header = {};
  header.magic = RIPPER_IR_FILE_MAGIC;
  header.version = RIPPER_IR_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = remote_id;
  header.source_flags = RIPPER_IR_SOURCE_RIPPER_LEARNED;
  strlcpy(header.name, ir_working_remote.name, sizeof(header.name));
  strlcpy(header.device_type,
          ir_guided_device_name != NULL && ir_guided_device_name[0] != '\0' ?
            ir_guided_device_name : "IR REMOTE",
          sizeof(header.device_type));
  header.button_count = ir_working_remote.button_count;
  header.page_count = 1;
  header.payload_bytes = payload_bytes;
  header.payload_crc32 = ~payload_crc;
  header.header_crc32 = ripper_ir_header_crc(header);

  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  bool wrote = file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  for (uint8_t button = 0; wrote && button < ir_working_remote.button_count; button++) {
    RipperIrButtonDiskV1 disk = {};
    make_working_ir_button_disk(button, disk);
    wrote = file.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
  }
  file.flush();
  file.close();
  if (!wrote || !validate_ripper_ir_remote_file(temporary_path, remote_id)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  return ripper_ir_repository_commit_staged(temporary_path);
}


void migrate_legacy_ir_remotes_to_sd() {
  if (!sd_card_ready || saved_ir_remote_count == 0) return;
  uint8_t verified = 0;
  for (uint8_t remote = 0; remote < saved_ir_remote_count; remote++) {
    if (write_legacy_ir_remote_to_sd(remote)) verified++;
  }
  sd_card_used_bytes = SD_MMC.usedBytes();
  Serial.printf("IR SD recovery migration: %u/%u verified; original NVS data retained\n",
                verified, saved_ir_remote_count);
  if (!rebuild_ripper_ir_repository_index()) {
    Serial.println("IR repository index rebuild failed; NVS data and remote files retained");
  }
}


bool validate_ir_discovery_database_file(const char *path) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file || file.size() < 80) {
    if (file) file.close();
    return false;
  }
  bool header_found = false;
  bool power_found = false;
  bool parsed_found = false;
  uint16_t lines_checked = 0;
  while (file.available() && lines_checked++ < 40) {
    String line = file.readStringUntil('\n');
    line.trim();
    if (line == "Filetype: IR library file") header_found = true;
    else if (line == "name: Power") power_found = true;
    else if (line == "type: parsed") parsed_found = true;
    if (header_found && power_found && parsed_found) break;
  }
  file.close();
  return header_found && power_found && parsed_found;
}


const char *ir_installer_protocol_name(uint8_t family, uint8_t bits) {
  if (family == 0) return "NEC";
  if (family == 1) return bits == 20 ? "SIRC20" : (bits == 15 ? "SIRC15" : "SIRC");
  if (family == 2) return "RC5";
  if (family == 3) return "RC6";
  return NULL;
}


bool install_ir_discovery_database_file(const char *path,
                                        const IrDiscoveryDbEntry *entries,
                                        uint16_t entry_count) {
  if (validate_ir_discovery_database_file(path)) return true;

  char temporary_path[96];
  char backup_path[96];
  snprintf(temporary_path, sizeof(temporary_path), "%s.tmp", path);
  snprintf(backup_path, sizeof(backup_path), "%s.invalid", path);
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);

  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  bool wrote = file.print("Filetype: IR library file\nVersion: 1\n#\n") > 0;
  for (uint16_t i = 0; wrote && i < entry_count; i++) {
    const IrDiscoveryDbEntry &entry = entries[i];
    const char *protocol = ir_installer_protocol_name(entry.family, entry.bits);
    if (protocol == NULL) continue;
    wrote = file.printf("name: Power\ntype: parsed\nprotocol: %s\n"
                        "address: %02X %02X 00 00\ncommand: %02X %02X 00 00\n#\n",
                        protocol,
                        entry.address & 0xFF, (entry.address >> 8) & 0xFF,
                        entry.command & 0xFF, (entry.command >> 8) & 0xFF) > 0;
  }
  file.flush();
  file.close();
  if (!wrote || !validate_ir_discovery_database_file(temporary_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }

  const bool replacing_invalid = SD_MMC.exists(path);
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  if (replacing_invalid && !SD_MMC.rename(path, backup_path)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  if (!SD_MMC.rename(temporary_path, path) ||
      !validate_ir_discovery_database_file(path)) {
    if (SD_MMC.exists(path)) SD_MMC.remove(path);
    if (replacing_invalid) SD_MMC.rename(backup_path, path);
    return false;
  }
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  return true;
}


bool install_missing_ir_discovery_databases() {
  if (!sd_card_ready) return false;
  if (!SD_MMC.exists("/infrared") && !SD_MMC.mkdir("/infrared")) return false;
  if (!SD_MMC.exists("/infrared/databases") &&
      !SD_MMC.mkdir("/infrared/databases")) return false;

  const bool tv_ok = install_ir_discovery_database_file(
    "/infrared/databases/tv.ir", IR_DISCOVERY_TV_DB, IR_DISCOVERY_TV_DB_COUNT);
  const bool projector_ok = install_ir_discovery_database_file(
    "/infrared/databases/projector.ir", IR_DISCOVERY_PROJECTOR_DB,
    IR_DISCOVERY_PROJECTOR_DB_COUNT);
  const bool audio_ok = install_ir_discovery_database_file(
    "/infrared/databases/audio.ir", IR_DISCOVERY_AUDIO_DB,
    IR_DISCOVERY_AUDIO_DB_COUNT);
  if (tv_ok && projector_ok && audio_ok) {
    Serial.printf("IR signal transmit databases ready: TV=%u, projector=%u, audio=%u supported codes\n",
                  IR_DISCOVERY_TV_DB_COUNT, IR_DISCOVERY_PROJECTOR_DB_COUNT,
                  IR_DISCOVERY_AUDIO_DB_COUNT);
    return true;
  }
  Serial.printf("IR signal transmit database install failed: TV=%s projector=%s audio=%s\n",
                tv_ok ? "OK" : "FAILED", projector_ok ? "OK" : "FAILED",
                audio_ok ? "OK" : "FAILED");
  return false;
}


bool catalog_usb_hex_path(const char *encoded, char *decoded, size_t decoded_size) {
  if (encoded == NULL || decoded == NULL) return false;
  const size_t encoded_length = strlen(encoded);
  if (encoded_length == 0 || (encoded_length & 1) != 0 ||
      encoded_length / 2 + 1 > decoded_size) return false;
  for (size_t i = 0; i < encoded_length; i += 2) {
    char pair[3] = {encoded[i], encoded[i + 1], 0};
    if (!isxdigit(pair[0]) || !isxdigit(pair[1])) return false;
    decoded[i / 2] = (char)strtoul(pair, NULL, 16);
  }
  decoded[encoded_length / 2] = '\0';
  return decoded[0] != '/' && strstr(decoded, "..") == NULL &&
         strchr(decoded, '\\') == NULL;
}


bool catalog_usb_ensure_parent_directories(const char *path) {
  char directory[512];
  strlcpy(directory, path, sizeof(directory));
  char *last_slash = strrchr(directory, '/');
  if (last_slash == NULL) return false;
  *last_slash = '\0';
  for (char *cursor = directory + 1; *cursor != '\0'; cursor++) {
    if (*cursor != '/') continue;
    *cursor = '\0';
    if (!SD_MMC.exists(directory) && !SD_MMC.mkdir(directory)) return false;
    *cursor = '/';
  }
  return SD_MMC.exists(directory) || SD_MMC.mkdir(directory);
}


bool catalog_usb_file_matches(const char *path, uint64_t expected_size,
                              uint32_t expected_crc) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file || file.size() != expected_size) {
    if (file) file.close();
    return false;
  }
  uint8_t buffer[1024];
  uint32_t crc = 0xFFFFFFFFUL;
  uint64_t processed = 0;
  while (file.available()) {
    const size_t count = file.read(buffer, sizeof(buffer));
    if (count == 0) {
      file.close();
      return false;
    }
    crc = ripper_crc32_update(crc, buffer, count);
    processed += count;
    if ((processed & 0xFFFFULL) == 0) delay(0);
  }
  file.close();
  return (~crc) == expected_crc;
}


bool catalog_usb_file_crc_state(const char *path, uint64_t &size,
                                uint32_t &running_crc) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  size = file.size();
  running_crc = 0xFFFFFFFFUL;
  uint8_t buffer[1024];
  uint64_t processed = 0;
  while (processed < size) {
    const size_t wanted = (size - processed) < sizeof(buffer) ?
      (size_t)(size - processed) : sizeof(buffer);
    const size_t count = file.read(buffer, wanted);
    if (count != wanted) {
      file.close();
      return false;
    }
    running_crc = ripper_crc32_update(running_crc, buffer, count);
    processed += count;
    if ((processed & 0xFFFFULL) == 0) delay(0);
  }
  file.close();
  return true;
}


void catalog_usb_abort(const char *reason) {
  if (catalog_usb_file) {
    catalog_usb_file.close();
  }
  if (catalog_usb_temp_path[0] != '\0' && SD_MMC.exists(catalog_usb_temp_path)) {
    SD_MMC.remove(catalog_usb_temp_path);
  }
  catalog_usb_receiving = false;
  catalog_usb_chunk_receiving = false;
  catalog_usb_chunk_expected = 0;
  catalog_usb_chunk_received = 0;
  catalog_usb_expected_bytes = 0;
  catalog_usb_received_bytes = 0;
  catalog_usb_final_path[0] = '\0';
  catalog_usb_temp_path[0] = '\0';
  release_catalog_usb_chunk_buffer();
  Serial.printf("RDB1 ERROR %s\n", reason == NULL ? "ABORTED" : reason);
}


void catalog_usb_pause() {
  if (catalog_usb_file) catalog_usb_file.close();
  catalog_usb_receiving = false;
  catalog_usb_chunk_receiving = false;
  catalog_usb_chunk_expected = 0;
  catalog_usb_chunk_received = 0;
  catalog_usb_expected_bytes = 0;
  catalog_usb_received_bytes = 0;
  catalog_usb_final_path[0] = '\0';
  catalog_usb_temp_path[0] = '\0';
  release_catalog_usb_chunk_buffer();
  Serial.println("RDB1 PAUSED");
}


bool catalog_usb_commit_file() {
  catalog_usb_file.flush();
  catalog_usb_file.close();
  if (catalog_usb_received_bytes != catalog_usb_expected_bytes ||
      (~catalog_usb_running_crc) != catalog_usb_expected_crc ||
      !catalog_usb_file_matches(catalog_usb_temp_path, catalog_usb_expected_bytes,
                                catalog_usb_expected_crc)) {
    catalog_usb_abort("VERIFY");
    return false;
  }

  char backup_path[520];
  snprintf(backup_path, sizeof(backup_path), "%s.bak", catalog_usb_final_path);
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  const bool replacing = SD_MMC.exists(catalog_usb_final_path);
  if (replacing && !SD_MMC.rename(catalog_usb_final_path, backup_path)) {
    catalog_usb_abort("BACKUP");
    return false;
  }
  if (!SD_MMC.rename(catalog_usb_temp_path, catalog_usb_final_path) ||
      !catalog_usb_file_matches(catalog_usb_final_path, catalog_usb_expected_bytes,
                                catalog_usb_expected_crc)) {
    if (SD_MMC.exists(catalog_usb_final_path)) SD_MMC.remove(catalog_usb_final_path);
    if (replacing) SD_MMC.rename(backup_path, catalog_usb_final_path);
    catalog_usb_abort("COMMIT");
    return false;
  }
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  catalog_usb_receiving = false;
  catalog_usb_final_path[0] = '\0';
  catalog_usb_temp_path[0] = '\0';
  release_catalog_usb_chunk_buffer();
  Serial.println("RDB1 OK");
  return true;
}


void catalog_usb_begin_put(char *arguments) {
  char *encoded_path = strtok(arguments, " ");
  char *size_text = strtok(NULL, " ");
  char *crc_text = strtok(NULL, " ");
  char relative_path[384];
  if (!sd_card_ready || encoded_path == NULL || size_text == NULL || crc_text == NULL ||
      !catalog_usb_hex_path(encoded_path, relative_path, sizeof(relative_path))) {
    Serial.println("RDB1 ERROR REQUEST");
    return;
  }
  const uint64_t file_size = strtoull(size_text, NULL, 10);
  const uint32_t file_crc = strtoul(crc_text, NULL, 16);
  if (file_size > RIPPER_CATALOG_USB_MAX_FILE_BYTES ||
      snprintf(catalog_usb_final_path, sizeof(catalog_usb_final_path), "%s%s",
               RIPPER_CATALOG_USB_PREFIX, relative_path) >=
        (int)sizeof(catalog_usb_final_path) ||
      snprintf(catalog_usb_temp_path, sizeof(catalog_usb_temp_path), "%s.tmp",
               catalog_usb_final_path) >= (int)sizeof(catalog_usb_temp_path)) {
    Serial.println("RDB1 ERROR PATH");
    return;
  }
  if (catalog_usb_file_matches(catalog_usb_final_path, file_size, file_crc)) {
    Serial.println("RDB1 SKIP");
    return;
  }
  if (!catalog_usb_ensure_parent_directories(catalog_usb_final_path)) {
    Serial.println("RDB1 ERROR DIRECTORY");
    return;
  }
  uint64_t resume_bytes = 0;
  uint32_t resume_crc = 0xFFFFFFFFUL;
  bool resume = false;
  if (SD_MMC.exists(catalog_usb_temp_path)) {
    if (!catalog_usb_file_crc_state(catalog_usb_temp_path, resume_bytes, resume_crc) ||
        resume_bytes > file_size) {
      SD_MMC.remove(catalog_usb_temp_path);
      resume_bytes = 0;
      resume_crc = 0xFFFFFFFFUL;
    } else {
      resume = true;
    }
  }
  sd_card_total_bytes = SD_MMC.totalBytes();
  sd_card_used_bytes = SD_MMC.usedBytes();
  const uint64_t remaining_bytes = file_size - resume_bytes;
  if (sd_card_total_bytes < sd_card_used_bytes ||
      sd_card_total_bytes - sd_card_used_bytes < remaining_bytes + 65536ULL) {
    Serial.println("RDB1 ERROR SPACE");
    return;
  }
  catalog_usb_file = SD_MMC.open(catalog_usb_temp_path,
                                 resume ? FILE_APPEND : FILE_WRITE);
  if (!catalog_usb_file) {
    Serial.println("RDB1 ERROR OPEN");
    return;
  }
  if (!ensure_catalog_usb_chunk_buffer()) {
    catalog_usb_file.close();
    if (SD_MMC.exists(catalog_usb_temp_path)) SD_MMC.remove(catalog_usb_temp_path);
    catalog_usb_final_path[0] = '\0';
    catalog_usb_temp_path[0] = '\0';
    return;
  }
  catalog_usb_expected_bytes = file_size;
  catalog_usb_received_bytes = resume_bytes;
  catalog_usb_expected_crc = file_crc;
  catalog_usb_running_crc = resume_crc;
  catalog_usb_last_data_ms = millis();
  catalog_usb_receiving = true;
  if (resume) {
    Serial.printf("RDB1 RESUME %llu %08lx\n",
                  (unsigned long long)resume_bytes,
                  (unsigned long)(~resume_crc));
  } else {
    Serial.println("RDB1 READY");
  }
  if (!resume && file_size == 0) catalog_usb_commit_file();
}


bool service_catalog_usb_transfer() {
  if (catalog_usb_receiving) {
    if (catalog_usb_chunk_receiving) {
      while (Serial.available() > 0 &&
             catalog_usb_chunk_received < catalog_usb_chunk_expected) {
        const size_t available = min(
          (size_t)Serial.available(),
          (size_t)(catalog_usb_chunk_expected - catalog_usb_chunk_received));
        const size_t count = Serial.readBytes(
          (char *)(catalog_usb_chunk_buffer + catalog_usb_chunk_received), available);
        if (count == 0) break;
        catalog_usb_chunk_received += count;
        catalog_usb_last_data_ms = millis();
      }
      if (catalog_usb_chunk_received == catalog_usb_chunk_expected) {
        uint32_t crc = ripper_crc32_update(
          0xFFFFFFFFUL, catalog_usb_chunk_buffer, catalog_usb_chunk_expected);
        if ((~crc) != catalog_usb_chunk_crc) {
          Serial.printf("RDB1 NAK %llu\n",
                        (unsigned long long)catalog_usb_received_bytes);
        } else if (catalog_usb_file.write(catalog_usb_chunk_buffer,
                                          catalog_usb_chunk_expected) !=
                   catalog_usb_chunk_expected) {
          catalog_usb_abort("WRITE");
          return false;
        } else {
          catalog_usb_running_crc = ripper_crc32_update(
            catalog_usb_running_crc, catalog_usb_chunk_buffer,
            catalog_usb_chunk_expected);
          catalog_usb_received_bytes += catalog_usb_chunk_expected;
          if ((catalog_usb_received_bytes % RIPPER_CATALOG_USB_DURABLE_INTERVAL) == 0 ||
              catalog_usb_received_bytes == catalog_usb_expected_bytes) {
            catalog_usb_file.flush();
          }
          Serial.printf("RDB1 ACK %llu\n",
                        (unsigned long long)catalog_usb_received_bytes);
        }
        catalog_usb_chunk_receiving = false;
        catalog_usb_chunk_expected = 0;
        catalog_usb_chunk_received = 0;
        catalog_usb_last_data_ms = millis();
      } else if ((uint32_t)(millis() - catalog_usb_last_data_ms) > 3000) {
        catalog_usb_chunk_receiving = false;
        catalog_usb_chunk_expected = 0;
        catalog_usb_chunk_received = 0;
        Serial.printf("RDB1 NAK %llu\n",
                      (unsigned long long)catalog_usb_received_bytes);
        catalog_usb_last_data_ms = millis();
      }
      catalog_usb_session_until_ms = millis() + 5000;
      return true;
    }

    while (Serial.available() > 0) {
      const char value = (char)Serial.read();
      if (value == '\r') continue;
      if (value != '\n') {
        if (catalog_usb_line_length + 1 >= sizeof(catalog_usb_line)) {
          catalog_usb_line_length = 0;
          Serial.printf("RDB1 NAK %llu\n",
                        (unsigned long long)catalog_usb_received_bytes);
        } else {
          catalog_usb_line[catalog_usb_line_length++] = value;
        }
        continue;
      }

      catalog_usb_line[catalog_usb_line_length] = '\0';
      if (strcmp(catalog_usb_line, "RDB1 ABORT") == 0) {
        catalog_usb_abort("ABORTED");
      } else if (strcmp(catalog_usb_line, "RDB1 PAUSE") == 0) {
        catalog_usb_pause();
      } else if (strcmp(catalog_usb_line, "RDB1 END") == 0) {
        if (catalog_usb_received_bytes == catalog_usb_expected_bytes) {
          catalog_usb_commit_file();
        } else {
          Serial.printf("RDB1 NAK %llu\n",
                        (unsigned long long)catalog_usb_received_bytes);
        }
      } else if (strncmp(catalog_usb_line, "RDB1 CHUNK ", 11) == 0) {
        char *offset_text = strtok(catalog_usb_line + 11, " ");
        char *length_text = strtok(NULL, " ");
        char *crc_text = strtok(NULL, " ");
        const uint64_t offset = offset_text == NULL ? UINT64_MAX :
          strtoull(offset_text, NULL, 10);
        const uint32_t length = length_text == NULL ? 0 :
          strtoul(length_text, NULL, 10);
        const uint32_t chunk_crc = crc_text == NULL ? 0 :
          strtoul(crc_text, NULL, 16);
        if (offset != catalog_usb_received_bytes || length == 0 ||
            length > RIPPER_CATALOG_USB_CHUNK_MAX ||
            catalog_usb_received_bytes + length > catalog_usb_expected_bytes) {
          Serial.printf("RDB1 NAK %llu\n",
                        (unsigned long long)catalog_usb_received_bytes);
        } else {
          catalog_usb_chunk_expected = (uint16_t)length;
          catalog_usb_chunk_received = 0;
          catalog_usb_chunk_crc = chunk_crc;
          catalog_usb_chunk_receiving = true;
          catalog_usb_last_data_ms = millis();
          catalog_usb_session_until_ms = millis() + 5000;
          Serial.println("RDB1 CHUNK READY");
        }
      } else if (catalog_usb_line_length > 0) {
        Serial.printf("RDB1 NAK %llu\n",
                      (unsigned long long)catalog_usb_received_bytes);
      }
      catalog_usb_line_length = 0;
      if (!catalog_usb_receiving) break;
    }
    if (catalog_usb_receiving &&
        (uint32_t)(millis() - catalog_usb_last_data_ms) > 15000) {
      Serial.printf("RDB1 NAK %llu\n",
                    (unsigned long long)catalog_usb_received_bytes);
      catalog_usb_last_data_ms = millis();
      catalog_usb_session_until_ms = millis() + 5000;
    }
    return true;
  }

  while (Serial.available() > 0) {
    const char value = (char)Serial.read();
    if (value == '\r') continue;
    if (value != '\n') {
      if (catalog_usb_line_length + 1 >= sizeof(catalog_usb_line)) {
        catalog_usb_line_length = 0;
        Serial.println("RDB1 ERROR LINE");
      } else {
        catalog_usb_line[catalog_usb_line_length++] = value;
      }
      continue;
    }
    catalog_usb_line[catalog_usb_line_length] = '\0';
    catalog_usb_session_until_ms = millis() + 5000;
    if (strcmp(catalog_usb_line, "RDB1 PING") == 0) {
      Serial.println(sd_card_ready ? "RDB1 PONG READY" : "RDB1 PONG NO_SD");
    } else if (strcmp(catalog_usb_line, "RDB1 PAUSE") == 0) {
      Serial.println("RDB1 PAUSED");
    } else if (strncmp(catalog_usb_line, "RDB1 PUT ", 9) == 0) {
      catalog_usb_begin_put(catalog_usb_line + 9);
    } else if (strncmp(catalog_usb_line, "RFC1 CHECK ", 11) == 0) {
      char *end = NULL;
      const unsigned long source = strtoul(catalog_usb_line + 11, &end, 10);
      if (end == catalog_usb_line + 11 || *end != '\0' || source > 1) {
        Serial.println("RFC1 ERROR INVALID_SOURCE");
      } else {
        run_ripper_rf_catalog_check((uint8_t)source);
      }
    } else if (strncmp(catalog_usb_line, "RFC1 IMPORT ", 12) == 0) {
      char *arguments = catalog_usb_line + 12;
      char *source_text = strtok(arguments, " ");
      char *profile_text = strtok(NULL, " ");
      char *extra = strtok(NULL, " ");
      char *source_end = NULL;
      char *profile_end = NULL;
      const unsigned long source = source_text == NULL ? ULONG_MAX :
        strtoul(source_text, &source_end, 10);
      const unsigned long profile = profile_text == NULL ? ULONG_MAX :
        strtoul(profile_text, &profile_end, 10);
      if (source_text == NULL || profile_text == NULL || extra != NULL ||
          source_end == source_text || *source_end != '\0' || source > 1 ||
          profile_end == profile_text || *profile_end != '\0') {
        Serial.println("RFC1 IMPORT ERROR REQUEST");
      } else {
        run_ripper_rf_catalog_import((uint8_t)source, (uint32_t)profile);
      }
    } else if (catalog_usb_line_length > 0) {
      Serial.println("RDB1 ERROR COMMAND");
    }
    catalog_usb_line_length = 0;
    if (catalog_usb_receiving) break;
  }
  return catalog_usb_receiving ||
         (int32_t)(catalog_usb_session_until_ms - millis()) > 0;
}


bool load_repository_ir_page(uint8_t requested_page) {
  if (!ir_working_remote_from_repository || ir_working_repository_path[0] == '\0' ||
      requested_page >= ir_working_repository_page_count ||
      !validate_ripper_ir_remote_file(ir_working_repository_path,
                                      ir_working_repository_id)) return false;
  File file = SD_MMC.open(ir_working_repository_path, FILE_READ);
  if (!file) return false;
  RipperIrRemoteFileHeaderV1 header = {};
  if (file.read((uint8_t *)&header, sizeof(header)) != sizeof(header)) {
    file.close(); return false;
  }

  SavedIrRemoteRecord loaded = {};
  loaded.magic = SAVED_IR_REMOTE_MAGIC;
  strlcpy(loaded.name, header.name, sizeof(loaded.name));
  memset(ir_working_repository_behavior, 0, sizeof(ir_working_repository_behavior));
  memset(ir_working_repository_repeats, 0, sizeof(ir_working_repository_repeats));
  memset(ir_working_repository_repeat_gaps, 0, sizeof(ir_working_repository_repeat_gaps));
  uint8_t cached = 0;
  bool overflow = false;
  for (uint16_t absolute_index = 0; absolute_index < header.button_count; absolute_index++) {
    RipperIrButtonDiskV1 disk = {};
    if (file.read((uint8_t *)&disk, sizeof(disk)) != sizeof(disk)) {
      file.close(); return false;
    }
    if (disk.page == requested_page) {
      if (cached >= MAX_IR_REMOTE_BUTTONS) {
        overflow = true;
      } else {
        strlcpy(loaded.button_names[cached], disk.label,
                sizeof(loaded.button_names[cached]));
        SavedIrRemoteCommand &command = loaded.buttons[cached];
        command.valid = 1;
        command.protocol = disk.protocol;
        command.address = disk.address;
        command.command = disk.command;
        command.extra = disk.extra;
        command.bits = disk.bits;
        command.flags = disk.flags;
        command.raw_data = disk.decoded_raw_data;
        ir_working_repository_behavior[cached] = disk.behavior_flags;
        ir_working_repository_repeats[cached] = disk.repeat_count == 0 ? 1 : disk.repeat_count;
        ir_working_repository_repeat_gaps[cached] = disk.repeat_gap_ms;
        ir_working_repository_absolute_indices[cached] = absolute_index;
        ir_working_repository_x[cached] = disk.x;
        ir_working_repository_y[cached] = disk.y;
        ir_working_repository_width[cached] = disk.width;
        ir_working_repository_height[cached] = disk.height;
        cached++;
      }
    }
    const uint32_t timing_bytes = (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    if (!file.seek(file.position() + timing_bytes)) {
      file.close(); return false;
    }
  }
  file.close();
  if (overflow || cached == 0) return false;
  loaded.button_count = cached;
  ir_working_remote = loaded;
  ir_working_repository_current_page = requested_page;
  return true;
}


bool load_repository_ir_remote_adapter(uint64_t remote_id) {
  if (!sd_card_ready || !ripper_ir_repository_ready || remote_id == 0) return false;
  RipperIrIndexEntryV1 metadata = {};
  if (!ripper_ir_repository_find(remote_id, metadata) || metadata.button_count == 0 ||
      metadata.button_count > 1024 || metadata.page_count == 0 ||
      !validate_ripper_ir_remote_file(metadata.file_path, remote_id)) return false;

  ir_working_remote_from_save = true;
  ir_working_remote_from_repository = true;
  ir_working_repository_id = remote_id;
  ir_working_repository_total_buttons = metadata.button_count;
  ir_working_repository_page_count = metadata.page_count;
  ir_working_repository_current_page = 0;
  strlcpy(ir_working_repository_path, metadata.file_path,
          sizeof(ir_working_repository_path));
  if (!load_repository_ir_page(0)) {
    clear_repository_ir_remote_adapter();
    return false;
  }
  return true;
}


