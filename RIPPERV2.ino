void open_ir_remote_layout_editor(lv_event_t *e) {
  if (!ir_working_remote_from_repository &&
      (selected_ir_saved_index < 0 || selected_ir_saved_index >= saved_ir_remote_count)) return;
  remote_layout_editing_ir = true;
  remote_layout_editing_remote_index = selected_ir_saved_index;
  if (ir_working_remote_from_repository) {
    memcpy(ir_repository_layout_backup_x, ir_working_repository_x,
           sizeof(ir_repository_layout_backup_x));
    memcpy(ir_repository_layout_backup_y, ir_working_repository_y,
           sizeof(ir_repository_layout_backup_y));
  } else {
    remote_layout_before_edit = saved_ir_layouts[selected_ir_saved_index];
  }
  remote_layout_selected_button = -1;
  remote_layout_delete_armed = false;
  refresh_remote_layout_editor();
  lv_scr_load(remote_layout_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void open_rf_remote_layout_editor(lv_event_t *e) {
  if (!rf_working_remote_from_repository &&
      (selected_saved_index < 0 || selected_saved_index >= saved_remote_count))
    return;
  remote_layout_editing_ir = false;
  remote_layout_editing_remote_index = selected_saved_index;
  if (rf_working_remote_from_repository) {
    for (uint8_t i = 0; i < universal_button_count; i++) {
      rf_repository_layout_backup_x[i] = rf_working_repository_x[i];
      rf_repository_layout_backup_y[i] = rf_working_repository_y[i];
    }
  } else {
    remote_layout_before_edit = saved_rf_layouts[selected_saved_index];
  }
  remote_layout_selected_button = -1;
  remote_layout_delete_armed = false;
  refresh_remote_layout_editor();
  lv_scr_load(remote_layout_screen);
  set_status("SYSTEM READY", COLOR_READY);
}


void previous_repository_rf_page(lv_event_t *e) {
  if (!rf_working_remote_from_repository ||
      rf_working_repository_current_page == 0) return;
  if (!load_repository_rf_page(rf_working_repository_current_page - 1)) {
    set_status("SD PAGE READ FAILED", COLOR_RED);
    return;
  }
  refresh_universal_remote();
  set_status("SYSTEM READY", COLOR_READY);
}


void next_repository_rf_page(lv_event_t *e) {
  if (!rf_working_remote_from_repository ||
      rf_working_repository_current_page + 1 >=
        rf_working_repository_page_count) return;
  if (!load_repository_rf_page(rf_working_repository_current_page + 1)) {
    set_status("SD PAGE READ FAILED", COLOR_RED);
    return;
  }
  refresh_universal_remote();
  set_status("SYSTEM READY", COLOR_READY);
}


