uint32_t ripper_rf_header_crc(RipperRfRemoteFileHeaderV1 header) {
  header.header_crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&header, sizeof(header));
}


uint32_t ripper_rf_index_header_crc(RipperRfIndexHeaderV1 header) {
  header.header_crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&header, sizeof(header));
}


uint32_t ripper_rf_tombstone_crc(RipperRfTombstoneV1 tombstone) {
  tombstone.crc32 = 0;
  return ~ripper_crc32_update(0xFFFFFFFFUL, (const uint8_t *)&tombstone,
                              sizeof(tombstone));
}


bool ripper_rf_repository_ensure_directories() {
  if (!sd_card_ready) return false;
  if (!SD_MMC.exists(RIPPER_IR_STORAGE_ROOT) &&
      !SD_MMC.mkdir(RIPPER_IR_STORAGE_ROOT)) return false;
  if (!SD_MMC.exists(RIPPER_RF_STORAGE_ROOT) &&
      !SD_MMC.mkdir(RIPPER_RF_STORAGE_ROOT)) return false;
  if (!SD_MMC.exists(RIPPER_RF_REMOTE_DIR) &&
      !SD_MMC.mkdir(RIPPER_RF_REMOTE_DIR)) return false;
  return true;
}


bool ripper_rf_repository_has_space(uint64_t required_bytes) {
  if (!sd_card_ready) return false;
  sd_card_total_bytes = SD_MMC.totalBytes();
  sd_card_used_bytes = SD_MMC.usedBytes();
  const uint64_t free_bytes = sd_card_total_bytes >= sd_card_used_bytes ?
    sd_card_total_bytes - sd_card_used_bytes : 0;
  return free_bytes >= required_bytes + RIPPER_RF_REPOSITORY_RESERVE_BYTES;
}


bool ripper_rf_read_remote_header(const char *path,
                                  RipperRfRemoteFileHeaderV1 &header) {
  memset(&header, 0, sizeof(header));
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  const bool read_ok = file.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  file.close();
  return read_ok && header.magic == RIPPER_RF_FILE_MAGIC &&
         ripper_rf_file_version_supported(header.version) &&
         header.header_size == sizeof(header) &&
         header.header_crc32 == ripper_rf_header_crc(header);
}


bool validate_ripper_rf_remote_file(const char *path, uint64_t expected_remote_id) {
  ripper_rf_validation_error[0] = '\0';
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) {
    strlcpy(ripper_rf_validation_error, "FILE OPEN", sizeof(ripper_rf_validation_error));
    return false;
  }
  RipperRfRemoteFileHeaderV1 header = {};
  const size_t header_read = file.read((uint8_t *)&header, sizeof(header));
  const uint32_t actual_header_crc = ripper_rf_header_crc(header);
  const uint64_t actual_file_size = file.size();
  const bool header_ok = header_read == sizeof(header) &&
    header.magic == RIPPER_RF_FILE_MAGIC &&
    ripper_rf_file_version_supported(header.version) &&
    header.header_size == sizeof(header) &&
    header.header_crc32 == ripper_rf_header_crc(header) &&
    (expected_remote_id == 0 || header.remote_id == expected_remote_id) &&
    header.remote_id != 0 && header.button_count <= 4096 &&
    header.page_count > 0 && header.payload_bytes <= 8UL * 1024UL * 1024UL &&
    file.size() == sizeof(header) + header.payload_bytes;
  if (!header_ok) {
    snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
             "HEADER read=%u magic=%08lx ver=%u size=%u crc=%08lx/%08lx id=%u bytes=%lu file=%llu",
             (unsigned)header_read, (unsigned long)header.magic,
             (unsigned)header.version, (unsigned)header.header_size,
             (unsigned long)header.header_crc32,
             (unsigned long)actual_header_crc,
             (unsigned)(header.remote_id != 0),
             (unsigned long)header.payload_bytes,
             (unsigned long long)actual_file_size);
    file.close();
    return false;
  }

  uint64_t structured_bytes = 0;
  for (uint16_t button = 0; button < header.button_count; button++) {
    RipperRfButtonDiskV1 disk = {};
    uint32_t timing_count = 0;
    uint64_t timing_bytes = 0;
    if (file.read((uint8_t *)&disk, sizeof(disk)) != sizeof(disk) ||
        disk.record_size != sizeof(disk) || disk.page >= header.page_count ||
        disk.encoding > RIPPER_RF_ENCODING_RAW_TIMINGS32 ||
        disk.repeat_count == 0 ||
        (disk.encoding == RIPPER_RF_ENCODING_UNASSIGNED && disk.raw_timing_count != 0) ||
        (disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS &&
         (disk.raw_timing_count == 0 || disk.raw_timing_count > 4096)) ||
        (disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS32 &&
         (header.version < RIPPER_RF_FILE_VERSION ||
          disk.raw_timing_count != 0 || disk.parsed_bit_count != 0 ||
          disk.parsed_key < 2 || disk.parsed_key > RIPPER_RF_MAX_RAW_TIMINGS))) {
      file.close();
      snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
               "RECORD button=%u enc=%u page=%u/%u repeat=%u count16=%u count64=%llu",
               (unsigned)button, (unsigned)disk.encoding, (unsigned)disk.page,
               (unsigned)header.page_count, (unsigned)disk.repeat_count,
               (unsigned)disk.raw_timing_count,
               (unsigned long long)disk.parsed_key);
      return false;
    }
    timing_count = ripper_rf_button_timing_count(disk);
    timing_bytes = ripper_rf_button_timing_bytes(disk);
    if (timing_count > RIPPER_RF_MAX_RAW_TIMINGS) {
      snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
               "COUNT button=%u count=%lu", (unsigned)button,
               (unsigned long)timing_count);
      file.close();
      return false;
    }
    structured_bytes += sizeof(disk) + timing_bytes;
    if (structured_bytes > header.payload_bytes ||
        structured_bytes > UINT32_MAX ||
        !file.seek(sizeof(header) + (uint32_t)structured_bytes)) {
      snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
               "SEEK button=%u structured=%llu payload=%lu position=%lu",
               (unsigned)button, (unsigned long long)structured_bytes,
               (unsigned long)header.payload_bytes,
               (unsigned long)file.position());
      file.close();
      return false;
    }
  }
  if (structured_bytes != header.payload_bytes || !file.seek(sizeof(header))) {
    snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
             "STRUCTURED structured=%llu payload=%lu position=%lu",
             (unsigned long long)structured_bytes,
             (unsigned long)header.payload_bytes,
             (unsigned long)file.position());
    file.close();
    return false;
  }

  uint8_t buffer[256];
  uint32_t remaining = header.payload_bytes;
  uint32_t crc = 0xFFFFFFFFUL;
  while (remaining > 0) {
    const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
    const size_t count = file.read(buffer, chunk);
    if (count != chunk) {
      snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
               "PAYLOAD READ remaining=%lu wanted=%u got=%u position=%lu",
               (unsigned long)remaining, (unsigned)chunk, (unsigned)count,
               (unsigned long)file.position());
      file.close();
      return false;
    }
    crc = ripper_crc32_update(crc, buffer, count);
    remaining -= count;
  }
  file.close();
  const uint32_t actual_payload_crc = ~crc;
  if (actual_payload_crc != header.payload_crc32) {
    snprintf(ripper_rf_validation_error, sizeof(ripper_rf_validation_error),
             "PAYLOAD CRC actual=%08lx expected=%08lx bytes=%lu",
             (unsigned long)actual_payload_crc,
             (unsigned long)header.payload_crc32,
             (unsigned long)header.payload_bytes);
    return false;
  }
  return true;
}


bool ripper_rf_repository_read_button(const char *path, uint16_t requested_button,
                                      RipperRfButtonDiskV1 &button,
                                      void *raw_timings, uint32_t raw_capacity,
                                      uint32_t &raw_count) {
  raw_count = 0;
  if (!sd_card_ready || path == NULL ||
      !validate_ripper_rf_remote_file(path, 0)) return false;
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  RipperRfRemoteFileHeaderV1 header = {};
  if (file.read((uint8_t *)&header, sizeof(header)) != sizeof(header) ||
      requested_button >= header.button_count) {
    file.close();
    return false;
  }
  for (uint16_t index = 0; index < header.button_count; index++) {
    if (file.read((uint8_t *)&button, sizeof(button)) != sizeof(button) ||
        button.record_size != sizeof(button)) {
      file.close();
      return false;
    }
    if (index == requested_button) {
      raw_count = ripper_rf_button_timing_count(button);
      if (raw_count > 0) {
        // A null buffer with zero capacity is a metadata-only query. The
        // runtime adapter uses this to learn the exact allocation required,
        // then streams only the pressed command's timings on a second read.
        if (raw_timings == NULL && raw_capacity == 0) {
          file.close();
          return true;
        }
        const uint64_t timing_bytes = ripper_rf_button_timing_bytes(button);
        if (raw_timings == NULL || raw_count > raw_capacity ||
            timing_bytes > SIZE_MAX ||
            file.read((uint8_t *)raw_timings, (size_t)timing_bytes) !=
              (size_t)timing_bytes) {
          file.close();
          raw_count = 0;
          return false;
        }
      }
      file.close();
      return true;
    }
    const uint64_t timing_bytes = ripper_rf_button_timing_bytes(button);
    if (timing_bytes > UINT32_MAX ||
        !file.seek(file.position() + (uint32_t)timing_bytes)) {
      file.close();
      return false;
    }
  }
  file.close();
  return false;
}


bool validate_ripper_rf_index_file(const char *path,
                                   RipperRfIndexHeaderV1 *header_out) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  RipperRfIndexHeaderV1 header = {};
  const bool header_ok = file.read((uint8_t *)&header, sizeof(header)) == sizeof(header) &&
    header.magic == RIPPER_RF_INDEX_MAGIC &&
    header.version == RIPPER_RF_INDEX_VERSION &&
    header.header_size == sizeof(header) &&
    header.record_size == sizeof(RipperRfIndexEntryV1) &&
    header.entry_count <= 65535UL &&
    header.header_crc32 == ripper_rf_index_header_crc(header) &&
    file.size() == sizeof(header) +
      (uint64_t)header.entry_count * sizeof(RipperRfIndexEntryV1);
  if (!header_ok) {
    file.close();
    return false;
  }
  uint8_t buffer[256];
  uint32_t remaining = header.entry_count * sizeof(RipperRfIndexEntryV1);
  uint32_t crc = 0xFFFFFFFFUL;
  while (remaining > 0) {
    const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
    const size_t count = file.read(buffer, chunk);
    if (count != chunk) {
      file.close();
      return false;
    }
    crc = ripper_crc32_update(crc, buffer, count);
    remaining -= count;
  }
  file.close();
  if ((~crc) != header.records_crc32) return false;
  if (header_out != NULL) *header_out = header;
  return true;
}


void ripper_rf_repository_set_state_from_index() {
  RipperRfIndexHeaderV1 header = {};
  ripper_rf_repository_ready = validate_ripper_rf_index_file(RIPPER_RF_INDEX_PATH,
                                                              &header);
  ripper_rf_repository_count = ripper_rf_repository_ready ? header.entry_count : 0;
  ripper_rf_repository_generation = ripper_rf_repository_ready ? header.generation : 0;
}


bool ripper_rf_repository_read_metadata(uint32_t ordinal,
                                        RipperRfIndexEntryV1 &entry) {
  memset(&entry, 0, sizeof(entry));
  if (!ripper_rf_repository_ready || ordinal >= ripper_rf_repository_count) return false;
  File file = SD_MMC.open(RIPPER_RF_INDEX_PATH, FILE_READ);
  if (!file) return false;
  const uint64_t offset = sizeof(RipperRfIndexHeaderV1) +
    (uint64_t)ordinal * sizeof(RipperRfIndexEntryV1);
  const bool ok = file.seek(offset) &&
    file.read((uint8_t *)&entry, sizeof(entry)) == sizeof(entry) &&
    entry.record_size == sizeof(entry);
  file.close();
  return ok;
}


bool ripper_rf_repository_find(uint64_t remote_id, RipperRfIndexEntryV1 &entry,
                               uint32_t *ordinal_out) {
  for (uint32_t ordinal = 0; ordinal < ripper_rf_repository_count; ordinal++) {
    if (!ripper_rf_repository_read_metadata(ordinal, entry)) return false;
    if (entry.remote_id == remote_id) {
      if (ordinal_out != NULL) *ordinal_out = ordinal;
      return true;
    }
  }
  return false;
}


bool validate_ripper_rf_tombstone(const char *path, uint64_t expected_remote_id) {
  File file = SD_MMC.open(path, FILE_READ);
  if (!file) return false;
  RipperRfTombstoneV1 tombstone = {};
  const bool valid = file.size() == sizeof(tombstone) &&
    file.read((uint8_t *)&tombstone, sizeof(tombstone)) == sizeof(tombstone) &&
    tombstone.magic == RIPPER_RF_TOMBSTONE_MAGIC &&
    (expected_remote_id == 0 || tombstone.remote_id == expected_remote_id) &&
    tombstone.crc32 == ripper_rf_tombstone_crc(tombstone);
  file.close();
  return valid;
}


bool write_ripper_rf_tombstone(const char *remote_path, uint64_t remote_id) {
  char marker_path[112];
  char temporary_path[120];
  snprintf(marker_path, sizeof(marker_path), "%s.deleted", remote_path);
  snprintf(temporary_path, sizeof(temporary_path), "%s.tmp", marker_path);
  if (validate_ripper_rf_tombstone(marker_path, remote_id)) return true;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  RipperRfTombstoneV1 tombstone = {};
  tombstone.magic = RIPPER_RF_TOMBSTONE_MAGIC;
  tombstone.remote_id = remote_id;
  tombstone.crc32 = ripper_rf_tombstone_crc(tombstone);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  const bool wrote = file.write((const uint8_t *)&tombstone, sizeof(tombstone)) ==
    sizeof(tombstone);
  file.flush();
  file.close();
  if (!wrote || !validate_ripper_rf_tombstone(temporary_path, remote_id)) {
    SD_MMC.remove(temporary_path);
    return false;
  }
  if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
  return SD_MMC.rename(temporary_path, marker_path) &&
         validate_ripper_rf_tombstone(marker_path, remote_id);
}


bool ripper_rf_repository_make_staging_path(uint64_t remote_id, char *path,
                                            size_t path_size) {
  if (path == NULL || path_size == 0 || remote_id == 0) return false;
  RipperRfIndexEntryV1 existing = {};
  if (ripper_rf_repository_find(remote_id, existing)) {
    return snprintf(path, path_size, "%s.tmp", existing.file_path) < (int)path_size;
  }
  return snprintf(path, path_size, RIPPER_RF_REMOTE_DIR "/%08lx%08lx.rfr.tmp",
                  (unsigned long)(remote_id >> 32),
                  (unsigned long)remote_id) < (int)path_size;
}


bool ripper_rf_repository_commit_index_temp() {
  if (!validate_ripper_rf_index_file(RIPPER_RF_INDEX_TEMP_PATH)) return false;
  if (SD_MMC.exists(RIPPER_RF_INDEX_BACKUP_PATH))
    SD_MMC.remove(RIPPER_RF_INDEX_BACKUP_PATH);
  const bool had_index = SD_MMC.exists(RIPPER_RF_INDEX_PATH);
  if (had_index && !SD_MMC.rename(RIPPER_RF_INDEX_PATH,
                                   RIPPER_RF_INDEX_BACKUP_PATH)) return false;
  if (!SD_MMC.rename(RIPPER_RF_INDEX_TEMP_PATH, RIPPER_RF_INDEX_PATH) ||
      !validate_ripper_rf_index_file(RIPPER_RF_INDEX_PATH)) {
    if (SD_MMC.exists(RIPPER_RF_INDEX_PATH)) SD_MMC.remove(RIPPER_RF_INDEX_PATH);
    if (had_index) SD_MMC.rename(RIPPER_RF_INDEX_BACKUP_PATH,
                                 RIPPER_RF_INDEX_PATH);
    return false;
  }
  if (SD_MMC.exists(RIPPER_RF_INDEX_BACKUP_PATH))
    SD_MMC.remove(RIPPER_RF_INDEX_BACKUP_PATH);
  ripper_rf_repository_set_state_from_index();
  return ripper_rf_repository_ready;
}


bool rebuild_ripper_rf_repository_index() {
  if (!ripper_rf_repository_ensure_directories()) return false;
  File directory = SD_MMC.open(RIPPER_RF_REMOTE_DIR, FILE_READ);
  if (!directory || !directory.isDirectory()) {
    if (directory) directory.close();
    return false;
  }
  if (SD_MMC.exists(RIPPER_RF_INDEX_TEMP_PATH))
    SD_MMC.remove(RIPPER_RF_INDEX_TEMP_PATH);
  File index = SD_MMC.open(RIPPER_RF_INDEX_TEMP_PATH, FILE_WRITE);
  if (!index) {
    directory.close();
    return false;
  }
  RipperRfIndexHeaderV1 index_header = {};
  bool wrote = index.write((const uint8_t *)&index_header, sizeof(index_header)) ==
    sizeof(index_header);
  uint32_t records_crc = 0xFFFFFFFFUL;
  uint32_t entry_count = 0;
  File candidate = directory.openNextFile();
  while (candidate && wrote) {
    char path[128] = {};
    const char *name = candidate.name();
    if (name != NULL && name[0] == '/') strlcpy(path, name, sizeof(path));
    else if (name != NULL) snprintf(path, sizeof(path), RIPPER_RF_REMOTE_DIR "/%s", name);
    const bool regular_remote = !candidate.isDirectory() &&
      ripper_ir_path_ends_with(path, ".rfr");
    candidate.close();
    if (regular_remote && validate_ripper_rf_remote_file(path, 0)) {
      RipperRfRemoteFileHeaderV1 remote_header = {};
      if (ripper_rf_read_remote_header(path, remote_header)) {
        RipperRfIndexEntryV1 entry = {};
        entry.record_size = sizeof(entry);
        entry.remote_id = remote_header.remote_id;
        entry.source_flags = remote_header.source_flags;
        File remote_file = SD_MMC.open(path, FILE_READ);
        entry.file_bytes = remote_file ? remote_file.size() : 0;
        if (remote_file) remote_file.close();
        entry.button_count = remote_header.button_count;
        entry.page_count = remote_header.page_count;
        strlcpy(entry.name, remote_header.name, sizeof(entry.name));
        strlcpy(entry.device_type, remote_header.device_type,
                sizeof(entry.device_type));
        strlcpy(entry.manufacturer, remote_header.manufacturer,
                sizeof(entry.manufacturer));
        strlcpy(entry.model, remote_header.model, sizeof(entry.model));
        strlcpy(entry.file_path, path, sizeof(entry.file_path));
        wrote = index.write((const uint8_t *)&entry, sizeof(entry)) == sizeof(entry);
        if (wrote) {
          records_crc = ripper_crc32_update(records_crc,
                                             (const uint8_t *)&entry,
                                             sizeof(entry));
          entry_count++;
        }
      }
    } else if (regular_remote) {
      Serial.printf("RF repository skipped corrupt remote: %s\n", path);
    }
    candidate = directory.openNextFile();
  }
  if (candidate) candidate.close();
  directory.close();
  if (!wrote) {
    index.close();
    SD_MMC.remove(RIPPER_RF_INDEX_TEMP_PATH);
    return false;
  }
  index_header.magic = RIPPER_RF_INDEX_MAGIC;
  index_header.version = RIPPER_RF_INDEX_VERSION;
  index_header.header_size = sizeof(index_header);
  index_header.record_size = sizeof(RipperRfIndexEntryV1);
  index_header.entry_count = entry_count;
  index_header.generation = ripper_rf_repository_generation + 1;
  index_header.records_crc32 = ~records_crc;
  index_header.header_crc32 = ripper_rf_index_header_crc(index_header);
  wrote = index.seek(0) &&
    index.write((const uint8_t *)&index_header, sizeof(index_header)) ==
      sizeof(index_header);
  index.flush();
  index.close();
  if (!wrote || !ripper_rf_repository_commit_index_temp()) {
    SD_MMC.remove(RIPPER_RF_INDEX_TEMP_PATH);
    return false;
  }
  Serial.printf("RF repository index ready: %lu remote(s), generation %lu\n",
                (unsigned long)ripper_rf_repository_count,
                (unsigned long)ripper_rf_repository_generation);
  return true;
}


bool recover_ripper_rf_repository_transactions() {
  if (!ripper_rf_repository_ensure_directories()) return false;
  bool transaction_found = false;
  File directory = SD_MMC.open(RIPPER_RF_REMOTE_DIR, FILE_READ);
  if (!directory || !directory.isDirectory()) {
    if (directory) directory.close();
    return false;
  }
  File candidate = directory.openNextFile();
  while (candidate) {
    char path[128] = {};
    const char *name = candidate.name();
    if (name != NULL && name[0] == '/') strlcpy(path, name, sizeof(path));
    else if (name != NULL) snprintf(path, sizeof(path), RIPPER_RF_REMOTE_DIR "/%s", name);
    const bool is_file = !candidate.isDirectory();
    candidate.close();
    if (is_file && ripper_ir_path_ends_with(path, ".rfr.deleted.tmp")) {
      transaction_found = true;
      char marker_path[128] = {};
      strlcpy(marker_path, path, sizeof(marker_path));
      marker_path[strlen(marker_path) - 4] = '\0';
      if (validate_ripper_rf_tombstone(marker_path, 0)) SD_MMC.remove(path);
      else if (validate_ripper_rf_tombstone(path, 0)) {
        if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
        SD_MMC.rename(path, marker_path);
      } else SD_MMC.remove(path);
    } else if (is_file && ripper_ir_path_ends_with(path, ".rfr.tmp")) {
      transaction_found = true;
      char final_path[128] = {};
      strlcpy(final_path, path, sizeof(final_path));
      final_path[strlen(final_path) - 4] = '\0';
      if (validate_ripper_rf_remote_file(final_path, 0)) SD_MMC.remove(path);
      else if (validate_ripper_rf_remote_file(path, 0)) {
        if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
        SD_MMC.rename(path, final_path);
      } else SD_MMC.remove(path);
    } else if (is_file && ripper_ir_path_ends_with(path, ".rfr.del")) {
      transaction_found = true;
      char original_path[128] = {};
      char marker_path[136] = {};
      strlcpy(original_path, path, sizeof(original_path));
      original_path[strlen(original_path) - 4] = '\0';
      snprintf(marker_path, sizeof(marker_path), "%s.deleted", original_path);
      RipperRfRemoteFileHeaderV1 deleted_header = {};
      if (ripper_rf_read_remote_header(path, deleted_header) &&
          validate_ripper_rf_tombstone(marker_path, deleted_header.remote_id))
        SD_MMC.remove(path);
      else if (validate_ripper_rf_remote_file(original_path, 0)) SD_MMC.remove(path);
      else {
        if (SD_MMC.exists(original_path)) SD_MMC.remove(original_path);
        SD_MMC.rename(path, original_path);
      }
    } else if (is_file && ripper_ir_path_ends_with(path, ".rfr.bak")) {
      transaction_found = true;
      char final_path[128] = {};
      strlcpy(final_path, path, sizeof(final_path));
      final_path[strlen(final_path) - 4] = '\0';
      if (validate_ripper_rf_remote_file(final_path, 0)) SD_MMC.remove(path);
      else if (validate_ripper_rf_remote_file(path, 0)) {
        if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
        SD_MMC.rename(path, final_path);
      }
    }
    candidate = directory.openNextFile();
  }
  if (candidate) candidate.close();
  directory.close();
  return transaction_found;
}


bool initialize_ripper_rf_repository() {
  ripper_rf_repository_ready = false;
  ripper_rf_repository_count = 0;
  if (!ripper_rf_repository_ensure_directories()) return false;
  if (recover_ripper_rf_repository_transactions())
    return rebuild_ripper_rf_repository_index();
  RipperRfIndexHeaderV1 header = {};
  if (validate_ripper_rf_index_file(RIPPER_RF_INDEX_PATH, &header)) {
    if (SD_MMC.exists(RIPPER_RF_INDEX_TEMP_PATH))
      SD_MMC.remove(RIPPER_RF_INDEX_TEMP_PATH);
    if (SD_MMC.exists(RIPPER_RF_INDEX_BACKUP_PATH))
      SD_MMC.remove(RIPPER_RF_INDEX_BACKUP_PATH);
    ripper_rf_repository_set_state_from_index();
    return true;
  }
  if (validate_ripper_rf_index_file(RIPPER_RF_INDEX_TEMP_PATH)) {
    if (SD_MMC.exists(RIPPER_RF_INDEX_PATH)) SD_MMC.remove(RIPPER_RF_INDEX_PATH);
    if (SD_MMC.rename(RIPPER_RF_INDEX_TEMP_PATH, RIPPER_RF_INDEX_PATH)) {
      ripper_rf_repository_set_state_from_index();
      if (ripper_rf_repository_ready) return true;
    }
  }
  if (validate_ripper_rf_index_file(RIPPER_RF_INDEX_BACKUP_PATH)) {
    if (SD_MMC.exists(RIPPER_RF_INDEX_PATH)) SD_MMC.remove(RIPPER_RF_INDEX_PATH);
    if (SD_MMC.rename(RIPPER_RF_INDEX_BACKUP_PATH, RIPPER_RF_INDEX_PATH)) {
      ripper_rf_repository_set_state_from_index();
      if (ripper_rf_repository_ready) return true;
    }
  }
  return rebuild_ripper_rf_repository_index();
}


bool ripper_rf_repository_commit_staged(const char *staged_path) {
  if (!sd_card_ready || staged_path == NULL ||
      !ripper_ir_path_ends_with(staged_path, ".rfr.tmp") ||
      !validate_ripper_rf_remote_file(staged_path, 0)) return false;
  RipperRfRemoteFileHeaderV1 header = {};
  if (!ripper_rf_read_remote_header(staged_path, header)) return false;
  char expected_path[112];
  if (!ripper_rf_repository_make_staging_path(header.remote_id, expected_path,
                                               sizeof(expected_path)) ||
      strcmp(staged_path, expected_path) != 0) return false;
  char final_path[96] = {};
  char backup_path[104];
  strlcpy(final_path, staged_path, sizeof(final_path));
  final_path[strlen(final_path) - 4] = '\0';
  snprintf(backup_path, sizeof(backup_path), "%s.bak", final_path);
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  const bool replacing = SD_MMC.exists(final_path);
  if (replacing && !SD_MMC.rename(final_path, backup_path)) return false;
  if (!SD_MMC.rename(staged_path, final_path) ||
      !validate_ripper_rf_remote_file(final_path, header.remote_id) ||
      !rebuild_ripper_rf_repository_index()) {
    if (SD_MMC.exists(final_path)) SD_MMC.remove(final_path);
    if (replacing) SD_MMC.rename(backup_path, final_path);
    rebuild_ripper_rf_repository_index();
    return false;
  }
  if (SD_MMC.exists(backup_path)) SD_MMC.remove(backup_path);
  char marker_path[112];
  snprintf(marker_path, sizeof(marker_path), "%s.deleted", final_path);
  if (SD_MMC.exists(marker_path)) SD_MMC.remove(marker_path);
  return true;
}


bool ripper_rf_repository_delete(uint64_t remote_id) {
  RipperRfIndexEntryV1 entry = {};
  if (!ripper_rf_repository_find(remote_id, entry) ||
      strncmp(entry.file_path, RIPPER_RF_REMOTE_DIR "/",
              strlen(RIPPER_RF_REMOTE_DIR) + 1) != 0 ||
      !ripper_ir_path_ends_with(entry.file_path, ".rfr")) return false;
  char deleted_path[104];
  snprintf(deleted_path, sizeof(deleted_path), "%s.del", entry.file_path);
  if (SD_MMC.exists(deleted_path)) SD_MMC.remove(deleted_path);
  if (!write_ripper_rf_tombstone(entry.file_path, remote_id)) return false;
  if (!SD_MMC.rename(entry.file_path, deleted_path)) {
    char marker_path[112];
    snprintf(marker_path, sizeof(marker_path), "%s.deleted", entry.file_path);
    SD_MMC.remove(marker_path);
    return false;
  }
  if (!rebuild_ripper_rf_repository_index()) {
    SD_MMC.rename(deleted_path, entry.file_path);
    char marker_path[112];
    snprintf(marker_path, sizeof(marker_path), "%s.deleted", entry.file_path);
    SD_MMC.remove(marker_path);
    rebuild_ripper_rf_repository_index();
    return false;
  }
  SD_MMC.remove(deleted_path);
  return true;
}


// Catalog RAW validation is streaming and bounded. Short waveforms keep the
// compact V1-compatible uint16_t payload; longer counts or durations select
// the V2 uint32_t representation. Consecutive source timings at the same
// level are merged without changing the waveform.
class RipperRfCatalogRawValidator : public RipperRfCatalogSignalVisitor {
 public:
  explicit RipperRfCatalogRawValidator(uint32_t expected_count)
      : expected_count_(expected_count) {}

  bool onRawTiming(int32_t signed_duration_us) override {
    if (signed_duration_us == 0 || signed_duration_us == INT32_MIN ||
        input_count_ >= expected_count_) return false;
    const bool positive = signed_duration_us > 0;
    const uint32_t duration = positive ? (uint32_t)signed_duration_us :
      (uint32_t)(-(int64_t)signed_duration_us);
    if (duration > RIPPER_RF_MAX_TIMING_US) return false;
    if (!has_current_) {
      first_level = positive ? 1 : 0;
      current_positive_ = positive;
      current_duration_ = duration;
      has_current_ = true;
    } else if (positive == current_positive_) {
      const uint64_t combined = (uint64_t)current_duration_ + duration;
      if (combined > RIPPER_RF_MAX_TIMING_US) return false;
      current_duration_ = (uint32_t)combined;
    } else {
      if (current_duration_ > UINT16_MAX) requires_extended_ = true;
      output_count++;
      if (output_count >= RIPPER_RF_MAX_RAW_TIMINGS) return false;
      current_positive_ = positive;
      current_duration_ = duration;
    }
    input_count_++;
    return true;
  }

  bool onBinRawByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onParsedKeyByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onSignalEnd(uint32_t emitted_values) override {
    if (has_current_) {
      if (current_duration_ > UINT16_MAX) requires_extended_ = true;
      output_count++;
    }
    if (output_count > 4096) requires_extended_ = true;
    return input_count_ == expected_count_ && emitted_values == expected_count_ &&
           output_count >= 2 && output_count <= RIPPER_RF_MAX_RAW_TIMINGS;
  }

  bool requiresExtended() const { return requires_extended_; }

  uint8_t first_level = 0;
  uint32_t output_count = 0;

 private:
  uint32_t expected_count_ = 0;
  uint32_t input_count_ = 0;
  uint32_t current_duration_ = 0;
  bool current_positive_ = false;
  bool has_current_ = false;
  bool requires_extended_ = false;
};


class RipperRfCatalogRawWriter : public RipperRfCatalogSignalVisitor {
 public:
  RipperRfCatalogRawWriter(File &target, uint32_t expected_count,
                           uint32_t expected_output_count,
                           bool extended,
                           uint32_t &payload_crc, uint32_t &payload_bytes)
      : target_(target), expected_count_(expected_count),
        expected_output_count_(expected_output_count),
        extended_(extended),
        payload_crc_(payload_crc), payload_bytes_(payload_bytes) {}

  bool onRawTiming(int32_t signed_duration_us) override {
    if (signed_duration_us == 0 || signed_duration_us == INT32_MIN ||
        input_count_ >= expected_count_) return false;
    const bool positive = signed_duration_us > 0;
    const uint32_t duration = positive ? (uint32_t)signed_duration_us :
      (uint32_t)(-(int64_t)signed_duration_us);
    if (duration > RIPPER_RF_MAX_TIMING_US) return false;
    if (!has_current_) {
      current_positive_ = positive;
      current_duration_ = duration;
      has_current_ = true;
    } else if (positive == current_positive_) {
      const uint64_t combined = (uint64_t)current_duration_ + duration;
      if (combined > RIPPER_RF_MAX_TIMING_US) return false;
      current_duration_ = (uint32_t)combined;
    } else {
      if (!emitCurrent()) return false;
      current_positive_ = positive;
      current_duration_ = duration;
      has_current_ = true;
    }
    input_count_++;
    return true;
  }

  bool onBinRawByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onParsedKeyByte(uint8_t value) override {
    (void)value;
    return false;
  }

  bool onSignalEnd(uint32_t emitted_values) override {
    return input_count_ == expected_count_ && emitted_values == expected_count_ &&
           emitCurrent() && output_count_ == expected_output_count_ && flush();
  }

 private:
  static const uint8_t BUFFER_TIMINGS = 64;
  File &target_;
  uint32_t expected_count_ = 0;
  uint32_t expected_output_count_ = 0;
  bool extended_ = false;
  uint32_t &payload_crc_;
  uint32_t &payload_bytes_;
  uint32_t buffer_[BUFFER_TIMINGS] = {};
  uint16_t compact_buffer_[BUFFER_TIMINGS] = {};
  uint8_t buffer_count_ = 0;
  uint32_t input_count_ = 0;
  uint32_t output_count_ = 0;
  uint32_t current_duration_ = 0;
  bool current_positive_ = false;
  bool has_current_ = false;

  bool emitCurrent() {
    if (!has_current_ || current_duration_ == 0 ||
        current_duration_ > RIPPER_RF_MAX_TIMING_US ||
        output_count_ >= expected_output_count_) return false;
    buffer_[buffer_count_++] = current_duration_;
    output_count_++;
    has_current_ = false;
    current_duration_ = 0;
    return buffer_count_ < BUFFER_TIMINGS || flush();
  }

  bool flush() {
    if (buffer_count_ == 0) return true;
    const uint8_t *data = (const uint8_t *)buffer_;
    size_t bytes = buffer_count_ * sizeof(buffer_[0]);
    if (!extended_) {
      for (uint8_t i = 0; i < buffer_count_; i++) {
        if (buffer_[i] > UINT16_MAX) return false;
        compact_buffer_[i] = (uint16_t)buffer_[i];
      }
      data = (const uint8_t *)compact_buffer_;
      bytes = buffer_count_ * sizeof(compact_buffer_[0]);
    }
    if (target_.write(data, bytes) != bytes) return false;
    payload_crc_ = ripper_crc32_update(payload_crc_, data, bytes);
    payload_bytes_ += bytes;
    buffer_count_ = 0;
    return true;
  }
};


// KeeLoq catalog records contain an already-encoded 64-bit frame. Preserve
// that exact frame using the public on-air timing; do not derive manufacturer
// secrets, advance counters, or claim to generate a fresh rolling code.
class RipperRfCatalogKeeLoqValidator : public RipperRfCatalogSignalVisitor {
 public:
  bool onRawTiming(int32_t value) override {
    (void)value;
    return false;
  }
  bool onBinRawByte(uint8_t value) override {
    (void)value;
    return false;
  }
  bool onParsedKeyByte(uint8_t value) override {
    (void)value;
    if (key_bytes_ >= 8) return false;
    key_bytes_++;
    return true;
  }
  bool onSignalEnd(uint32_t emitted_values) override {
    return key_bytes_ == 8 && emitted_values == 8;
  }
 private:
  uint8_t key_bytes_ = 0;
};


class RipperRfCatalogKeeLoqWriter : public RipperRfCatalogSignalVisitor {
 public:
  RipperRfCatalogKeeLoqWriter(File &target, uint32_t &payload_crc,
                              uint32_t &payload_bytes)
      : target_(target), payload_crc_(payload_crc),
        payload_bytes_(payload_bytes) {}

  bool onRawTiming(int32_t value) override {
    (void)value;
    return false;
  }
  bool onBinRawByte(uint8_t value) override {
    (void)value;
    return false;
  }
  bool onParsedKeyByte(uint8_t value) override {
    if (key_bytes_ >= sizeof(key_)) return false;
    key_[key_bytes_++] = value;
    return true;
  }
  bool onSignalEnd(uint32_t emitted_values) override {
    if (key_bytes_ != 8 || emitted_values != 8) return false;
    uint16_t timings[156] = {};
    uint16_t count = 0;
    for (uint8_t pulse = 0; pulse < 11; pulse++) {
      timings[count++] = 400;
      timings[count++] = 400;
    }
    timings[count++] = 400;
    timings[count++] = 4000;
    for (uint8_t byte = 0; byte < 8; byte++) {
      for (int8_t bit = 7; bit >= 0; bit--) {
        const bool one = (key_[byte] & (1U << bit)) != 0;
        timings[count++] = one ? 400 : 800;
        timings[count++] = one ? 800 : 400;
      }
    }
    // Status pair and end marker match Flipper's public KeeLoq encoder.
    timings[count++] = 400;
    timings[count++] = 800;
    timings[count++] = 400;
    timings[count++] = 16000;
    if (count != 156) return false;
    const size_t bytes = sizeof(timings);
    if (target_.write((const uint8_t *)timings, bytes) != bytes) return false;
    payload_crc_ = ripper_crc32_update(payload_crc_,
                                        (const uint8_t *)timings, bytes);
    payload_bytes_ += bytes;
    return true;
  }

 private:
  File &target_;
  uint32_t &payload_crc_;
  uint32_t &payload_bytes_;
  uint8_t key_[8] = {};
  uint8_t key_bytes_ = 0;
};


void close_ripper_rf_catalog_session() {
  ripper_rf_catalog.end();
  ripper_rf_catalog_active_source = -1;
}


void set_ripper_rf_import_error(char *target, size_t target_size,
                                const char *message) {
  if (target != NULL && target_size > 0)
    strlcpy(target, message == NULL ? "IMPORT FAILED" : message, target_size);
}


bool make_catalog_rf_button(const RipperRfCatalogSignal &signal,
                            uint16_t local_ordinal, uint8_t first_level,
                            uint32_t stored_timing_count,
                            bool extended_raw,
                            RipperRfButtonDiskV1 &disk) {
  memset(&disk, 0, sizeof(disk));
  const bool raw = signal.encoding == RIPPER_RF_CATALOG_ENCODING_RAW &&
    strcmp(signal.protocol, "RAW") == 0;
  const bool keeloq = signal.encoding == RIPPER_RF_CATALOG_ENCODING_PARSED &&
    signal.bit_count == 64 && strcmp(signal.protocol, "KeeLoq") == 0;
  if ((!raw && !keeloq) ||
      (raw && signal.raw_timing_count < 2) ||
      stored_timing_count < 2 ||
      stored_timing_count > RIPPER_RF_MAX_RAW_TIMINGS ||
      (keeloq && stored_timing_count != 156) ||
      (keeloq && extended_raw) ||
      signal.frequency_hz == 0 || local_ordinal == UINT16_MAX) return false;

  uint32_t bandwidth_hz = 0;
  uint8_t legacy_profile = 0xFF;
  if (strcmp(signal.preset, "FuriHalSubGhzPresetOok270Async") == 0) {
    bandwidth_hz = 270000;
    legacy_profile = 1;
  } else if (strcmp(signal.preset, "FuriHalSubGhzPresetOok650Async") == 0) {
    bandwidth_hz = 650000;
    legacy_profile = 2;
  } else {
    return false;
  }

  disk.record_size = sizeof(disk);
  disk.button_id = local_ordinal + 1;
  disk.page = local_ordinal / MAX_UNIVERSAL_BUTTONS;
  disk.encoding = extended_raw ? RIPPER_RF_ENCODING_RAW_TIMINGS32 :
                                 RIPPER_RF_ENCODING_RAW_TIMINGS;
  disk.repeat_count = keeloq ? 10 : 1;
  disk.first_level = first_level;
  disk.modulation = RIPPER_RF_MODULATION_OOK;
  disk.legacy_profile_index = legacy_profile;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  disk.frequency_hz = signal.frequency_hz;
  disk.bit_rate_bps = 3790;
  disk.deviation_hz = 5000;
  disk.bandwidth_hz = bandwidth_hz;
  if (extended_raw) {
    disk.raw_timing_count = 0;
    disk.parsed_key = stored_timing_count;
  } else {
    disk.raw_timing_count = (uint16_t)stored_timing_count;
  }
  strlcpy(disk.preset_name, signal.preset, sizeof(disk.preset_name));
  strlcpy(disk.protocol_name, keeloq ? "KeeLoq" : "RAW",
          sizeof(disk.protocol_name));
  strlcpy(disk.label, signal.label, sizeof(disk.label));
  return true;
}


uint64_t generate_catalog_rf_remote_id() {
  for (uint8_t attempt = 0; attempt < 32; attempt++) {
    const uint64_t candidate = generate_saved_rf_remote_id();
    RipperRfIndexEntryV1 existing = {};
    if (candidate == 0 || ripper_rf_repository_find(candidate, existing)) continue;
    char final_path[96];
    char marker_path[112];
    snprintf(final_path, sizeof(final_path), RIPPER_RF_REMOTE_DIR "/%08lx%08lx.rfr",
             (unsigned long)(candidate >> 32), (unsigned long)candidate);
    snprintf(marker_path, sizeof(marker_path), "%s.deleted", final_path);
    if (!SD_MMC.exists(final_path) && !SD_MMC.exists(marker_path)) return candidate;
  }
  return 0;
}


bool import_ripper_rf_catalog_profile(uint8_t source, uint32_t profile_ordinal,
                                      uint64_t &remote_id_out,
                                      char *error_text, size_t error_size) {
  remote_id_out = 0;
  set_ripper_rf_import_error(error_text, error_size, "IMPORT FAILED");
  if (source > 1 || profile_ordinal > UINT16_MAX) {
    set_ripper_rf_import_error(error_text, error_size, "CATALOG PROFILE RANGE");
    return false;
  }
  if (!sd_card_ready || !ripper_rf_repository_ready) {
    set_ripper_rf_import_error(error_text, error_size, "RF REPOSITORY UNAVAILABLE");
    return false;
  }
  if (!ensure_ripper_rf_catalog_ready(source)) {
    set_ripper_rf_import_error(error_text, error_size, "RF CATALOG UNAVAILABLE");
    return false;
  }

  RipperRfCatalogProfile profile = {};
  if (!ripper_rf_catalog.readProfile(profile_ordinal, profile) ||
      profile.signal_count == 0 || profile.signal_count > 3060) {
    close_ripper_rf_catalog_session();
    set_ripper_rf_import_error(error_text, error_size,
                               "PROFILE NOT FULLY SUPPORTED");
    return false;
  }

  uint64_t estimated_payload = 0;
  for (uint16_t local = 0; local < profile.signal_count; local++) {
    RipperRfCatalogSignal signal = {};
    RipperRfButtonDiskV1 disk = {};
    if (!ripper_rf_catalog.readSignal(profile_ordinal, local, signal)) {
      close_ripper_rf_catalog_session();
      set_ripper_rf_import_error(error_text, error_size,
                                 "PROFILE CONTAINS UNSUPPORTED SIGNAL");
      return false;
    }
    const bool raw = signal.encoding == RIPPER_RF_CATALOG_ENCODING_RAW &&
      strcmp(signal.protocol, "RAW") == 0 &&
      (signal.flags & RIPPER_RF_CATALOG_SIGNAL_PARSEABLE) != 0;
    const bool keeloq = signal.encoding == RIPPER_RF_CATALOG_ENCODING_PARSED &&
      signal.bit_count == 64 && strcmp(signal.protocol, "KeeLoq") == 0 &&
      strcmp(signal.preset, "FuriHalSubGhzPresetOok650Async") == 0;
    uint8_t first_level = 1;
    uint32_t stored_count = 156;
    bool extended_raw = false;
    bool signal_valid = keeloq;
    if (raw) {
      RipperRfCatalogRawValidator validator(signal.raw_timing_count);
      signal_valid = ripper_rf_catalog.parseSignal(profile_ordinal, local,
                                                    validator);
      first_level = validator.first_level;
      stored_count = validator.output_count;
      extended_raw = validator.requiresExtended();
    }
    if (!signal_valid ||
        !make_catalog_rf_button(signal, local, first_level, stored_count,
                                extended_raw, disk)) {
      close_ripper_rf_catalog_session();
      set_ripper_rf_import_error(error_text, error_size,
                                 "PROFILE CONTAINS UNSUPPORTED SIGNAL");
      return false;
    }
    estimated_payload += sizeof(disk) + ripper_rf_button_timing_bytes(disk);
  }
  if (estimated_payload > 8ULL * 1024ULL * 1024ULL ||
      !ripper_rf_repository_has_space(sizeof(RipperRfRemoteFileHeaderV1) +
                                      estimated_payload)) {
    close_ripper_rf_catalog_session();
    set_ripper_rf_import_error(error_text, error_size,
                               estimated_payload > 8ULL * 1024ULL * 1024ULL ?
                                 "PROFILE TOO LARGE" : "INSUFFICIENT SD SPACE");
    return false;
  }

  const uint64_t remote_id = generate_catalog_rf_remote_id();
  char temporary_path[112] = {};
  if (remote_id == 0 ||
      !ripper_rf_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) {
    close_ripper_rf_catalog_session();
    set_ripper_rf_import_error(error_text, error_size, "REMOTE ID UNAVAILABLE");
    return false;
  }
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!target) {
    close_ripper_rf_catalog_session();
    set_ripper_rf_import_error(error_text, error_size, "IMPORT FILE OPEN FAILED");
    return false;
  }

  RipperRfRemoteFileHeaderV1 placeholder = {};
  bool wrote = target.write((const uint8_t *)&placeholder,
                            sizeof(placeholder)) == sizeof(placeholder);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  uint32_t payload_bytes = 0;
  uint16_t failed_local = UINT16_MAX;
  const char *failed_stage = wrote ? "NONE" : "PLACEHOLDER";
  char failed_label[48] = {};
  for (uint16_t local = 0; wrote && local < profile.signal_count; local++) {
    failed_local = local;
    failed_stage = "SIGNAL READ";
    RipperRfCatalogSignal signal = {};
    wrote = ripper_rf_catalog.readSignal(profile_ordinal, local, signal);
    if (!wrote) break;
    strlcpy(failed_label, signal.label, sizeof(failed_label));

    RipperRfButtonDiskV1 disk = {};
    const bool keeloq = signal.encoding == RIPPER_RF_CATALOG_ENCODING_PARSED &&
      signal.bit_count == 64 && strcmp(signal.protocol, "KeeLoq") == 0 &&
      strcmp(signal.preset, "FuriHalSubGhzPresetOok650Async") == 0;
    uint8_t first_level = 1;
    uint32_t stored_count = 156;
    bool extended_raw = false;
    if (keeloq) {
      failed_stage = "KEY VALIDATE";
      RipperRfCatalogKeeLoqValidator validator;
      wrote = ripper_rf_catalog.parseSignal(profile_ordinal, local, validator);
    } else {
      failed_stage = "RAW VALIDATE";
      RipperRfCatalogRawValidator validator(signal.raw_timing_count);
      wrote = ripper_rf_catalog.parseSignal(profile_ordinal, local, validator);
      first_level = validator.first_level;
      stored_count = validator.output_count;
      extended_raw = validator.requiresExtended();
    }
    if (!wrote) break;

    failed_stage = "BUTTON WRITE";
    wrote = make_catalog_rf_button(signal, local, first_level,
                                   stored_count, extended_raw, disk) &&
      target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk,
                                      sizeof(disk));
    payload_bytes += sizeof(disk);

    if (keeloq) {
      failed_stage = "KEY WRITE";
      RipperRfCatalogKeeLoqWriter writer(target, payload_crc, payload_bytes);
      wrote = ripper_rf_catalog.parseSignal(profile_ordinal, local, writer);
    } else {
      failed_stage = "RAW WRITE";
      RipperRfCatalogRawWriter writer(target, signal.raw_timing_count,
                                      stored_count, extended_raw,
                                      payload_crc, payload_bytes);
      wrote = ripper_rf_catalog.parseSignal(profile_ordinal, local, writer);
    }
  }

  RipperRfRemoteFileHeaderV1 header = {};
  if (wrote && payload_bytes <= estimated_payload) {
    header.magic = RIPPER_RF_FILE_MAGIC;
    header.version = RIPPER_RF_FILE_VERSION;
    header.header_size = sizeof(header);
    header.remote_id = remote_id;
    header.source_flags = RIPPER_RF_SOURCE_CATALOG |
      ((uint32_t)(source + 1) << RIPPER_RF_CATALOG_SOURCE_SHIFT) |
      ((profile_ordinal & 0xFFFFUL) << RIPPER_RF_CATALOG_PROFILE_SHIFT);
    if (profile.model[0] != '\0') strlcpy(header.name, profile.model, sizeof(header.name));
    else snprintf(header.name, sizeof(header.name), "RF CATALOG %lu",
                  (unsigned long)profile_ordinal);
    strlcpy(header.device_type, profile.category, sizeof(header.device_type));
    // Empty manufacturer metadata remains empty; the encoded source/profile
    // association above is attribution, not a manufactured brand claim.
    strlcpy(header.manufacturer, profile.manufacturer,
            sizeof(header.manufacturer));
    strlcpy(header.model, profile.model, sizeof(header.model));
    header.button_count = profile.signal_count;
    header.page_count =
      (profile.signal_count + MAX_UNIVERSAL_BUTTONS - 1) /
      MAX_UNIVERSAL_BUTTONS;
    header.payload_bytes = payload_bytes;
    header.payload_crc32 = ~payload_crc;
    header.header_crc32 = ripper_rf_header_crc(header);
    wrote = target.seek(0) &&
      target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  } else {
    wrote = false;
  }
  target.flush();
  target.close();
  close_ripper_rf_catalog_session();

  bool validated = false;
  if (wrote) validated = validate_ripper_rf_remote_file(temporary_path, remote_id);
  if (!wrote || !validated) {
    File diagnostic_file = SD_MMC.open(temporary_path, FILE_READ);
    const uint64_t diagnostic_size = diagnostic_file ? diagnostic_file.size() : 0;
    if (diagnostic_file) diagnostic_file.close();
    Serial.printf("RFC1 IMPORT DIAG wrote=%u validated=%u local=%u stage=%s label=%s payload=%lu estimated=%llu file=%llu validator=%s catalog=%s\n",
                  (unsigned)wrote, (unsigned)validated,
                  failed_local == UINT16_MAX ? 65535U : (unsigned)failed_local,
                  failed_stage, failed_label[0] != '\0' ? failed_label : "NONE",
                  (unsigned long)payload_bytes,
                  (unsigned long long)estimated_payload,
                  (unsigned long long)diagnostic_size,
                  ripper_rf_validation_error[0] != '\0' ?
                    ripper_rf_validation_error : "NOT RUN",
                  ripper_rf_catalog.lastError()[0] != '\0' ?
                    ripper_rf_catalog.lastError() : "NONE");
    if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
    set_ripper_rf_import_error(error_text, error_size,
                               "PROFILE VALIDATION FAILED");
    return false;
  }
  if (!ripper_rf_repository_commit_staged(temporary_path)) {
    if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
    set_ripper_rf_import_error(error_text, error_size, "IMPORT COMMIT FAILED");
    return false;
  }
  remote_id_out = remote_id;
  set_ripper_rf_import_error(error_text, error_size, "");
  return true;
}


void run_ripper_rf_catalog_import(uint8_t source, uint32_t profile_ordinal) {
  const uint32_t free_before = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  uint64_t remote_id = 0;
  char error_text[64] = {};
  if (!import_ripper_rf_catalog_profile(source, profile_ordinal, remote_id,
                                        error_text, sizeof(error_text))) {
    Serial.printf("RFC1 IMPORT ERROR %u %lu %s\n", (unsigned int)source,
                  (unsigned long)profile_ordinal,
                  error_text[0] == '\0' ? "IMPORT FAILED" : error_text);
    return;
  }
  RipperRfIndexEntryV1 imported = {};
  const uint32_t free_after = heap_caps_get_free_size(MALLOC_CAP_INTERNAL);
  if (!ripper_rf_repository_find(remote_id, imported)) {
    Serial.println("RFC1 IMPORT ERROR INDEX LOOKUP");
    return;
  }
  Serial.printf("RFC1 IMPORT OK %u %lu %08lx%08lx %u %u %lu %lu\n",
                (unsigned int)source, (unsigned long)profile_ordinal,
                (unsigned long)(remote_id >> 32), (unsigned long)remote_id,
                imported.button_count, imported.page_count,
                (unsigned long)free_before, (unsigned long)free_after);
}


void make_legacy_rf_button_disk(uint8_t remote_index, uint8_t button_index,
                                RipperRfButtonDiskV1 &disk) {
  memset(&disk, 0, sizeof(disk));
  const SavedRfRawCommand &command =
    saved_rf_raw_commands[remote_index][button_index];
  disk.record_size = sizeof(disk);
  disk.button_id = button_index + 1;
  disk.page = button_index / MAX_UNIVERSAL_BUTTONS;
  disk.encoding = command.valid && command.edge_count > 0 ?
    RIPPER_RF_ENCODING_RAW_TIMINGS : RIPPER_RF_ENCODING_UNASSIGNED;
  disk.repeat_count = command.valid >= 2 ? 8 : 1;
  disk.first_level = command.first_level ? 1 : 0;
  disk.x = INT16_MIN;
  disk.y = INT16_MIN;
  if (saved_rf_layouts[remote_index].magic == SAVED_REMOTE_LAYOUT_MAGIC) {
    disk.x = saved_rf_layouts[remote_index].x[button_index];
    disk.y = saved_rf_layouts[remote_index].y[button_index];
  }
  if (command.profile_index < RF_PROFILE_COUNT) {
    const RFProfilePreset &profile = RF_PROFILES[command.profile_index];
    disk.legacy_profile_index = command.profile_index;
    disk.modulation = profile.ook ? RIPPER_RF_MODULATION_OOK :
                                    RIPPER_RF_MODULATION_FSK;
    disk.frequency_hz = (uint32_t)lroundf(profile.frequency * 1000000.0f);
    disk.bit_rate_bps = (uint32_t)lroundf(profile.bit_rate * 1000.0f);
    disk.deviation_hz = (uint32_t)lroundf(profile.deviation * 1000.0f);
    disk.bandwidth_hz = (uint32_t)lroundf(profile.bandwidth * 1000.0f);
    strlcpy(disk.preset_name, profile.name, sizeof(disk.preset_name));
  } else {
    disk.legacy_profile_index = 0xFF;
    strlcpy(disk.preset_name, "UNKNOWN", sizeof(disk.preset_name));
  }
  disk.raw_timing_count = disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS ?
    (command.edge_count <= RF_SAVED_RAW_MAX_EDGES ? command.edge_count :
                                                     RF_SAVED_RAW_MAX_EDGES) : 0;
  strlcpy(disk.label, saved_remotes[remote_index].button_names[button_index],
          sizeof(disk.label));
}


bool write_legacy_rf_remote_to_sd(uint8_t remote_index) {
  if (!sd_card_ready || remote_index >= saved_remote_count ||
      saved_rf_remote_ids[remote_index] == 0) return false;
  const SavedRemoteRecord &remote = saved_remotes[remote_index];
  if (remote.magic != SAVED_REMOTE_MAGIC ||
      remote.button_count > MAX_UNIVERSAL_BUTTONS) return false;
  if (!ripper_rf_repository_ensure_directories()) return false;
  const uint64_t remote_id = saved_rf_remote_ids[remote_index];
  char temporary_path[112];
  if (!ripper_rf_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path))) return false;
  char final_path[96] = {};
  strlcpy(final_path, temporary_path, sizeof(final_path));
  final_path[strlen(final_path) - 4] = '\0';
  char marker_path[112];
  snprintf(marker_path, sizeof(marker_path), "%s.deleted", final_path);
  if (validate_ripper_rf_tombstone(marker_path, remote_id)) {
    Serial.printf("RF NVS recovery copy remains hidden after user deletion: %s\n",
                  remote.name);
    return true;
  }

  uint32_t payload_bytes = 0;
  uint32_t payload_crc = 0xFFFFFFFFUL;
  for (uint8_t button = 0; button < remote.button_count; button++) {
    RipperRfButtonDiskV1 disk = {};
    make_legacy_rf_button_disk(remote_index, button, disk);
    payload_bytes += sizeof(disk) +
      (uint32_t)disk.raw_timing_count * sizeof(uint16_t);
    payload_crc = ripper_crc32_update(payload_crc, (const uint8_t *)&disk,
                                      sizeof(disk));
    if (disk.raw_timing_count > 0) {
      payload_crc = ripper_crc32_update(
        payload_crc,
        (const uint8_t *)saved_rf_raw_commands[remote_index][button].durations_us,
        disk.raw_timing_count * sizeof(uint16_t));
    }
  }
  if (!ripper_rf_repository_has_space(sizeof(RipperRfRemoteFileHeaderV1) +
                                      payload_bytes)) {
    Serial.printf("RF SD migration skipped for %s: insufficient free space\n",
                  remote.name);
    return false;
  }
  RipperRfRemoteFileHeaderV1 header = {};
  header.magic = RIPPER_RF_FILE_MAGIC;
  header.version = RIPPER_RF_FILE_VERSION;
  header.header_size = sizeof(header);
  header.remote_id = remote_id;
  header.source_flags = RIPPER_RF_SOURCE_LEGACY_NVS;
  strlcpy(header.name, remote.name, sizeof(header.name));
  strlcpy(header.device_type, remote.category[0] ? remote.category : "RF REMOTE",
          sizeof(header.device_type));
  header.button_count = remote.button_count;
  header.page_count = remote.button_count == 0 ? 1 :
    (remote.button_count + MAX_UNIVERSAL_BUTTONS - 1) / MAX_UNIVERSAL_BUTTONS;
  header.payload_bytes = payload_bytes;
  header.payload_crc32 = ~payload_crc;
  header.header_crc32 = ripper_rf_header_crc(header);

  RipperRfRemoteFileHeaderV1 existing = {};
  if (validate_ripper_rf_remote_file(final_path, remote_id) &&
      ripper_rf_read_remote_header(final_path, existing)) {
    // NVS is a recovery copy once a repository remote has been edited or had
    // a button added. Never let boot migration replace that newer SD object
    // with the older fixed-size NVS snapshot.
    if ((existing.source_flags & RIPPER_RF_SOURCE_RIPPER_LEARNED) != 0 ||
        (existing.source_flags & RIPPER_RF_SOURCE_CATALOG) != 0) return true;
    if (existing.header_crc32 == header.header_crc32 &&
        existing.payload_crc32 == header.payload_crc32) return true;
  }

  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File file = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!file) return false;
  bool wrote = file.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  for (uint8_t button = 0; wrote && button < remote.button_count; button++) {
    RipperRfButtonDiskV1 disk = {};
    make_legacy_rf_button_disk(remote_index, button, disk);
    wrote = file.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (wrote && disk.raw_timing_count > 0) {
      wrote = file.write(
        (const uint8_t *)saved_rf_raw_commands[remote_index][button].durations_us,
        disk.raw_timing_count * sizeof(uint16_t)) ==
          disk.raw_timing_count * sizeof(uint16_t);
    }
  }
  file.flush();
  file.close();
  if (!wrote || !validate_ripper_rf_remote_file(temporary_path, remote_id)) {
    SD_MMC.remove(temporary_path);
    Serial.printf("RF SD migration verification failed for %s; NVS copy retained\n",
                  remote.name);
    return false;
  }
  if (!ripper_rf_repository_commit_staged(temporary_path)) {
    Serial.printf("RF SD migration commit failed for %s; NVS copy retained\n",
                  remote.name);
    return false;
  }
  Serial.printf("RF NVS recovery copy verified on SD: %s (%u buttons)\n",
                final_path, remote.button_count);
  return true;
}


void migrate_legacy_rf_remotes_to_sd() {
  ripper_rf_repository_runtime_authoritative = false;
  if (!sd_card_ready) return;
  if (saved_remote_count == 0) {
    ripper_rf_repository_runtime_authoritative = ripper_rf_repository_ready;
    return;
  }
  uint8_t verified = 0;
  for (uint8_t remote = 0; remote < saved_remote_count; remote++) {
    if (write_legacy_rf_remote_to_sd(remote)) verified++;
  }
  sd_card_used_bytes = SD_MMC.usedBytes();
  Serial.printf("RF SD recovery migration: %u/%u verified; original NVS data retained\n",
                verified, saved_remote_count);
  if (!rebuild_ripper_rf_repository_index()) {
    Serial.println("RF repository index rebuild failed; NVS data and RF files retained");
    return;
  }
  ripper_rf_repository_runtime_authoritative =
    ripper_rf_repository_ready && verified == saved_remote_count;
}


void process_pending_rf_repository_deletes() {
  if (!sd_card_ready || !ripper_rf_repository_ready) return;
  bool changed = false;
  for (uint8_t i = 0; i < MAX_SAVED_REMOTES; i++) {
    const uint64_t remote_id = pending_rf_repository_delete_ids[i];
    if (remote_id == 0) continue;
    RipperRfIndexEntryV1 existing = {};
    if (!ripper_rf_repository_find(remote_id, existing) ||
        ripper_rf_repository_delete(remote_id)) {
      pending_rf_repository_delete_ids[i] = 0;
      changed = true;
    }
  }
  if (changed) persist_pending_rf_repository_deletes();
}


void clear_repository_rf_remote_adapter() {
  rf_working_remote_from_repository = false;
  rf_working_repository_id = 0;
  rf_working_repository_path[0] = '\0';
  rf_working_repository_name[0] = '\0';
  memset(rf_working_repository_absolute_indices, 0,
         sizeof(rf_working_repository_absolute_indices));
  memset(rf_working_repository_x, 0, sizeof(rf_working_repository_x));
  memset(rf_working_repository_y, 0, sizeof(rf_working_repository_y));
  memset(rf_working_repository_width, 0, sizeof(rf_working_repository_width));
  memset(rf_working_repository_height, 0, sizeof(rf_working_repository_height));
  rf_working_repository_total_buttons = 0;
  rf_working_repository_page_count = 1;
  rf_working_repository_current_page = 0;
  rf_repository_send_error[0] = '\0';
}


bool load_repository_rf_page(uint8_t requested_page) {
  if (!rf_working_remote_from_repository ||
      rf_working_repository_path[0] == '\0' ||
      requested_page >= rf_working_repository_page_count ||
      !validate_ripper_rf_remote_file(rf_working_repository_path,
                                      rf_working_repository_id)) return false;
  File file = SD_MMC.open(rf_working_repository_path, FILE_READ);
  if (!file) return false;
  RipperRfRemoteFileHeaderV1 header = {};
  if (file.read((uint8_t *)&header, sizeof(header)) != sizeof(header)) {
    file.close();
    return false;
  }

  memset(universal_button_names, 0, sizeof(universal_button_names));
  memset(universal_working_rf_commands, 0,
         sizeof(universal_working_rf_commands));
  memset(rf_working_repository_absolute_indices, 0,
         sizeof(rf_working_repository_absolute_indices));
  uint8_t cached = 0;
  bool overflow = false;
  for (uint16_t absolute = 0; absolute < header.button_count; absolute++) {
    RipperRfButtonDiskV1 disk = {};
    if (file.read((uint8_t *)&disk, sizeof(disk)) != sizeof(disk) ||
        disk.record_size != sizeof(disk)) {
      file.close();
      return false;
    }
    if (disk.page == requested_page) {
      if (cached >= MAX_UNIVERSAL_BUTTONS) {
        overflow = true;
      } else {
        strlcpy(universal_button_names[cached], disk.label,
                sizeof(universal_button_names[cached]));
        rf_working_repository_absolute_indices[cached] = absolute;
        rf_working_repository_x[cached] = disk.x;
        rf_working_repository_y[cached] = disk.y;
        rf_working_repository_width[cached] = disk.width;
        rf_working_repository_height[cached] = disk.height;
        cached++;
      }
    }
    const uint64_t timing_bytes = ripper_rf_button_timing_bytes(disk);
    if (timing_bytes > UINT32_MAX ||
        !file.seek(file.position() + (uint32_t)timing_bytes)) {
      file.close();
      return false;
    }
  }
  file.close();
  // Never truncate a malformed page. A valid Ripper RF page currently holds
  // at most the twelve touch targets supported by the graphical remote.
  if (overflow || cached == 0) return false;
  universal_button_count = cached;
  universal_remote_loaded_from_save = true;
  rf_working_repository_current_page = requested_page;
  return true;
}


bool load_repository_rf_remote_adapter(uint64_t remote_id) {
  if (!sd_card_ready || !ripper_rf_repository_ready || remote_id == 0)
    return false;
  RipperRfIndexEntryV1 metadata = {};
  if (!ripper_rf_repository_find(remote_id, metadata) ||
      metadata.button_count == 0 || metadata.button_count > 4096 ||
      metadata.page_count == 0 ||
      !validate_ripper_rf_remote_file(metadata.file_path, remote_id))
    return false;

  rf_working_remote_from_repository = true;
  rf_working_repository_id = remote_id;
  rf_working_repository_total_buttons = metadata.button_count;
  rf_working_repository_page_count = metadata.page_count;
  rf_working_repository_current_page = 0;
  strlcpy(rf_working_repository_path, metadata.file_path,
          sizeof(rf_working_repository_path));
  strlcpy(rf_working_repository_name, metadata.name,
          sizeof(rf_working_repository_name));
  if (!load_repository_rf_page(0)) {
    clear_repository_rf_remote_adapter();
    return false;
  }
  return true;
}


int8_t find_legacy_rf_remote_by_id(uint64_t remote_id) {
  if (remote_id == 0) return -1;
  for (uint8_t i = 0; i < saved_remote_count; i++) {
    if (saved_rf_remote_ids[i] == remote_id) return (int8_t)i;
  }
  return -1;
}


bool rewrite_repository_rf_remote(uint64_t remote_id, const char *new_name,
                                  bool update_current_page_layout) {
  RipperRfIndexEntryV1 entry = {};
  if (!sd_card_ready || !ripper_rf_repository_ready || remote_id == 0 ||
      !ripper_rf_repository_find(remote_id, entry) ||
      !validate_ripper_rf_remote_file(entry.file_path, remote_id)) return false;

  File size_probe = SD_MMC.open(entry.file_path, FILE_READ);
  const uint64_t source_bytes = size_probe ? size_probe.size() : 0;
  if (size_probe) size_probe.close();
  if (source_bytes == 0 || !ripper_rf_repository_has_space(source_bytes))
    return false;

  char temporary_path[112] = {};
  if (!ripper_rf_repository_make_staging_path(remote_id, temporary_path,
                                               sizeof(temporary_path)))
    return false;
  if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
  File source = SD_MMC.open(entry.file_path, FILE_READ);
  File target = SD_MMC.open(temporary_path, FILE_WRITE);
  if (!source || !target) {
    if (source) source.close();
    if (target) target.close();
    return false;
  }

  RipperRfRemoteFileHeaderV1 header = {};
  bool wrote = source.read((uint8_t *)&header, sizeof(header)) == sizeof(header);
  RipperRfRemoteFileHeaderV1 placeholder = {};
  wrote = wrote && target.write((const uint8_t *)&placeholder,
                                sizeof(placeholder)) == sizeof(placeholder);
  uint32_t payload_crc = 0xFFFFFFFFUL;
  uint32_t payload_bytes = 0;
  uint8_t buffer[256];
  for (uint16_t absolute = 0; wrote && absolute < header.button_count;
       absolute++) {
    RipperRfButtonDiskV1 disk = {};
    wrote = source.read((uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (!wrote) break;
    if (update_current_page_layout &&
        disk.page == rf_working_repository_current_page) {
      for (uint8_t local = 0; local < universal_button_count; local++) {
        if (rf_working_repository_absolute_indices[local] == absolute) {
          disk.x = rf_working_repository_x[local];
          disk.y = rf_working_repository_y[local];
          disk.width = rf_working_repository_width[local];
          disk.height = rf_working_repository_height[local];
          break;
        }
      }
    }
    wrote = target.write((const uint8_t *)&disk, sizeof(disk)) == sizeof(disk);
    if (wrote) {
      payload_crc = ripper_crc32_update(payload_crc,
                                         (const uint8_t *)&disk,
                                         sizeof(disk));
      payload_bytes += sizeof(disk);
    }
    const uint64_t timing_bytes = ripper_rf_button_timing_bytes(disk);
    if (timing_bytes > UINT32_MAX) {
      wrote = false;
      break;
    }
    uint32_t remaining = (uint32_t)timing_bytes;
    while (wrote && remaining > 0) {
      const size_t chunk = remaining > sizeof(buffer) ? sizeof(buffer) : remaining;
      wrote = source.read(buffer, chunk) == chunk &&
              target.write(buffer, chunk) == chunk;
      if (wrote) {
        payload_crc = ripper_crc32_update(payload_crc, buffer, chunk);
        payload_bytes += chunk;
      }
      remaining -= chunk;
    }
  }
  source.close();

  if (wrote && payload_bytes == header.payload_bytes) {
    if (new_name != NULL && new_name[0] != '\0')
      strlcpy(header.name, new_name, sizeof(header.name));
    if (new_name != NULL || update_current_page_layout)
      header.source_flags |= RIPPER_RF_SOURCE_RIPPER_LEARNED;
    header.payload_crc32 = ~payload_crc;
    header.header_crc32 = ripper_rf_header_crc(header);
    wrote = target.seek(0) &&
      target.write((const uint8_t *)&header, sizeof(header)) == sizeof(header);
  } else {
    wrote = false;
  }
  target.flush();
  target.close();
  if (!wrote || !validate_ripper_rf_remote_file(temporary_path, remote_id) ||
      !ripper_rf_repository_commit_staged(temporary_path)) {
    if (SD_MMC.exists(temporary_path)) SD_MMC.remove(temporary_path);
    return false;
  }
  return true;
}


bool rename_repository_rf_remote(uint64_t remote_id, const char *new_name) {
  if (new_name == NULL || new_name[0] == '\0' ||
      !rewrite_repository_rf_remote(remote_id, new_name, false)) return false;

  const int8_t legacy_index = find_legacy_rf_remote_by_id(remote_id);
  if (legacy_index >= 0) {
    strlcpy(saved_remotes[legacy_index].name, new_name,
            sizeof(saved_remotes[legacy_index].name));
    persist_saved_remotes();
  }
  if (rf_working_remote_from_repository &&
      rf_working_repository_id == remote_id) {
    const uint8_t page = rf_working_repository_current_page;
    if (!load_repository_rf_remote_adapter(remote_id) ||
        (page > 0 && !load_repository_rf_page(page))) return false;
  }
  return true;
}


bool update_repository_rf_current_page_layout() {
  if (!rf_working_remote_from_repository || rf_working_repository_id == 0)
    return false;
  const uint64_t remote_id = rf_working_repository_id;
  const uint8_t page = rf_working_repository_current_page;
  if (!rewrite_repository_rf_remote(remote_id, NULL, true) ||
      !load_repository_rf_remote_adapter(remote_id) ||
      (page > 0 && !load_repository_rf_page(page))) return false;
  return true;
}

uint8_t safe_rf_profile_index() {
  return rf_profile_index < RF_PROFILE_COUNT ? rf_profile_index : 0;
}

// RadioLib configures the normal CC1101 settings.  These small register sets
// add the AGC/data-slicer tuning used by Flipper's asynchronous AM presets.
// Keeping this helper local also avoids touching the display SPI bus.
void write_cc1101_register(uint8_t address, uint8_t value) {
#if CC1101_ACCESS_ENABLED
  cc1101_spi.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE0));
  digitalWrite(CC1101_CS, LOW);
  cc1101_spi.transfer(address);
  cc1101_spi.transfer(value);
  digitalWrite(CC1101_CS, HIGH);
  cc1101_spi.endTransaction();
#else
  (void)address;
  (void)value;
#endif
}

void apply_flipper_ook_receive_tuning(bool bandwidth_650khz) {
  // CC1101 register addresses and values from Flipper Zero's public
  // OOK-270/OOK-650 asynchronous presets.  Frequency remains controlled by
  // RadioLib above; only the receive/demodulation behavior is adjusted here.
  const uint8_t registers[][2] = {
    {0x02, 0x0D}, // IOCFG0: async serial data on GDO0
    {0x03, (uint8_t)(bandwidth_650khz ? 0x07 : 0x47)}, // FIFOTHR
    {0x08, 0x32}, // PKTCTRL0: async, infinite packet mode
    {0x0B, 0x06}, // FSCTRL1
    {0x0C, 0x00}, // MDMCFG0: 25 kHz channel spacing
    {0x0D, 0x00}, // MDMCFG1: 25 kHz channel spacing
    {0x10, (uint8_t)(bandwidth_650khz ? 0x17 : 0x67)}, // MDMCFG4: RX bandwidth
    {0x11, 0x32}, // MDMCFG3: 3.79 kBaud
    {0x12, 0x30}, // MDMCFG2: ASK/OOK, no sync
    {0x13, 0x00},
    {0x14, 0x00},
    {0x18, 0x18}, // MCSM0
    {0x19, 0x18}, // FOCCFG
    {0x1B, (uint8_t)(bandwidth_650khz ? 0x07 : 0x03)}, // AGCCTRL2
    {0x1C, 0x00}, // AGCCTRL1
    {0x1D, (uint8_t)(bandwidth_650khz ? 0x91 : 0x40)}, // AGCCTRL0
    {0x20, 0xFB}, // WORCTRL
    {0x21, 0xB6}, // FREND1
    {0x22, 0x11}  // FREND0
  };
  for (uint8_t i = 0; i < sizeof(registers) / sizeof(registers[0]); i++) {
    write_cc1101_register(registers[i][0], registers[i][1]);
  }
}


void apply_flipper_fsk_receive_tuning(uint8_t deviation_register) {
  // Flipper's asynchronous 2-FSK presets.  RadioLib establishes the basic
  // frequency first; these registers then match the public Flipper receive
  // modem configuration (async GDO0, 4.798 kBaud, 270 kHz bandwidth).
  const uint8_t registers[][2] = {
    {0x02, 0x0D}, // IOCFG0: async serial data on GDO0
    {0x07, 0x04}, // PKTCTRL1
    {0x08, 0x32}, // PKTCTRL0: async, continuous
    {0x0B, 0x06}, // FSCTRL1
    {0x0C, 0x00}, // MDMCFG0
    {0x0D, 0x02}, // MDMCFG1
    {0x10, 0x67}, // MDMCFG4: 270 kHz RX bandwidth
    {0x11, 0x83}, // MDMCFG3: 4.798 kBaud
    {0x12, 0x04}, // MDMCFG2: 2-FSK, no sync
    {0x15, deviation_register},
    {0x18, 0x18}, // MCSM0
    {0x19, 0x16}, // FOCCFG
    {0x1B, 0x07}, // AGCCTRL2
    {0x1C, 0x00}, // AGCCTRL1
    {0x1D, 0x91}, // AGCCTRL0
    {0x20, 0xFB}, // WORCTRL
    {0x21, 0x56}, // FREND1
    {0x22, 0x10}  // FREND0
  };
  for (uint8_t i = 0; i < sizeof(registers) / sizeof(registers[0]); i++) {
    write_cc1101_register(registers[i][0], registers[i][1]);
  }
}

bool apply_rf_profile(uint8_t profile_index, bool announce = true) {
#if !CC1101_ACCESS_ENABLED
  (void)profile_index;
  return false;
#else
  if (profile_index >= RF_PROFILE_COUNT) return false;
  // Direct RX leaves the CC1101 and GDO0 in an asynchronous state. Return to
  // packet/idle mode before replacing its modem registers, particularly when
  // switching repeatedly between OOK and FSK from the touch profile menu.
  cc1101.packetMode();
  delay(2);
  const RFProfilePreset &profile = RF_PROFILES[profile_index];
  ConfigFSK_t config;
  config.frequency = profile.frequency;
  config.bitRate = profile.bit_rate;
  config.frequencyDeviation = profile.deviation;
  config.receiverBandwidth = profile.bandwidth;
  config.power = 0;

  int16_t state = cc1101.begin(config);
  if (state != RADIOLIB_ERR_NONE) {
    Serial.printf("CC1101 profile init failed: %d\n", state);
    return false;
  }
  state = cc1101.setOOK(profile.ook);
  if (state != RADIOLIB_ERR_NONE) {
    Serial.printf("CC1101 modulation setup failed: %d\n", state);
    return false;
  }
  if (profile.ook && profile.bit_rate > 3.7 && profile.bit_rate < 3.9 &&
      (profile.bandwidth == 270.0 || profile.bandwidth == 650.0)) {
    apply_flipper_ook_receive_tuning(profile.bandwidth == 650.0);
  } else if (!profile.ook && profile.bit_rate > 4.7 && profile.bit_rate < 4.9 &&
             profile.bandwidth == 270.0) {
    uint8_t deviation_register = 0x04;
    if (profile.deviation > 30.0) deviation_register = 0x47;
    else if (profile.deviation > 8.0) deviation_register = 0x30;
    apply_flipper_fsk_receive_tuning(deviation_register);
  }
  rf_profile_index = profile_index;
  if (announce) {
    Serial.printf("CC1101 ready: %s (%.2f MHz %s)\n", profile.name,
                  profile.frequency, profile.ook ? "OOK" : "FSK");
  }
  return true;
#endif
}


void load_rf_profile_preference() {
  saved_preferences.begin("ripperzero", true);
  uint8_t stored_profile = saved_preferences.getUChar("rfProfile", 0);
  saved_preferences.end();
  if (stored_profile < RF_PROFILE_COUNT) {
    rf_profile_index = stored_profile;
  }
}


void persist_rf_profile_preference() {
  saved_preferences.begin("ripperzero", false);
  saved_preferences.putUChar("rfProfile", rf_profile_index);
  saved_preferences.end();
}

// A short receive-only profile scan.  Hold an owned remote close to the
// antenna while this runs; it selects a radio starting point, not a protocol.
bool scan_rf_profiles() {
#if !CC1101_ACCESS_ENABLED
  return false;
#else
  if (rf_capture_active) return false;
  const uint8_t previous_profile = safe_rf_profile_index();
  int8_t best_profile = -1;
  float best_rssi = -140.0f;
  float best_score = -1000.0f;
  uint16_t best_transitions = 0;
  const uint32_t scan_until = millis() + 3500;

  // Cycle through the presets for long enough that the person has time to
  // tap SCAN and then press/hold their remote.  The earlier single pass was
  // too short and only measured ambient noise.
  while ((int32_t)(millis() - scan_until) < 0) {
    for (uint8_t i = 0; i < RF_PROFILE_COUNT &&
         (int32_t)(millis() - scan_until) < 0; i++) {
      if (!apply_rf_profile(i, false)) continue;
      if (cc1101.receiveDirectAsync() != RADIOLIB_ERR_NONE) continue;
      delay(8);
      float peak = -140.0f;
      uint16_t transitions = 0;
      uint8_t previous_level = digitalRead(CC1101_GDO0);
      const uint32_t sample_until = millis() + 48;
      while ((int32_t)(millis() - sample_until) < 0) {
        const float rssi = cc1101.getRSSI();
        if (rssi > peak) peak = rssi;
        const uint8_t level = digitalRead(CC1101_GDO0);
        if (level != previous_level) {
          transitions++;
          previous_level = level;
        }
        delayMicroseconds(250);
      }
      cc1101.packetMode();
      // Prefer a profile that produces a clean changing data stream.  RSSI is
      // still included because very slow remotes may not toggle often during
      // this short observation window.
      const float transition_bonus = min((uint16_t)80, transitions) * 0.35f;
      const float score = peak + transition_bonus;
      if (score > best_score) {
        best_score = score;
        best_rssi = peak;
        best_transitions = transitions;
        best_profile = i;
        Serial.printf("RF profile candidate: %s peak=%.1f dBm edges=%u score=%.1f\n",
                      RF_PROFILES[i].name, peak, transitions, score);
      }
    }
  }
  if (best_profile < 0 ||
      (best_rssi < RF_PROFILE_MIN_SIGNAL_DBM && best_transitions < 4)) {
    apply_rf_profile(previous_profile);
    Serial.printf("RF scan: no usable signal (best=%.1f dBm edges=%u)\n",
                  best_rssi, best_transitions);
    return false;
  }
  // RSSI cannot prove a protocol, but it can choose the strongest receive
  // starting point. Keep this internal so the user never has to manage radio
  // presets manually.
  rf_profile_last_rssi = best_rssi;
  rf_profile_suggested_index = best_profile;
  apply_rf_profile(best_profile, false);
  Serial.printf("RF scan selected: %s peak=%.1f dBm edges=%u score=%.1f\n",
                RF_PROFILES[best_profile].name, rf_profile_last_rssi,
                best_transitions, best_score);
  return true;
#endif
}

uint8_t read_cc1101_status_register(uint8_t address) {
#if CC1101_ACCESS_ENABLED
  cc1101_spi.beginTransaction(
    SPISettings(1000000, MSBFIRST, SPI_MODE0)
  );

  digitalWrite(CC1101_CS, LOW);
  cc1101_spi.transfer(address | 0xC0);
  uint8_t value = cc1101_spi.transfer(0x00);
  digitalWrite(CC1101_CS, HIGH);

  cc1101_spi.endTransaction();
  return value;
#else
  (void)address;
  return 0;
#endif
}


bool initialize_cc1101() {
#if !CC1101_ACCESS_ENABLED
  Serial.println("CC1101 access disabled to preserve the display SPI bus");
  return false;
#else
  cc1101_spi.begin(
    CC1101_SCK,
    CC1101_MISO,
    CC1101_MOSI,
    CC1101_CS
  );

  pinMode(CC1101_CS, OUTPUT);
  digitalWrite(CC1101_CS, HIGH);
  delay(5);

  uint8_t partnum = read_cc1101_status_register(0x30);
  uint8_t version = read_cc1101_status_register(0x31);
  Serial.printf(
    "CC1101 SPI probe: PARTNUM=0x%02X VERSION=0x%02X\n",
    partnum,
    version
  );

  return apply_rf_profile(rf_profile_index);
#endif
}


bool initialize_e01_radio() {
#if !E01_ACCESS_ENABLED
  Serial.println("E01/nRF24 support installed but disabled pending verified wiring");
  return false;
#else
  // The CC1101 owns initialization of this SPI bus. RF24 uses transactions
  // with its independent CSN pin, allowing both radios to remain connected.
  pinMode(CC1101_CS, OUTPUT);
  digitalWrite(CC1101_CS, HIGH);
  pinMode(E01_CSN_PIN, OUTPUT);
  digitalWrite(E01_CSN_PIN, HIGH);

  if (!e01_radio.begin(&cc1101_spi, E01_CE_PIN, E01_CSN_PIN)) {
    Serial.println("E01/nRF24 not detected");
    return false;
  }

  // Start conservatively. The PA/LNA module can draw sharp current peaks;
  // higher PA levels remain unavailable until its 3.3 V supply is validated.
  e01_radio.setPALevel(RF24_PA_MIN);
  e01_radio.setDataRate(RF24_1MBPS);
  e01_radio.setChannel(76);
  e01_radio.stopListening();
  e01_radio.powerDown();
  Serial.println("E01/nRF24 detected and parked in low-power mode");
  return true;
#endif
}


bool transmit_discovery_candidate() {
#if !CC1101_ACCESS_ENABLED
  return false;
#else
  if (!cc1101_ready) {
    return false;
  }

  set_status("TRANSMITTING", COLOR_SETTINGS);

  // A bounded low-power bring-up packet.  Future protocol templates replace
  // this payload only after a compatible device/protocol is selected.
  uint8_t candidate[] = {
    'R', 'Z', 'D',
    (uint8_t)discovery_candidate_index
  };

  int16_t state = cc1101.transmit(candidate, sizeof(candidate));
  if (state != RADIOLIB_ERR_NONE) {
    Serial.printf("CC1101 transmit failed: %d\n", state);
    return false;
  }

  set_status("SYSTEM READY", COLOR_READY);

  Serial.printf("CC1101 test candidate %d sent\n", discovery_candidate_index + 1);
  return true;
#endif
}


void IRAM_ATTR rf_capture_edge() {
  // GDO2 is mapped to carrier-sense. Ignore demodulator chatter unless a
  // nearby transmitter is actually present.
  if (digitalRead(CC1101_GDO2) == LOW) {
    return;
  }

  rf_capture_carrier_seen = true;
  uint32_t now = micros();
  uint32_t previous = rf_capture_last_edge_us;

  if (previous == 0 || !rf_capture_active) {
    rf_capture_last_edge_us = now;
    return;
  }

  uint32_t duration = now - previous;
  if (duration < RF_CAPTURE_MIN_PULSE_US) {
    return;
  }

  rf_capture_last_edge_us = now;

  // A long quiet interval separates repeats of typical fixed-code remotes.
  // Keep only the newest complete-looking frame, not the idle gap itself.
  if (duration > RF_CAPTURE_FRAME_GAP_US) {
    rf_capture_edge_count = 0;
    return;
  }

  uint16_t index = rf_capture_edge_count;
  if (index < RF_CAPTURE_MAX_EDGES) {
    rf_capture_durations[index] = duration;
    rf_capture_edge_count = index + 1;
  }
}

// GDO2 is configured as the CC1101 carrier-sense output.  It is deliberately
// separate from GDO0: GDO0 carries the demodulated data, while this flag lets
// us begin the RMT recording only after a nearby transmitter is present.
void IRAM_ATTR rf_capture_carrier_detected() {
  if (rf_capture_active) {
    // Carrier sense is only a hint. The RSSI rise above the idle baseline is
    // what authorizes recording; otherwise steady nearby RF looks like a tap.
    rf_capture_gdo2_seen = true;
  }
}


bool start_rf_capture() {
#if !CC1101_ACCESS_ENABLED
  return false;
#else
  if (!cc1101_ready) {
    return false;
  }

  noInterrupts();
  rf_capture_edge_count = 0;
  rf_capture_last_edge_us = 0;
  rf_capture_active = true;
  rf_capture_ready = false;
  rf_capture_carrier_seen = false;
  rf_capture_gdo2_seen = false;
  rf_capture_gdo2_interrupt_attached = false;
  rf_rmt_capture_started = false;
  rf_capture_peak_rssi = -140.0f;
  rf_capture_baseline_rssi = -140.0f;
  rf_capture_baseline_sum = 0.0f;
  rf_capture_baseline_samples = 0;
  rf_capture_armed_ms = millis();
  rf_capture_quiet_started_ms = rf_capture_armed_ms;
  rf_capture_baseline_ready = false;
  interrupts();

  pinMode(CC1101_GDO0, INPUT);
  pinMode(CC1101_GDO2, INPUT);
  int16_t state = cc1101.receiveDirectAsync();
  if (state != RADIOLIB_ERR_NONE) {
    rf_capture_active = false;
    Serial.printf("CC1101 raw capture start failed: %d\n", state);
    return false;
  }

  state = cc1101.setDIOMapping(2, RADIOLIB_CC1101_GDOX_CARRIER_SENSE);
  if (state != RADIOLIB_ERR_NONE) {
    rf_capture_active = false;
    Serial.printf("CC1101 carrier-sense setup failed: %d\n", state);
    return false;
  }

  if (!rf_rmt_ready) {
    rf_rmt_ready = rmtInit(CC1101_GDO0, RMT_RX_MODE, RMT_MEM_NUM_BLOCKS_4, 1000000);
    // ESP32-S3 RMT supports at most 32767 ticks at 1 MHz. Keep listening
    // across the ~25 ms inter-frame gaps used by Hunter and similar remotes
    // so repeat-aware extraction receives more than one complete frame.
    if (rf_rmt_ready) rmtSetRxMaxThreshold(CC1101_GDO0, RF_RMT_RX_TIMEOUT_US);
  }
  if (!rf_rmt_ready) {
    rf_capture_active = false;
    Serial.println("RMT capture start failed");
    return false;
  }

  // Raw Lab validates its signal with the measured RSSI rise and therefore
  // does not need the separate carrier-sense GPIO interrupt. Avoiding that
  // late ISR-service allocation also prevents the observed ESP32 IPC stack
  // canary failure at the auto-find-to-capture handoff. The established RF
  // learner keeps its GDO2 carrier hint unchanged.
  if (!rf_raw_lab_capture_mode) {
    attachInterrupt(digitalPinToInterrupt(CC1101_GDO2),
                    rf_capture_carrier_detected, RISING);
    rf_capture_gdo2_interrupt_attached = true;
  }

  Serial.printf("CC1101 capture armed: %s; measuring idle RF, then waiting for button\n",
                RF_PROFILES[safe_rf_profile_index()].name);
  return true;
#endif
}


void stop_rf_capture() {
#if CC1101_ACCESS_ENABLED
  if (!rf_capture_active) {
    return;
  }

  rf_capture_active = false;
  if (rf_capture_gdo2_interrupt_attached) {
    detachInterrupt(digitalPinToInterrupt(CC1101_GDO2));
    rf_capture_gdo2_interrupt_attached = false;
  }
  if (rf_rmt_ready) {
    rmtDeinit(CC1101_GDO0);
    rf_rmt_ready = false;
  }
  rf_rmt_capture_started = false;
  cc1101.packetMode();
#endif
}


bool rf_capture_edges_match(uint16_t first, uint16_t second) {
  uint32_t a = rf_capture_durations[first];
  uint32_t b = rf_capture_durations[second];
  if (a < RF_CAPTURE_MIN_PULSE_US || b < RF_CAPTURE_MIN_PULSE_US ||
      a >= RF_RMT_IDLE_MARKER_US || b >= RF_RMT_IDLE_MARKER_US ||
      rf_capture_levels[first] != rf_capture_levels[second]) {
    return false;
  }
  uint32_t difference = a > b ? a - b : b - a;
  // Compare timing families, not ADC-perfect microseconds. Cheap remote
  // oscillators and the CC1101 slicer routinely move an edge by 10-20%.
  uint32_t tolerance = max((uint32_t)120, (a + b) / 5U);
  return difference <= tolerance;
}


bool find_repeated_rf_frame(uint16_t &start_out, uint16_t &count_out) {
  // Find the shortest stable period inside the captured burst. Remotes often
  // send the same command a different number of times depending on how long
  // the button is held, so retaining the longest matching run makes otherwise
  // identical presses appear different. Keep exactly one repeated frame.
  const uint16_t captured_edges = rf_capture_edge_count;
  const uint16_t search_limit = captured_edges > 640 ? 640 : captured_edges;
  uint16_t best_start = 0;
  uint16_t best_period = 0;
  uint8_t best_repeats = 0;
  uint8_t best_quality = 0;

  for (uint16_t first = 0; first + 20 < search_limit; first++) {
    if (rf_capture_durations[first] >= RF_RMT_IDLE_MARKER_US) continue;
    uint16_t second_limit = min((uint16_t)(search_limit - 20),
                                (uint16_t)(first + RF_SAVED_RAW_MAX_EDGES));
    for (uint16_t second = first + 20; second <= second_limit; second++) {
      const uint16_t period = second - first;
      if (second + period > search_limit) continue;

      // A real remote frame normally contains a sync or frame-gap interval.
      // Requiring an anchor prevents highly repetitive 400/800 data from
      // being mistaken for a tiny 20-edge "frame" inside the payload.
      bool has_anchor = false;
      for (uint16_t offset = 0; offset < period; offset++) {
        const uint32_t duration = rf_capture_durations[first + offset];
        if (duration >= 2000 && duration < RF_RMT_IDLE_MARKER_US) {
          has_anchor = true;
          break;
        }
      }
      if (!has_anchor) continue;

      uint16_t matches = 0;
      for (uint16_t offset = 0; offset < period; offset++) {
        if (rf_capture_edges_match(first + offset, second + offset)) matches++;
      }
      uint8_t quality = (uint32_t)matches * 100U / period;
      if (quality < 85) continue;

      uint8_t repeats = 2;
      for (uint16_t next = second + period;
           next + period <= search_limit && repeats < 8;
           next += period) {
        uint16_t repeat_matches = 0;
        for (uint16_t offset = 0; offset < period; offset++) {
          if (rf_capture_edges_match(first + offset, next + offset)) repeat_matches++;
        }
        if ((uint32_t)repeat_matches * 100U / period < 85) break;
        repeats++;
      }

      if (repeats > best_repeats ||
          (repeats == best_repeats && quality > best_quality) ||
          (repeats == best_repeats && quality == best_quality &&
           (best_period == 0 || period < best_period))) {
        best_start = first;
        best_period = period;
        best_repeats = repeats;
        best_quality = quality;
      }
    }
  }

  if (best_period < 20) return false;
  start_out = best_start;
  count_out = best_period;
  rf_capture_repeat_quality = best_quality;
  rf_capture_repeat_count = best_repeats;
  Serial.printf("RF learner found one %u-edge frame repeated %u times (%u%% timing agreement)\n",
                best_period, best_repeats, best_quality);
  return true;
}


bool build_rf_learn_frame_from_capture(RfLearnFrame &frame) {
  if (rf_capture_edge_count < 20) return false;
  rf_capture_repeat_quality = 0;
  rf_capture_repeat_count = 0;

  // Prefer a frame that proves it repeats inside this one capture. This is a
  // lightweight BinRAW-style extraction: the eventual stored command is the
  // useful waveform, not the RMT stop marker or unrelated noise around it.
  uint16_t best_start = 0;
  uint16_t best_count = 0;
  bool repeated_frame = find_repeated_rf_frame(best_start, best_count);
  uint8_t idle_markers = 0;

  if (!repeated_frame) {
    // For short single-burst remotes, retain the best span between RMT's
    // artificial end-of-capture markers. Those still must agree over three
    // independent presses before a command can be saved.
    uint16_t span_start = 0;
    for (uint16_t i = 0; i <= rf_capture_edge_count; i++) {
      bool ends_span = i == rf_capture_edge_count ||
                       rf_capture_durations[i] >= RF_RMT_IDLE_MARKER_US;
      if (!ends_span) continue;

      uint16_t span_count = i - span_start;
      if (span_count >= 20 && span_count <= RF_SAVED_RAW_MAX_EDGES &&
          span_count > best_count) {
        best_start = span_start;
        best_count = span_count;
      }
      if (i < rf_capture_edge_count) {
        idle_markers++;
        span_start = i + 1;
      }
    }
  }
  if (best_count == 0) return false;

  // Normalize after the longest real pause. Captures can begin at different
  // instants, while a command's sync interval is a stable replay point.
  uint16_t anchor_offset = 0;
  uint32_t longest = 0;
  for (uint16_t i = 0; i < best_count; i++) {
    uint32_t duration = rf_capture_durations[best_start + i];
    if (duration > longest) {
      longest = duration;
      anchor_offset = i;
    }
  }
  // Fast OOK/FSK-style envelopes can have a much shorter synchronization
  // interval than inexpensive outlet remotes. Repetition and three-capture
  // validation still protect against treating random chatter as a command.
  if (longest < 400) return false;

  memset(&frame, 0, sizeof(frame));
  frame.edge_count = best_count;
  uint16_t start = (anchor_offset + 1) % best_count;
  frame.first_level = rf_capture_levels[best_start + start] ? 1 : 0;
  for (uint16_t i = 0; i < frame.edge_count; i++) {
    uint16_t source = best_start + ((start + i) % best_count);
    uint32_t duration = rf_capture_durations[source];
    if (duration < RF_CAPTURE_MIN_PULSE_US || duration >= RF_RMT_IDLE_MARKER_US) return false;
    frame.durations_us[i] = (uint16_t)duration;
  }
  if (repeated_frame) {
    Serial.printf("RF learner extracted %u-edge repeated waveform\n", frame.edge_count);
  } else if (idle_markers > 0 || rf_capture_edge_count != best_count) {
    Serial.printf("RF learner isolated %u-edge frame; ignored %u RMT idle marker(s)\n",
                  frame.edge_count, idle_markers);
  }
  return true;
}


bool normalize_rf_learn_frame_lengths(RfLearnFrame *frames, uint8_t count) {
  if (frames == NULL || count == 0) return false;
  uint16_t shortest = frames[0].edge_count;
  uint16_t longest = frames[0].edge_count;
  for (uint8_t i = 1; i < count; i++) {
    shortest = min(shortest, frames[i].edge_count);
    longest = max(longest, frames[i].edge_count);
  }
  if (shortest < 20) return false;
  if (shortest == longest) return true;
  // One or two clipped boundary transitions should not invalidate an
  // otherwise identical message. Larger differences still require a retry.
  if (longest - shortest > 6) return false;
  for (uint8_t i = 0; i < count; i++) frames[i].edge_count = shortest;
  Serial.printf("RF learner normalized boundary variation: %u-%u edges -> %u\n",
                shortest, longest, shortest);
  return true;
}


void save_failed_rf_capture_diagnostic(const char *reason) {
  if (!sd_card_ready || rf_capture_edge_count == 0) return;
  File file = SD_MMC.open("/rf_failed_captures.csv", FILE_APPEND);
  if (!file) return;
  if (file.size() == 0) {
    file.println("date_time,reason,profile,frequency_mhz,peak_rssi_dbm,noise_dbm,edge_count,levels,durations_us");
  }
  char date_time[32] = "DATE NOT SET";
  if (rtc_ready && rtc.isClockIntegrityGuaranteed()) {
    RTC_DateTime now = rtc.getDateTime();
    format_clock_text(date_time, sizeof(date_time), now, true);
  }
  const uint8_t profile = safe_rf_profile_index();
  file.printf("\"%s\",\"%s\",\"%s\",%.3f,%.1f,%.1f,%u,\"",
              date_time, reason, RF_PROFILES[profile].name,
              RF_PROFILES[profile].frequency, rf_capture_peak_rssi,
              rf_capture_baseline_rssi, rf_capture_edge_count);
  for (uint16_t i = 0; i < rf_capture_edge_count; i++) {
    file.print(rf_capture_levels[i] ? '1' : '0');
  }
  file.print("\",\"");
  for (uint16_t i = 0; i < rf_capture_edge_count; i++) {
    if (i) file.print(' ');
    file.print((unsigned long)rf_capture_durations[i]);
  }
  file.println("\"");
  file.close();
  Serial.printf("RF rejected capture saved to SD: %s\n", reason);
}


bool rf_learn_frames_match(const RfLearnFrame &first, const RfLearnFrame &second) {
  if (first.edge_count != second.edge_count || first.edge_count < 20 ||
      first.first_level != second.first_level) {
    return false;
  }
  // Compare timing shape as well as absolute microseconds. Two captures from
  // the same inexpensive OOK remote can be uniformly a little faster/slower
  // because of oscillator and CC1101 data-slicer drift. Derive one scale
  // factor for the packet, then reject only edges that disagree with that
  // scaled timing. This remains deliberately stricter than a raw replay.
  uint32_t first_total = 0;
  uint32_t second_total = 0;
  for (uint16_t i = 0; i < first.edge_count; i++) {
    first_total += first.durations_us[i];
    second_total += second.durations_us[i];
  }
  if (first_total == 0 || second_total == 0) return false;
  const uint32_t scale_permille = second_total * 1000UL / first_total;
  if (scale_permille < 800 || scale_permille > 1250) return false;

  uint16_t matching_edges = 0;
  for (uint16_t i = 0; i < first.edge_count; i++) {
    uint32_t a = first.durations_us[i] * scale_permille / 1000UL;
    uint32_t b = second.durations_us[i];
    uint32_t difference = a > b ? a - b : b - a;
    // Data slicers naturally move edges by tens of microseconds. Compare the
    // timing class with a 25% window and permit a few noisy edges rather than
    // rejecting an otherwise identical packet on the first imperfect pulse.
    uint32_t tolerance = max((uint32_t)120, (a + b) / 8U);
    if (difference <= tolerance) matching_edges++;
  }
  return (uint32_t)matching_edges * 100U >= (uint32_t)first.edge_count * 85U;
}


uint8_t rf_learn_frame_similarity(const RfLearnFrame &first,
                                  const RfLearnFrame &second) {
  if (first.edge_count != second.edge_count || first.edge_count < 20 ||
      first.first_level != second.first_level) return 0;

  uint32_t first_total = 0;
  uint32_t second_total = 0;
  for (uint16_t i = 0; i < first.edge_count; i++) {
    first_total += first.durations_us[i];
    second_total += second.durations_us[i];
  }
  if (first_total == 0 || second_total == 0) return 0;
  const uint32_t scale_permille = second_total * 1000UL / first_total;
  if (scale_permille < 800 || scale_permille > 1250) return 0;

  uint16_t matching_edges = 0;
  for (uint16_t i = 0; i < first.edge_count; i++) {
    const uint32_t a = first.durations_us[i] * scale_permille / 1000UL;
    const uint32_t b = second.durations_us[i];
    const uint32_t difference = a > b ? a - b : b - a;
    const uint32_t tolerance = max((uint32_t)120, (a + b) / 8U);
    if (difference <= tolerance) matching_edges++;
  }
  return (uint8_t)((uint32_t)matching_edges * 100U / first.edge_count);
}


uint32_t rf_learn_frame_fingerprint(const RfLearnFrame &frame) {
  uint32_t hash = 2166136261UL;
  for (uint16_t i = 0; i < frame.edge_count; i++) {
    const uint16_t bucket = frame.durations_us[i] / 25U;
    hash ^= bucket;
    hash *= 16777619UL;
  }
  hash ^= frame.edge_count;
  return hash;
}


struct RfDynamicProtocolSignature {
  const char *name;
  uint16_t short_us;
  uint16_t long_us;
  uint16_t tolerance_us;
  uint16_t min_edges;
  uint16_t max_edges;
  float min_frequency_mhz;
  float max_frequency_mhz;
  bool ook;
};


uint32_t rf_duration_difference(uint32_t first, uint32_t second) {
  return first > second ? first - second : second - first;
}


uint8_t score_dynamic_protocol_signature(
  const RfDynamicProtocolSignature &signature,
  const RfLearnFrame first_set[RF_LEARN_SAMPLE_COUNT],
  const RfLearnFrame second_set[RF_LEARN_SAMPLE_COUNT]
) {
  uint32_t timing_samples = 0;
  uint32_t timing_match_quality = 0;
  uint32_t edge_total = 0;
  for (uint8_t set = 0; set < 2; set++) {
    const RfLearnFrame *frames = set == 0 ? first_set : second_set;
    for (uint8_t sample = 0; sample < RF_LEARN_SAMPLE_COUNT; sample++) {
      edge_total += frames[sample].edge_count;
      for (uint16_t edge = 0; edge < frames[sample].edge_count; edge++) {
        const uint16_t duration = frames[sample].durations_us[edge];
        // Ignore long synchronization gaps. The timing score describes the
        // encoded data cells, not the protocol's leading silence.
        if (duration > signature.long_us + signature.tolerance_us) continue;
        timing_samples++;
        const uint32_t short_difference =
          rf_duration_difference(duration, signature.short_us);
        const uint32_t long_difference =
          rf_duration_difference(duration, signature.long_us);
        const uint32_t closest_difference = min(short_difference, long_difference);
        if (closest_difference <= signature.tolerance_us) {
          timing_match_quality +=
            (signature.tolerance_us - closest_difference) * 100U /
            signature.tolerance_us;
        }
      }
    }
  }
  if (timing_samples < 40) return 0;

  const uint16_t average_edges = edge_total / (RF_LEARN_SAMPLE_COUNT * 2U);
  const uint8_t timing_score =
    (uint8_t)min((uint32_t)65,
                 timing_match_quality * 65U / (timing_samples * 100U));
  const uint8_t edge_score =
    average_edges >= signature.min_edges && average_edges <= signature.max_edges ? 15 : 0;
  const uint8_t active_profile_index = safe_rf_profile_index();
  const float frequency = RF_PROFILES[active_profile_index].frequency;
  const uint8_t frequency_score =
    frequency >= signature.min_frequency_mhz && frequency <= signature.max_frequency_mhz ? 10 : 0;
  const uint8_t modulation_score =
    RF_PROFILES[active_profile_index].ook == signature.ook ? 10 : 0;
  return timing_score + edge_score + frequency_score + modulation_score;
}


void identify_dynamic_protocol(
  const RfLearnFrame first_set[RF_LEARN_SAMPLE_COUNT],
  const RfLearnFrame second_set[RF_LEARN_SAMPLE_COUNT],
  char *name_out,
  size_t name_size,
  uint8_t *confidence_out
) {
  // Receive-only signatures derived from public protocol timing and frame
  // descriptions. They identify a likely family; they do not decrypt,
  // generate, synchronize, or replay a rolling-code transmission.
  static const RfDynamicProtocolSignature signatures[] = {
    {"KEELOQ HCS200/300", 370, 772, 180, 120, 165, 280.0f, 930.0f, true},
    {"SECURITY+ 1.0", 500, 1500, 180, 38, 105, 300.0f, 400.0f, true},
    {"SECURITY+ 2.0", 250, 500, 110, 60, 155, 300.0f, 400.0f, true},
    {"NICE FLOR-S / ONE", 500, 1000, 300, 70, 165, 400.0f, 900.0f, true},
    {"SOMFY TELIS / RTS", 640, 1280, 250, 60, 165, 433.0f, 434.0f, true},
    {"CAME ATOMO", 600, 1200, 250, 65, 155, 433.0f, 434.0f, true},
    {"CAME ATOMO", 600, 1200, 250, 65, 155, 868.0f, 869.0f, true}
  };

  uint8_t best_score = 0;
  const char *best_name = "UNKNOWN CHANGING CODE";
  for (uint8_t i = 0; i < sizeof(signatures) / sizeof(signatures[0]); i++) {
    const uint8_t score = score_dynamic_protocol_signature(
      signatures[i], first_set, second_set);
    if (score > best_score) {
      best_score = score;
      best_name = signatures[i].name;
    }
  }
  if (best_score < 78) best_name = "UNKNOWN CHANGING CODE";
  strlcpy(name_out, best_name, name_size);
  if (confidence_out != NULL) *confidence_out = best_score;
}


bool analyze_changing_code_candidate(const RfLearnFrame frames[RF_LEARN_SAMPLE_COUNT],
                                     uint8_t *similarity_out) {
  const uint8_t similarity_01 = rf_learn_frame_similarity(frames[0], frames[1]);
  const uint8_t similarity_02 = rf_learn_frame_similarity(frames[0], frames[2]);
  const uint8_t similarity_12 = rf_learn_frame_similarity(frames[1], frames[2]);
  const uint8_t average = (similarity_01 + similarity_02 + similarity_12) / 3U;
  if (similarity_out != NULL) *similarity_out = average;

  // This is intentionally a candidate detector, not a protocol decoder. A
  // stable frame shape with three different payload fingerprints is typical
  // of rolling/changing-code traffic, while very low similarity is noise or
  // three unrelated signals. Replay and saving remain disabled.
  const bool same_shape = frames[0].edge_count == frames[1].edge_count &&
                          frames[0].edge_count == frames[2].edge_count &&
                          frames[0].first_level == frames[1].first_level &&
                          frames[0].first_level == frames[2].first_level;
  const uint32_t fingerprint_0 = rf_learn_frame_fingerprint(frames[0]);
  const uint32_t fingerprint_1 = rf_learn_frame_fingerprint(frames[1]);
  const uint32_t fingerprint_2 = rf_learn_frame_fingerprint(frames[2]);
  const bool all_different = fingerprint_0 != fingerprint_1 &&
                             fingerprint_0 != fingerprint_2 &&
                             fingerprint_1 != fingerprint_2;
  const bool every_pair_has_stable_structure = similarity_01 >= 55 &&
                                                similarity_02 >= 55 &&
                                                similarity_12 >= 55;
  return same_shape && all_different && every_pair_has_stable_structure &&
         average >= 60 && average < 90;
}


bool store_changing_code_analysis(
  const RfLearnFrame frames[RF_LEARN_SAMPLE_COUNT],
  uint8_t structural_similarity,
  const char *likely_protocol,
  uint8_t protocol_confidence
) {
  RollingCodeAnalysisRecord record = {};
  record.magic = ROLLING_ANALYSIS_MAGIC;
  const uint8_t active_profile_index = safe_rf_profile_index();
  record.frequency_mhz = RF_PROFILES[active_profile_index].frequency;
  record.profile_index = active_profile_index;
  record.structural_similarity = structural_similarity;
  record.edge_count = frames[0].edge_count;
  record.protocol_confidence = protocol_confidence;
  strlcpy(record.likely_protocol, likely_protocol, sizeof(record.likely_protocol));
  strlcpy(record.category,
          rf_smart_learn_category != NULL ? rf_smart_learn_category : "UNKNOWN",
          sizeof(record.category));

  for (uint8_t sample = 0; sample < RF_LEARN_SAMPLE_COUNT; sample++) {
    record.fingerprints[sample] = rf_learn_frame_fingerprint(frames[sample]);
    uint32_t total = 0;
    uint16_t shortest = UINT16_MAX;
    uint16_t longest = 0;
    for (uint16_t edge = 0; edge < frames[sample].edge_count; edge++) {
      const uint16_t duration = frames[sample].durations_us[edge];
      total += duration;
      if (duration < shortest) shortest = duration;
      if (duration > longest) longest = duration;
    }
    record.total_us[sample] = total;
    record.shortest_us[sample] = shortest == UINT16_MAX ? 0 : shortest;
    record.longest_us[sample] = longest;
  }

  if (rtc_ready && rtc.isClockIntegrityGuaranteed()) {
    RTC_DateTime now = rtc.getDateTime();
    format_clock_text(record.date_time, sizeof(record.date_time), now, true);
  } else {
    strlcpy(record.date_time, "DATE NOT SET", sizeof(record.date_time));
  }

  saved_preferences.begin("ripperzero", false);
  record.sequence = saved_preferences.getUInt("rollSeq", 0) + 1;
  saved_preferences.putUInt("rollSeq", record.sequence);
  const uint8_t slot = (record.sequence - 1) % MAX_ROLLING_ANALYSIS_RECORDS;
  char key[12];
  snprintf(key, sizeof(key), "roll%u", slot);
  const bool internal_saved =
    saved_preferences.putBytes(key, &record, sizeof(record)) == sizeof(record);
  saved_preferences.end();

  if (sd_card_ready) {
    File file = SD_MMC.open("/rolling_analysis_v2.csv", FILE_APPEND);
    if (file) {
      if (file.size() == 0) {
        file.println("sequence,date,category,frequency_mhz,radio_profile,likely_protocol,protocol_confidence,edges,structural_similarity,fingerprint_1,fingerprint_2,fingerprint_3,total_1_us,total_2_us,total_3_us");
      }
      file.printf("%lu,%s,%s,%.3f,%s,%s,%u,%u,%u,%08lX,%08lX,%08lX,%lu,%lu,%lu\n",
                  (unsigned long)record.sequence, record.date_time,
                  record.category, record.frequency_mhz,
                  RF_PROFILES[record.profile_index].name,
                  record.likely_protocol, record.protocol_confidence,
                  record.edge_count, record.structural_similarity,
                  (unsigned long)record.fingerprints[0],
                  (unsigned long)record.fingerprints[1],
                  (unsigned long)record.fingerprints[2],
                  (unsigned long)record.total_us[0],
                  (unsigned long)record.total_us[1],
                  (unsigned long)record.total_us[2]);
      file.close();
    }
  }

  Serial.printf("Stored changing-code analysis #%lu in slot %u: %s (%u%%)%s\n",
                (unsigned long)record.sequence, slot, record.likely_protocol,
                record.protocol_confidence,
                sd_card_ready ? " and SD CSV" : "");
  return internal_saved;
}


uint16_t rf_median_duration(uint16_t a, uint16_t b, uint16_t c) {
  if (a > b) { uint16_t swap = a; a = b; b = swap; }
  if (b > c) { uint16_t swap = b; b = c; c = swap; }
  if (a > b) b = a;
  return b;
}


const char *rf_capture_quality_name(float peak_rssi, float baseline_rssi) {
  const float rise = peak_rssi - baseline_rssi;
  if (peak_rssi >= -55.0f && rise >= 18.0f && rf_capture_repeat_quality >= 92) return "EXCELLENT";
  if (peak_rssi >= -70.0f && rise >= 12.0f && rf_capture_repeat_quality >= 85) return "GOOD";
  if (peak_rssi >= RF_CAPTURE_MIN_VALID_RSSI_DBM && rise >= RF_CAPTURE_MIN_RSSI_RISE_DB) return "FAIR";
  return "WEAK";
}


bool replay_saved_rf_raw_command(const SavedRfRawCommand &command) {
#if !CC1101_ACCESS_ENABLED
  (void)command;
  return false;
#else
  if (!cc1101_ready || !command.valid || command.edge_count < 20 ||
      command.edge_count > RF_SAVED_RAW_MAX_EDGES ||
      command.profile_index >= RF_PROFILE_COUNT) {
    return false;
  }
  if (!apply_rf_profile(command.profile_index, false)) return false;

  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  if (cc1101.transmitDirectAsync() != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    return false;
  }

  // valid=1 is the legacy raw-burst format. valid=2 marks the new canonical
  // one-frame format, which must be repeated like the original outlet remote.
  const uint8_t repeat_count = command.valid >= 2 ? 8 : 1;
  for (uint8_t repeat = 0; repeat < repeat_count; repeat++) {
    bool level = command.first_level != 0;
    digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    for (uint16_t i = 0; i < command.edge_count; i++) {
      delayMicroseconds(command.durations_us[i]);
      level = !level;
      digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    }
  }

  digitalWrite(CC1101_GDO0, LOW);
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  return true;
#endif
}


bool apply_repository_rf_radio(const RipperRfButtonDiskV1 &disk) {
#if !CC1101_ACCESS_ENABLED
  (void)disk;
  return false;
#else
  if (!cc1101_ready) return false;
  if ((disk.frequency_hz == 0 || disk.bit_rate_bps == 0 ||
       disk.bandwidth_hz == 0 ||
       disk.modulation == RIPPER_RF_MODULATION_UNKNOWN) &&
      disk.legacy_profile_index < RF_PROFILE_COUNT) {
    return apply_rf_profile(disk.legacy_profile_index, false);
  }
  if (disk.modulation != RIPPER_RF_MODULATION_OOK &&
      disk.modulation != RIPPER_RF_MODULATION_FSK) return false;
  const float frequency_mhz = disk.frequency_hz / 1000000.0f;
  const bool supported_band =
    (frequency_mhz >= 300.0f && frequency_mhz <= 348.0f) ||
    (frequency_mhz >= 387.0f && frequency_mhz <= 464.0f) ||
    (frequency_mhz >= 779.0f && frequency_mhz <= 928.0f);
  if (!supported_band || disk.bit_rate_bps == 0 || disk.bandwidth_hz == 0)
    return false;

  cc1101.packetMode();
  delay(2);
  ConfigFSK_t config;
  config.frequency = frequency_mhz;
  config.bitRate = disk.bit_rate_bps / 1000.0f;
  config.frequencyDeviation =
    disk.deviation_hz == 0 ? 5.0f : disk.deviation_hz / 1000.0f;
  config.receiverBandwidth = disk.bandwidth_hz / 1000.0f;
  config.power = 0;
  int16_t state = cc1101.begin(config);
  if (state != RADIOLIB_ERR_NONE) return false;
  state = cc1101.setOOK(disk.modulation == RIPPER_RF_MODULATION_OOK);
  if (state != RADIOLIB_ERR_NONE) return false;

  if (disk.modulation == RIPPER_RF_MODULATION_OOK &&
      disk.bit_rate_bps >= 3700 && disk.bit_rate_bps <= 3900 &&
      (disk.bandwidth_hz == 270000 || disk.bandwidth_hz == 650000)) {
    apply_flipper_ook_receive_tuning(disk.bandwidth_hz == 650000);
  } else if (disk.modulation == RIPPER_RF_MODULATION_FSK &&
             disk.bit_rate_bps >= 4700 && disk.bit_rate_bps <= 4900 &&
             disk.bandwidth_hz == 270000) {
    uint8_t deviation_register = 0x04;
    if (disk.deviation_hz > 30000) deviation_register = 0x47;
    else if (disk.deviation_hz > 8000) deviation_register = 0x30;
    apply_flipper_fsk_receive_tuning(deviation_register);
  }
  return true;
#endif
}


void delay_repository_rf_duration(uint32_t duration_us) {
  const uint32_t started = micros();
  while ((uint32_t)(micros() - started) < duration_us) {
    const uint32_t elapsed = (uint32_t)(micros() - started);
    const uint32_t remaining = duration_us - elapsed;
    const uint32_t chunk = remaining > 20000UL ? 20000UL : remaining;
    delayMicroseconds(chunk);
    // Long catalog recordings can contain multi-second steady levels. Yield
    // between bounded waits while leaving GDO0 unchanged so the UI task and
    // watchdog remain healthy without introducing extra RF edges.
    if (remaining > chunk) yield();
  }
}


bool replay_repository_rf_button_from_path(const char *path,
                                           uint16_t total_buttons,
                                           uint16_t button_index) {
  strlcpy(rf_repository_send_error, "RF COMMAND NOT SUPPORTED",
          sizeof(rf_repository_send_error));
  if (path == NULL || path[0] == '\0' || button_index >= total_buttons)
    return false;

  RipperRfButtonDiskV1 disk = {};
  uint32_t raw_count = 0;
  if (!ripper_rf_repository_read_button(path,
                                        button_index, disk, NULL, 0,
                                        raw_count)) {
    strlcpy(rf_repository_send_error, "SD READ FAILED",
            sizeof(rf_repository_send_error));
    return false;
  }
  if (disk.encoding == RIPPER_RF_ENCODING_UNASSIGNED) {
    strlcpy(rf_repository_send_error, "RF BUTTON HAS NO SIGNAL",
            sizeof(rf_repository_send_error));
    return false;
  }
  // Parsed and BinRAW records stay preserved in the repository, but this
  // checkpoint cannot safely infer their protocol-specific bit encoder.
  const bool extended_raw =
    disk.encoding == RIPPER_RF_ENCODING_RAW_TIMINGS32;
  if (disk.encoding != RIPPER_RF_ENCODING_RAW_TIMINGS && !extended_raw) {
    strlcpy(rf_repository_send_error, "RF ENCODING UNSUPPORTED",
            sizeof(rf_repository_send_error));
    return false;
  }
  if (raw_count < 2 || raw_count > RIPPER_RF_MAX_RAW_TIMINGS) {
    strlcpy(rf_repository_send_error, "RF RAW DATA INVALID",
            sizeof(rf_repository_send_error));
    return false;
  }

  const size_t timing_width = extended_raw ? sizeof(uint32_t) : sizeof(uint16_t);
  const size_t timing_bytes = raw_count * timing_width;
  // Compact signals prefer deterministic internal RAM. Extended recordings
  // are loaded one pressed command at a time and prefer PSRAM so the rest of
  // the catalog and UI never share a large permanent allocation.
  void *timings = heap_caps_malloc(
    timing_bytes, (extended_raw ? MALLOC_CAP_SPIRAM : MALLOC_CAP_INTERNAL) |
                  MALLOC_CAP_8BIT);
  if (timings == NULL) {
    timings = heap_caps_malloc(
      timing_bytes, (extended_raw ? MALLOC_CAP_INTERNAL : MALLOC_CAP_SPIRAM) |
                    MALLOC_CAP_8BIT);
  }
  if (timings == NULL) {
    strlcpy(rf_repository_send_error, "RF MEMORY LOW",
            sizeof(rf_repository_send_error));
    return false;
  }
  uint32_t loaded_count = 0;
  const bool loaded = ripper_rf_repository_read_button(
    path, button_index, disk, timings, raw_count,
    loaded_count);
  if (!loaded || loaded_count != raw_count) {
    heap_caps_free(timings);
    strlcpy(rf_repository_send_error, "SD READ FAILED",
            sizeof(rf_repository_send_error));
    return false;
  }
  for (uint32_t i = 0; i < loaded_count; i++) {
    const uint32_t duration = extended_raw ?
      ((const uint32_t *)timings)[i] : ((const uint16_t *)timings)[i];
    if (duration == 0 || duration > RIPPER_RF_MAX_TIMING_US) {
      heap_caps_free(timings);
      strlcpy(rf_repository_send_error, "RF RAW DATA INVALID",
              sizeof(rf_repository_send_error));
      return false;
    }
  }

#if !CC1101_ACCESS_ENABLED
  heap_caps_free(timings);
  strlcpy(rf_repository_send_error, "CC1101 NOT READY",
          sizeof(rf_repository_send_error));
  return false;
#else
  if (!apply_repository_rf_radio(disk)) {
    heap_caps_free(timings);
    strlcpy(rf_repository_send_error, "RF SETTINGS UNSUPPORTED",
            sizeof(rf_repository_send_error));
    return false;
  }
  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  if (cc1101.transmitDirectAsync() != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    heap_caps_free(timings);
    strlcpy(rf_repository_send_error, "RF TRANSMIT FAILED",
            sizeof(rf_repository_send_error));
    return false;
  }

  const uint8_t repeats = disk.repeat_count == 0 ? 1 : disk.repeat_count;
  for (uint8_t repeat = 0; repeat < repeats; repeat++) {
    bool level = disk.first_level != 0;
    digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    for (uint32_t i = 0; i < loaded_count; i++) {
      const uint32_t duration = extended_raw ?
        ((const uint32_t *)timings)[i] : ((const uint16_t *)timings)[i];
      delay_repository_rf_duration(duration);
      level = !level;
      digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    }
    digitalWrite(CC1101_GDO0, LOW);
    if (repeat + 1 < repeats && disk.repeat_gap_us > 0)
      delay_repository_rf_duration(disk.repeat_gap_us);
  }
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  heap_caps_free(timings);
  rf_repository_send_error[0] = '\0';
  return true;
#endif
}


bool replay_repository_rf_button(uint16_t button_index) {
  if (!rf_working_remote_from_repository ||
      rf_working_repository_path[0] == '\0' ||
      button_index >= rf_working_repository_total_buttons) {
    strlcpy(rf_repository_send_error, "RF COMMAND NOT SUPPORTED",
            sizeof(rf_repository_send_error));
    return false;
  }
  return replay_repository_rf_button_from_path(
    rf_working_repository_path, rf_working_repository_total_buttons,
    button_index);
}


void send_saved_rf_button(lv_event_t *e) {
  uint8_t button_index = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  if (rf_working_remote_from_repository) {
    if (button_index >= universal_button_count) return;
    set_status("TRANSMITTING", COLOR_RF);
    lv_timer_handler();
    const uint16_t absolute =
      rf_working_repository_absolute_indices[button_index];
    if (replay_repository_rf_button(absolute)) {
      Serial.printf("RF repository remote sent: %s\n",
                    universal_button_names[button_index]);
      set_status("SYSTEM READY", COLOR_READY);
    } else {
      set_status(rf_repository_send_error[0] != '\0' ?
                   rf_repository_send_error : "RF SEND FAILED",
                 COLOR_RED);
    }
    return;
  }
  if (selected_saved_index < 0 || selected_saved_index >= saved_remote_count ||
      button_index >= MAX_UNIVERSAL_BUTTONS) return;
  const SavedRfRawCommand &command = saved_rf_raw_commands[selected_saved_index][button_index];
  if (!command.valid) {
    set_status("RF BUTTON HAS NO SIGNAL", COLOR_RED);
    return;
  }
  set_status("TRANSMITTING", COLOR_RF);
  if (replay_saved_rf_raw_command(command)) {
    Serial.printf("RF remote sent: %s\n", saved_remotes[selected_saved_index].button_names[button_index]);
    set_status("SYSTEM READY", COLOR_READY);
  } else {
    set_status("RF SEND FAILED", COLOR_RED);
  }
}


bool replay_rf_capture_once() {
#if !CC1101_ACCESS_ENABLED
  return false;
#else
  if (!cc1101_ready || !rf_capture_ready || rf_capture_edge_count < 20) {
    return false;
  }

  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  int16_t state = cc1101.transmitDirectAsync();
  if (state != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    Serial.printf("CC1101 raw replay start failed: %d\n", state);
    return false;
  }

  // Replay a single captured waveform. This is intentionally one-shot and is
  // only for checking the user's own fan before implementing saved replay.
  bool level = false;
  // Recreate the quiet lead-in that separates repeated outlet commands.
  delayMicroseconds(15000);
  uint16_t edges = rf_capture_edge_count;
  for (uint16_t i = 0; i < edges; i++) {
    uint32_t duration = rf_capture_durations[i];
    if (duration < 100 || duration > 20000) {
      continue;
    }
    level = !level;
    digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
    delayMicroseconds(duration);
  }

  digitalWrite(CC1101_GDO0, LOW);
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  Serial.printf("CC1101 replayed %u raw pulse edges\n", edges);
  return true;
#endif
}


void print_hunter_capture_dump(uint16_t edges) {
  const uint16_t dump_edges = edges < 256 ? edges : 256;
  Serial.printf("RF_RAW_US count=%u\n", dump_edges);
  for (uint16_t i = 0; i < dump_edges; i++) {
    Serial.print((unsigned long)rf_capture_durations[i]);
    Serial.print((i + 1) % 16 == 0 ? '\n' : ',');
  }
  if (dump_edges % 16 != 0) Serial.println();
}

void print_hunter_capture_levels(uint16_t edges) {
  const uint16_t dump_edges = edges < 256 ? edges : 256;
  Serial.print("RF_LEVELS=");
  for (uint16_t i = 0; i < dump_edges; i++) Serial.print(rf_capture_levels[i] ? '1' : '0');
  Serial.println();
}

void print_hunter_normalized_bits(uint16_t edges) {
  Serial.print("RF_NORMALIZED=");
  for (uint16_t i = 0; i < edges; i++) {
    uint32_t d = rf_capture_durations[i];
    if (d >= 300 && d <= 900) Serial.print(d < 600 ? '0' : '1');
  }
  Serial.println();
}

void print_hunter_stable_tail(uint16_t edges) {
  char bits[513];
  uint16_t count = 0;
  for (uint16_t i = 0; i < edges && count < sizeof(bits) - 1; i++) {
    uint32_t d = rf_capture_durations[i];
    if (d >= 300 && d <= 900) bits[count++] = d < 600 ? '0' : '1';
  }
  bits[count] = '\0';
  const uint16_t tail = count > 120 ? 120 : count;
  Serial.print("RF_STABLE_TAIL=");
  Serial.println(bits + count - tail);
}

uint32_t rf_frame_fingerprint(uint16_t start, uint16_t end) {
  uint32_t hash = 2166136261UL;
  for (uint16_t i = start; i < end; i++) {
    // A 25 us bucket tolerates small timer/data-slicer variation while still
    // distinguishing a genuinely different fixed-code frame.
    uint16_t bucket = (uint16_t)(rf_capture_durations[i] / 25U);
    hash ^= bucket;
    hash *= 16777619UL;
  }
  return hash;
}

void print_rf_frame_candidates(uint16_t edges) {
  uint16_t start = 0;
  uint8_t frame_number = 0;
  for (uint16_t i = 0; i < edges; i++) {
    if (rf_capture_durations[i] < RF_FRAME_DELIMITER_US) continue;
    // The first segment starts at an arbitrary time, so only report segments
    // that begin after a full inter-frame delimiter.
    if (frame_number > 0 || start > 0) {
      uint16_t length = i - start;
      if (length >= 6) {
        Serial.printf("RF_FRAME %u edges=%u fingerprint=%08lX\n", frame_number,
                      length, (unsigned long)rf_frame_fingerprint(start, i));
      }
    }
    frame_number++;
    start = i + 1;
  }
  if (start > 0 && edges - start >= 6) {
    Serial.printf("RF_FRAME %u edges=%u fingerprint=%08lX\n", frame_number,
                  edges - start, (unsigned long)rf_frame_fingerprint(start, edges));
  }
}

// Look for the common fixed-code pulse-pair family used by many inexpensive
// outlet/switch remotes (short/long and long/short pairs).  This is deliberately
// only a detector: a code must repeat across separate captures before it can
// become a saved command.
void detect_fixed_code_pulse_pairs(uint16_t edges) {
  for (uint16_t start = 0; start + 48 <= edges; start++) {
    uint32_t code = 0;
    uint8_t bits = 0;
    uint16_t short_sum = 0;
    uint8_t short_count = 0;
    bool valid = true;

    for (uint8_t bit = 0; bit < 24; bit++) {
      uint16_t i = start + bit * 2;
      uint32_t first = rf_capture_durations[i];
      uint32_t second = rf_capture_durations[i + 1];
      if (first < 100 || second < 100 || first > 5000 || second > 5000 ||
          rf_capture_levels[i] == rf_capture_levels[i + 1]) {
        valid = false;
        break;
      }
      uint32_t shorter = first < second ? first : second;
      uint32_t longer = first < second ? second : first;
      // A broad 2:1 to 5:1 acceptance range handles common protocol variants
      // and timer error, while excluding nearly equal noise pulses.
      if (longer < shorter * 2 || longer > shorter * 5) {
        valid = false;
        break;
      }
      if (shorter > 900) {
        valid = false;
        break;
      }
      short_sum += shorter;
      short_count++;
      code = (code << 1) | (first > second ? 1UL : 0UL);
      bits++;
    }

    if (valid && bits == 24 && short_count == 24) {
      uint16_t pulse = short_sum / short_count;
      Serial.printf("RF FIXED-CODE CANDIDATE: EV1527/HS1527-like, bits=24 code=%06lX pulse=%u us\n",
                    (unsigned long)code, pulse);
      return;
    }
  }
  Serial.println("RF fixed-code decoder: no supported pulse-pair frame");
}

// First stage of the generic fixed-code learner.  Many inexpensive 315/433 MHz
// switches encode a command as integer multiples of one short OOK pulse.  This
// does not assume a vendor or command format; it only decides whether the
// captured waveform looks clean enough to offer a fixed-code decoder next.
void analyze_generic_ook_candidate(uint16_t edges) {
  const uint16_t BIN_US = 25;
  const uint16_t MIN_BASE_US = 175;
  const uint16_t MAX_BASE_US = 700;
  const uint8_t BIN_COUNT = (MAX_BASE_US - MIN_BASE_US) / BIN_US + 1;
  uint16_t bins[BIN_COUNT] = {0};

  for (uint16_t i = 0; i < edges; i++) {
    uint32_t duration = rf_capture_durations[i];
    if (duration >= MIN_BASE_US && duration <= MAX_BASE_US) {
      bins[(duration - MIN_BASE_US) / BIN_US]++;
    }
  }

  uint8_t best_bin = 0;
  for (uint8_t i = 1; i < BIN_COUNT; i++) {
    if (bins[i] > bins[best_bin]) best_bin = i;
  }
  uint16_t base = MIN_BASE_US + best_bin * BIN_US + BIN_US / 2;
  uint16_t valid = 0;
  uint16_t pulse_multiple_matches = 0;
  for (uint16_t i = 0; i < edges; i++) {
    uint32_t duration = rf_capture_durations[i];
    if (duration < 120 || duration > 10000) continue;
    valid++;
    uint8_t multiple = (duration + base / 2) / base;
    if (multiple >= 1 && multiple <= 16) {
      uint32_t expected = (uint32_t)multiple * base;
      uint32_t error = duration > expected ? duration - expected : expected - duration;
      if (error <= base / 4) pulse_multiple_matches++;
    }
  }

  uint8_t confidence = valid ? (uint32_t)pulse_multiple_matches * 100 / valid : 0;
  if (bins[best_bin] >= 8 && confidence >= 65) {
    Serial.printf("RF PROFILE CANDIDATE: OOK fixed-code pulse=%u us confidence=%u%%\n", base, confidence);
    Serial.println("Possible PT2262/SC2262/HT6P20B tri-state family; capture 3 matching presses before saving");
  } else {
    Serial.printf("RF PROFILE: unclassified (OOK pulse-fit confidence=%u%%)\n", confidence);
    Serial.println("Keep as raw/advanced profile; do not save or replay yet");
  }
}


// ============================================================
// DISPLAY FLUSH
// ============================================================

void my_disp_flush(
  lv_disp_drv_t *disp_drv,
  const lv_area_t *area,
  lv_color_t *color_p
) {

  uint32_t w =
    area->x2 - area->x1 + 1;

  uint32_t h =
    area->y2 - area->y1 + 1;


  gfx->draw16bitRGBBitmap(
    area->x1,
    area->y1,
    (uint16_t *)&color_p->full,
    w,
    h
  );

  // Keep an exact screen mirror in PSRAM without changing LVGL's draw-buffer
  // ownership. Copy only the clipped dirty region, then expose the complete
  // framebuffer to the authenticated phone endpoint at a bounded rate.
  if (ripper_mobile_framebuffer != NULL) {
    const int32_t x1 = max((int32_t)0, (int32_t)area->x1);
    const int32_t y1 = max((int32_t)0, (int32_t)area->y1);
    const int32_t x2 = min((int32_t)RIPPER_MOBILE_FRAME_WIDTH - 1,
                           (int32_t)area->x2);
    const int32_t y2 = min((int32_t)RIPPER_MOBILE_FRAME_HEIGHT - 1,
                           (int32_t)area->y2);
    if (x1 <= x2 && y1 <= y2) {
      const uint32_t source_width = area->x2 - area->x1 + 1;
      const uint32_t copy_width = x2 - x1 + 1;
      for (int32_t y = y1; y <= y2; y++) {
        const uint32_t source_offset =
          (uint32_t)(y - area->y1) * source_width + (x1 - area->x1);
        const uint32_t target_offset =
          (uint32_t)y * RIPPER_MOBILE_FRAME_WIDTH + x1;
        memcpy(&ripper_mobile_framebuffer[target_offset],
               &((uint16_t *)&color_p->full)[source_offset],
               copy_width * sizeof(uint16_t));
      }
      // Each tile records the newest generation that touched it. A phone that
      // misses several updates can therefore request every region changed
      // since its own generation without a full framebuffer transfer.
      ripper_mobile_frame_generation++;
      if (ripper_mobile_frame_generation == 0) {
        ripper_mobile_frame_generation = 1;
        for (uint16_t tile = 0; tile < RIPPER_MOBILE_TILE_COUNT; tile++)
          ripper_mobile_tile_generation[tile] = 1;
      }
      const uint8_t first_column = x1 / RIPPER_MOBILE_TILE_SIZE;
      const uint8_t last_column = x2 / RIPPER_MOBILE_TILE_SIZE;
      const uint8_t first_row = y1 / RIPPER_MOBILE_TILE_SIZE;
      const uint8_t last_row = y2 / RIPPER_MOBILE_TILE_SIZE;
      for (uint8_t row = first_row; row <= last_row; row++) {
        for (uint8_t column = first_column; column <= last_column; column++) {
          const uint16_t tile = row * RIPPER_MOBILE_TILE_COLUMNS + column;
          ripper_mobile_tile_generation[tile] = ripper_mobile_frame_generation;
        }
      }
    }
  }


  lv_disp_flush_ready(
    disp_drv
  );
}


// ============================================================
// TOUCH READ
// ============================================================

void my_touchpad_read(
  lv_indev_drv_t *indev_drv,
  lv_indev_data_t *data
) {

  int16_t x[1];
  int16_t y[1];

  uint8_t touched =
    touch.getPoint(
      x,
      y,
      1
    );


  if (touched) {

    auto_shutdown_last_activity_ms = millis();
    // A physical touch always wins and cancels any stale phone pointer.
    ripper_mobile_pointer_pressed = false;
    ripper_mobile_touch_phase = 0;
    ripper_mobile_touch_seen = false;

    data->state =
      LV_INDEV_STATE_PR;

    data->point.x =
      x[0];

    data->point.y =
      y[0];

  } else if (ripper_mobile_pointer_pressed &&
             (uint32_t)(millis() - ripper_mobile_pointer_last_event_ms) < 3000) {

    auto_shutdown_last_activity_ms = millis();
    data->state = LV_INDEV_STATE_PR;
    data->point.x = ripper_mobile_touch_x;
    data->point.y = ripper_mobile_touch_y;

  } else if (ripper_mobile_pointer_pressed) {

    // Fail released if the phone disconnects while holding a control. This
    // prevents a lost network packet from leaving an LVGL button held down.
    ripper_mobile_pointer_pressed = false;
    data->state = LV_INDEV_STATE_REL;
    data->point.x = ripper_mobile_touch_x;
    data->point.y = ripper_mobile_touch_y;

  } else if (ripper_mobile_touch_phase == 1) {

    auto_shutdown_last_activity_ms = millis();
    data->state = LV_INDEV_STATE_PR;
    data->point.x = ripper_mobile_touch_x;
    data->point.y = ripper_mobile_touch_y;
    if (ripper_mobile_touch_seen &&
        (int32_t)(millis() - ripper_mobile_touch_release_ms) >= 0) {
      ripper_mobile_touch_phase = 2;
    }
    ripper_mobile_touch_seen = true;

  } else if (ripper_mobile_touch_phase == 2) {

    data->state = LV_INDEV_STATE_REL;
    data->point.x = ripper_mobile_touch_x;
    data->point.y = ripper_mobile_touch_y;
    ripper_mobile_touch_phase = 0;
    ripper_mobile_touch_seen = false;

  } else {

    data->state =
      LV_INDEV_STATE_REL;
  }
}


