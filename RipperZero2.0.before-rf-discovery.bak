// ============================================================
// SETUP
// ============================================================

void setup() {

  Serial.begin(
    115200
  );

  Serial.println();
  Serial.println(
    "Starting Nick's RipperZero..."
  );


  // START I2C

  Wire.begin(
    I2C_SDA,
    I2C_SCL
  );


  // START TCA9554

  TCA.begin();

  TCA.pinMode1(
    1,
    OUTPUT
  );

  lcd_reset();


  // START TOUCH

  if (
    !touch.begin(
      Wire,
      FT6X36_SLAVE_ADDRESS
    )
  ) {

    Serial.println(
      "Failed to find FT6X36 - check wiring!"
    );

    while (1) {
      delay(1000);
    }
  }


  Serial.println(
    "Touch initialized"
  );


  // START DISPLAY

  if (!gfx->begin()) {

    Serial.println(
      "gfx->begin() failed!"
    );

  } else {

    Serial.println(
      "Display initialized"
    );
  }


  gfx->fillScreen(
    RGB565_BLACK
  );


  // BACKLIGHT

  pinMode(
    GFX_BL,
    OUTPUT
  );

  digitalWrite(
    GFX_BL,
    HIGH
  );


  // START LVGL

  lv_init();


  screenWidth =
    gfx->width();

  screenHeight =
    gfx->height();


  // BUFFER = 120 LINES

  bufSize =
    screenWidth * 120;


  disp_draw_buf1 =
    (lv_color_t *)heap_caps_malloc(
      bufSize * sizeof(lv_color_t),
      MALLOC_CAP_DEFAULT |
      MALLOC_CAP_8BIT
    );


  disp_draw_buf2 =
    (lv_color_t *)heap_caps_malloc(
      bufSize * sizeof(lv_color_t),
      MALLOC_CAP_DEFAULT |
      MALLOC_CAP_8BIT
    );


  if (
    !disp_draw_buf1 ||
    !disp_draw_buf2
  ) {

    Serial.println(
      "ERROR: LVGL buffer allocation failed!"
    );

    while (1) {
      delay(1000);
    }
  }


  lv_disp_draw_buf_init(
    &draw_buf,
    disp_draw_buf1,
    disp_draw_buf2,
    bufSize
  );


  // REGISTER DISPLAY

  lv_disp_drv_init(
    &disp_drv
  );


  disp_drv.hor_res =
    screenWidth;

  disp_drv.ver_res =
    screenHeight;

  disp_drv.flush_cb =
    my_disp_flush;

  disp_drv.draw_buf =
    &draw_buf;


  lv_disp_drv_register(
    &disp_drv
  );


  // REGISTER TOUCH

  static lv_indev_drv_t indev_drv;


  lv_indev_drv_init(
    &indev_drv
  );


  indev_drv.type =
    LV_INDEV_TYPE_POINTER;

  indev_drv.read_cb =
    my_touchpad_read;


  lv_indev_drv_register(
    &indev_drv
  );


  // ==========================================================
  // CREATE ALL SCREENS
  // ==========================================================

  create_home_screen();

  create_rf_screen();

  create_universal_screen();

  universal_remote_screen =
    lv_obj_create(NULL);

  lv_obj_set_style_bg_color(
    universal_remote_screen,
    lv_color_hex(COLOR_BG),
    LV_PART_MAIN
  );

  lv_obj_set_style_bg_opa(
    universal_remote_screen,
    LV_OPA_COVER,
    LV_PART_MAIN
  );

  create_universal_capture_screen();

  create_known_screen();

  create_device_type_screen();

  create_known_capture_screen();


  // OTHER MAIN MENU SCREENS

  ir_screen =
    create_page(
      "IR REMOTE",
      "Control and learn infrared devices",
      COLOR_IR
    );


  saved_screen =
    create_page(
      "SAVED",
      "Stored signals, remotes and data",
      COLOR_SAVED
    );


  settings_screen =
    create_page(
      "SETTINGS",
      "System and display configuration",
      COLOR_SETTINGS
    );


  // BUILD EMPTY UNIVERSAL REMOTE

  refresh_universal_remote();


  // LOAD HOME SCREEN

  lv_scr_load(
    home_screen
  );


  set_status(
    "SYSTEM READY",
    COLOR_READY
  );


  Serial.println(
    "Nick's RipperZero ready!"
  );
}


// ============================================================
// MAIN LOOP
// ============================================================

void loop() {

  lv_timer_handler();

  delay(5);
}