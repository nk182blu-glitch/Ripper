}


void adjust_rf_raw_deviation(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  rf_raw_lab_deviation_hz = constrain((int64_t)rf_raw_lab_deviation_hz + delta,
                                      (int64_t)0, (int64_t)380000);
  refresh_rf_raw_settings_screen();
}


void cycle_rf_raw_bandwidth(lv_event_t *e) {
  static const uint32_t choices[] = {
    58000, 68000, 81000, 102000, 116000, 135000, 162000, 203000,
    232000, 270000, 325000, 406000, 464000, 541000, 650000, 812000
  };
  const int8_t direction = (int8_t)(intptr_t)lv_event_get_user_data(e);
  uint8_t nearest = 0;
  uint32_t nearest_difference = UINT32_MAX;
  for (uint8_t i = 0; i < sizeof(choices) / sizeof(choices[0]); i++) {
    const uint32_t difference = choices[i] > rf_raw_lab_bandwidth_hz ?
      choices[i] - rf_raw_lab_bandwidth_hz : rf_raw_lab_bandwidth_hz - choices[i];
    if (difference < nearest_difference) {
      nearest = i;
      nearest_difference = difference;
    }
  }
  const uint8_t count = sizeof(choices) / sizeof(choices[0]);
  nearest = direction > 0 ? (nearest + 1) % count :
    (nearest == 0 ? count - 1 : nearest - 1);
  rf_raw_lab_bandwidth_hz = choices[nearest];
  refresh_rf_raw_settings_screen();
}


void adjust_rf_raw_repeats(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  rf_raw_lab_repeat_count = constrain((int)rf_raw_lab_repeat_count + delta, 1, 20);
  refresh_rf_raw_settings_screen();
  refresh_rf_raw_lab_screen();
}


void adjust_rf_raw_gap(lv_event_t *e) {
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  rf_raw_lab_repeat_gap_us = constrain((int64_t)rf_raw_lab_repeat_gap_us + delta,
                                       (int64_t)0, (int64_t)1000000);
  refresh_rf_raw_settings_screen();
  refresh_rf_raw_lab_screen();
}


