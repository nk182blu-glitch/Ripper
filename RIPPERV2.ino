// ============================================================
// HUNTER TX45 RECEIVE-ONLY CAPTURE WORKFLOW
// ============================================================

const char *const HUNTER_TX45_TX_COMMANDS[] = {
  "0000100011111111011100",  // Fan power
  "1100000000110011111111",  // Light
  "1000000001110111111110",  // Speed up
  "1000000010110111111101",  // Speed down
  "0001000001111110111110"   // Pair
};

void load_hunter_tx45_identity() {
  if (hunter_tx45_ripper_identity != 0) return;
  saved_preferences.begin("ripperzero", true);
  hunter_tx45_ripper_identity = saved_preferences.getULong64("tx45Id", 0);
  saved_preferences.end();
  hunter_tx45_ripper_identity &= 0x7FFFFFFFFFULL;
  if (hunter_tx45_ripper_identity == 0) {
    hunter_tx45_ripper_identity =
      ((((uint64_t)esp_random()) << 32) | esp_random()) & 0x7FFFFFFFFFULL;
    if (hunter_tx45_ripper_identity == 0) hunter_tx45_ripper_identity = 1;
    saved_preferences.begin("ripperzero", false);
    saved_preferences.putULong64("tx45Id", hunter_tx45_ripper_identity);
    saved_preferences.end();
  }
}

void hunter_tx45_write_chip(bool level) {
  digitalWrite(CC1101_GDO0, level ? HIGH : LOW);
  delayMicroseconds(400);
}

void hunter_tx45_write_frame(const char *command_bits) {
  // 24 alternating preamble chips followed by 12 quiet chips.
  for (uint8_t i = 0; i < 24; i++) hunter_tx45_write_chip((i & 1) == 0);
  for (uint8_t i = 0; i < 12; i++) hunter_tx45_write_chip(false);

  // 39-bit persistent Ripper identity, fixed 01000 delimiter, 22-bit command.
  for (int8_t bit = 38; bit >= 0; bit--) {
    const bool one = (hunter_tx45_ripper_identity >> bit) & 1ULL;
    hunter_tx45_write_chip(true);
    hunter_tx45_write_chip(one);
    hunter_tx45_write_chip(false);
  }
  const char *delimiter = "01000";
  for (uint8_t i = 0; i < 5; i++) {
    hunter_tx45_write_chip(true);
    hunter_tx45_write_chip(delimiter[i] == '1');
    hunter_tx45_write_chip(false);
  }
  for (uint8_t i = 0; i < 22; i++) {
    hunter_tx45_write_chip(true);
    hunter_tx45_write_chip(command_bits[i] == '1');
    hunter_tx45_write_chip(false);
  }
  for (uint8_t i = 0; i < 62; i++) hunter_tx45_write_chip(false);
}

bool transmit_hunter_tx45(uint8_t command_index, uint8_t repeat_count) {
#if !CC1101_ACCESS_ENABLED
  (void)command_index;
  (void)repeat_count;
  return false;
#else
  if (!cc1101_ready || command_index >= 5 || rf_capture_active) return false;
  load_hunter_tx45_identity();
  if (!apply_rf_profile(0, false)) return false;
  pinMode(CC1101_GDO0, OUTPUT);
  digitalWrite(CC1101_GDO0, LOW);
  if (cc1101.transmitDirectAsync() != RADIOLIB_ERR_NONE) {
    pinMode(CC1101_GDO0, INPUT);
    return false;
  }
  for (uint8_t repeat = 0; repeat < repeat_count; repeat++) {
    hunter_tx45_write_frame(HUNTER_TX45_TX_COMMANDS[command_index]);
  }
  digitalWrite(CC1101_GDO0, LOW);
  cc1101.packetMode();
  pinMode(CC1101_GDO0, INPUT);
  return true;
#endif
}

void send_hunter_tx45_command(lv_event_t *e) {
  const uint8_t command = (uint8_t)(uintptr_t)lv_event_get_user_data(e);
  set_status("TRANSMITTING", COLOR_RF);
  lv_timer_handler();
  if (transmit_hunter_tx45(command, 4)) {
    set_status("SYSTEM READY", COLOR_READY);
    play_board_tone(1050, 55);
  } else {
    set_status("RF SEND FAILED", COLOR_RED);
  }
}

