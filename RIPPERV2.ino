}

void open_ir_raw_timings(lv_event_t *e) {
  (void)e;
  if (ir_raw_timing_screen == NULL) create_ir_raw_timing_screen();
  if (ir_raw_lab_selected_timing >= ir_raw_lab_timing_count)
    ir_raw_lab_selected_timing = ir_raw_lab_timing_count == 0 ? 0 : ir_raw_lab_timing_count - 1;
  refresh_ir_raw_timing_screen();
  lv_scr_load(ir_raw_timing_screen);
}

void raw_timing_previous(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count > 0) {
    ir_raw_lab_selected_timing = ir_raw_lab_selected_timing == 0 ?
      ir_raw_lab_timing_count - 1 : ir_raw_lab_selected_timing - 1;
  }
  refresh_ir_raw_timing_screen();
}

void raw_timing_next(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count > 0)
    ir_raw_lab_selected_timing = (ir_raw_lab_selected_timing + 1) % ir_raw_lab_timing_count;
  refresh_ir_raw_timing_screen();
}

void adjust_raw_timing(lv_event_t *e) {
  if (ir_raw_lab_timing_count == 0) return;
  const int32_t delta = (int32_t)(intptr_t)lv_event_get_user_data(e);
  int32_t value = (int32_t)ir_raw_lab_timings[ir_raw_lab_selected_timing] + delta;
  ir_raw_lab_timings[ir_raw_lab_selected_timing] = constrain(value, 10, 65535);
  refresh_ir_raw_timing_screen();
}

void add_raw_timing(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count == UINT16_MAX ||
      !reserve_ir_raw_lab_timings(ir_raw_lab_timing_count + 1)) {
    set_status("IR MEMORY LOW", COLOR_RED);
    return;
  }
  const uint16_t insert_at = ir_raw_lab_timing_count == 0 ? 0 : ir_raw_lab_selected_timing + 1;
  for (uint16_t i = ir_raw_lab_timing_count; i > insert_at; i--)
    ir_raw_lab_timings[i] = ir_raw_lab_timings[i - 1];
  ir_raw_lab_timings[insert_at] = 560;
  ir_raw_lab_timing_count++;
  ir_raw_lab_selected_timing = insert_at;
  refresh_ir_raw_timing_screen();
}

void delete_raw_timing(lv_event_t *e) {
  (void)e;
  if (ir_raw_lab_timing_count == 0) return;
  for (uint16_t i = ir_raw_lab_selected_timing; i + 1 < ir_raw_lab_timing_count; i++)
    ir_raw_lab_timings[i] = ir_raw_lab_timings[i + 1];
  ir_raw_lab_timing_count--;
  if (ir_raw_lab_selected_timing >= ir_raw_lab_timing_count && ir_raw_lab_selected_timing > 0)
    ir_raw_lab_selected_timing--;
  refresh_ir_raw_timing_screen();
}

void refresh_ir_raw_timing_screen() {
  if (ir_raw_timing_label == NULL) return;
  if (ir_raw_lab_timing_count == 0) {
    lv_label_set_text(ir_raw_timing_label, "NO TIMINGS\n\nPress ADD to create a MARK.");
    return;
  }
  char text[280];
  const bool mark = (ir_raw_lab_selected_timing & 1U) == 0;
  snprintf(text, sizeof(text),
           "TIMING %u OF %u\n\n%s\n%u microseconds\n\nSequence always alternates:\nMARK, SPACE, MARK, SPACE...",
           ir_raw_lab_selected_timing + 1, ir_raw_lab_timing_count,
           mark ? "MARK (carrier on)" : "SPACE (carrier off)",
           ir_raw_lab_timings[ir_raw_lab_selected_timing]);
  lv_label_set_text(ir_raw_timing_label, text);
}

